---
/**
 * /qui-sommes-nous — refonte éditoriale de septembre 2026 (décision owner, voir
 * MIGRATION.md § 9.dq). La page porte deux rôles :
 *  1. raconter pourquoi Hippodoc existe (récit de Ryan, repris de son pitch) ;
 *  2. servir de page auteur aux articles du blog et aux guides, dont le JSON-LD
 *     `author` pointe ici : qui écrit, avec quelles sources, soutenu par qui.
 * Chaque information n'apparaît qu'une fois (pas de frise qui redise les soutiens,
 * pas de « 900+ » répété). Zéro JS client.
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/pages/Icon.astro';
import { SITE_URL, APP_URL, PRODUCT_DEFINITION, CONTACT_EMAIL, CALENDLY_URL, SOCIALS } from '@/lib/site';
import ryanPhoto from '@/assets/founders/ryan-goburdhun.jpeg';
import thomasPhoto from '@/assets/founders/thomas-payet.jpeg';
import pitchPhoto from '@/assets/about/ryan-the-pitch-deel-station-f.jpg';

const title = 'Hippodoc, créé par un médecin remplaçant — Qui sommes-nous';
const description =
  "Ryan, médecin généraliste remplaçant, et Thomas, expert tech, ont créé Hippodoc. Soutenu par la Région Île-de-France, Bpifrance et des syndicats d'internes.";

const articleCount = (await getCollection('blog')).length;
const ryanSchemaImage = await getImage({ src: ryanPhoto, width: 400, height: 400, format: 'jpeg' });

const ryanId = `${SITE_URL}/qui-sommes-nous#ryan-goburdhun`;
const thomasId = `${SITE_URL}/qui-sommes-nous#thomas-payet`;

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: "Qui sommes-nous — l'équipe Hippodoc",
  description,
  url: `${SITE_URL}/qui-sommes-nous`,
  inLanguage: 'fr-FR',
  mainEntity: { '@id': `${SITE_URL}/#organization` },
  about: [{ '@id': ryanId }, { '@id': thomasId }],
};

const ryanSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': ryanId,
  name: 'Ryan Goburdhun',
  honorificPrefix: 'Dr',
  jobTitle: "Médecin généraliste remplaçant, fondateur d'Hippodoc",
  description:
    "Médecin généraliste remplaçant et développeur. Il a conçu l'application Hippodoc et écrit les guides et articles du blog.",
  image: `${SITE_URL}${ryanSchemaImage.src}`,
  url: `${SITE_URL}/qui-sommes-nous`,
  worksFor: { '@id': `${SITE_URL}/#organization` },
  knowsAbout: ['Remplacement médical', 'Rétrocession d’honoraires', 'URSSAF des médecins libéraux', 'CARMF', 'Micro-BNC', 'Déclaration 2035'],
  sameAs: ['https://www.linkedin.com/in/ryangbd/'],
};

const thomasSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': thomasId,
  name: 'Thomas Payet',
  jobTitle: "Direction technique d'Hippodoc",
  url: `${SITE_URL}/qui-sommes-nous`,
  worksFor: { '@id': `${SITE_URL}/#organization` },
  sameAs: ['https://www.linkedin.com/in/tpayet/'],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Qui sommes-nous', item: `${SITE_URL}/qui-sommes-nous` },
  ],
};

const promises = [
  {
    icon: 'file-check',
    title: 'Des règles vérifiées à la source',
    text: 'Calculs et guides s’appuient sur les textes officiels (impots.gouv, URSSAF, CARMF). Chaque article est daté et mis à jour quand la règle change.',
  },
  {
    icon: 'shield-check',
    title: 'Tes données protégées',
    text: 'Hébergées dans l’Union européenne. Tu peux demander leur suppression à tout moment.',
  },
  {
    icon: 'mail',
    title: 'Une vraie personne te répond',
    text: 'Tu écris, c’est nous qui lisons et qui répondons. Pas de centre d’appels.',
  },
] as const;

type Partner = { name: string; full: string; place: string; url: string; logo?: string; w?: number; h?: number };

const syndicats: Partner[] = [
  { name: 'SILR', full: 'Syndicat des Internes du Languedoc-Roussillon', place: 'Montpellier', logo: '/lovable-uploads/silr-logo-160.webp', w: 160, h: 160, url: 'https://www.silr.fr/le-silr/nos-partenaires/' },
  { name: 'CRP-IMG', full: 'Internes de médecine générale de Poitiers', place: 'Poitiers', logo: '/lovable-uploads/crp-img-logo.png', w: 300, h: 168, url: 'https://www.isnar-img.com/villes/poitiers-crp-img/' },
  { name: 'SIOI', full: "Syndicat des Internes de l'Océan Indien", place: 'La Réunion', logo: '/lovable-uploads/sioi-logo.jpg', w: 501, h: 254, url: 'https://www.sioi974.fr/' },
  { name: 'AIMGL', full: 'Association des Internes de Médecine Générale de Limoges', place: 'Limoges', logo: '/lovable-uploads/aimgl-logo-160.webp', w: 166, h: 160, url: 'https://www.aimgl.fr' },
];

/** Sans `logo`, la tuile affiche l'initiale du partenaire. */
const partenaires: Partner[] = [
  { name: 'HomeDoc', full: 'Le logement des internes en médecine', place: 'Partout en France', logo: '/lovable-uploads/homedoc-logo-160.webp', w: 147, h: 160, url: 'https://homedoc.fr' },
  { name: 'Doctripper', full: 'Plateforme de remplacements médicaux', place: 'Partout en France', logo: '/lovable-uploads/doctripper-logo.png', w: 1127, h: 1183, url: 'https://doctripper.com' },
];

const stats = [
  { icon: 'users', value: '900+', label: 'médecins inscrits' },
  { icon: 'calendar-check', value: '17 000+', label: 'journées de remplacement enregistrées' },
  { icon: 'instagram', value: '10 000+', label: 'abonnés sur Instagram' },
  { icon: 'file-check', value: String(articleCount), label: 'guides et articles gratuits' },
] as const;

/**
 * Témoignages : UNIQUEMENT de vrais avis, publiés avec l'accord de la personne
 * (prénom + initiale, statut). Tableau vide → la section n'est pas rendue.
 * Les trois avis hérités de la SPA (« Dr Sophie M. », « Dr Julien R. »,
 * « Dr Amina K. ») ont été retirés : invérifiables (MIGRATION.md § 9.dq).
 */
const testimonials: { name: string; role: string; quote: string }[] = [];

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '_');
---

<BaseLayout title={title} description={description} path="/qui-sommes-nous" jsonLd={[breadcrumbSchema, aboutSchema, ryanSchema, thomasSchema]}>
  <Header />

  <main class="flex-1 bg-white">
    <!-- Héros : une question, une phrase, un visage -->
    <section class="relative overflow-hidden bg-gradient-to-br from-hippo-50 via-white to-hippo-100/60">
      <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-hippo-200/40 blur-3xl"></div>
      <div class="container relative max-w-6xl px-4 pb-16 pt-8 md:pb-24">
        <nav aria-label="Fil d'Ariane" class="mb-10 text-sm text-muted-foreground">
          <ol class="flex flex-wrap items-center gap-1">
            <li><a href="/" class="inline-flex min-h-6 items-center hover:text-hippo-600">Accueil</a></li>
            <li aria-hidden="true">›</li>
            <li class="text-foreground" aria-current="page">Qui sommes-nous</li>
          </ol>
        </nav>

        <div class="grid items-center gap-12 md:grid-cols-[1.4fr_1fr]">
          <div>
            <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-hippo-600">Qui sommes-nous</p>
            <h1 class="mb-6 text-4xl font-bold leading-tight tracking-tight text-hippo-900 md:text-5xl">
              Hippodoc est né d'une question : <span class="text-hippo-600">«&nbsp;combien je gagne vraiment&nbsp;?&nbsp;»</span>
            </h1>
            <p class="max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl">
              Un médecin remplaçant et un expert de la tech ont construit l'outil qui te dit, à tout moment, ce que tu as gagné, ce que tu dois mettre de côté et ce qui te reste.
            </p>
          </div>

          <figure class="mx-auto w-full max-w-xs">
            <div class="relative">
              <div class="absolute -inset-3 rotate-3 rounded-[2rem] bg-hippo-200/60"></div>
              <Image src={ryanPhoto} alt="Dr Ryan Goburdhun, médecin généraliste remplaçant et fondateur d'Hippodoc" width={320} height={320} widths={[320, 640]} sizes="320px" loading="eager" class="relative aspect-square w-full rounded-[2rem] object-cover shadow-xl" />
            </div>
            <figcaption class="mt-6 text-center">
              <span class="block font-semibold text-hippo-900">Dr Ryan Goburdhun</span>
              <span class="block text-sm text-muted-foreground">Médecin généraliste remplaçant, fondateur</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- L'histoire, à la première personne (reprise du pitch de Ryan) -->
    <section class="py-16 md:py-24" aria-labelledby="histoire">
      <div class="container max-w-3xl px-4">
        <h2 id="histoire" class="mb-8 text-3xl font-bold text-hippo-900 md:text-4xl">L'histoire, racontée par Ryan</h2>
        <div class="space-y-5 text-lg leading-relaxed text-foreground/85">
          <p>
            <strong class="text-foreground">J'adore mon métier.</strong> Mais en commençant à remplacer, j'ai vite compris que le plus compliqué, ce n'était pas la médecine : c'était de savoir <strong class="text-foreground">où j'en étais financièrement</strong>. Chaque cabinet a son taux de rétrocession, ses délais, ses habitudes. L'URSSAF tombe sans prévenir, la CARMF est à anticiper, le choix micro-BNC ou réel à trancher…
          </p>
          <p>
            Le piège, c'est que les cotisations et les impôts arrivent tard, parfois calculés sur les revenus d'il y a un ou deux ans. On peut donc avoir de l'argent sur son compte alors qu'une partie n'est déjà plus vraiment à nous. Elle n'a juste pas encore été prélevée.
          </p>
        </div>

        <blockquote class="my-10 border-l-4 border-hippo-500 pl-6">
          <p class="text-2xl font-semibold leading-snug text-hippo-800 md:text-3xl">
            «&nbsp;Quand le stress financier entre dans la pièce avec le patient, ce n'est plus seulement un problème d'argent. Ça devient un problème de soin.&nbsp;»
          </p>
        </blockquote>

        <div class="space-y-5 text-lg leading-relaxed text-foreground/85">
          <p>
            En en parlant autour de moi, j'ai compris que je n'étais pas le seul : tout le monde bricolait avec un tableur, des notes iPhone et beaucoup d'inquiétude.
          </p>
          <p>
            Comme je code aussi, je pouvais construire la solution. Médecin le jour, développeur la nuit, j'ai écrit les premières lignes d'<strong class="text-foreground">Hippodoc</strong> en 2023, puis je l'ai ouvert aux premiers remplaçants en 2024 : l'outil que j'aurais voulu avoir dès mon premier remplacement.
          </p>
          <p>
            Je remplace toujours, et beaucoup d'idées d'Hippodoc viennent de là, ou des questions que m'envoient les internes.
          </p>
        </div>
        <p class="mt-8 font-semibold text-hippo-800">— Ryan</p>
      </div>
    </section>

    <!-- L'équipe -->
    <section class="bg-hippo-50/50 py-16 md:py-24" aria-labelledby="equipe">
      <div class="container max-w-5xl px-4">
        <h2 id="equipe" class="mb-12 text-center text-3xl font-bold text-hippo-900 md:text-4xl">L'équipe</h2>

        <div class="grid gap-8 md:grid-cols-2">
          <article id="ryan-goburdhun" class="scroll-mt-24 rounded-2xl border border-hippo-100 bg-white p-6 shadow-sm md:p-8">
            <div class="mb-6 flex items-center gap-4">
              <Image src={ryanPhoto} alt="" width={80} height={80} widths={[80, 160]} sizes="80px" class="h-20 w-20 shrink-0 rounded-full object-cover ring-4 ring-hippo-50" />
              <div class="min-w-0">
                <h3 class="text-xl font-bold text-hippo-900">Dr Ryan Goburdhun</h3>
                <p class="text-sm font-medium text-hippo-700">Médecin généraliste remplaçant · Fondateur</p>
                <a href="https://www.linkedin.com/in/ryangbd/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Ryan Goburdhun" class="mt-1 inline-flex min-h-6 items-center gap-1.5 text-sm text-hippo-600 hover:text-hippo-800">
                  <Icon name="linkedin" class="h-4 w-4" /> LinkedIn
                </a>
              </div>
            </div>
            <ul class="space-y-3 text-sm leading-relaxed text-muted-foreground">
              <li class="flex gap-3"><Icon name="code" class="mt-0.5 h-4 w-4 shrink-0 text-hippo-600" /><span>Conçoit et développe l'application.</span></li>
              <li class="flex gap-3"><Icon name="file-check" class="mt-0.5 h-4 w-4 shrink-0 text-hippo-600" /><span>Écrit les <a href="/blog" class="font-medium text-hippo-600 underline-offset-2 hover:underline">{articleCount} articles du blog</a> et les guides, à partir des textes officiels.</span></li>
            </ul>
          </article>

          <article id="thomas-payet" class="scroll-mt-24 rounded-2xl border border-hippo-100 bg-white p-6 shadow-sm md:p-8">
            <div class="mb-6 flex items-center gap-4">
              <Image src={thomasPhoto} alt="" width={80} height={80} widths={[80, 160]} sizes="80px" class="h-20 w-20 shrink-0 rounded-full object-cover ring-4 ring-hippo-50" />
              <div class="min-w-0">
                <h3 class="text-xl font-bold text-hippo-900">Thomas Payet</h3>
                <p class="text-sm font-medium text-hippo-700">Direction technique · COO de <a href="https://www.meilisearch.com/" target="_blank" rel="noopener noreferrer" class="underline-offset-2 hover:underline">Meilisearch</a></p>
                <a href="https://www.linkedin.com/in/tpayet/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Thomas Payet" class="mt-1 inline-flex min-h-6 items-center gap-1.5 text-sm text-hippo-600 hover:text-hippo-800">
                  <Icon name="linkedin" class="h-4 w-4" /> LinkedIn
                </a>
              </div>
            </div>
            <p class="text-sm leading-relaxed text-muted-foreground">
              «&nbsp;Chez Meilisearch, on construit des outils utilisés par des millions de personnes. Quand Ryan m'a montré comment un médecin gère ses finances, j'ai été surpris : aucune vision en temps réel, aucune estimation fiable des cotisations, zéro automatisation. J'ai rejoint Hippodoc en 2024 pour apporter une tech <strong class="text-foreground">solide, précise et simple</strong> à utiliser.&nbsp;»
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Nos engagements -->
    <section class="py-16 md:py-24" aria-labelledby="engagements">
      <div class="container max-w-5xl px-4">
        <h2 id="engagements" class="mb-12 text-center text-3xl font-bold text-hippo-900 md:text-4xl">Ce qu'on te promet</h2>
        <div class="grid gap-8 md:grid-cols-3">
          {promises.map((p) => (
            <div class="text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-hippo-600 text-white">
                <Icon name={p.icon} class="h-6 w-6" />
              </div>
              <h3 class="mb-2 font-semibold text-hippo-900">{p.title}</h3>
              <p class="text-sm leading-relaxed text-muted-foreground">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Soutiens : ce qui s'est réellement passé, pas seulement des logos -->
    <section class="bg-hippo-900 py-16 text-white md:py-24" aria-labelledby="soutiens">
      <div class="container max-w-6xl px-4">
        <h2 id="soutiens" class="mb-3 text-center text-3xl font-bold md:text-4xl">Ils ont examiné Hippodoc de près</h2>
        <p class="mx-auto mb-12 max-w-2xl text-center text-lg text-hippo-100">
          Un dossier, un jury, des questions difficiles. Voici ceux qui ont dit oui.
        </p>

        <article class="grid overflow-hidden rounded-3xl bg-white text-foreground shadow-lg lg:grid-cols-[1.3fr_1fr]">
          <Image src={pitchPhoto} alt="Ryan Goburdhun présente Hippodoc sur la scène de The Pitch by Deel, à Station F" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 660px, 100vw" class="aspect-[3/2] h-full w-full object-cover" />
          <div class="flex flex-col justify-center p-6 md:p-10">
            <p class="mb-3 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-hippo-700">
              <Icon name="mic" class="h-4 w-4" /> 13 avril 2026 · Station F, Paris
            </p>
            <h3 class="mb-4 text-2xl font-bold text-hippo-900">The Pitch by Deel : top 3&nbsp;% des candidatures</h3>
            <p class="leading-relaxed text-muted-foreground">
              Des milliers de jeunes entreprises ont candidaté dans le monde à ce concours international. Hippodoc a été retenu pour la finale de Paris, et Ryan a présenté le projet sur scène, en anglais, devant un jury d'investisseurs.
            </p>
          </div>
        </article>

        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <article class="flex gap-5 rounded-2xl bg-white p-6 text-foreground shadow-lg">
            <div class="flex w-28 shrink-0 flex-col items-center justify-center gap-3">
              <img src="/lovable-uploads/region-idf-112.webp" alt="Région Île-de-France" width="114" height="56" loading="lazy" class="h-12 w-auto" />
              <img src="/lovable-uploads/bpi-112.webp" alt="Bpifrance" width="103" height="48" loading="lazy" class="h-10 w-auto" />
            </div>
            <div>
              <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-hippo-700">Novembre 2025</p>
              <h3 class="mb-2 text-lg font-bold text-hippo-900">Lauréat Innov'Up</h3>
              <p class="text-sm leading-relaxed text-muted-foreground">
                La subvention d'innovation de la Région Île-de-France, instruite par Bpifrance, a financé le développement de l'application.
              </p>
            </div>
          </article>

          <article class="flex gap-5 rounded-2xl bg-white p-6 text-foreground shadow-lg">
            <div class="flex w-28 shrink-0 items-center justify-center">
              <img src="/lovable-uploads/french-care-160.webp" alt="La French Care" width="79" height="80" loading="lazy" class="h-20 w-auto" />
            </div>
            <div>
              <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-hippo-700">Depuis 2025</p>
              <h3 class="mb-2 text-lg font-bold text-hippo-900">Membre de La French Care</h3>
              <p class="text-sm leading-relaxed text-muted-foreground">
                Le réseau des acteurs de l'innovation en santé en France, porté avec Bpifrance.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Aux côtés des internes -->
    <section class="py-16 md:py-24" aria-labelledby="internes">
      <div class="container max-w-5xl px-4">
        <h2 id="internes" class="mb-3 text-center text-3xl font-bold text-hippo-900 md:text-4xl">Aux côtés des internes, partout en France</h2>
        <p class="mx-auto mb-12 max-w-2xl text-center text-lg text-muted-foreground">
          Ces syndicats d'internes ont signé une convention avec Hippodoc pour accompagner leurs adhérents dans leurs premiers remplacements.
        </p>

        <ul class="grid grid-cols-2 gap-4 md:grid-cols-4">
          {syndicats.map((p) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener noreferrer" data-ph={`landing_partner_${slug(p.name)}`} class="flex h-full flex-col items-center rounded-2xl border border-hippo-100 bg-white p-4 text-center transition-shadow hover:shadow-md">
                <span class="mb-3 flex h-20 w-full items-center justify-center">
                  <img src={p.logo} alt={`${p.name} — ${p.full}`} width={p.w} height={p.h} loading="lazy" class="max-h-16 max-w-full object-contain" />
                </span>
                <span class="font-semibold text-hippo-900">{p.name}</span>
                <span class="mt-1 inline-flex items-center gap-1 text-xs text-muted-foreground">
                  <Icon name="map-pin" class="h-3 w-3" /> {p.place}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <h3 class="mb-4 mt-12 text-center text-sm font-semibold uppercase tracking-wider text-hippo-700">Et des partenaires pensés pour les jeunes médecins</h3>
        <ul class="mx-auto grid max-w-xl gap-4 sm:grid-cols-2">
          {partenaires.map((p) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener noreferrer" data-ph={`landing_partner_${slug(p.name)}`} class="flex h-full items-center gap-4 rounded-2xl border border-hippo-100 bg-white p-4 transition-shadow hover:shadow-md">
                <span class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-hippo-50">
                  {p.logo ? (
                    <img src={p.logo} alt="" width={p.w} height={p.h} loading="lazy" class="max-h-12 max-w-12 object-contain" />
                  ) : (
                    <span class="text-lg font-bold text-hippo-700" aria-hidden="true">{p.name.charAt(0)}</span>
                  )}
                </span>
                <span class="min-w-0">
                  <span class="block font-semibold text-hippo-900">{p.name}</span>
                  <span class="block text-sm text-muted-foreground">{p.full}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-10 text-center text-sm text-muted-foreground">
          Tu fais partie du bureau d'un syndicat ou d'une association d'internes&nbsp;?{' '}
          <a href={`mailto:${CONTACT_EMAIL}?subject=Partenariat%20Hippodoc`} data-ph="landing_about_partner_contact" class="font-medium text-hippo-600 underline-offset-2 hover:underline">Écris-nous</a>, on monte une offre pour tes adhérents.
        </p>
      </div>
    </section>

    <!-- Hippodoc aujourd'hui : définition (GEO) + chiffres -->
    <section class="bg-hippo-50/50 py-16 md:py-24" aria-labelledby="chiffres">
      <div class="container max-w-5xl px-4">
        <h2 id="chiffres" class="mb-4 text-center text-3xl font-bold text-hippo-900 md:text-4xl">Hippodoc aujourd'hui</h2>
        <!-- GEO : définition produit verbatim (site.ts) -->
        <p class="mx-auto mb-12 max-w-2xl text-center leading-relaxed text-muted-foreground">{PRODUCT_DEFINITION}</p>
        <dl class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
          {stats.map((s) => (
            <div class="flex flex-col items-center rounded-2xl border border-hippo-100 bg-white p-5 text-center">
              <Icon name={s.icon} class="order-1 mb-3 h-6 w-6 text-hippo-600" />
              <dt class="order-3 text-sm text-muted-foreground">{s.label}</dt>
              <dd class="order-2 mb-1 text-3xl font-bold text-hippo-900 md:text-4xl">{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    {testimonials.length > 0 && (
      <section class="py-16 md:py-24" aria-labelledby="temoignages">
        <div class="container max-w-5xl px-4">
          <h2 id="temoignages" class="mb-12 text-center text-3xl font-bold text-hippo-900 md:text-4xl">Ce qu'en disent les médecins</h2>
          <div class="grid gap-6 md:grid-cols-3">
            {testimonials.map((t) => (
              <figure class="rounded-2xl border border-hippo-100 bg-white p-6">
                <Icon name="quote" class="mb-3 h-5 w-5 text-hippo-300" />
                <blockquote class="mb-4 text-sm leading-relaxed text-foreground/85">«&nbsp;{t.quote}&nbsp;»</blockquote>
                <figcaption>
                  <span class="block text-sm font-semibold text-foreground">{t.name}</span>
                  <span class="block text-xs text-muted-foreground">{t.role}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA + contact direct -->
    <section class="px-4 py-16 md:py-24">
      <div class="container relative max-w-5xl overflow-hidden rounded-3xl bg-gradient-to-br from-hippo-600 via-hippo-700 to-hippo-900 px-6 py-12 text-center text-white shadow-2xl md:py-16">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(56,189,248,0.18),transparent_55%)]"></div>
        <div class="relative">
          <h2 class="mb-4 text-3xl font-bold md:text-4xl">Prêt à y voir clair&nbsp;?</h2>
          <p class="mx-auto mb-8 max-w-xl text-lg text-hippo-100">30 jours pour essayer, sans engagement.</p>
          <a
            href={`${APP_URL}/auth?tab=signup`}
            data-track="cta_signup_qui_sommes_nous"
            class="group inline-flex items-center gap-3 rounded-2xl bg-white px-8 py-4 text-lg font-bold text-hippo-700 shadow-lg transition-transform hover:scale-105 hover:text-hippo-800"
          >
            Commencer gratuitement
            <Icon name="arrow-right" class="h-5 w-5 transition-transform group-hover:translate-x-1" />
          </a>

          <div class="mx-auto mt-12 max-w-2xl border-t border-white/15 pt-8">
            <p class="mb-4 text-sm text-hippo-100">Une question avant de te lancer&nbsp;? Écris-nous, on lit tout.</p>
            <div class="flex flex-wrap justify-center gap-3">
              <a href={`mailto:${CONTACT_EMAIL}`} data-ph="landing_about_email" class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-white/10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/20">
                <Icon name="mail" class="h-4 w-4" /> {CONTACT_EMAIL}
              </a>
              <a href={CALENDLY_URL} target="_blank" rel="noopener" data-calendly="qui_sommes_nous" class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-white/10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/20">
                <Icon name="calendar" class="h-4 w-4" /> 15 min avec Ryan
              </a>
              <a href={SOCIALS.instagram} target="_blank" rel="noopener noreferrer" data-ph="landing_about_instagram" class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-white/10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/20">
                <Icon name="instagram" class="h-4 w-4" /> @hippodoc.fr
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
