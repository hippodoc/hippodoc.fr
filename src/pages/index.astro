---
/**
 * Page d'accueil — porté de src/pages/landing/index.tsx (SPA source) + ses ~14
 * sous-composants sous src/components/landing/. Voir le rapport de migration pour
 * le détail des adaptations "zéro JS" (lightbox, carrousel, orbite, tabs, accordéons…).
 *
 * Éléments de la source volontairement non repris :
 *  - PromoBanner : dormant en prod (isInstagram10kActive() === false).
 *  - CalendlyWidget : badge flottant tiers déposé (cf. CtaBanner : CTA devenu mailto).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_URL, SOFTWARE_APPLICATION_SCHEMA } from '@/lib/site';

import HeroSection from '@/components/home/HeroSection.astro';
import SocialProofSection from '@/components/home/SocialProofSection.astro';
import PresentationVideoSection from '@/components/home/PresentationVideoSection.astro';
import FeaturesSection from '@/components/home/FeaturesSection.astro';
import CtaBanner from '@/components/home/CtaBanner.astro';
import JourneySection from '@/components/home/JourneySection.astro';
import TestimonialsSection from '@/components/home/TestimonialsSection.astro';
import PartnersSection from '@/components/home/PartnersSection.astro';
import PricingSection from '@/components/home/PricingSection.astro';
import FaqSection from '@/components/home/FaqSection.astro';

const title = 'Hippodoc — Cockpit financier des médecins | Super-Net';
const description =
  "Hippodoc calcule revenus, cotisations URSSAF, CARMF, impôts et Super-Net des médecins remplaçants, installés, collaborateurs ou salariés. Essai 30 jours.";

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Hippodoc',
  url: SITE_URL,
  description: 'Le cockpit financier des médecins qui calcule tout pour vous : revenus, cotisations, impôts et Super-Net.',
  publisher: { '@id': `${SITE_URL}/#organization` },
};

// 11 questions/réponses — verbatim, identiques à celles rendues par FaqSection.astro.
const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: "Hippodoc gère-t-il l'activité mixte libéral et salariat ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Oui, Hippodoc est conçu pour les médecins qui combinent plusieurs types d'activité. Tu peux suivre tes revenus libéraux (remplacements, cabinet propre, vacations, collaborations libérales) et salariés (hôpital, gardes, centres de santé) dans un seul outil, avec un Super-Net global qui prend tout en compte.",
      },
    },
    {
      '@type': 'Question',
      name: 'Comment calculer mes cotisations URSSAF en tant que médecin libéral ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Hippodoc calcule automatiquement tes cotisations sociales grâce à une connexion directe aux serveurs officiels de l'URSSAF. Selon ton régime (RSPM ou PAMC), tu obtiens une estimation précise de tes cotisations URSSAF et CARMF, mise à jour à chaque nouvelle journée enregistrée.",
      },
    },
    {
      '@type': 'Question',
      name: 'Quel est le meilleur régime fiscal pour un médecin libéral ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Le choix entre Micro-BNC et régime réel dépend de tes charges réelles. Hippodoc intègre un simulateur fiscal qui compare les deux régimes avec tes données réelles. En général, le Micro-BNC est avantageux si tes charges sont inférieures à 34% de ton chiffre d'affaires.",
      },
    },
    {
      '@type': 'Question',
      name: 'Comment gérer mes revenus de médecin remplaçant ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Hippodoc centralise toute ton activité en un seul endroit. Tu enregistres chaque journée avec le lieu d'exercice, le montant encaissé et la rétrocession. Le tableau de bord affiche en temps réel tes revenus encaissés, en attente, et ton Super-Net estimé après cotisations et impôts.",
      },
    },
    {
      '@type': 'Question',
      name: 'Comment suivre mes paiements en attente de rétrocession ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Hippodoc distingue automatiquement les journées payées de celles en attente. Tu visualises d'un coup d'œil les montants à percevoir, avec des alertes pour les paiements tardifs. Tu peux même envoyer des relances directement depuis l'application.",
      },
    },
    {
      '@type': 'Question',
      name: 'Comment estimer mon revenu net après impôts en tant que médecin ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Avec le Super-Net d'Hippodoc, tu vois ton vrai revenu après URSSAF, CARMF et impôts. Tout est calculé selon ta situation réelle (régime fiscal, famille, revenus salariés) pour une estimation claire, fiable et sans mauvaise surprise.",
      },
    },
    {
      '@type': 'Question',
      name: 'Peut-on générer des contrats de remplacement médical ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Oui, Hippodoc permet de générer des contrats de remplacement conformes aux exigences de l'Ordre des médecins. Tu renseignes les informations (dates, lieu d'exercice, conditions) et le contrat PDF est généré avec signature électronique intégrée.",
      },
    },
    {
      '@type': 'Question',
      name: 'Hippodoc est-il adapté aux internes et aux médecins qui débutent ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Absolument ! Hippodoc a été pensé pour accompagner les médecins dès le début de leur activité. Aucune connaissance comptable n'est requise : l'application te guide pas à pas. Tu bénéficies automatiquement du régime RSPM (cotisations réduites pour les revenus inférieurs à 38 000 €), et un tarif préférentiel est proposé aux internes. Le blog pédagogique intégré répond à toutes tes questions sur l'administratif et le fiscal.",
      },
    },
    {
      '@type': 'Question',
      name: 'Hippodoc est-il adapté aux internes en médecine ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Oui, Hippodoc accompagne les internes dès leur premier semestre. Tu suis tes gardes hospitalières, ton salaire d'interne, tes frais réels (logement de stage, déplacements CHU, congrès, livres médicaux) et tu prépares ton passage en remplacement libéral. Bonus : code promo INTERNE2026 = 90 jours offerts.",
      },
    },
    {
      '@type': 'Question',
      name: 'Comment fonctionne la collaboration libérale sur Hippodoc ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Hippodoc gère nativement la collaboration libérale. Tu enregistres ton lieu d'exercice avec ton taux de redevance, et chaque mois la redevance due est calculée automatiquement à partir de tes recettes encaissées. Le suivi payé/à verser est intégré, et la redevance est ventilée en ligne L16/BG de ta déclaration 2035, déductible de ton bénéfice imposable.",
      },
    },
  ],
};

// VideoObject — mêmes valeurs que la source (src/pages/landing/index.tsx),
// contentUrl/thumbnailUrl réécrits en absolu sur hippodoc.fr.
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Hippodoc en 90 secondes',
  description:
    "Film de présentation sous-titré d'Hippodoc : tu factures, Hippodoc calcule le reste — URSSAF, CARMF, impôts et Super-Net pour les médecins remplaçants, installés, collaborateurs ou salariés.",
  thumbnailUrl: [`${SITE_URL}/lovable-uploads/og-image.png`],
  uploadDate: '2026-08-04',
  duration: 'PT1M33S',
  contentUrl: `${SITE_URL}/__l5e/assets-v1/4cf79149-a5fa-405a-af43-eb2dcd648009/hippodoc-presentation-st.mp4`,
  publisher: { '@id': `${SITE_URL}/#organization` },
};
---

<BaseLayout
  title={title}
  description={description}
  path=""
  ogImage="https://hippodoc.fr/lovable-uploads/og-image.png"
  ogImageAlt="Hippodoc — Le cockpit financier des médecins"
  jsonLd={[SOFTWARE_APPLICATION_SCHEMA, websiteSchema, faqPageSchema, videoSchema]}
>
  <Fragment slot="head">
    <!-- Préchargement de l'image LCP du Hero (AVIF) — mirroré depuis index.html de la source. -->
    <link
      rel="preload"
      as="image"
      type="image/avif"
      href="/lovable-uploads/hero-dashboard-4-960.avif"
      imagesrcset="/lovable-uploads/hero-dashboard-4-640.avif 640w, /lovable-uploads/hero-dashboard-4-960.avif 960w, /lovable-uploads/hero-dashboard-4.avif 1920w"
      imagesizes="(max-width: 768px) 100vw, 50vw"
      fetchpriority="high"
    />
  </Fragment>

  <a
    href="#contenu-principal"
    class="fixed left-3 top-3 z-[100] -translate-y-24 rounded-md bg-background px-4 py-3 font-semibold text-foreground shadow-lg transition-transform focus:translate-y-0 focus:outline-none focus:ring-2 focus:ring-ring"
  >
    Aller au contenu principal
  </a>

  <div class="min-h-screen bg-gradient-to-b from-hippo-50 to-white">
    <Header />

    <main id="contenu-principal" tabindex="-1" class="flex-1">
      <HeroSection />
      <SocialProofSection />
      <PresentationVideoSection />
      <FeaturesSection />
      <CtaBanner />
      <JourneySection />
      <TestimonialsSection />
      <PartnersSection />
      <PricingSection />
      <FaqSection />
    </main>

    <Footer />
  </div>
</BaseLayout>
