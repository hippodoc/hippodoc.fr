---
/**
 * Page d'accueil — porté de src/pages/landing/index.tsx (SPA source) + ses ~14
 * sous-composants sous src/components/landing/. Voir le rapport de migration pour
 * le détail des adaptations "zéro JS" (lightbox, carrousel, orbite, tabs, accordéons…).
 *
 * Éléments de la source volontairement non repris :
 *  - PromoBanner : dormant en prod (isInstagram10kActive() === false).
 *  - CalendlyWidget : badge flottant tiers déposé (cf. CtaBanner : CTA devenu mailto).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
// DA 2026, phase 1 (MIGRATION.md § 9) : en-tête et pied de la nouvelle direction
// artistique, sur l'accueil seule. Les autres pages gardent Header et Footer.
import HeaderDA from '@/components/da/HeaderDA.astro';
import FooterDA from '@/components/da/FooterDA.astro';
import ScriptTiroirDA from '@/components/da/ScriptTiroirDA.astro';
// Même fichier que le `src` du @font-face de da.css : Vite émet une seule URL à
// empreinte, le préchargement et la feuille de style demandent donc le même fichier.
import policeDA from '@/assets/fonts/google-sans-flex-latin-wght400-800-rond100.woff2?url';
import { SITE_URL, SOFTWARE_APPLICATION_SCHEMA } from '@/lib/site';
import { FAQ_ACCUEIL, reponseTexte } from '@/data/faqAccueil';

// DA 2026, phases 2 et 3 : le premier écran, « Sous la surface » (fenêtre
// produit à onglets et trois grandes cases), puis les feuilles claires : « Pour
// qui », le fondateur et le film, les syndicats et partenaires, les témoignages,
// les tarifs, les questions, les guides, et la scène finale. Les anciennes
// sections (`src/components/home/`) sont supprimées depuis la phase 4a.
import Hero from '@/components/accueil/Hero.astro';
import { imagesBuste } from '@/components/accueil/buste';
import SousLaSurface from '@/components/accueil/SousLaSurface.astro';
import PourQui from '@/components/accueil/PourQui.astro';
import Fondateur from '@/components/accueil/Fondateur.astro';
import Partenaires from '@/components/accueil/Partenaires.astro';
import Temoignages from '@/components/accueil/Temoignages.astro';
import Tarifs from '@/components/accueil/Tarifs.astro';
import Questions from '@/components/accueil/Questions.astro';
import Guides from '@/components/accueil/Guides.astro';
import SceneFinale from '@/components/accueil/SceneFinale.astro';

// Mêmes fichiers que le <picture> de Hero.astro (même fabrique, mêmes URL).
const buste = await imagesBuste();

const title = 'Hippodoc — Cockpit financier des médecins | Super-Net';
const description =
  "Hippodoc calcule revenus, cotisations URSSAF, CARMF, impôts et Super-Net des médecins remplaçants, installés, collaborateurs ou salariés. Essai 30 jours.";

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Hippodoc',
  url: SITE_URL,
  description: 'Le cockpit financier des médecins qui calcule tout pour vous : revenus, cotisations, impôts et Super-Net.',
  publisher: { '@id': `${SITE_URL}/#organization` },
};

// 10 questions/réponses — verbatim, identiques à celles rendues par accueil/Questions.astro.
const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  // Dérivé de la source unique : le schéma ne peut plus diverger du texte visible,
  // ce que Google exige. Auparavant les 10 questions étaient recopiées à la main ici.
  mainEntity: FAQ_ACCUEIL.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: reponseTexte(item) },
  })),
};

// VideoObject. Depuis le 10 novembre 2026 (MIGRATION.md § 9.ec) : film vertical
// de 57 secondes, servi par le site. contentUrl = public/hippodoc-film-v21.mp4
// (le `src` du <video>, cf. accueil/Fondateur.astro), thumbnailUrl =
// public/hippodoc-film-v21-poster.jpg (le film à 8,5 s). `name` suit le titre
// visible du bloc ; `description` attend la phase 4c (§ 9.eb).
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Hippodoc en une minute',
  description:
    "Film de présentation sous-titré d'Hippodoc : tu factures, Hippodoc calcule le reste — URSSAF, CARMF, impôts et Super-Net pour les médecins remplaçants, installés, collaborateurs ou salariés.",
  thumbnailUrl: [`${SITE_URL}/hippodoc-film-v21-poster.jpg`],
  uploadDate: '2026-11-10T22:00:00+01:00',
  duration: 'PT57S',
  contentUrl: `${SITE_URL}/hippodoc-film-v21.mp4`,
  width: 720,
  height: 1280,
  publisher: { '@id': `${SITE_URL}/#organization` },
};
---

<BaseLayout
  title={title}
  description={description}
  path=""
  ogImage="https://www.hippodoc.fr/lovable-uploads/og-image.png"
  ogImageAlt="Hippodoc — Le cockpit financier des médecins"
  jsonLd={[SOFTWARE_APPLICATION_SCHEMA, websiteSchema, faqPageSchema, videoSchema]}
  bodyClass="da"
>
  <Fragment slot="head">
    <!-- Police de la DA : préchargée, sinon elle n'est découverte qu'après la feuille de style.
         `crossorigin` obligatoire : sans lui, le fichier est téléchargé deux fois. -->
    <link rel="preload" as="font" type="font/woff2" href={policeDA} crossorigin />
    <!-- Barre du navigateur mobile : le ciel de la DA (jeton sky-1). -->
    <meta name="theme-color" content="#C9DEFF" />
    <!-- Préchargement du buste de la mascotte, l'image du premier écran. Pas de `href` :
         un navigateur qui lit l'AVIF mais pas `imagesrcset` (Safari 16.4 à 17.1)
         téléchargerait une largeur que le <picture> ne choisira peut-être pas. -->
    <link
      rel="preload"
      as="image"
      type="image/avif"
      imagesrcset={buste.avif.srcSet.attribute}
      imagesizes={buste.sizes}
      fetchpriority="high"
    />
  </Fragment>

  <a
    href="#contenu-principal"
    class="fixed left-3 top-3 z-[100] -translate-y-24 rounded-md bg-background px-4 py-3 font-semibold text-foreground shadow-lg transition-transform focus:translate-y-0 focus:outline-none focus:ring-2 focus:ring-ring"
  >
    Aller au contenu principal
  </a>

  <div class="min-h-screen bg-gradient-to-b from-hippo-50 to-white">
    {/* La pastille survole le ciel du premier écran, qui lui réserve le haut. */}
    <HeaderDA variante="flottante" />

    <main id="contenu-principal" tabindex="-1" class="flex-1">
      <Hero />
      <SousLaSurface />
      <PourQui />
      <Fondateur />
      <Partenaires />
      <Temoignages />
      <Tarifs />
      <Questions />
      <Guides />
      <SceneFinale />
    </main>

    {/* Les trois logos des soutiens sont dans le bloc Partenaires : le pied ne les répète pas. */}
    <FooterDA soutiens={false} />
    {/* Micro-script du tiroir mobile de l'en-tête, hors du flux de l'en-tête. */}
    <ScriptTiroirDA />
  </div>
</BaseLayout>
