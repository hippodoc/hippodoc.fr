---
/**
 * /guide — page de téléchargement du « Guide du remplaçant » (PDF offert).
 *
 * Porte d'entrée du lien envoyé en DM Instagram par ManyChat
 * (`?utm_source=instagram&utm_medium=dm&utm_campaign=…`) : la cible est le
 * navigateur intégré d'Instagram, sur téléphone. D'où, sur mobile, le bouton de
 * téléchargement dans le premier écran, AVANT la couverture.
 *
 * Page indexable : le sommaire et les 6 règles (repris du guide, p. 2 et 3)
 * sont le texte que Google lit. Le PDF lui-même porte `X-Robots-Tag: noindex`
 * (vercel.json) : c'est cette page, mesurée et reliée au reste du site, qui doit
 * se positionner, pas le fichier nu. Voir MIGRATION.md § 9.di.
 *
 * Habillée dans la DA 2026 en phase 5d (MIGRATION.md § 9.em) : seul l'habillage
 * a changé. Textes, titres, liens, images, ordre des blocs, JSON-LD, `data-ph`,
 * `data-guide-download` et `data-guide-share` sont ceux d'avant, au caractère près
 * (période d'observation SEO). Un bloc « ciel » (titre, bouton, couverture), trois
 * feuilles (les règles, le sommaire, l'aperçu), puis la fin : l'auteur, le second
 * bouton sur l'eau profonde, l'appel au simulateur, et le soleil sur l'eau du
 * pied. Aucune classe utilitaire : tout est dans le <style> de la page.
 *
 * Mesure : `guide_remplacant_viewed` / `guide_remplacant_downloaded`
 * (page-analytics.ts), via `[data-guide-download]`. Zéro JS propre à la page.
 */
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BlogCtaBand from '@/components/BlogCtaBand.astro';
import { SITE_URL } from '@/lib/site';
import { GUIDE_REMPLACANT } from '@/lib/guide-remplacant';
import couverture from '@/assets/guide/couverture.png';
import apercuRegles from '@/assets/guide/apercu-6-regles.png';
import apercuJournee from '@/assets/guide/apercu-journee-600.png';
import apercuCalendrier from '@/assets/guide/apercu-calendrier.png';
import ryanPhoto from '@/assets/founders/ryan-goburdhun.jpeg';

const { pdf, edition, pages, misAJourIso, misAJourTexte } = GUIDE_REMPLACANT;

/* Partage WhatsApp : simple lien `wa.me`, zéro JS. L'UTM rattache les visites
   issues d'un partage entre internes (`hd_premiere_source` = whatsapp). */
const partageWhatsApp = `https://wa.me/?text=${encodeURIComponent(
  `Le guide du remplaçant ${edition}, offert par Hippodoc : licence, contrat, URSSAF, CARMF, impôts. ${SITE_URL}/guide?utm_source=whatsapp&utm_medium=partage&utm_campaign=guide-remplacant`
)}`;

const title = 'Guide du médecin remplaçant 2026-2027 (PDF gratuit)';
const description =
  "Licence, contrat, URSSAF, CARMF, impôts : le guide offert aux internes et jeunes remplaçants. 26 pages, chiffres 2026, et ce qu'il te reste vraiment.";
const path = '/guide';

const sommaire = [
  { n: 1, titre: 'Libéral, salarié ou les deux', detail: 'Ton cadre, et l’intérim en établissement' },
  { n: 2, titre: 'Démarrer', detail: 'Les démarches dans l’ordre, licence et autorisation' },
  { n: 3, titre: 'Ton premier rempla', detail: 'Le contrat en 4 points, le jour J' },
  { n: 4, titre: 'Ton argent', detail: 'La rétrocession, ta journée à 600 €, le Super-Net' },
  { n: 5, titre: 'Tes cotisations', detail: 'RSPM ou PAMC, pourquoi l’année 2 pique, la CARMF en clair' },
  { n: 6, titre: 'Tes impôts', detail: 'Micro-BNC ou réel, acomptes, le piège de septembre, CFE' },
  { n: 7, titre: 'Combien il te reste vraiment', detail: '3 profils chiffrés, la règle des 35 %' },
  { n: 8, titre: 'Te protéger', detail: 'Si tu t’arrêtes, qui paie ?' },
  { n: 9, titre: 'Ton calendrier et ta routine', detail: 'Ton année en un coup d’œil, rempla après rempla' },
];

/* Guide p. 3, « L'essentiel en 6 règles » : titres et textes repris du PDF.
   Rendus en set:html pour les exposants (1<sup>re</sup>…) : chaînes littérales, jamais de saisie. */
const regles = [
  {
    titre: 'Une licence ne suffit pas pour remplacer.',
    texte:
      'Interne, chaque rempla demande aussi une autorisation de l’Ordre, demandée par le remplacé, et un contrat écrit, même pour une journée.',
  },
  {
    titre: 'Ton chiffre d’affaires n’est pas ton revenu.',
    texte:
      'Sur 100 € de rétrocession, il te reste de 60 à 69 € dans nos profils types, une fois cotisations, impôt et frais payés : ton Super-Net.',
  },
  {
    titre: '35 % de chaque virement, de côté.',
    texte:
      'Sur un compte à part, dès que l’argent arrive : ta réserve pour les cotisations et l’impôt. À ajuster selon ton cas.',
  },
  {
    titre: 'Les premiers prélèvements sont trompeurs.',
    texte: 'En PAMC (le régime classique), tu paies d’abord des forfaits. La vraie facture arrive pendant ta 2<sup>e</sup> année.',
  },
  {
    titre: 'Aucun impôt prélevé la 1<sup>re</sup> année, sauf si tu agis.',
    texte:
      'Crée ton acompte sur impots.gouv.fr dès ta première rétro. Sinon, tout tombe à partir de septembre de l’année suivante.',
  },
  {
    titre: 'Pas d’indemnités de l’Assurance maladie avant 12 mois.',
    texte: 'La CARMF ne prend le relais qu’à partir du 91<sup>e</sup> jour d’arrêt. Une prévoyance se prend tôt.',
  },
];

const apercus = [
  { src: apercuRegles, legende: 'L’essentiel en 6 règles', alt: 'Page 3 du guide : l’essentiel en 6 règles' },
  { src: apercuJournee, legende: 'Ta journée à 600 €, vraiment', alt: 'Page 10 du guide : de 600 € de rétrocession à 373 € de Super-Net' },
  { src: apercuCalendrier, legende: 'Ton année en un coup d’œil', alt: 'Page 22 du guide : le calendrier de l’année du remplaçant' },
];

const guideSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  '@id': `${SITE_URL}${path}#guide`,
  name: `Le guide du remplaçant ${edition}`,
  description:
    'Licence, contrat, URSSAF, CARMF, impôts : le guide des internes et jeunes remplaçants pour démarrer ses remplacements et savoir ce qu’il reste vraiment.',
  bookFormat: 'https://schema.org/EBook',
  encodingFormat: 'application/pdf',
  numberOfPages: pages,
  inLanguage: 'fr-FR',
  isAccessibleForFree: true,
  url: `${SITE_URL}${path}`,
  image: `${SITE_URL}/guide/partage.jpg`,
  datePublished: misAJourIso,
  dateModified: misAJourIso,
  author: { '@type': 'Person', name: 'Ryan Goburdhun', jobTitle: 'Médecin, fondateur d’Hippodoc', url: `${SITE_URL}/qui-sommes-nous` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  audience: { '@type': 'Audience', audienceType: 'Internes en médecine et jeunes médecins remplaçants' },
};

/* Les flèches et les points de suspension du menu d'Instagram ne sont pas dans
   la police : dessinés, le caractère reste dans le texte, masqué à l'œil. */
const iconeTelechargement =
  '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>';
const flecheDroite =
  '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>';
const troisPoints =
  '<svg class="pts" width="18" height="18" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true"><circle cx="3.5" cy="9" r="1.6"/><circle cx="9" cy="9" r="1.6"/><circle cx="14.5" cy="9" r="1.6"/></svg>';
---

<BaseLayout
  {title}
  {description}
  {path}
  ogImage="/guide/partage.jpg"
  ogImageAlt={`Le guide du remplaçant ${edition}, PDF gratuit de 26 pages par Hippodoc`}
  jsonLd={[guideSchema]}
  bodyClass="da-fond"
>
  <Fragment slot="head">
    {/* Barre du navigateur mobile : le ciel de la DA (jeton sky-1), comme l'accueil. */}
    <meta name="theme-color" content="#C9DEFF" />
  </Fragment>
  {/* La pastille survole le ciel du premier bloc, qui lui réserve le haut. */}
  <Header variante="flottante" />

  <!-- Pas de bulle de chat sur mobile ici : elle masquait la droite des cartes
       (56 px sur 320) pendant toute la lecture, et ces visiteurs arrivent d'un DM
       Instagram, où la conversation a déjà lieu (le guide le dit p. 25). Sur
       ordinateur, la bulle reste (§ 9.dk). -->
  <style is:global>
    @media (max-width: 767px) {
      #crisp-launcher {
        display: none;
      }
    }
  </style>

  <main>
    <!-- Le ciel : sur mobile, titre → bouton → couverture (le bouton tient dans le
         premier écran). À partir de 768 px, la couverture est à droite du titre. -->
    <section class="tete da-bloc">
      <div class="wrap haut">
        <div class="intro">
          <p class="marque">
            <span class="num">PDF gratuit</span>&nbsp;· <span class="num">{pages} pages</span>&nbsp;·{' '}
            <span class="num">Édition {edition}</span>
          </p>
          <h1 class="aff">
            Le guide du médecin remplaçant <span class="num eau">{edition}</span>
          </h1>
          <p class="lead">
            Licence, contrat, URSSAF, CARMF, impôts : tout pour démarrer tes remplas sereinement,{' '}
            <strong>et savoir ce qu'il te reste vraiment.</strong>
          </p>
          <div class="action">
            <a
              href={pdf}
              target="_blank"
              rel="noopener"
              type="application/pdf"
              data-guide-download="hero"
              data-ph="guide_remplacant_download_hero"
              class="btn btn-brand"
            >
              <Fragment set:html={iconeTelechargement} />
              Télécharger le guide
            </a>
            <p class="note">Sans inscription · Médecine générale et spécialités</p>
            <p class="note">
              Rien ne s'ouvre ? Touche <span aria-hidden="true" class="sr">⋯</span><Fragment set:html={troisPoints} /><span class="sr">le menu</span> puis
              « Ouvrir dans le navigateur ».
            </p>
          </div>
        </div>

        <div class="couverture">
          <a href={pdf} target="_blank" rel="noopener" data-guide-download="couverture" tabindex="-1" aria-hidden="true">
            <Image
              src={couverture}
              alt=""
              widths={[288, 432, 576, 720]}
              sizes="(min-width: 768px) 320px, 288px"
              loading="eager"
              fetchpriority="high"
            />
          </a>
        </div>
      </div>
    </section>

    <!-- L'essentiel en 6 règles (guide p. 3) : une feuille sable, six fiches -->
    <section class="band da-bloc" aria-labelledby="regles">
      <div class="wrap">
        <div class="band-head">
          <p class="sur">Si tu ne lis qu'une page</p>
          <h2 id="regles">L'essentiel en 6 règles</h2>
        </div>
        <ol class="regles" role="list">
          {regles.map((r, i) => (
            <li class="regle">
              <span class="n">
                {i + 1}
              </span>
              <span class="regle-in">
                <strong set:html={r.titre} />
                <span class="regle-p" set:html={r.texte} />
              </span>
            </li>
          ))}
        </ol>
        <!-- Relance au pic d'intérêt : après les règles, le détail est dans le PDF. -->
        <p class="relance">
          Le détail et les chiffres 2026 de chaque règle sont dans le guide.
          <a
            href={pdf}
            target="_blank"
            rel="noopener"
            type="application/pdf"
            data-guide-download="regles"
            data-ph="guide_remplacant_download_regles"
            class="lien fl"
          >
            Télécharger le guide <span aria-hidden="true" class="sr">→</span><Fragment set:html={flecheDroite} />
          </a>
        </p>
      </div>
    </section>

    <!-- Sommaire : une feuille ciel, le titre à gauche, les neuf chapitres sur une fiche -->
    <section class="band air da-bloc" aria-labelledby="sommaire">
      <div class="wrap cote">
        <div class="band-head">
          <h2 id="sommaire">Ce que tu vas trouver dedans</h2>
          <p class="lead">
            Le guide qu'on aurait aimé lire avant notre premier rempla. Licence en poche, tout arrive en même temps :
            l'Ordre, l'URSSAF, la CARMF, les impôts, et la question que personne ne pose clairement : combien il te reste
            vraiment ? Neuf chapitres, dans l'ordre où tu en auras besoin.
          </p>
        </div>
        <div class="chapitres">
          <ol class="fiche" role="list">
            {sommaire.map((c) => (
              <li class="chapitre">
                <span class="n">
                  {c.n}
                </span>
                <span class="chapitre-in">
                  <span class="chapitre-t">{c.titre}</span>
                  <span class="chapitre-p">{c.detail}</span>
                </span>
              </li>
            ))}
          </ol>
          <p class="plus">
            Plus un glossaire des sigles (ASV, BNC, PAMC, RSPM…) et la liste des sources officielles.
          </p>
        </div>
      </div>
    </section>

    <!-- Aperçu de pages : une feuille sable, trois pages en cartes au bord blanc -->
    <section class="band da-bloc" aria-labelledby="apercu">
      <div class="wrap">
        <div class="band-head">
          <h2 id="apercu">Un aperçu</h2>
          <p class="lead">
            Des pages courtes, des exemples chiffrés, et un calendrier pour ne rater aucune échéance.
          </p>
        </div>
        <ul class="pages" role="list">
          {apercus.map((a) => (
            <li>
              <figure>
                <Image
                  src={a.src}
                  alt={a.alt}
                  widths={[280, 420, 560]}
                  sizes="(min-width: 768px) 30vw, 72vw"
                  loading="lazy"
                />
                <figcaption>{a.legende}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Auteur, fraîcheur, second bouton : la fin, sur le ciel, puis le soleil de
         l'accueil qui se lève sur l'eau du pied de page (décor). -->
    <section class="fin da-bloc" aria-labelledby="auteur">
      <div class="wrap fin-in">
        <h2 id="auteur" class="sr">Qui a écrit ce guide</h2>
        <div class="auteur">
          <Image src={ryanPhoto} alt="Ryan Goburdhun" width={128} height={128} />
          <div>
            <p class="auteur-nom">
              Écrit par <a href="/qui-sommes-nous#ryan-goburdhun" class="lien">Ryan</a>, médecin, fondateur d'Hippodoc
            </p>
            <p class="auteur-mot">
              À jour au {misAJourTexte}. Chaque chiffre renvoie à sa source : Ordre des médecins, URSSAF, CARMF,
              Assurance maladie, impots.gouv.fr. Information générale : pour ton cas, vois avec ton conseil de l'Ordre,
              l'URSSAF, la CARMF ou un expert-comptable.
            </p>
          </div>
        </div>

        <div class="garde">
          <p class="garde-t">Garde-le sous la main pour ton premier rempla</p>
          <p class="garde-p">Et envoie-le à un co-interne qui démarre.</p>
          <div class="garde-btn">
            <a
              href={pdf}
              target="_blank"
              rel="noopener"
              type="application/pdf"
              data-guide-download="bas"
              data-ph="guide_remplacant_download_bas"
              class="btn btn-brand"
            >
              <Fragment set:html={iconeTelechargement} />
              Télécharger le guide
            </a>
          </div>
          <a
            href={partageWhatsApp}
            target="_blank"
            rel="noopener"
            data-guide-share="whatsapp"
            data-ph="guide_remplacant_share_whatsapp"
            class="envoi"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            L'envoyer sur WhatsApp
          </a>
        </div>

        <div class="chiffres">
          <BlogCtaBand emplacement="guide_remplacant" />
        </div>
      </div>
      <div class="horizon" aria-hidden="true">
        <span class="sun"></span>
        <span class="wave w3"></span>
        <span class="wave w4"></span>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Un groupe de mots reste sur une ligne ; plus large que son bloc (texte
     grossi), il se dénoue au lieu de déborder. */
  .num { display: inline-block; max-width: 100%; white-space: normal; }
  .sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* Texte grossi : un mot plus large que sa fiche se coupe au lieu de la pousser. */
  main { overflow-wrap: break-word; }

  /* Le ciel : le bloc passe sous la pastille de l'en-tête, il lui réserve le
     haut. En bas, l'air et les 40 px que recouvre la feuille suivante. */
  .tete { position: relative; padding: 100px 0 96px; background: linear-gradient(var(--sky-1) 0, var(--sky) 460px); }
  /* Corps de texte en rem : la feuille de la DA les pose en px, ils ne suivaient
     plus la taille de police du navigateur. Même rendu à 16 px. */
  .da-bloc { font-size: 1.0625rem; }
  .lead { font-size: 1.1875rem; }
  .btn { font-size: 1.0625rem; }
  h2 { --corps: clamp(min(2rem, 10vw), 4.5vw, 3.625rem); }

  /* Le premier écran. Une colonne bornée : le titre, le bouton, la couverture. */
  .haut { display: grid; grid-template-columns: minmax(0, 1fr); gap: 34px; }
  .intro > * { margin: 0; }
  /* « PDF gratuit · 26 pages · Édition » : une pastille blanche, comme « FAQ ». */
  /* Deux classes : la remise à zéro des marges (`.intro > *`) pèse plus qu'une
     classe seule, une fois le style scopé. */
  .intro .marque { display: inline-block; margin-bottom: 16px; padding: 5px 14px; border-radius: 18px; background: var(--paper); box-shadow: var(--clay-sm); font-size: 0.84375rem; font-weight: var(--tb); line-height: 1.5; color: var(--ink); }
  .intro h1 { --corps: var(--h1-page); text-wrap-style: balance; }
  .eau { color: var(--w4); }
  .intro .lead { margin-top: 16px; }
  .lead strong { color: var(--ink); }
  .intro .action { margin-top: 26px; }
  .action > * { margin: 0; }
  /* Le bouton : toute la largeur sur téléphone (la cible du navigateur intégré
     d'Instagram), à sa mesure au-delà. */
  .action .btn, .garde .btn { gap: 10px; width: 100%; min-height: 58px; padding-block: 8px; font-size: 1.1875rem; text-align: center; }
  .btn :global(svg) { flex: none; }
  .note { font-size: 0.9375rem; line-height: 1.5; color: var(--ink-2); }
  .action .btn + .note { margin-top: 18px; }
  .note + .note { margin-top: 4px; }
  /* Les trois points du menu d'Instagram : dessinés, sur la ligne du texte. */
  .note :global(.pts) { display: inline-block; margin: 0 0.1em; vertical-align: -0.22em; color: var(--ink); }

  /* La couverture : une carte au bord blanc, à peine penchée. */
  .couverture { justify-self: center; width: 100%; max-width: 18rem; }
  .couverture a { display: block; }
  .couverture img { box-sizing: border-box; display: block; width: 100%; height: auto; border: 6px solid var(--paper); border-radius: var(--r-md); box-shadow: var(--clay); rotate: 2deg; }

  /* Petit titre au-dessus d'un titre */
  .sur { font-size: 0.8125rem; font-weight: var(--tb); letter-spacing: 0.08em; line-height: 1.4; text-transform: uppercase; color: var(--ink-3); }
  .band-head .sur { margin-bottom: -4px; }

  /* Le numéro : une pastille encre. */
  .n { display: inline-flex; flex: none; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: var(--ink); color: var(--paper); font-size: 0.9375rem; font-weight: var(--tb); line-height: 1; font-variant-numeric: tabular-nums; }

  /* Les six règles : six fiches. */
  .regles { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .regle { display: flex; gap: 14px; padding: 20px 20px 22px; border-radius: 24px; background: var(--paper); box-shadow: var(--clay-sm); }
  .regle-in { min-width: 0; }
  .regle strong { display: block; font-size: 1.0625rem; line-height: 1.35; color: var(--ink); text-wrap-style: pretty; }
  .regle-p { display: block; margin-top: 6px; font-size: 1rem; line-height: 1.55; color: var(--ink-2); }
  /* Les exposants (« 1re », « 2e ») ne changent pas l'interligne. */
  .regle :global(sup) { line-height: 0; }
  .relance { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; margin: 22px 0 0; font-size: 1rem; color: var(--ink-2); }
  /* La flèche dessinée, sur la ligne du lien. */
  .fl { display: inline-flex; align-items: center; gap: 6px; }
  .fl :global(svg) { flex: none; }

  /* Le sommaire : le titre et le chapô à gauche, les chapitres à droite. */
  .cote { display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; gap: 26px; }
  .cote .band-head { margin-bottom: 0; }
  .cote .lead { font-size: 1.0625rem; line-height: 1.6; }
  .chapitres { min-width: 0; }
  .fiche { margin: 0; padding: 6px 20px; border-radius: 28px; background: var(--paper); box-shadow: var(--clay); list-style: none; }
  .chapitre { display: flex; gap: 14px; padding: 14px 0; border-top: 1px solid var(--line); }
  .chapitre:first-child { border-top: 0; }
  .chapitre .n { width: 28px; height: 28px; margin-top: 1px; font-size: 0.875rem; }
  .chapitre-in { min-width: 0; }
  .chapitre-t { display: block; font-weight: var(--tb); line-height: 1.35; color: var(--ink); }
  .chapitre-p { display: block; margin-top: 2px; font-size: 0.96875rem; line-height: 1.5; color: var(--ink-2); }
