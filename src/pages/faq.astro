/* Les feuilles : quatre fonds pour dix rubriques. Les rubriques gardent leur
   ordre : une feuille ne fait que réunir des voisines (vérifié au build). */
const FEUILLES: { ton: 'sable' | 'fond' | 'air'; ids: string[] }[] = [
  { ton: 'sable', ids: ['activite', 'revenus', 'planification'] },
  { ton: 'fond', ids: ['paiements', 'cotisations', 'documents'] },
  { ton: 'air', ids: ['mobile', 'securite'] },
  { ton: 'sable', ids: ['tarifs', 'contact'] },
];
if (FEUILLES.flatMap((f) => f.ids).join() !== faqSections.map((s) => s.id).join()) {
  throw new Error('/faq : FEUILLES doit reprendre toutes les rubriques, dans leur ordre');
}
const feuilles = FEUILLES.map((f) => ({ ton: f.ton, sections: faqSections.filter((s) => f.ids.includes(s.id)) }));

let globalQuestionIndex = 0;

/* Pas de « ? », « : », « ! » ou « / » seul en début de ligne : le mot qui précède et sa
   ponctuation tiennent ensemble dans un <span class="num">. Le texte ne change
   pas (l'espace reste une espace), ni le JSON-LD, qui lit `q` et `aPlain`.
   Les balises sont laissées telles quelles, seul le texte entre elles est lu. */
const nouer = (html: string) =>
  html
    .split(/(<[^>]+>)/)
    .map((morceau) => (morceau.startsWith('<') ? morceau : morceau.replace(/(\S+) ([?!:/])(?=\s|$)/g, '<span class="num">$1 $2</span>')))
    .join('');
/* Une question est du texte, pas du HTML : elle est échappée avant d'être nouée. */
const echapper = (texte: string) => texte.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSections.flatMap((section) =>
    section.questions.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.aPlain },
    }))
  ),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: `${SITE_URL}/faq` },
  ],
};

const title = 'FAQ Hippodoc - Questions fréquentes pour médecins';
const description =
  'Toutes les réponses sur Hippodoc : activité libérale et salariée, cotisations URSSAF, Super-Net, fiscalité, paiements et export comptable.';

/* La mascotte : mêmes largeurs et mêmes formats que dans accueil/SousLaSurface.astro,
   donc les mêmes fichiers (aucune image de plus dans le build). */
const [mascotteAvif, mascotteWebp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: tablette, format, width: 250, widths: [150, 250, 300, 500] }))
);
const TAILLES = '(min-width: 900px) 250px, (min-width: 560px) 190px, 124px';
/* Le pouce levé : mêmes largeurs et mêmes formats que dans accueil/TroisCases.astro. */
const [pouceAvif, pouceWebp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: pouce, format, width: 230, widths: [150, 230, 300, 460] }))
);
const TAILLES_POUCE = '(min-width: 900px) 160px, (min-width: 560px) 104px, 92px';
---

<BaseLayout title={title} description={description} path="/faq" jsonLd={[breadcrumbSchema, faqSchema]} bodyClass="da-fond">
  <Fragment slot="head">
    {/* Barre du navigateur mobile : le ciel de la DA (jeton sky-1), comme l'accueil. */}
    <meta name="theme-color" content="#C9DEFF" />
  </Fragment>
  {/* La pastille survole le ciel du premier bloc, qui lui réserve le haut. */}
  <Header />

  <main>
    <div class="tete da-bloc">
      <div class="wrap">
        <nav aria-label="Fil d'Ariane" class="fil">
          <ol role="list">
            <li><a href="/">Accueil</a></li>
            <li aria-hidden="true">›</li>
            <li aria-current="page">FAQ</li>
          </ol>
        </nav>

        <div class="intro">
          <div class="marque">
            <Fragment set:html={picto('aide', 16)} />
            <span>FAQ</span>
          </div>

          <h1 class="aff">
            Toutes tes questions sur{' '}
            <span>Hippodoc</span>
          </h1>
          <p class="lead">
            L'app qui simplifie la gestion administrative de <strong>tous les médecins</strong>
          </p>
        </div>

        {/* Décor : elle consulte sa tablette, debout derrière la première feuille. */}
        <picture class="guide">
          <source type="image/avif" srcset={mascotteAvif.srcSet.attribute} sizes={TAILLES} />
          <img src={mascotteWebp.src} srcset={mascotteWebp.srcSet.attribute} sizes={TAILLES} alt="" width={mascotteWebp.attributes.width} height={mascotteWebp.attributes.height} decoding="async" />
        </picture>
      </div>
    </div>

    {/* Quatre feuilles : sable, eau profonde, ciel, sable. Dans une feuille, les
        rubriques se suivent. */}
    {feuilles.map((feuille) => (
      <div class:list={['band', 'da-bloc', 'feuille', feuille.ton]}>
        {feuille.sections.map((section) => (
          <section id={section.id} class="rubrique">
            <div class="wrap grille">
              <div class:list={['nom', section.id === 'contact' && 'aidee']}>
                <span class="pastille" aria-hidden="true"><span class="sr">{section.icon}</span><Fragment set:html={picto(DESSINS[section.id], 24)} /></span>
                <h2 set:html={nouer(echapper(section.title))} />
                {/* Décor : elle lève le pouce, debout derrière les questions. */}
                {section.id === 'contact' && (
                  <picture class="pouce">
                    <source type="image/avif" srcset={pouceAvif.srcSet.attribute} sizes={TAILLES_POUCE} />
                    <img src={pouceWebp.src} srcset={pouceWebp.srcSet.attribute} sizes={TAILLES_POUCE} alt="" width={pouceWebp.attributes.width} height={pouceWebp.attributes.height} loading="lazy" decoding="async" />
                  </picture>
                )}
              </div>

              <div class="liste">
                {section.questions.map((item) => {
                  globalQuestionIndex++;
                  const questionNumber = globalQuestionIndex;
                  return (
                    <details class="qa">
                      <summary>
                        <span class="qa-t"><span class="qa-n">{questionNumber}</span><span class="qa-q" set:html={nouer(echapper(item.q))} /></span>
                        <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 3v12M3 9h12"/></svg>
                      </summary>
                      <div class="qa-in" set:html={nouer(item.aHtml)} />
                    </details>
                  );
                })}
              </div>
            </div>
          </section>
        ))}
      </div>
    ))}

    {/* La fin : la question, les deux portes de sortie, puis le soleil de
        l'accueil qui se lève sur l'eau du pied de page (décor). */}
    <div class="fin da-bloc">
      <div class="wrap fin-copy">
        <p class="aff">Tu n'as pas trouvé ta <span class="num">réponse ?</span></p>
        <div class="portes">
          <a href="/#pricing" class="btn btn-brand">
            Découvrir Hippodoc
          </a>
          <a href="mailto:contact@hippodoc.fr" class="btn btn-white">
            <Fragment set:html={picto('courrier', 18)} />
            Nous contacter
          </a>
        </div>
      </div>
      <div class="horizon" aria-hidden="true">
        <span class="sun"></span>
        <span class="wave w3"></span>
        <span class="wave w4"></span>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .num, .nom :global(.num) { white-space: nowrap; }
  .sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Le ciel : le bloc passe sous la pastille de l'en-tête, il lui réserve le
     haut. En bas, l'air et les 40 px que recouvre la première feuille. */
  .tete { position: relative; padding: 100px 0 88px; background: linear-gradient(var(--sky-1) 0, var(--sky) 460px); }
  /* Corps de texte en rem : la feuille de la DA les pose en px, ils ne suivaient
     plus la taille de police du navigateur. Même rendu à 16 px. */
  .da-bloc { font-size: 1.0625rem; }
  .lead { font-size: 1.1875rem; }
  .btn { font-size: 1.0625rem; }
  .qa-t { font-size: 1.125rem; }
  /* Texte grossi : un mot plus large que sa fiche se coupe au lieu de la
     pousser, et un mot noué à sa ponctuation (`.num`) peut alors se dénouer. */
  .qa-t, .qa-q { min-width: 0; overflow-wrap: anywhere; }
  .qa-q :global(.num) { display: inline-block; max-width: 100%; white-space: normal; }
  .fil { font-size: 0.90625rem; color: var(--ink-2); }
  .fil ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0 6px; margin: 0; padding: 0; list-style: none; }
  /* Une cible de 44 px de haut, sans changer la hauteur de la ligne. */
  .fil a { display: inline-flex; align-items: center; min-height: 44px; margin: -10px 0; border-radius: 6px; color: inherit; text-decoration: underline; text-decoration-color: rgba(58, 75, 120, 0.4); text-underline-offset: 4px; }
  .fil a:hover { color: var(--ink); text-decoration-color: currentColor; }
  .fil [aria-current] { font-weight: var(--tb); color: var(--ink); }
  .intro { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; margin-top: 22px; }
  .intro > * { margin: 0; }
  /* « FAQ » : une pastille blanche, comme « Populaire » sur les tarifs. */
  .marque { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px 4px 9px; border-radius: var(--r-pill); background: var(--paper); box-shadow: var(--clay-sm); font-size: 0.84375rem; font-weight: var(--tb); line-height: 1.5; color: var(--ink); }
  .marque :global(svg) { flex: none; color: var(--brand); }
  .intro h1 { --corps: var(--h1-page); max-width: 13em; text-wrap-style: balance; }
  /* Le mot en couleur : le bleu de « l'eau » dans le titre de l'accueil. */
  .intro h1 span { color: var(--w4); }
  .lead strong { color: var(--ink); }
  /* La mascotte : debout derrière la première feuille, coupée à mi-corps par son
     bord haut (les 78 % du haut de l'image : la tablette et les mains restent
     visibles), hors du flux. Le texte lui laisse la place à droite.
     `min-height: 0` : sans lui, le moteur de Safari donne au cadre la hauteur
     de l'image entière (§ 9.ep) ; de même pour `.pouce` à partir de 1024 px. */
  .guide { position: absolute; right: max(var(--gut), env(safe-area-inset-right, 0px)); bottom: -50px; width: var(--masc); aspect-ratio: 732 / 970; min-height: 0; overflow: hidden; pointer-events: none; }
  .guide img { display: block; width: 100%; max-width: none; height: auto; }
  .tete { --masc: clamp(104px, 30vw, 124px); --place: calc(100% - var(--masc) - 14px); }
  .lead { max-width: min(36rem, var(--place)); }

  /* Les feuilles : quatre fonds pour dix rubriques, qui se suivent dans leur
     feuille, séparées par l'espace et leur titre. En bas, l'air et les 40 px que
     recouvre la feuille suivante. */
  .feuille { padding: 40px 0 78px; }
  .rubrique + .rubrique { margin-top: 38px; }
  /* La feuille du milieu : l'eau profonde de l'accueil (« Sous la surface »).
     Titres blancs, plis blancs ; l'anneau de focus repasse à l'encre dans un pli. */
  .feuille.fond { --focus: #FFFFFF; background: linear-gradient(var(--deep), var(--deep-2)); color: var(--paper); }
  .fond .qa { --focus: var(--ink); color: var(--ink); }
  .grille { display: grid; gap: 20px; }
  .nom { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .nom h2 { --corps: clamp(min(1.625rem, 8.2vw), 3.2vw, 2.25rem); margin: 0; }
  .pastille { display: flex; flex: none; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 50%; background: var(--paper); box-shadow: var(--clay-sm); color: var(--brand); }
  .liste { position: relative; z-index: 1; min-width: 0; }
  .liste .qa:last-child { margin-bottom: 0; }
  /* « Besoin d'aide ? » : la mascotte au pouce levé, à droite du titre, debout
     derrière la première question (les 62 % du haut de l'image). */
  .pouce { flex: none; align-self: flex-end; width: 92px; aspect-ratio: 685 / 760; margin: -6px 6px -22px auto; overflow: hidden; pointer-events: none; }
  .pouce img { display: block; width: 100%; max-width: none; height: auto; }

  /* Le numéro de la question : une petite pastille, en tête de sa première ligne
     sur téléphone, dans sa colonne à partir de 560 px. */
  .rubrique .qa > summary { gap: 14px; }
  .qa-n { display: inline-flex; align-items: center; justify-content: center; min-width: 23px; height: 23px; margin-right: 7px; padding: 0 5px; border-radius: var(--r-pill); background: var(--sky-soft); font-size: 0.8125rem; font-weight: var(--tb); line-height: 1; color: var(--ink-2); vertical-align: 2px; font-variant-numeric: tabular-nums; }
  .qa[open] .qa-n { background: var(--ink); color: var(--paper); }

  /* Les réponses : du texte, des listes, des paragraphes, dans cet ordre. */
  .qa-in { max-width: 42rem; font-size: 1.03125rem; line-height: 1.6; color: var(--ink-2); overflow-wrap: anywhere; }
  .qa-in :global(p), .qa-in :global(ul) { max-width: none; margin: 10px 0 0; font-size: 1em; }
  .qa-in :global(.chip) { font-size: 0.84375rem; }
  .qa-in :global(ul) { display: grid; gap: 6px; padding: 0; list-style: none; }
  .qa-in :global(li) { position: relative; padding-left: 20px; }
  .qa-in :global(li)::before { content: ""; position: absolute; left: 3px; top: 0.62em; width: 7px; height: 7px; border-radius: 50%; background: var(--w3); }
  /* Les trois lignes de la saisie : un dessin à la place de la puce. */
  .qa-in :global(.pictos li) { padding-left: 28px; }
