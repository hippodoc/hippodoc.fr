---
/**
 * /faq — porté verbatim depuis src/pages/faq.tsx (SPA source).
 * Accordéons natifs <details>/<summary> (zéro JS). Les 32 questions
 * alimentent la FAQPage JSON-LD en intégralité (texte visible = schéma).
 *
 * Habillée dans la DA 2026 en phase 5b (MIGRATION.md § 9.ee) : seul l'habillage
 * a changé. Textes, titres, liens, ancres, ordre des blocs et JSON-LD sont ceux
 * d'avant, au caractère près (période d'observation SEO).
 * - Page entièrement dans la DA, comme l'accueil et /tarifs : fond `da-fond`,
 *   en-tête qui flotte (le ciel du premier bloc lui réserve le haut).
 * - Un ciel (fil d'Ariane, titre), puis quatre feuilles pour les dix rubriques,
 *   dans l'ordre (`FEUILLES`) : sable (l'activité, les revenus, le planning),
 *   eau profonde (paiements, cotisations, documents), ciel (mobile, sécurité),
 *   sable (tarifs, aide). Dans une feuille, les rubriques se suivent, séparées
 *   par l'espace et leur titre : le nom à gauche, les questions en plis `.qa` à
 *   droite (l'un sous l'autre sur téléphone). Une feuille par rubrique faisait
 *   un zébrage, et un cinquième de page en plus sur téléphone. La page finit
 *   sur le soleil et l'eau du pied de page, comme /tarifs.
 * - Chaque rubrique reste un <section id="…"> qui contient ses <details>, dans
 *   l'ordre : src/lib/page-analytics.ts les compte pour `faq_question_opened`.
 *   La feuille est un <div> autour de ses rubriques, sans texte.
 * - Les questions restent des libellés (`.qa-t`), pas des titres : la page
 *   garde ses onze titres (un <h1>, un <h2> par rubrique).
 * - Aucune classe utilitaire ici, réponses comprises : tout est dans le <style>
 *   de la page (une feuille à part, servie à /faq seule) et dans da.css. Les
 *   réponses sont injectées en HTML : leurs règles passent par `:global()`.
 * - Les émojis ne sont pas dans la police : dessinés en SVG (ou, pour les
 *   couleurs du calendrier, portés par les pastilles d'état de l'accueil), le
 *   caractère reste dans le texte, masqué à l'œil (classe `sr`).
 * - Deux mascottes (décor, les mêmes fichiers que sur l'accueil) : à la
 *   tablette, derrière la première feuille ; le pouce levé, à côté de « Besoin
 *   d'aide ? ». Les <picture> sont écrits ici, sans accueil/Mascotte.astro
 *   (voir tarifs.astro).
 * - Corps de texte en rem (ils suivent la taille de police réglée dans le
 *   navigateur).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getImage } from 'astro:assets';
import tablette from '@/assets/accueil/mascotte-f-tablette.webp';
import pouce from '@/assets/accueil/mascotte-f-pouce.webp';
import { SITE_URL } from '@/lib/site';

/* Dessins au trait (tracés Lucide, comme pages/Icon.astro), à la place des émojis. */
const TRACES = {
  aide: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
  courrier: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  date: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  lieu: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
  montant: '<path d="M4 10h12"/><path d="M4 14h9"/><path d="M19 6a7.7 7.7 0 0 0-5.2-2A7.9 7.9 0 0 0 6 12c0 4.4 3.5 8 7.8 8 2 0 3.8-.8 5.2-2"/>',
  agenda: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/>',
  billet: '<rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01"/><path d="M18 12h.01"/>',
  calcul: '<rect width="16" height="20" x="4" y="2" rx="2"/><path d="M8 6h8"/><path d="M16 14v4"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>',
  papier: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  mobile: '<rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/>',
  verrou: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  carte: '<rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/>',
  bouee: '<circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/><circle cx="12" cy="12" r="4"/>',
};
const picto = (nom: keyof typeof TRACES, taille = 18) =>
  `<svg width="${taille}" height="${taille}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${TRACES[nom]}</svg>`;
/* Le dessin de chaque rubrique (son émoji reste dans `icon`, et dans le texte). */
const DESSINS: Record<string, keyof typeof TRACES> = {
  activite: 'date', revenus: 'montant', planification: 'agenda', paiements: 'billet', cotisations: 'calcul',
  documents: 'papier', mobile: 'mobile', securite: 'verrou', tarifs: 'carte', contact: 'bouee',
};

/* `aPlain` est la réponse du schéma FAQPage : elle dit ce que `aHtml` affiche, mot pour
   mot, ponctuation comprise (`verify-site.mjs`, contrôle « 4 septies », MIGRATION.md
   § 9.fa). Une liste : un élément par ligne (`\n`), sans virgule ni point ajoutés, avec
   l'émoji de son élément `sr`. Les deux se modifient ensemble. */
