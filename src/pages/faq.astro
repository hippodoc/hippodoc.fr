            <a
              href="mailto:contact@hippodoc.fr"
              class="inline-flex items-center gap-2 w-fit bg-gradient-to-r from-hippo-500 to-hippo-600 text-white py-2.5 px-5 rounded-lg font-semibold shadow-lg shadow-hippo-500/25 hover:shadow-xl hover:shadow-hippo-500/30 hover:scale-[1.02] transition-all duration-300"
            >contact@hippodoc.fr</a>
            <p class="text-sm">On est une petite équipe. On lit <strong>tous les messages</strong>, et on fait évoluer l'app avec <strong>vos retours terrain</strong>.</p>
          </div>`,
        aPlain:
          "Une question, un bug, une suggestion ? Écris-nous, on te répond vite : contact@hippodoc.fr. On est une petite équipe. On lit tous les messages, et on fait évoluer l'app avec vos retours terrain.",
      },
    ],
  },
];

let globalQuestionIndex = 0;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSections.flatMap((section) =>
    section.questions.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.aPlain },
    }))
  ),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: `${SITE_URL}/faq` },
  ],
};

const title = 'FAQ Hippodoc - Questions fréquentes pour médecins';
const description =
  'Toutes les réponses sur Hippodoc : activité libérale et salariée, cotisations URSSAF, Super-Net, fiscalité, paiements et export comptable.';
---

<BaseLayout title={title} description={description} path="/faq" jsonLd={[breadcrumbSchema, faqSchema]}>
  <Header />

  <div class="min-h-screen relative overflow-hidden">
    <!-- Fond dégradé -->
    <div class="absolute inset-0 bg-gradient-to-b from-hippo-50/80 via-white to-cyan-50/30" aria-hidden="true"></div>

    <div class="relative z-10 container max-w-4xl pt-12 pb-12">
      <nav aria-label="Fil d'Ariane" class="mb-6 text-sm text-muted-foreground">
        <ol class="flex flex-wrap items-center gap-1">
          <li><a href="/" class="hover:text-hippo-600">Accueil</a></li>
          <li aria-hidden="true">›</li>
          <li class="text-foreground" aria-current="page">FAQ</li>
        </ol>
      </nav>

      <!-- Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-hippo-100/80 backdrop-blur-sm border border-hippo-200/50 shadow-sm mb-6">
          <Icon name="help-circle" class="w-4 h-4 text-hippo-600" />
          <span class="text-sm font-semibold text-hippo-700">FAQ</span>
        </div>

        <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">
          Toutes tes questions sur{' '}
          <span class="bg-gradient-to-r from-hippo-600 via-cyan-500 to-hippo-500 bg-clip-text text-transparent">Hippodoc</span>
        </h1>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          L'app qui simplifie la gestion administrative de <strong class="text-hippo-700">tous les médecins</strong>
        </p>
      </div>

      <!-- FAQ Sections -->
      <div class="space-y-6">
        {faqSections.map((section) => (
          <section id={section.id} class="bg-white/70 backdrop-blur-xl rounded-2xl border border-white/60 shadow-lg shadow-hippo-100/20 overflow-hidden">
            <div class="px-6 py-4 border-b border-hippo-100/50 bg-gradient-to-r from-hippo-50/50 to-cyan-50/30">
              <div class="flex items-center gap-3">
                <span class="text-2xl" aria-hidden="true">{section.icon}</span>
                <h2 class="text-xl font-bold text-gray-900">{section.title}</h2>
              </div>
            </div>

            <div class="px-2">
              {section.questions.map((item) => {
                globalQuestionIndex++;
                const questionNumber = globalQuestionIndex;
                return (
                  <details class="group border-b border-hippo-100/30 last:border-0">
                    <summary class="py-4 px-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden flex items-center gap-3 text-left">
                      <span class="flex-shrink-0 w-7 h-7 rounded-full bg-gradient-to-br from-hippo-500 to-cyan-500 text-white text-xs font-bold flex items-center justify-center shadow-sm">
                        {questionNumber}
                      </span>
                      <span class="text-base font-medium text-gray-800 group-open:text-hippo-700 transition-colors flex-1">
                        {item.q}
                      </span>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-hippo-400 transition-transform group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div class="pb-5 pl-14 pr-4 text-muted-foreground leading-relaxed [&_strong]:text-hippo-700 [&_strong]:font-semibold" set:html={item.aHtml} />
                  </details>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <!-- Bottom CTA -->
      <div class="mt-12 text-center">
        <p class="text-muted-foreground mb-4">Tu n'as pas trouvé ta réponse ?</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/#pricing"
            class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-hippo-500 to-hippo-600 text-white font-semibold rounded-lg shadow-lg shadow-hippo-500/25 hover:shadow-xl hover:shadow-hippo-500/30 hover:scale-[1.02] transition-all duration-300"
          >
            Découvrir Hippodoc
          </a>
          <a
            href="mailto:contact@hippodoc.fr"
            class="inline-flex items-center gap-2 px-6 py-3 bg-white/80 backdrop-blur-sm border border-hippo-200/60 text-hippo-700 font-semibold rounded-xl shadow-sm hover:shadow-md hover:scale-[1.02] transition-all duration-300"
          >
            <Icon name="mail" class="w-4 h-4" />
            Nous contacter
          </a>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>
