            const isHippodoc = p.key === 'hippodoc';
            return (
              <div class={`h-full rounded-2xl border p-6 ${isHippodoc ? 'border-hippo-300 bg-gradient-to-br from-hippo-50/60 to-white shadow-lg shadow-hippo-100/40 md:scale-[1.02]' : 'border-slate-200'}`}>
                <span class="font-bold tracking-tight text-base" style={`color:${tool.color}`}>{tool.wordmark}</span>
                <div class="mt-3">
                  <p class="mb-1 text-xs uppercase tracking-wider text-slate-500">Prix d'entrée</p>
                  <p class={`text-2xl font-bold ${isHippodoc ? 'text-hippo-700' : 'text-slate-900'}`}>{p.entry}</p>
                </div>
                <div class="mt-3 space-y-3 text-sm">
                  <div>
                    <p class="text-xs uppercase tracking-wider text-slate-500">Offre populaire</p>
                    <p class="font-medium text-slate-800">{p.popular}</p>
                  </div>
                  <div>
                    <p class="text-xs uppercase tracking-wider text-slate-500">Engagement</p>
                    <p class="text-slate-800">{p.engagement}</p>
                  </div>
                  <div>
                    <p class="text-xs uppercase tracking-wider text-slate-500">Essai</p>
                    <p class="text-slate-800">{p.trial}</p>
                  </div>
                  <p class="border-t border-slate-100 pt-2 text-xs italic text-slate-500">{p.note}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ═════════════════ FAQ ═════════════════ -->
    <section id="faq" class="bg-gradient-to-b from-slate-50/50 to-white py-16 md:py-24">
      <div class="container max-w-3xl">
        <div class="mb-12 text-center">
