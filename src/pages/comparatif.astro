const canonicalUrl = `${SITE_URL}/comparatif`;
const title = 'Comparatif Indy, Pennylane, Hiway Care vs Hippodoc — Médecin libéral 2026';
const description =
  'Comparatif factuel des outils de gestion pour médecin libéral en 2026 : Indy, Pennylane, Hiway Care, Hippodoc. Fonctions, tarifs, profils — qui fait quoi.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Comparatif', item: canonicalUrl },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: LAST_UPDATED_ISO,
  dateModified: LAST_UPDATED_ISO,
  mainEntityOfPage: canonicalUrl,
  author: { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: 'Hippodoc', url: SITE_URL },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'Hippodoc',
    logo: { '@type': 'ImageObject', url: LOGO_URL },
  },
  image: DEFAULT_OG_IMAGE,
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Outils de gestion pour médecins libéraux comparés',
  itemListElement: TOOLS.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: t.name,
      applicationCategory: 'BusinessApplication',
      description: t.tagline,
      url: t.url,
    },
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  path="/comparatif"
  ogType="article"
  ogImageAlt="Comparatif Indy, Pennylane, Hiway Care et Hippodoc pour médecin libéral"
  jsonLd={[breadcrumbSchema, articleSchema, itemListSchema, faqSchema]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={LAST_UPDATED_ISO} />
    <meta property="article:modified_time" content={LAST_UPDATED_ISO} />
  </Fragment>

  <Header />

  <main>
    <!-- ═════════════════ HERO ═════════════════ -->
    <section class="relative overflow-hidden bg-gradient-to-b from-hippo-50/60 via-white to-white pb-16 pt-28 md:pb-24 md:pt-36">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -left-20 -top-20 h-80 w-80 rounded-full bg-hippo-200/40 blur-3xl"></div>
        <div class="absolute -right-20 top-40 h-72 w-72 rounded-full bg-indigo-200/30 blur-3xl"></div>
      </div>

      <div class="container relative max-w-6xl">
        <div class="mx-auto max-w-4xl text-center">
          <nav aria-label="Fil d'Ariane" class="mb-5 text-sm text-slate-500">
            <ol class="flex flex-wrap items-center justify-center gap-1">
              <li><a href="/" class="hover:text-hippo-700">Accueil</a></li>
              <li aria-hidden="true">›</li>
              <li class="text-slate-700" aria-current="page">Comparatif</li>
            </ol>
          </nav>

          <span class="mb-5 inline-flex items-center rounded-full border border-hippo-200 bg-white/70 px-3 py-1 text-xs font-semibold text-hippo-700 backdrop-blur">
            <Icon name="sparkles" class="mr-1.5 h-3 w-3" />
            Comparatif indépendant · mis à jour {LAST_UPDATED_LABEL}
          </span>

          <h1 class="mb-6 text-4xl font-bold leading-tight tracking-tight text-hippo-900 md:text-6xl">
            <span class="font-bold tracking-tight" style={`color:${TOOLS[0].color}`}>{TOOLS[0].wordmark}</span>,{' '}
            <span class="font-bold tracking-tight" style={`color:${TOOLS[1].color}`}>{TOOLS[1].wordmark}</span>,{' '}
            <span class="font-bold tracking-tight" style={`color:${TOOLS[2].color}`}>{TOOLS[2].wordmark}</span>{' '}
            ou <span class="font-bold tracking-tight" style={`color:${TOOLS[3].color}`}>{TOOLS[3].wordmark}</span> ?
            <span class="mt-4 block text-2xl font-medium text-slate-700 md:text-3xl">
              Quel outil de gestion choisir quand on est médecin libéral en 2026 ?
            </span>
          </h1>
          <p class="mx-auto mb-8 max-w-3xl text-lg text-slate-600">
            Tu hésites entre plusieurs solutions pour gérer ta comptabilité, tes cotisations et tes déclarations ?
            Voici un comparatif <strong>100 % factuel</strong>, sourcé sur les sites officiels des éditeurs — pas un commercial déguisé.
          </p>

          <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-slate-500">
            <a href="#en-bref" class="transition-colors hover:text-hippo-700">En 30 secondes</a>
            <span aria-hidden="true">·</span>
            <a href="#tableau" class="transition-colors hover:text-hippo-700">Tableau comparatif</a>
            <span aria-hidden="true">·</span>
            <a href="#profils" class="transition-colors hover:text-hippo-700">Par profil</a>
            <span aria-hidden="true">·</span>
            <a href="#tarifs" class="transition-colors hover:text-hippo-700">Tarifs</a>
            <span aria-hidden="true">·</span>
            <a href="#faq" class="transition-colors hover:text-hippo-700">FAQ</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═════════════════ TL;DR ═════════════════ -->
    <section id="en-bref" class="bg-white py-16 md:py-20">
      <div class="container max-w-6xl">
        <div class="mb-12 text-center">
          <span class="mb-3 inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold text-foreground">En 30 secondes</span>
          <h2 class="text-3xl font-bold text-hippo-900 md:text-4xl">À chaque besoin son outil</h2>
          <p class="mx-auto mt-3 max-w-2xl text-slate-600">
            Aucune solution n'est universellement meilleure. Voici ce que chacune fait <em>vraiment</em> bien.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
          {VERDICTS.map((v) => {
            const tool = TOOLS.find((t) => t.key === v.key)!;
            const isHippodoc = v.key === 'hippodoc';
            return (
              <div class={`h-full rounded-2xl border p-6 ${isHippodoc ? 'border-hippo-300 bg-gradient-to-br from-hippo-50/80 to-white shadow-md shadow-hippo-100/50' : 'border-slate-200 transition-colors hover:border-slate-300'}`}>
                <span class="font-bold tracking-tight text-base" style={`color:${tool.color}`}>{tool.wordmark}</span>
                <h3 class={`mt-3 text-base font-bold ${isHippodoc ? 'text-hippo-900' : 'text-slate-900'}`}>{v.label}</h3>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{v.line}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ═════════════════ MARCHÉ EN BREF ═════════════════ -->
    <section id="marche" class="bg-gradient-to-b from-slate-50/50 to-white py-16 md:py-24">
      <div class="container max-w-6xl">
        <div class="mb-12 text-center">
          <span class="mb-3 inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold text-foreground">Le marché en bref</span>
          <h2 class="text-3xl font-bold text-hippo-900 md:text-4xl">Les quatre solutions, en détail</h2>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {TOOLS.map((tool) => {
            const isHippodoc = tool.key === 'hippodoc';
            return (
              <div class={`h-full overflow-hidden rounded-2xl border ${isHippodoc ? 'border-hippo-300 bg-gradient-to-br from-hippo-50/60 to-white shadow-lg shadow-hippo-100/40' : 'border-slate-200 bg-white'}`}>
                <div class="h-1" style={`background-color:${tool.color}`} aria-hidden="true"></div>
                <div class="p-6">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <span class="font-bold tracking-tight text-2xl md:text-3xl" style={`color:${tool.color}`}>{tool.wordmark}</span>
                      <p class="mt-2 text-sm text-slate-600">{tool.tagline}</p>
                    </div>
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl" style={`background-color:${tool.color}15; color:${tool.color}`}>
                      <Icon name={tool.icon} class="h-5 w-5" />
                    </span>
                  </div>
                  <p class="mb-4 mt-4 text-sm leading-relaxed text-slate-700">{tool.pitch}</p>
                  <ul class="space-y-2">
                    {tool.bullets.map((b) => (
                      <li class="flex items-start gap-2 text-sm text-slate-700">
                        <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-5 border-t border-slate-100 pt-4">
                    <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-normal text-slate-700">
                      Cible : {tool.cible}
                    </span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ═════════════════ TABLEAU COMPARATIF ═════════════════ -->
    <section id="tableau" class="bg-white py-16 md:py-24">
      <div class="container max-w-6xl">
        <div class="mb-12 text-center">
          <span class="mb-3 inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold text-foreground">Tableau comparatif</span>
          <h2 class="text-3xl font-bold text-hippo-900 md:text-4xl">Qui fait quoi, fonctionnalité par fonctionnalité</h2>
          <p class="mx-auto mt-3 max-w-2xl text-slate-600">
            Survole les <Icon name="info" class="inline h-3.5 w-3.5 text-slate-400" /> pour des précisions. Cellules « Partiel » : la fonction existe mais n'est pas le cœur de l'offre.
          </p>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
          <table class="w-full min-w-[760px] border-collapse text-sm">
            <thead>
              <tr class="border-b border-slate-200 bg-white">
                <th scope="col" class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Fonctionnalité</th>
                {TOOLS.map((t) => (
                  <th scope="col" class={`px-3 py-4 text-center ${t.key === 'hippodoc' ? 'bg-hippo-50/60' : ''}`}>
                    <span class="font-bold tracking-tight text-base" style={`color:${t.color}`}>{t.wordmark}</span>
                  </th>
                ))}
              </tr>
            </thead>
            {GROUPS.map((group, gi) => (
              <tbody class={gi < GROUPS.length - 1 ? 'border-b border-slate-200' : ''}>
                <tr class="bg-slate-50/80">
                  <th scope="colgroup" colspan={TOOLS.length + 1} class="px-5 py-3 text-left text-sm font-semibold text-hippo-900">
                    <span class="inline-flex items-center gap-2">
                      <Icon name={group.icon} class="h-4 w-4 text-hippo-600" />
                      {group.title}
                    </span>
                  </th>
                </tr>
                {group.rows.map((row, ri) => (
                  <tr class={`border-b border-slate-100 last:border-0 ${ri % 2 === 1 ? 'bg-slate-50/40' : ''}`}>
                    <th scope="row" class="px-5 py-3 text-left text-sm font-normal text-slate-800">
                      {row.label}
                      {row.help && (
                        <span class="ml-1 inline-flex align-middle" title={row.help} tabindex="0">
                          <Icon name="info" class="h-3.5 w-3.5 text-slate-400" />
                          <span class="sr-only"> — {row.help}</span>
                        </span>
                      )}
                    </th>
                    {TOOLS.map((t) => {
                      const cell = row.values[t.key];
                      const isHippodoc = t.key === 'hippodoc';
                      return (
                        <td class={`px-3 py-3 text-center ${isHippodoc ? 'bg-hippo-50/40' : ''}`}>
                          {cell === true ? (
                            <Icon name="check" class="inline h-5 w-5 text-emerald-600" />
                          ) : cell === false ? (
                            <Icon name="minus" class="inline h-5 w-5 text-slate-300" />
                          ) : cell === 'partial' ? (
                            <span class="inline-flex items-center gap-1 text-xs font-medium text-amber-700">
                              <span class="h-2 w-2 rounded-full bg-amber-500" aria-hidden="true"></span>
                              Partiel
                            </span>
                          ) : (
                            <span class={`text-xs leading-snug ${isHippodoc ? 'font-semibold text-hippo-700' : 'text-slate-700'}`}>{cell}</span>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>

        <p class="mx-auto mt-4 max-w-3xl text-center text-xs text-slate-500">
          <Icon name="check" class="inline h-3 w-3 text-emerald-600" /> Couvert · <span class="text-amber-700">●</span> Partiel · <Icon name="minus" class="inline h-3 w-3 text-slate-300" /> Non couvert.
          Texte court = précision factuelle. Sources : sites officiels des éditeurs ({LAST_UPDATED_LABEL}).
        </p>
      </div>
    </section>

    <!-- ═════════════════ PERSONAS ═════════════════ -->
    <section id="profils" class="bg-gradient-to-b from-slate-50/50 to-white py-16 md:py-24">
      <div class="container max-w-6xl">
        <div class="mb-12 text-center">
          <span class="mb-3 inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold text-foreground">À chaque profil son outil</span>
          <h2 class="text-3xl font-bold text-hippo-900 md:text-4xl">Quatre médecins, quatre besoins</h2>
          <p class="mx-auto mt-3 max-w-2xl text-slate-600">
            Hippodoc est souvent <strong>complémentaire</strong> d'un outil de comptabilité — pas un substitut.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {PERSONAS.map((p) => (
            <div class="h-full rounded-2xl border border-slate-200 bg-white p-6 transition-colors hover:border-hippo-200">
              <div class="flex items-center gap-3">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-hippo-100 text-hippo-700">
                  <Icon name={p.icon} class="h-5 w-5" />
                </span>
                <div>
                  <h3 class="text-lg font-bold text-hippo-900">{p.name}</h3>
                  <p class="mt-0.5 text-xs text-slate-500">{p.subtitle}</p>
                </div>
              </div>
              <div class="mt-4 space-y-3">
                <p class="text-sm leading-relaxed text-slate-700">
                  <span class="font-semibold text-hippo-800">Son besoin : </span>{p.need}
                </p>
                <div class="rounded-lg border border-hippo-100 bg-hippo-50/60 p-3">
                  <p class="text-sm leading-relaxed text-hippo-900">
                    <span class="font-semibold">Notre lecture : </span>{p.reco}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═════════════════ TARIFS ═════════════════ -->
    <section id="tarifs" class="bg-white py-16 md:py-24">
      <div class="container max-w-6xl">
        <div class="mb-12 text-center">
