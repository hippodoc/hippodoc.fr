---
/**
 * /comparatif — porté verbatim depuis src/pages/comparatif.tsx (SPA source).
 * Tableau desktop/mobile unifié en un seul <table> réel + overflow-x-auto
 * (spec migration : pas de Tabs JS mobile). Tooltips → attribut title natif.
 * Accordéon FAQ → <details>/<summary> natif. Zéro JS.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
