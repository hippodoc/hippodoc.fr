          <a href="/faq" class="text-hippo-600 underline underline-offset-4 hover:text-hippo-800">Consulte notre FAQ complète</a>{' '}
          ou écris-nous à{' '}
          <a href="mailto:contact@hippodoc.fr" class="text-hippo-600 underline underline-offset-4 hover:text-hippo-800">contact@hippodoc.fr</a>.
        </div>
      </div>
    </section>

    <!-- ═════════════════ CTA FINAL ═════════════════ -->
