const canonicalUrl = `${SITE_URL}/comparatif`;
/* Titre ramené de 73 à 51 caractères : au-delà de ~60, Google tronque et la fin
   du titre — ici « Médecin libéral 2026 », qui porte la requête — disparaît de
   l'aperçu. Hiway Care sort du titre mais reste dans la description et la page. */
const title = 'Comparatif Indy, Pennylane, Hippodoc — médecin 2026';
const description =
  'Comparatif factuel des outils de gestion pour médecin libéral en 2026 : Indy, Pennylane, Hiway Care, Hippodoc. Fonctions, tarifs, profils — qui fait quoi.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Comparatif', item: canonicalUrl },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: LAST_UPDATED_ISO,
  dateModified: LAST_UPDATED_ISO,
  mainEntityOfPage: canonicalUrl,
  author: { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: 'Hippodoc', url: SITE_URL },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'Hippodoc',
    logo: { '@type': 'ImageObject', url: LOGO_URL },
  },
  image: DEFAULT_OG_IMAGE,
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Outils de gestion pour médecins libéraux comparés',
  itemListElement: TOOLS.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: t.name,
      applicationCategory: 'BusinessApplication',
      description: t.tagline,
      url: t.url,
    },
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  path="/comparatif"
  ogType="article"
  ogImageAlt="Comparatif Indy, Pennylane, Hiway Care et Hippodoc pour médecin libéral"
  jsonLd={[breadcrumbSchema, articleSchema, itemListSchema, faqSchema]}
  bodyClass="da-fond"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={LAST_UPDATED_ISO} />
    <meta property="article:modified_time" content={LAST_UPDATED_ISO} />
    {/* Barre du navigateur mobile : le ciel de la DA (jeton sky-1), comme l'accueil. */}
    <meta name="theme-color" content="#C9DEFF" />
  </Fragment>

  {/* La pastille survole le ciel du premier bloc, qui lui réserve le haut. */}
  <Header variante="flottante" />

  <main>
    <!-- ═════════════════ LE CIEL : TITRE ═════════════════ -->
    <section class="tete da-bloc">
      <div class="wrap">
        <div class="intro">
          <nav aria-label="Fil d'Ariane" class="fil">
            <ol role="list">
              <li><a href="/">Accueil</a></li>
              <li aria-hidden="true">›</li>
              <li aria-current="page">Comparatif</li>
            </ol>
          </nav>

          <span class="marque">
            <Icon name="sparkles" class="ic" />
            Comparatif indépendant · mis à jour {LAST_UPDATED_LABEL}
          </span>

          <h1 class="aff">
            <span class="mot" style={`color:${TOOLS[0].textColor}`}>{TOOLS[0].wordmark}</span>,{' '}
            <span class="mot" style={`color:${TOOLS[1].textColor}`}>{TOOLS[1].wordmark}</span>,{' '}
            <span class="mot" style={`color:${TOOLS[2].textColor}`}>{TOOLS[2].wordmark}</span>{' '}
            ou <span class="mot" style={`color:${TOOLS[3].textColor}`}>{TOOLS[3].wordmark}</span> ?
            <span class="sous">
              Quel outil de gestion choisir quand on est médecin libéral en 2026 ?
            </span>
          </h1>
          <p class="lead">
            Tu hésites entre plusieurs solutions pour gérer ta comptabilité, tes cotisations et tes déclarations ?
            Voici un comparatif <strong>100 % factuel</strong>, sourcé sur les sites officiels des éditeurs — pas un commercial déguisé.
          </p>

          {/* Les cinq ancres : des pastilles. Les points médians restent dans le
               HTML, ils ne sont plus dessinés. */}
          <div class="ancres">
            <a href="#en-bref">En 30 secondes</a>
            <span aria-hidden="true">·</span>
            <a href="#tableau">Tableau comparatif</a>
            <span aria-hidden="true">·</span>
            <a href="#profils">Par profil</a>
            <span aria-hidden="true">·</span>
            <a href="#tarifs">Tarifs</a>
            <span aria-hidden="true">·</span>
            <a href="#faq">FAQ</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═════════════════ EN 30 SECONDES : feuille sable ═════════════════ -->
    <section id="en-bref" class="band da-bloc">
      <div class="wrap">
        <div class="band-head">
          <span class="pastille">En 30 secondes</span>
          <h2>À chaque besoin son outil</h2>
          <p class="lead">
            Aucune solution n'est universellement meilleure. Voici ce que chacune fait <em>vraiment</em> bien.
          </p>
        </div>

        <div class="quatre">
          {VERDICTS.map((v) => {
            const tool = TOOLS.find((t) => t.key === v.key)!;
            const isHippodoc = v.key === 'hippodoc';
            return (
              <div class:list={['fiche', 'verdict', isHippodoc && 'nous']}>
                <span class="mot" style={`color:${tool.textColor}`}>{tool.wordmark}</span>
                <h3>{v.label}</h3>
                <p>{v.line}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ═════════════════ LE MARCHÉ EN BREF : feuille ciel ═════════════════ -->
    <section id="marche" class="band air da-bloc">
      <div class="wrap">
        <div class="band-head">
          <span class="pastille">Le marché en bref</span>
          <h2>Les quatre solutions, en détail</h2>
        </div>

        <div class="deux">
          {TOOLS.map((tool) => {
            const isHippodoc = tool.key === 'hippodoc';
            return (
              <div class:list={['fiche', 'solution', isHippodoc && 'nous']}>
                <div class="solution-in">
                  <div class="solution-tete">
                    <div>
                      <span class="mot grand" style={`color:${tool.textColor}`}>{tool.wordmark}</span>
                      <p class="devise">{tool.tagline}</p>
                    </div>
                    <span class="rond" style={`background-color:${tool.color}15; color:${tool.color}`}>
                      <Icon name={tool.icon} class="ic" />
                    </span>
                  </div>
                  <p class="pitch">{tool.pitch}</p>
                  <ul class="points" role="list">
                    {tool.bullets.map((b) => (
                      <li>
                        <Icon name="check" class="ic" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="cible">
                    <span class="chip off">
                      Cible : {tool.cible}
                    </span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ═════════════════ TABLEAU COMPARATIF : feuille sable ═════════════════ -->
    <section id="tableau" class="band da-bloc">
      <div class="wrap">
        <div class="band-head mid">
          <span class="pastille">Tableau comparatif</span>
          <h2>Qui fait quoi, fonctionnalité par fonctionnalité</h2>
          <p class="lead">
            Survole les <Icon name="info" class="ic info" /> pour des précisions. Cellules « Partiel » : la fonction existe mais n'est pas le cœur de l'offre.
          </p>
        </div>

        {/* Un seul vrai <table>. Plus large que l'écran sur téléphone, il défile de
             côté dans sa fiche (la page, jamais) ; la colonne des fonctionnalités
             reste en place, et une ombre à droite dit qu'il reste des colonnes. */}
        <div class="tableau" tabindex="0" role="region" aria-label="Tableau comparatif">
          <table>
            <thead>
              <tr>
                <th scope="col">Fonctionnalité</th>
                {TOOLS.map((t) => (
                  <th scope="col" class:list={[t.key === 'hippodoc' && 'nous']}>
                    <span class="mot" style={`color:${t.textColor}`}>{t.wordmark}</span>
                  </th>
                ))}
              </tr>
            </thead>
            {GROUPS.map((group) => (
              <tbody>
                <tr class="groupe">
                  <th scope="colgroup" colspan={TOOLS.length + 1}>
                    <span class="groupe-t">
                      <Icon name={group.icon} class="ic" />
                      {group.title}
                    </span>
                  </th>
                </tr>
                {group.rows.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.label}
                      {row.help && (
                        <span class="aide" title={row.help} tabindex="0">
                          <Icon name="info" class="ic" />
                          <span class="sr"> — {row.help}</span>
                        </span>
                      )}
                    </th>
                    {TOOLS.map((t) => {
                      const cell = row.values[t.key];
                      const isHippodoc = t.key === 'hippodoc';
                      return (
                        <td class:list={[isHippodoc && 'nous']}>
                          {cell === true ? (
                            <Icon name="check" class="ic oui" />
                          ) : cell === false ? (
                            <Icon name="minus" class="ic non" />
                          ) : cell === 'partial' ? (
                            <span class="partiel">
                              <span class="pt" aria-hidden="true"></span>
                              Partiel
                            </span>
                          ) : (
                            <span class="precision">{cell}</span>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>

        {/* « ● » n'est pas dans la police : dessiné, le caractère reste dans le
             texte, masqué à l'œil. */}
        <p class="legende">
          <Icon name="check" class="ic oui" /> Couvert · <span class="sr">●</span><span class="pt" aria-hidden="true"></span> Partiel · <Icon name="minus" class="ic non" /> Non couvert.
          Texte court = précision factuelle. Sources : sites officiels des éditeurs ({LAST_UPDATED_LABEL}).
        </p>
      </div>
    </section>

    <!-- ═════════════════ PERSONAS : feuille ciel ═════════════════ -->
    <section id="profils" class="band air da-bloc">
      <div class="wrap">
        <div class="band-head">
          <span class="pastille">À chaque profil son outil</span>
          <h2>Quatre médecins, quatre besoins</h2>
          <p class="lead">
            Hippodoc est souvent <strong>complémentaire</strong> d'un outil de comptabilité — pas un substitut.
          </p>
        </div>

        <div class="deux">
          {PERSONAS.map((p) => (
            <div class="fiche profil">
              <div class="profil-tete">
                <span class="rond">
                  <Icon name={p.icon} class="ic" />
                </span>
                <div>
                  <h3>{p.name}</h3>
                  <p class="situation">{p.subtitle}</p>
                </div>
              </div>
              <div class="profil-corps">
                <p>
                  <span class="fort">Son besoin : </span>{p.need}
                </p>
                <div class="lecture">
                  <p>
                    <span class="fort">Notre lecture : </span>{p.reco}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═════════════════ TARIFS : feuille sable ═════════════════ -->
    <section id="tarifs" class="band da-bloc">
      <div class="wrap">
        <div class="band-head mid">
          <span class="pastille">Tarifs {LAST_UPDATED_LABEL}</span>
          <h2>Combien ça coûte vraiment ?</h2>
          <p class="lead">
            Tarifs constatés sur les sites officiels en {LAST_UPDATED_LABEL}, susceptibles d'évoluer.
          </p>
        </div>

        <div class="quatre">
          {PRICING.map((p) => {
            const tool = TOOLS.find((t) => t.key === p.key)!;
            const isHippodoc = p.key === 'hippodoc';
            return (
              <div class:list={['fiche', 'prix', isHippodoc && 'nous']}>
                <span class="mot" style={`color:${tool.textColor}`}>{tool.wordmark}</span>
                <div class="entree">
                  <p class="et">Prix d'entrée</p>
                  <p class="montant">{p.entry}</p>
                </div>
                <div class="lignes">
                  <div>
                    <p class="et">Offre populaire</p>
                    <p class="val fort">{p.popular}</p>
                  </div>
                  <div>
                    <p class="et">Engagement</p>
                    <p class="val">{p.engagement}</p>
                  </div>
                  <div>
                    <p class="et">Essai</p>
                    <p class="val">{p.trial}</p>
                  </div>
                  <p class="nota">{p.note}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ═════════════════ FAQ : feuille ciel, le titre à gauche, les plis à droite ═════════════════ -->
    <section id="faq" class="band air da-bloc">
      <div class="wrap cote">
        <div class="band-head">
          <span class="pastille">FAQ</span>
          <h2>Les questions qu'on nous pose</h2>
        </div>

        <div class="liste">
          <div>
            {FAQ.map((f) => (
              <details class="qa">
                <summary>
                  <span class="qa-t">{f.q}</span>
                  <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 3v12M3 9h12"/></svg>
                </summary>
                <div class="qa-in"><p>{f.a}</p></div>
              </details>
            ))}
          </div>

          <div class="autres">
            D'autres questions ?{' '}
            <a href="/faq" class="lien">Consulte notre FAQ complète</a>{' '}
            ou écris-nous à{' '}
            <a href="mailto:contact@hippodoc.fr" class="lien">contact@hippodoc.fr</a>.
          </div>
        </div>
      </div>
    </section>

    {/* La fin : l'appel à l'essai sur le ciel, la note sur le comparatif, puis le
         soleil de l'accueil qui se lève sur l'eau du pied de page (décor). */}
    <div class="fin da-bloc">
      <!-- ═════════════════ CTA FINAL ═════════════════ -->
      <section class="wrap fin-copy">
        <span class="pastille">
          Essai 30 jours · Sans engagement
        </span>
        <h2>Tester Hippodoc dans ton vrai quotidien</h2>
        <p class="lead">
          Connecte tes données en 5 minutes et vois ton Super-Net mois par mois — comme si tu l'utilisais depuis 6 mois.
        </p>
        <div class="portes">
          <a
            href={`${APP_URL}/auth?tab=signup`}
            data-track="cta_signup_comparatif"
            class="btn btn-brand"
          >
            Démarrer mon essai 30 jours <Icon name="arrow-right" class="ic" />
          </a>
          <a
            href="/simulateur"
            class="btn btn-white"
          >
            Tester le simulateur gratuit
          </a>
        </div>
        <p class="encore">
          Pas encore convaincu ? Découvre{' '}
          <a href="/qui-sommes-nous" class="lien">qui nous sommes</a>{' '}
          ou notre{' '}
          <a href="/blog/regime-fiscal-micro-bnc-vs-reel" class="lien">guide Micro-BNC vs Réel</a>.
        </p>
      </section>

      <!-- ═════════════════ À PROPOS DE CE COMPARATIF ═════════════════ -->
      <section class="wrap apropos">
        <div class="apropos-fiche">
          <p class="apropos-t">À propos de ce comparatif</p>
          <p>
            Comparatif rédigé par l'équipe Hippodoc, basé sur les informations publiques de chaque éditeur consultées en {LAST_UPDATED_LABEL}.
            Indy®, Pennylane® et Hiway Care® sont des marques déposées par leurs éditeurs respectifs, mentionnées ici à des fins de comparaison
            factuelle (article L713-3 du Code de la propriété intellectuelle — exception comparative).
          </p>
          <p>
            Une information vous semble inexacte ou obsolète ? Écrivez-nous à{' '}
            <a href="mailto:contact@hippodoc.fr" class="lien">contact@hippodoc.fr</a>
            {' '}— nous corrigeons sous 48 h ouvrées.
          </p>
          <div class="sources">
            <a href="https://www.indy.fr/prix/" target="_blank" rel="noopener noreferrer nofollow">
              Source Indy <Icon name="chevron-right" class="ic" />
            </a>
            <a href="https://www.pennylane.com/fr/tarifs" target="_blank" rel="noopener noreferrer nofollow">
              Source Pennylane <Icon name="chevron-right" class="ic" />
            </a>
            <a href="https://hiway.fr/care" target="_blank" rel="noopener noreferrer nofollow">
              Source Hiway Care <Icon name="chevron-right" class="ic" />
            </a>
          </div>
        </div>
      </section>

      <div class="horizon" aria-hidden="true">
        <span class="sun"></span>
        <span class="wave w3"></span>
        <span class="wave w4"></span>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* Texte grossi : un mot plus large que sa fiche se coupe au lieu de la pousser. */
  main { overflow-wrap: break-word; }
  /* Les dessins au trait de pages/Icon.astro : à la taille du texte qui les porte. */
  main :global(.ic) { display: inline-block; flex: none; width: 1em; height: 1em; }

  /* Le ciel : le bloc passe sous la pastille de l'en-tête, il lui réserve le
     haut. En bas, l'air et les 40 px que recouvre la feuille suivante. */
  .tete { position: relative; padding: 100px 0 96px; background: linear-gradient(var(--sky-1) 0, var(--sky) 460px); }
  /* Corps de texte en rem : la feuille de la DA les pose en px, ils ne suivaient
     plus la taille de police du navigateur. Même rendu à 16 px. */
  .da-bloc { font-size: 1.0625rem; }
  .lead { font-size: 1.1875rem; }
  .btn { font-size: 1.0625rem; }
  .chip { font-size: 0.84375rem; }
  .qa-t { min-width: 0; font-size: 1.125rem; overflow-wrap: anywhere; }
  .qa-in p { font-size: 1.03125rem; }
  h2 { --corps: clamp(min(2rem, 10vw), 4.5vw, 3.625rem); }
  @media (max-width: 359px) { .qa-t { font-size: 1.0625rem; } }

  /* Fil d'Ariane (celui de /faq). Une cible de 44 px de haut, sans changer la
     hauteur de la ligne. */
  .fil { font-size: 0.90625rem; color: var(--ink-2); }
  .fil ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0 6px; margin: 0; padding: 0; list-style: none; }
  .fil a { display: inline-flex; align-items: center; min-height: 44px; margin: -10px 0; border-radius: 6px; color: inherit; text-decoration: underline; text-decoration-color: rgba(58, 75, 120, 0.4); text-underline-offset: 4px; }
  .fil a:hover { color: var(--ink); text-decoration-color: currentColor; }
  .fil [aria-current] { font-weight: var(--tb); color: var(--ink); }

  /* Le titre de la page */
  .intro { max-width: 56rem; }
  .intro > * { margin: 0; }
  /* « Comparatif indépendant · mis à jour » : une pastille blanche, comme « FAQ ». */
  /* Deux classes : la remise à zéro des marges (`.intro > *`) pèse plus qu'une
     classe seule, une fois le style scopé. */
  .intro .marque { display: inline-flex; align-items: center; gap: 7px; margin: 22px 0 16px; padding: 5px 14px 5px 11px; border-radius: 18px; background: var(--paper); box-shadow: var(--clay-sm); font-size: 0.84375rem; font-weight: var(--tb); line-height: 1.5; color: var(--ink); }
  .marque :global(.ic) { color: var(--brand); }
  .intro h1 { --corps: var(--h1-page); text-wrap-style: balance; }
  /* Le nom d'un éditeur, dans sa couleur de marque assombrie (attribut style). */
  .mot { font-weight: var(--dw); letter-spacing: -0.02em; white-space: nowrap; }
  /* La question, sous les quatre noms : dans le <h1>, en plus petit. */
  .sous { display: block; max-width: 30ch; margin-top: 14px; font-family: var(--text); font-size: clamp(1.25rem, 2.4vw, 1.625rem); font-weight: 560; line-height: 1.25; letter-spacing: -0.012em; color: var(--ink-2); text-wrap-style: balance; }
  .intro .lead { max-width: 42rem; margin-top: 18px; }
  .lead strong { color: var(--ink); }
  /* Les ancres : cinq pastilles. */
  .intro .ancres { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
  .ancres span { display: none; }
  .ancres a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: var(--r-pill); background: var(--paper); box-shadow: var(--clay-sm); font-size: 0.9375rem; font-weight: var(--tb); line-height: 1.2; color: var(--ink); text-decoration: none; }
  .ancres a:hover { background: var(--sky-soft); }

  /* Le petit nom d'une feuille : une pastille blanche au-dessus du titre. */
  .pastille { align-self: flex-start; display: inline-block; padding: 4px 13px; border-radius: var(--r-pill); background: var(--paper); box-shadow: var(--clay-sm); font-size: 0.84375rem; font-weight: var(--tb); line-height: 1.5; color: var(--ink); }
  .band-head.mid .pastille, .fin .pastille { align-self: center; }

  /* Les fiches */
  .fiche { min-width: 0; padding: 24px 22px 26px; border-radius: 28px; background: var(--paper); box-shadow: var(--clay); }
  .fiche p { margin: 0; }
  /* La nôtre : un liseré de la couleur de l'eau, rien de plus (le comparatif
     reste factuel). */
  .fiche.nous { box-shadow: inset 0 0 0 2px var(--w4), var(--clay); }
  .quatre, .deux { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }

  /* En 30 secondes : quatre verdicts. */
  .verdict h3 { margin: 12px 0 0; font-family: var(--text); font-size: 1.125rem; font-weight: var(--tb); line-height: 1.3; letter-spacing: 0; color: var(--ink); }
  .verdict p { margin-top: 10px; font-size: 1rem; line-height: 1.55; color: var(--ink-2); }

  /* Les quatre solutions, en détail. */
  .solution-tete { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .solution-tete > div, .profil-tete > div, .points span { min-width: 0; }
  .mot.grand { font-size: clamp(1.625rem, 3vw, 2rem); line-height: 1.1; letter-spacing: -0.03em; white-space: normal; }
  .devise { margin-top: 6px !important; font-size: 0.96875rem; line-height: 1.45; color: var(--ink-2); }
  .rond { display: inline-flex; flex: none; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 16px; background: var(--sky); color: var(--brand); font-size: 1.375rem; }
  .pitch { margin: 16px 0 !important; font-size: 1rem; line-height: 1.6; color: var(--ink-2); }
  .points { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; margin: 0; padding: 0; list-style: none; font-size: 1rem; line-height: 1.5; color: var(--ink-2); }
  .points li { display: flex; align-items: flex-start; gap: 10px; }
  .points :global(.ic) { margin-top: 0.22em; font-size: 1.0625rem; color: var(--brand); }
  .cible { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); }
  .cible .chip { padding: 5px 12px; white-space: normal; }

  /* Le tableau : une fiche. Le <table> garde une largeur lisible ; plus large
     que sa fiche, il y défile de côté. La colonne des fonctionnalités reste en
     place (collante, sur fond blanc). L'ombre de droite n'apparaît que tant
     qu'il reste des colonnes (fond « local » : il défile avec le contenu et la
     couvre en bout de course) ; les cellules sont transparentes ou à peine
     teintées, pour la laisser voir. */
  .tableau {
    --col: 8.25rem;
    overflow-x: auto; overscroll-behavior-x: contain; border-radius: 28px; box-shadow: var(--clay);
    background:
      linear-gradient(to left, var(--paper) 40%, rgba(255, 255, 255, 0)) 100% 0 / 56px 100% no-repeat local,
      linear-gradient(to left, rgba(20, 37, 79, 0.3), rgba(20, 37, 79, 0)) 100% 0 / 26px 100% no-repeat scroll,
      var(--paper);
  }
  .tableau table { width: 100%; min-width: 33rem; border-collapse: separate; border-spacing: 0; font-size: 0.875rem; line-height: 1.4; }
  .tableau th, .tableau td { padding: 12px 8px; text-align: center; vertical-align: middle; }
  .tableau thead th { padding-top: 18px; padding-bottom: 14px; font-size: 1rem; }
  .tableau thead th:first-child { font-size: 0.75rem; font-weight: var(--tb); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  /* La première colonne : collante. */
  .tableau thead th:first-child, .tableau th[scope="row"] { position: sticky; left: 0; z-index: 1; width: var(--col); min-width: var(--col); max-width: var(--col); padding-left: 16px; background: var(--paper); box-shadow: 1px 0 0 var(--line); text-align: left; }
  .tableau th[scope="row"] { font-weight: var(--tw); color: var(--ink); }
  .tableau tbody tr:not(.groupe) > * { border-top: 1px solid var(--line); }
  /* Le nom d'un groupe : une bande ciel doux ; le libellé reste à gauche quand
     le tableau défile. */
  .groupe th { padding: 11px 16px; background: var(--sky-soft); text-align: left; }
  .groupe-t { position: sticky; left: 16px; display: inline-flex; align-items: center; gap: 8px; font-size: 0.9375rem; font-weight: var(--tb); color: var(--ink); }
  .groupe-t :global(.ic) { font-size: 1.0625rem; color: var(--brand); }
  /* Notre colonne : à peine teintée. */
  .tableau .nous { background: rgba(42, 96, 196, 0.07); }
  .tableau td :global(.ic) { vertical-align: middle; }
  .tableau :global(.oui) { font-size: 1.25rem; color: var(--ok); }
  .tableau :global(.non) { font-size: 1.25rem; color: rgba(20, 37, 79, 0.3); }
  .partiel { display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px; border-radius: var(--r-pill); background: var(--wait-bg); font-size: 0.8125rem; font-weight: var(--tb); line-height: 1.35; color: var(--wait); white-space: nowrap; }
  .pt { display: inline-block; flex: none; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .precision { display: inline-block; font-size: 0.8125rem; line-height: 1.35; color: var(--ink-2); }
  .nous .precision { font-weight: var(--tb); color: var(--brand); }
  /* Le « i » d'une précision : une cible de 24 px, le texte reste lu. */
  .aide { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; margin: -4px 0 -4px 2px; border-radius: 50%; vertical-align: middle; color: var(--ink-3); cursor: help; }
  .aide :global(.ic) { font-size: 1rem; }
  /* La précision se lit aussi au clavier et au toucher (à la souris, le
     navigateur montre déjà `title` au survol) : une fiche posée sous le nom de
     la fonctionnalité, par-dessus les colonnes voisines. Elle se place par
     rapport à la cellule (collante), pas au « i » : elle reste dans la partie
     visible du tableau. Sur les dernières lignes elle monte, pour ne pas en
     sortir. Le second `content` la retire de ce que lit un lecteur d'écran,
     qui a déjà le texte masqué. */
  .aide::after {
    content: attr(title); content: attr(title) / "";
    position: absolute; z-index: 2; top: calc(100% - 4px); left: 12px; display: none;
    width: max-content; max-width: min(17rem, 76vw); padding: 10px 14px; border-radius: 16px; background: var(--paper);
    box-shadow: 0 0 0 1px var(--line), var(--float);
    font-size: 0.8125rem; font-weight: var(--tw); line-height: 1.45; text-align: left; white-space: normal; color: var(--ink-2); cursor: auto;
  }
  .aide:focus::after { display: block; }
  @media (hover: none) { .aide:hover::after { display: block; } }
  .tableau th[scope="row"]:focus-within, .tableau th[scope="row"]:hover { z-index: 3; }
  .tableau tbody:last-of-type tr:nth-last-child(-n+3) .aide::after { top: auto; bottom: calc(100% - 4px); }
  .legende { max-width: 46rem; margin: 20px auto 0; font-size: 0.875rem; line-height: 1.6; text-align: center; color: var(--ink-2); }
  .legende :global(.ic) { display: inline-block; font-size: 1rem; vertical-align: -0.18em; }
  .legende :global(.oui) { color: var(--ok); }
  .legende :global(.non) { color: var(--ink-3); }
  .legende .pt { margin-right: 1px; color: var(--wait); }
  .lead :global(.info) { display: inline-block; vertical-align: -0.14em; color: var(--ink-3); }

  /* Quatre médecins, quatre besoins. */
  .profil-tete { display: flex; align-items: center; gap: 14px; }
  .profil h3 { margin: 0; font-family: var(--text); font-size: 1.1875rem; font-weight: var(--tb); line-height: 1.3; letter-spacing: 0; color: var(--ink); }
