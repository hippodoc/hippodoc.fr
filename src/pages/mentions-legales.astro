---
/**
 * Mentions légales (LCEN, art. 6 III ; Code de commerce, art. R123-237).
 * Refaites sobres le 14 novembre 2026 (MIGRATION.md § 9.fz) : identité
 * de la société d'après l'extrait Kbis (RCS Paris 943 434 738), hébergeurs
 * vérifiés (site sur Vercel, application sur Lovable, données chez Supabase,
 * région AWS eu-west-3 à Paris), adresses relevées sur leurs propres pages.
 * Le capital social reste : la loi l'exige d'une société inscrite au RCS.
 * L'avertissement HDS et les limites des estimations sont dans les
 * conditions d'utilisation (art. 7.2) et la politique de confidentialité.
 */
import PageLegale from '@/layouts/PageLegale.astro';

const title = "Mentions légales | Hippodoc";
const description = "Mentions légales d'Hippodoc : éditeur du site et de l'application, directeur de la publication, hébergeurs, propriété intellectuelle et données personnelles.";
const path = "/mentions-legales";
---

<PageLegale {title} {description} {path}>
  <Fragment slot="tete">
    <h1 class="aff">Mentions légales</h1>
    <p class="lead">
      Informations sur l'éditeur et les hébergeurs du site <strong>www.hippodoc.fr</strong> et de
      l'application <strong>app.hippodoc.fr</strong>, conformément à la loi n° 2004-575 du 21 juin 2004
      pour la confiance dans l'économie numérique.
    </p>
  </Fragment>

  <section>
    <h2>1. Éditeur</h2>
    <div class="lg-serre">
      <p><strong>HIPPODOC</strong>, société par actions simplifiée à associé unique (SASU) au capital de 1 €</p>
      <p>Siège social : 60 rue François Ier, 75008 Paris, France</p>
      <p>RCS Paris 943 434 738</p>
      <p>Email : <a href="mailto:contact@hippodoc.fr">contact@hippodoc.fr</a></p>
      <p>Téléphone : <a href="tel:+33756898961">+33 7 56 89 89 61</a></p>
    </div>
  </section>

  <section>
    <h2>2. Directeur de la publication</h2>
    <p>Ryan Goburdhun, président de la société HIPPODOC.</p>
  </section>

  <section>
    <h2>3. Hébergement</h2>
    <div class="lg-note">
      <p><strong>Site www.hippodoc.fr</strong></p>
      <p>Vercel Inc., 440 N Barranca Avenue #4133, Covina, CA 91723, États-Unis</p>
      <p><a href="https://vercel.com" rel="noopener noreferrer">vercel.com</a></p>
    </div>
    <div class="lg-note">
      <p><strong>Application app.hippodoc.fr</strong></p>
      <p>Lovable Labs Sweden AB, Regeringsgatan 25, 111 53 Stockholm, Suède</p>
      <p><a href="https://lovable.dev" rel="noopener noreferrer">lovable.dev</a></p>
    </div>
    <div class="lg-note">
      <p><strong>Données de l'application</strong></p>
      <p>Supabase Pte. Ltd, 65 Chulia Street #38-02/03, OCBC Centre, Singapour 049513</p>
      <p>Serveurs situés à Paris, en France.</p>
      <p><a href="https://supabase.com" rel="noopener noreferrer">supabase.com</a></p>
    </div>
  </section>

  <section>
    <h2>4. Propriété intellectuelle</h2>
    <p>
      Les contenus du site et de l'application (textes, images, illustrations, logo, logiciels) sont la
      propriété de HIPPODOC ou de ses partenaires. Toute reproduction ou réutilisation, totale ou
      partielle, sans autorisation écrite préalable de HIPPODOC est interdite.
    </p>
  </section>

  <section>
    <h2>5. Données personnelles et cookies</h2>
    <p>
      Le traitement des données personnelles et l'usage des cookies sont décrits dans la{' '}
      <a href="/politique-confidentialite">politique de confidentialité</a> et la{' '}
      <a href="/rgpd">charte RGPD</a>. Pour toute question ou pour exercer vos droits :{' '}
      <a href="mailto:contact@hippodoc.fr">contact@hippodoc.fr</a>.
    </p>
    <p>
      L'utilisation de l'application est régie par les{' '}
      <a href="/conditions-utilisations">conditions générales d'utilisation</a>.
    </p>
  </section>

  <div class="lg-maj">
    <p>Dernière mise à jour : 14 novembre 2026</p>
  </div>
</PageLegale>
