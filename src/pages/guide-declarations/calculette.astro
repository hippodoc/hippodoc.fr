---
/**
 * HippoCalc — calculette fiscale & sociale du médecin libéral (2042-C PRO + DSFU).
 * Portage de src/pages/guide-declarations/calculette.tsx (SPA source) :
 * chrome (Header/Footer/Hero/FAQ/Disclaimer/CTA) rendu en HTML statique ici,
 * formulaire + résultats interactifs délégués à l'îlot React CalculetteApp
 * (src/components/calculette/CalculetteApp.tsx), 100 % client-side, zéro réseau.
 *
 * Habillée dans la DA 2026 en phase 5d (MIGRATION.md § 9.el) : seul l'habillage a
 * changé. Textes, titres, liens, `id`, ordre des blocs, JSON-LD et `data-track`
 * sont ceux d'avant (période d'observation SEO) ; aucun calcul n'est touché.
 * - Page entièrement dans la DA : fond `da-fond`, en-tête « flottante ».
 * - Trois blocs : le ciel (le titre et son aperçu fictif, l'îlot de la
 *   calculette, l'appel à l'essai sur l'eau profonde), une feuille sable (les
 *   questions, en plis `.qa`), puis la fin (l'avertissement, le soleil sur
 *   l'eau du pied de page).
 * - Aucune classe utilitaire dans cette page : tout est dans son <style> et dans
 *   da.css. L'îlot React garde ses utilitaires ; ses couleurs et ses formes
 *   viennent de src/styles/calculette.css (`.calc`).
 * - Caractères absents de la police (←, →) et « + » des plis : dessinés en SVG,
 *   le caractère reste dans le texte, masqué à l'œil (classe `sr`).
 */
import '@/styles/calculette.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CalculetteApp from '@/components/calculette/CalculetteApp.tsx';
import { SITE_URL, APP_URL } from '@/lib/site';

const title = 'Calculette fiscale médecin libéral 2026 | Hippodoc';
const description =
  "HippoCalc — la calculette fiscale & sociale du médecin libéral. Reporte tes cases 2035, on remplit ta 2042-C PRO et ta DSFU. Gratuit, instantané, confidentiel.";
const path = '/guide-declarations/calculette';
const signupUrl = `${APP_URL}/auth?tab=signup`;

/* FAQ — verbatim depuis le tableau `FAQ` de la page source (7 Q/A). */
const FAQ = [
  {
    q: 'Quelle différence entre 5QC et 5QI ?',
    a: "5QC concerne les médecins en BNC réel adhérents à une AGA/OGA ou recourant à un expert-comptable conventionné. 5QI concerne les non-adhérents — leur bénéfice est majoré de 25 % avant calcul de l'impôt. Cette calculette suppose 5QC.",
  },
  {
    q: 'Quels sont les plafonds des chèques-vacances ANCV ?',
    a: "Deux plafonds indépendants s'appliquent en même temps. Plafond FISCAL (= 1 SMIC mensuel brut) : 1 766 € en 2024 · 1 802 € en 2025 · 1 823 € en 2026 — c'est le maximum déductible du bénéfice (5QC en réel ; en micro-BNC, la calculette applique la méthode répandue du × 1,515 sur 5HQ, qu'aucun texte officiel ne décrit : zone grise). Plafond SOCIAL (= 30 % du SMIC mensuel) : 530 € · 541 € · 547 € — c'est la limite d'exo cotisations URSSAF + CARMF, la CSG-CRDS reste due. La case DSCN reçoit le montant commandé, dans la limite du plafond fiscal (1 SMIC mensuel brut). Voir RO-005 pour le détail.",
  },
  {
    q: 'Pourquoi mon RBS est-il négatif ?',
    a: 'Le Revenu Brut Social peut être négatif quand tes insuffisances (CN) dépassent largement ton excédent (CE). Dans ce cas rare, le moteur le route automatiquement vers la case DSDG (valeur absolue) et laisse DSDE à 0.',
  },
  {
    q: "C'est quoi le cadre 8 (DE / DB) ?",
    a: 'Nouveau cadre obligatoire pour les revenus 2025+ (réforme LFSS 2024). DE = sommes à réintégrer au RBS (intéressement, plus-values CT exonérées…). DB = sommes à déduire (IJ déjà comptées en gains divers, pour éviter une double imposition sociale).',
  },
  {
    q: 'Cette calculette remplace-t-elle mon expert-comptable ?',
    a: 'Non. C\'est un outil d\'estimation pédagogique qui automatise les 13 formules officielles 2042-C PRO et DSFU (ex DS-PAMC). Vérifie toujours auprès de ton AGA, ton expert-comptable, ou des notices officielles 2041 DRI PAMC et 2035-NOT. Pour aller plus loin, consulte le Guide Déclarations complet : /guide-declarations',
  },
  {
    q: 'Quand dois-je passer du RSPM au PAMC ?',
    a: "Le RSPM (Régime Simplifié des Professions Médicales) est une option déclarative auprès de l'URSSAF, réservée aux remplaçants. La bascule en PAMC devient obligatoire dans deux cas : recettes > 19 000 € pendant 2 années consécutives, OU recettes > 38 000 € sur une seule année (CSS Art. L646-1). Dans les deux cas, tu RESTES en RSPM jusqu'au 31 décembre de l'année du dépassement ; la bascule en PAMC s'applique au 1er janvier de l'année suivante : l'URSSAF te radie d'office du RSPM, sans démarche de ta part. L'année du dépassement, la part de tes recettes au-dessus de 19 000 € est cotisée à 21,2 %. Le toggle de la calculette est 100 % manuel : aucune bascule automatique côté logiciel.",
  },
  {
    q: 'Mon profil n\'est pas exactement dans la liste (collaborateur libéral, salarié exclusif, interne) — que faire ?',
    a: 'Cette calculette couvre les 4 cas les plus fréquents. Pour les profils plus spécifiques (collaborateur libéral en SELARL, interne en remplacement, salarié exclusif…), consulte les fiches détaillées du Guide Déclarations qui couvrent 12 profils types avec leurs particularités fiscales : /guide-declarations#fiches',
  },
];

/* JSON-LD — repris des 3 scripts <Helmet> de la page source. */
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'HippoCalc',
  description,
  url: `${SITE_URL}${path}`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  inLanguage: 'fr',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Guide Déclarations', item: `${SITE_URL}/guide-declarations` },
    { '@type': 'ListItem', position: 3, name: 'HippoCalc', item: `${SITE_URL}${path}` },
  ],
};

const jsonLd = [webAppSchema, faqSchema, breadcrumbSchema];

/* Dessins : la croix des plis (da.css la fait tourner), la flèche (le dessin de
   accueil/TroisCases.astro ; `gauche` la retourne). */
const croix =
  '<svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 3v12M3 9h12"/></svg>';
const dessinFleche =
  '<svg viewBox="0 0 16 12" width="16" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 6h12.5M9.5 1.5 14 6l-4.5 4.5"/></svg>';
const fleche = `<span class="fl"><span class="sr">→</span>${dessinFleche}</span>`;
const flecheGauche = `<span class="fl gauche"><span class="sr">←</span>${dessinFleche}</span>`;
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd} bodyClass="da-fond">
  <Fragment slot="head">
    {/* Barre du navigateur mobile : le ciel de la DA (jeton sky-1), comme l'accueil. */}
    <meta name="theme-color" content="#C9DEFF" />
  </Fragment>
  {/* La pastille survole le ciel du premier bloc, qui lui réserve le haut. */}
  <Header variante="flottante" />
  <main>
    <div class="tete da-bloc">
      <!-- Titre de la page : « Hippo » en encre, « Calc » dans le bleu de l'eau, et l'aperçu (décor) -->
      <section class="wrap intro">
        <a
          href="/guide-declarations"
          class="retour"
        >
          <Fragment set:html={flecheGauche} /> Guide Déclarations
        </a>
        <div class="hero">
          <div class="hero-txt">
            <div class="gages">
              <span class="chip plan gage">
                <span class="point"></span>
                Outil gratuit · Millésime 2026
              </span>
              <span class="chip wait gage">
                Bêta · En travaux
              </span>
            </div>
            <h1 class="aff">
              <span>Hippo</span><span class="eau">Calc</span>
            </h1>
            <p class="lead">
              Ta 2042-C PRO et ta DSFU pré-remplies en 2 minutes, depuis ta 2035 ou tes recettes Micro-BNC.
            </p>
            <p class="prive">
              Tout reste dans ton navigateur. Rien n'est envoyé.
            </p>
            <p class="aide">
              Pas sûr d'une case ?{' '}
              <a href="/guide-declarations#glossaire" class="lien">
                Consulte le glossaire 2035
              </a>
              <span class="sep">·</span>
              <a href="/guide-declarations#fiches" class="lien">
                Trouve ta fiche profil
              </a>
            </p>
          </div>

          <!-- Aperçu décoratif (chiffres d'illustration repris verbatim du hero source) -->
          <div aria-hidden="true" class="apercu">
            <div class="apercu-fiche">
              <div class="apercu-tete">
                <span class="apercu-nom">2042-C PRO · 2026</span>
                <span class="apercu-etat">
                  <span class="point"></span>
                  Pré-rempli
                </span>
              </div>
              <div class="apercu-lignes">
                <div>
                  <span>5QC</span>
                  <span class="val">52 800 €</span>
                </div>
                <div>
                  <span>1AS</span>
                  <span class="val">14 200 €</span>
                </div>
                <div>
                  <span>1AJ</span>
                  <span class="val">0 €</span>
                </div>
              </div>
              <div class="apercu-suite">
                <div class="apercu-nom">
                  DSFU · URSSAF
                </div>
                <div class="apercu-lignes">
                  <div>
                    <span>DSCS</span>
                    <span class="val">52 800 €</span>
                  </div>
                  <div>
                    <span>DSCN</span>
                    <span class="val">11 244 €</span>
                  </div>
                  <div>
                    <span>DSAU</span>
                    <span class="val">1,0000</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Îlot React — formulaire + résultats, 100 % client-side -->
      {/* Titre réservé aux lecteurs d'écran : les cartes de l'îlot ouvrent sur des
          titres de niveau 3 (CardTitle), d'où un saut h1 → h3 dans la hiérarchie.
          CardTitle est partagé par tout le site : on ne touche pas au composant,
          on rétablit le niveau manquant ici.
          Commentaire Astro `{…}` et non `<!-- -->` : un commentaire HTML est émis
          dans la page, et celui-ci citait « h3 » — il était compté comme un vrai
          titre par les outils d'analyse. */}
      <h2 class="sr">La calculette</h2>
      <CalculetteApp client:visible />

      <!-- Appel à l'essai : une fiche sur l'eau profonde -->
      <section class="wrap essai">
        <div class="essai-fiche">
          <div class="essai-in">
            <div class="essai-txt">
              <span class="essai-gage">
                Hippodoc
              </span>
              <h2>
                Et si tout ça se faisait tout seul ?
              </h2>
              <p>
                Hippodoc pré-remplit ta 2042-C PRO et ta DSFU à partir de tes encaissements, et garde ton Super-Net à jour en temps réel.
              </p>
            </div>
            <div class="essai-action">
              <a
                id="calculette-cta-signup"
                href={signupUrl}
                data-track="calculette_2042_dspamc_cta_click"
                class="btn btn-brand"
              >
                Essayer Hippodoc <Fragment set:html={fleche} />
              </a>
              <p class="essai-mention">
                30 jours offerts · Sans engagement
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- FAQ — SEO, natif details/summary (pas de Radix : le contenu doit être présent dans le HTML) -->
    <section class="band da-bloc" aria-labelledby="faq-title">
      <div class="wrap cote">
        <div class="band-head">
          <p class="sur">FAQ</p>
          <h2 id="faq-title">
            Questions fréquentes
          </h2>
          <p class="lead">
            Les {FAQ.length} questions qu'on nous pose le plus souvent.
          </p>
        </div>
        <div class="liste">
          {FAQ.map((f) => (
            <details class="qa">
              <summary>
                <span class="qa-t">{f.q}</span>
                <span aria-hidden="true" class="sr">+</span><Fragment set:html={croix} />
              </summary>
              <div class="qa-in"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
        <p class="autre">
          Une autre question ?{' '}
          <a href="/guide-declarations#glossaire" class="lien">
            Consulte le glossaire complet <Fragment set:html={fleche} />
          </a>
        </p>
      </div>
    </section>

    <!-- Avertissement, puis le soleil qui se lève sur l'eau du pied de page -->
    <section class="fin da-bloc">
      <div class="wrap fin-copy">
        <p class="avis">
          <strong>Outil d'estimation.</strong>{' '}
          HippoCalc automatise les formules officielles 2042-C PRO et DSFU mais ne remplace ni ton expert-comptable, ni ton AGA, ni les notices officielles (2041 DRI PAMC, 2035-NOT).
          <span class="sep">•</span>
          <strong>100 % local.</strong>{' '}
          Tes saisies sont sauvegardées uniquement dans ton navigateur. Aucune donnée n'est envoyée à Hippodoc.
        </p>
      </div>
      <div class="horizon" aria-hidden="true">
        <span class="sun"></span>
        <span class="wave w3"></span>
        <span class="wave w4"></span>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    // Analytics du CTA marketing statique (hors îlot React) — même événement que
    // la SPA source (calculette_2042_dspamc_cta_click, context 'public').
    import { trackEvent } from '@/lib/analytics';

    document.getElementById('calculette-cta-signup')?.addEventListener('click', () => {
      trackEvent('calculette_2042_dspamc_cta_click', { context: 'public' });
    });
  </script>
</BaseLayout>

<style>
  /* Texte grossi : un mot plus large que sa fiche se coupe au lieu de la pousser
     (la propriété s'hérite : elle vaut aussi dans l'îlot). */
  main { overflow-wrap: break-word; }
  /* Les flèches arrivent par `set:html` : leurs classes ne portent pas l'attribut
     de portée de la page, d'où `:global`. */
  .sr, main :global(.sr) { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* La flèche dessinée, sur la ligne du texte (accueil/TroisCases.astro). */
  main :global(.fl) { white-space: nowrap; }
  main :global(.fl svg) { display: inline-block; width: 0.95em; height: auto; vertical-align: -0.02em; }
  main :global(.fl.gauche svg) { scale: -1 1; }

  /* Le ciel : le bloc passe sous la pastille de l'en-tête, il lui réserve le
     haut. En bas, 88 px d'air et les 40 px que recouvre la feuille suivante. */
  .tete { position: relative; padding: 100px 0 128px; background: linear-gradient(var(--sky-1) 0, var(--sky) 460px); }
  /* Corps de texte en rem : la feuille de la DA les pose en px, ils ne suivaient
     plus la taille de police du navigateur. Même rendu à 16 px. */
  .da-bloc { font-size: 1.0625rem; }
  .lead { font-size: 1.1875rem; }
  .btn { gap: 9px; padding-block: 8px; font-size: 1.0625rem; text-align: center; }
  .chip { font-size: 0.84375rem; }
  .qa-t { min-width: 0; font-size: 1.125rem; overflow-wrap: anywhere; }
  .qa-in p { font-size: 1.03125rem; }
  h2 { --corps: clamp(min(2rem, 10vw), 4.5vw, 3.625rem); }
  @media (max-width: 359px) { .qa-t { font-size: 1.0625rem; } }

  /* Le titre de la page */
  .intro { margin-bottom: 36px; }
  .retour { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; border-radius: var(--r-sm); font-size: 0.9375rem; font-weight: 560; color: var(--ink-2); text-decoration: none; }
  .retour:hover { color: var(--ink); }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; gap: 40px; margin-top: 10px; }
  .hero-txt { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .hero-txt > * { margin: 0; }
  .gages { display: flex; flex-wrap: wrap; gap: 8px; }
  .gage { display: inline-flex; align-items: center; gap: 7px; padding: 6px 13px; white-space: normal; }
  .point { flex: none; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  /* « Hippo » en encre, « Calc » dans le bleu de l'eau. Plus grand que le titre
     des autres pages : c'est un nom, sur une ligne. */
  .intro h1 { --corps: clamp(min(3rem, 16vw), 7.4vw, 5.5rem); }
  .eau { color: var(--w4); }
  .prive { font-size: 0.9375rem; color: var(--ink-2); }
  .aide { font-size: 1rem; color: var(--ink-2); }
  .aide .sep { margin: 0 8px; color: var(--ink-3); }
  /* L'aperçu (décor, à partir de 1 024 px) : une fiche en relief, un peu penchée. */
  .apercu { display: none; }
  .apercu-fiche { display: grid; gap: 16px; padding: 24px 24px 26px; border-radius: 28px; background: var(--paper); box-shadow: var(--clay); rotate: 2deg; }
  .apercu-tete { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .apercu-nom { font-size: 0.75rem; font-weight: var(--tb); letter-spacing: 0.08em; text-transform: uppercase; color: var(--brand); }
  .apercu-etat { display: inline-flex; align-items: center; gap: 6px; font-size: 0.75rem; font-weight: var(--tb); color: var(--ok); }
  .apercu-lignes { display: grid; gap: 8px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.875rem; color: var(--ink-3); }
  .apercu-lignes > div { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .apercu-lignes .val { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--ink); }
  .apercu-suite { display: grid; gap: 10px; padding-top: 16px; border-top: 1px solid var(--line); }

  /* L'appel à l'essai : l'eau profonde, le bouton jaune. */
  .essai { margin-top: 28px; }
  .essai-fiche { --focus: #FFFFFF; padding: 32px 24px 34px; border-radius: 32px; background: linear-gradient(var(--deep), #1F4FAF); color: var(--paper); box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.22), inset 0 -5px 0 rgba(10, 25, 70, 0.22), 0 22px 44px -22px rgba(13, 40, 105, 0.6); }
  .essai-in { display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; gap: 24px; }
  .essai-txt { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .essai-txt > * { margin: 0; }
  .essai-gage { padding: 4px 12px; border-radius: var(--r-pill); background: rgba(255, 255, 255, 0.08); font-size: 0.8125rem; font-weight: var(--tb); letter-spacing: 0.06em; line-height: 1.4; text-transform: uppercase; }
  .essai h2 { --corps: clamp(min(1.75rem, 9vw), 3.4vw, 2.5rem); color: var(--paper); }
  .essai-txt p { max-width: 36rem; font-size: 1.0625rem; line-height: 1.55; color: var(--on-deep-2); }
  .essai-action { display: flex; flex-direction: column; align-items: stretch; gap: 14px; }
  .essai-mention { margin: 0; font-size: 0.875rem; color: var(--on-deep-2); text-align: center; }

  /* Petit titre au-dessus d'un titre */
  .sur { margin: 0; font-size: 0.8125rem; font-weight: var(--tb); letter-spacing: 0.08em; line-height: 1.4; text-transform: uppercase; color: var(--ink-3); }
  /* Les questions : le titre à gauche, les plis à droite (accueil/Questions.astro). */
  .cote { display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; gap: 26px; }
  .cote .band-head { margin-bottom: 0; }
  .liste { min-width: 0; }
  .liste .qa:last-child { margin-bottom: 0; }
  .autre { margin: 0; font-size: 1rem; color: var(--ink-2); }

  /* La fin : l'avertissement, puis le soleil qui se lève sur l'eau du pied de
     page (les deux dernières vagues de accueil/SceneFinale.astro, immobiles).
     -1 px en bas : pas de filet clair au-dessus du pied. */
  .fin { position: relative; z-index: 1; margin-top: -40px; margin-bottom: -1px; overflow: hidden; border-radius: var(--r-xl) var(--r-xl) 0 0; background: linear-gradient(var(--sky-1) 0, var(--sky-2) 50%, var(--glow) 100%); text-align: center; }
  .fin-copy { z-index: 1; padding-top: 72px; }
  .avis { max-width: 46rem; margin: 0 auto; font-size: 0.9375rem; line-height: 1.6; color: var(--ink-2); text-wrap-style: pretty; }
  .avis strong { color: var(--ink); }
  .avis .sep { margin: 0 8px; color: var(--ink-3); }
  /* Le halo dépasse le soleil de 62 px (92 px sur ordinateur) : 20 px d'air
     entre le texte et lui. */
  .horizon { position: relative; height: 190px; margin-top: 60px; --p: 300px; --th: 40px; }
  .sun { position: absolute; left: 50%; bottom: -122px; width: 290px; height: 290px; margin-left: -145px; border-radius: 50%; background: radial-gradient(circle at 50% 36%, #FFE98A, #FFD03C 72%); box-shadow: 0 0 0 26px rgba(255, 214, 74, 0.26), 0 0 0 62px rgba(255, 214, 74, 0.13); }
  .wave { position: absolute; left: 0; right: 0; bottom: 0; }
