---
/**
 * /guide-declarations — portage de src/pages/guide-declarations/index.tsx +
 * GuideDeclarationsBody.tsx (SPA source « hippodocfinary »).
 *
 * Structure (ordre identique à la source, `GuideDeclarationsBody.tsx`) :
 *   Hero (statique) → recherche (îlot) → Zone 1 « Commence ici »
 *   (FiscalSocialPrimer statique + boussole = îlot React) → Zone 2
 *   « Référence rapide » (FlowChart + Caseopedia, statiques) → Zone 3
 *   « Pour aller plus loin » (Fiches, Questions, Glossaire, statiques) →
 *   Zone 4 « Outils pratiques » (Problèmes/recours, Calendrier, CTA
 *   premium, disclaimer — tous statiques). L'encart « pont assistant »
 *   (HippoFisc) est retiré le 01/11/2026 : HippoFisc est masqué dans
 *   l'app (MIGRATION.md § 9.dz).
 *
 * Déviations volontaires documentées dans chaque composant porté
 * (src/components/guide/*) :
 *  - Un seul îlot interactif hydraté : la boussole (`BoussoleWizard`,
 *    `client:visible`) + la recherche (`BoussoleSearchIsland`,
 *    `client:visible`), toutes deux autonomes (pas d'état partagé entre
 *    elles ni avec les sections statiques — contrairement à la source où
 *    `GuideDeclarationsBody` orchestrait un état levé commun).
 *  - Sélectionner un profil dans la boussole NE filtre PLUS le reste de
 *    la page (Caseopedia/FlowChart/Fiches/Questions) : ces sections sont
 *    rendues 100 % statiques et affichent toujours tout leur contenu.
 *  - IntersectionObserver (ToC active + analytics `..._section_viewed`) :
 *    omis (consigne explicite : zéro scroll listener ajouté).
 *  - Sommaire latéral (`TableOfContents.tsx`, FAB mobile + Drawer) : omis
 *    — nécessitait un `resize` listener + Drawer JS pour une simple nav
 *    de confort ; tout le contenu reste atteignable au scroll normal et
 *    via la nav globale du Header.
 *  - `PromoBanner` (dormant en prod, cf. src/pages/index.astro) : non
 *    repris, comme sur le reste du site cible.
 *
 * Habillée dans la DA 2026 en phase 5d (MIGRATION.md § 9.el) : seul l'habillage a
 * changé. Textes, titres, liens, ancres, `id`, ordre des blocs, JSON-LD et
 * `data-track` sont ceux d'avant (période d'observation SEO) ; la logique des
 * deux îlots (recherche, boussole) n'est pas touchée.
 * - Page entièrement dans la DA : fond `da-fond`, en-tête qui flotte. Le
 *   bandeau d'échéance reste entre l'en-tête et <main>, dans le flux : une
 *   pastille sur le ciel, sous celle de l'en-tête.
 * - <main class="gd"> porte le ciel : le titre, la barre de recherche (collante,
 *   enfant direct de <main> pour le rester sur toute la page) et les quatre
 *   pages détaillées sont posés dessus. Puis quatre feuilles, une par étape
 *   (sable, ciel, sable, ciel), et la fin : l'appel à l'essai sur l'eau
 *   profonde, les articles, l'avertissement, le soleil sur l'eau du pied.
 * - Aucune classe utilitaire dans cette page ni dans les composants `guide/`
 *   (sauf FormattedText.tsx, non modifié) : tout est dans src/styles/guide.css
 *   (classes `gd-*`, feuille servie aux pages du guide seulement) et da.css.
 */
import '@/styles/guide.css';
import BlogReadMore from '@/components/BlogReadMore.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_URL } from '@/lib/site';
import { questionsFAQ } from '@/data/boussoleData';
import { GUIDE_DECLARATIONS_LAST_UPDATED_ISO } from '@/lib/guide/lastUpdated';

import HeroSection from '@/components/guide/HeroSection.astro';
import SousPagesNav from '@/components/guide/SousPagesNav.astro';
import SeasonalBanner from '@/components/guide/SeasonalBanner.astro';
import SectionDivider from '@/components/guide/SectionDivider.astro';
import FiscalSocialPrimer from '@/components/guide/FiscalSocialPrimer.astro';
import FlowChartSection from '@/components/guide/FlowChartSection.astro';
import CalendrierSection from '@/components/guide/CalendrierSection.astro';
import PremiumCtaSection from '@/components/guide/PremiumCtaSection.astro';
import DisclaimerSection from '@/components/guide/DisclaimerSection.astro';

import { CaseopediaSection } from '@/components/guide/CaseopediaSection';
import { FichesPratiquesSection } from '@/components/guide/FichesPratiquesSection';
import { TopQuestionsSection } from '@/components/guide/TopQuestionsSection';
import { GlossaireSection } from '@/components/guide/GlossaireSection';
import { ProblemesRecoursSection } from '@/components/guide/ProblemesRecoursSection';

import { BoussoleSearchIsland } from '@/components/guide/BoussoleSearchIsland';
import { BoussoleWizard } from '@/components/guide/BoussoleWizard';

const title = 'Déclarations fiscales et sociales du médecin | Hippodoc';
const description =
  'Guide pratique des déclarations fiscales et sociales du médecin libéral : 2042-C-PRO, 2035, DSFU, URSSAF, CARMF, micro-BNC, réel.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questionsFAQ.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.reponse },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Guide Déclarations', item: `${SITE_URL}/guide-declarations` },
  ],
};

/* Auteur nommé : la page n'en déclarait aucun, alors que chaque article de blog
   porte `Person: Dr. Ryan Goburdhun`. Sur un contenu fiscal destiné à des
   professionnels de santé (YMYL), « qui répond de ce qui est écrit » est le
   signal E-E-A-T le plus directement lisible — et c'était la seule page experte
   du site à ne pas le dire. `reviewedBy` / `lastReviewed` sont les propriétés
   que schema.org prévoit exactement pour ce cas. Voir MIGRATION.md § 9.aj. */
const authorSchema = {
  '@type': 'Person',
  name: 'Dr. Ryan Goburdhun',
  jobTitle: "Médecin remplaçant & fondateur d'Hippodoc",
  url: `${SITE_URL}/qui-sommes-nous`,
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Guide des déclarations fiscales et sociales du médecin',
  description,
  url: `${SITE_URL}/guide-declarations`,
  author: authorSchema,
  reviewedBy: authorSchema,
  lastReviewed: GUIDE_DECLARATIONS_LAST_UPDATED_ISO,
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: 'fr',
  isPartOf: { '@type': 'WebSite', url: SITE_URL },
  dateModified: GUIDE_DECLARATIONS_LAST_UPDATED_ISO,
};
---

<BaseLayout
  title={title}
  description={description}
  path="/guide-declarations"
  ogType="article"
  jsonLd={[faqSchema, breadcrumbSchema, webPageSchema]}
  bodyClass="da-fond"
>
  <Fragment slot="head">
    {/* Barre du navigateur mobile : le ciel de la DA (jeton sky-1), comme l'accueil. */}
    <meta name="theme-color" content="#C9DEFF" />
  </Fragment>
  {/* La pastille survole le ciel : le bandeau d'échéance, ou à défaut le titre,
      lui réserve le haut. */}
  <Header />
  <SeasonalBanner />

  <main class="gd">
    <HeroSection />
    <BoussoleSearchIsland client:visible />
    {/* Remplacé au build par un <link rel="modulepreload"> par fichier JS de la
        recherche (src/lib/precharge-ilots.mjs, MIGRATION.md § 9.er). Ici et pas dans le
        <head> : à cet endroit du HTML, les feuilles de style ont pris leur avance. */}
    <template data-precharge-ilots="BoussoleSearchIsland"></template>
    <SousPagesNav />

    {/* Zone 1 : Commence ici */}
    <div class="band da-bloc">
      <SectionDivider step={1} label="Commence ici" hint="Comprends · identifie-toi · checklist" compact />
      <FiscalSocialPrimer />
      <BoussoleWizard client:visible={{ rootMargin: "100%" }} />
    </div>

    {/* Zone 2 : Référence rapide */}
    <div class="band air da-bloc">
      <SectionDivider step={2} label="Référence rapide" hint="Parcours déclaratif & cases" />
      <FlowChartSection />
      <CaseopediaSection />
    </div>

    {/* Zone 3 : Pour aller plus loin */}
    <div class="band da-bloc">
      <SectionDivider step={3} label="Pour aller plus loin" hint="Fiches · questions · glossaire" />
      <FichesPratiquesSection />
      <TopQuestionsSection />
      <div class="wrap gd-sec">
        <GlossaireSection />
      </div>
    </div>

    {/* Zone 4 : Outils pratiques */}
    <div class="band air da-bloc">
      <SectionDivider step={4} label="Outils pratiques" hint="Problèmes · calendrier" />
      <ProblemesRecoursSection />
      <CalendrierSection />
    </div>

    {/* La fin : l'appel à l'essai, les articles, l'avertissement, puis le soleil
        qui se lève sur l'eau du pied de page. */}
    <div class="gd-fin da-bloc">
      <PremiumCtaSection />
      {/* Le guide ne liait aucun article du blog (MIGRATION.md § 9.co). */}
      <div class="wrap gd-lire">
        <BlogReadMore
          emplacement="guide"
          titre="Pour aller plus loin, sur le blog"
          slugs={['remplir-declaration-2035', 'regime-fiscal-micro-bnc-vs-reel', 'guide-impots-internes-remplacants', 'pdsa-exoneration-gardes-regulees', 'calendrier-fiscal-remplacant', 'frais-pros-medecin-liberal-2026']}
        />
      </div>
      <DisclaimerSection />
      <div class="gd-horizon" aria-hidden="true">
        <span class="gd-soleil"></span>
        <span class="gd-vague v3"></span>
        <span class="gd-vague v4"></span>
      </div>
    </div>
  </main>

  <Footer />
  {/* Les fichiers de la boussole, eux, en fin de page : elle est plus bas, hydratée à
      l'approche ; ses fichiers (dont les données du guide, 100 Ko) ne disputent pas le
      débit à la recherche et sont là quand le visiteur arrive (§ 9.er). */}
  <template data-precharge-ilots="BoussoleWizard"></template>
</BaseLayout>
