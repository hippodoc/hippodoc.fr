---
/**
 * Simulateur Super-Net — portage de src/pages/simulateur-public.tsx (SPA source).
 * Chrome (Header/Footer/Hero/Guide explicatif/Disclaimer/CTA) rendu en HTML
 * statique ici ; formulaire + résultats interactifs délégués à l'îlot React
 * SimulateurApp (src/components/simulateur/SimulateurApp.tsx). Branche PAMC :
 * cotisations par le modèle officiel de l'Urssaf (src/lib/simulateur/urssaf.ts, repli
 * sur l'Edge Function calculate-urssaf) ; branche RSPM (remplaçant, mode Auto jusqu'à
 * 19 000 €) calculée côté client. L'impôt est calculé côté client dans les deux cas
 * (useRspmCalculation.ts). Audit de novembre 2026 : MIGRATION.md § 9.fr.
 *
 * JSON-LD ajouté en août 2026 (voir MIGRATION.md § 9.ae) : la page n'en avait
 * pas, par parité avec la SPA source. Écart assumé — l'outil jumeau
 * /guide-declarations/calculette porte WebApplication + FAQPage + BreadcrumbList
 * depuis l'origine, et /simulateur reçoit 41 liens internes pour zéro impression
 * de recherche. La parité de migration ne justifiait plus de s'en priver.
 *
 * Habillée dans la DA 2026 en phase 5d (MIGRATION.md § 9.ek) : seul l'habillage a
 * changé. Textes, titres, liens, ancres, ordre des blocs, JSON-LD, `data-track`
 * et `data-calendly` sont ceux d'avant (période d'observation SEO) ; aucun
 * calcul n'est touché.
 * - Page entièrement dans la DA : fond `da-fond`, en-tête qui flotte.
 * - Cinq blocs : le ciel (titre, l'îlot du simulateur, la prise de rendez-vous),
 *   une feuille sable (le mode d'emploi, en plis `.qa`), une feuille ciel (les
 *   trois définitions, l'exemple chiffré, les limites), une feuille sable (les
 *   questions), puis la fin (l'appel à l'essai, les articles à lire, le soleil
 *   sur l'eau du pied de page).
 * - Aucune classe utilitaire dans cette page : tout est dans son <style> et
 *   dans da.css. L'îlot React garde ses utilitaires de mise en page ; ses
 *   couleurs viennent de src/styles/simulateur.css (classes `sim-*`).
 * - Caractères absents de la police (→, ↗, 💡) : dessinés en SVG, le caractère
 *   reste dans le texte, masqué à l'œil (classe `sr`). Le « + » des plis aussi.
 * - Mascotte au pouce levé (décor, les fichiers de l'accueil), à partir de
 *   1 024 px : à droite du titre, debout derrière le haut de l'îlot.
 */
import '@/styles/simulateur.css';
import { getImage } from 'astro:assets';
import pouce from '@/assets/accueil/mascotte-f-pouce.webp';
import BlogReadMore from '@/components/BlogReadMore.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SimulateurApp from '@/components/simulateur/SimulateurApp.tsx';
import { APP_URL, CALENDLY_URL, SITE_URL } from '@/lib/site';
import { getDeclarationParams } from '@/lib/declarationParams';
import { getMicroBncCeiling, getPlafondEpargneRetraite } from '@/lib/baremes-ir';

const title = 'Simulateur revenus médecin gratuit | Hippodoc';
const description =
  "Simule gratuitement ton revenu net de médecin. Compare Micro-BNC et Régime Réel, calcule tes cotisations URSSAF et ton Super-Net en quelques clics.";
const path = '/simulateur';
const signupUrl = `${APP_URL}/auth?tab=signup`;

/* Plafonds chèques-vacances ANCV — mêmes valeurs que SimulateurGuide.tsx (SPA source),
   lues dynamiquement depuis la source unique de vérité (déclarationParams.ts). */
const cvPlafond2024 = getDeclarationParams(2024).plafondChequesVacances;
const cvPlafond2025 = getDeclarationParams(2025).plafondChequesVacances;
const cvPlafond2026 = getDeclarationParams(2026).plafondChequesVacances;

const trustBadges = ['URSSAF 2026', 'Barème fiscal 2026', 'Calcul instantané'];

/* Six repères (MIGRATION.md § 9.fs) : chaque montant vient du code du simulateur. Les règles
   sont celles vérifiées à l'audit de novembre 2026 (Légifrance, BOFiP, CARMF, Urssaf). */
const ANNEE_REPERES = 2026;
const euros = (n: number) => `${new Intl.NumberFormat('fr-FR').format(n)}\u00a0€`;
const REPERES: { chiffre: string; titre: string; texte: string; soleil?: boolean }[] = [
  {
    chiffre: euros(getMicroBncCeiling(ANNEE_REPERES)),
    titre: 'Plafond du <span class="insecable">Micro-BNC</span>',
    texte: "Tes recettes de l'année. Deux années de suite au-dessus, tu passes au régime réel.",
  },
  {
    chiffre: '34\u00a0%',
    titre: 'Abattement du <span class="insecable">Micro-BNC</span>',
    texte: "Pour l'impôt, il remplace tes charges et tes cotisations. Au réel, tu déduis les vraies.",
  },
  {
    chiffre: euros(19000),
    titre: 'Seuil du RSPM',
    texte: "L'offre simplifiée des remplaçants, sur leurs rétrocessions : 13,5\u00a0% de cotisations, 21,2\u00a0% au-delà.",
  },
  {
    chiffre: euros(0),
    titre: 'De forfaits du secteur 1 pour un remplaçant',
    texte: 'Le 2\u00a0%, le 3\u00a0% et le groupe III sont réservés aux médecins installés.',
    soleil: true,
  },
  {
    chiffre: euros(getDeclarationParams(ANNEE_REPERES).plafondChequesVacances),
    titre: 'De chèques-vacances déductibles',
    texte: "Au régime réel, dans la limite d'un SMIC mensuel par an.",
  },
  {
    chiffre: euros(getPlafondEpargneRetraite('per', 0, ANNEE_REPERES)),
    titre: 'De PER déductible, au minimum',
    texte: 'Même avec de petits revenus, en Micro-BNC comme au régime réel.',
  },
];

/* FAQ — chaque réponse reformule un contenu DÉJÀ présent sur cette page
   (glossaire « Trois mots à connaître », guide d'utilisation, disclaimer).
   Un FAQPage dont les questions ne sont pas visibles enfreint les consignes
   Google : elles sont donc rendues plus bas en <details> natifs, comme sur
   /guide-declarations/calculette. */
const FAQ: { q: string; a: string }[] = [
  {
    q: "C'est quoi le Super-Net ?",
    a: "Ce qu'il te reste vraiment en poche : tes revenus, moins tes charges professionnelles, moins tes cotisations sociales (URSSAF et CARMF), moins ton impôt sur le revenu. C'est le chiffre affiché en tête de chaque carte de résultat.",
  },
  {
    q: 'Le simulateur prend-il en compte la CARMF ?',
    a: "Oui. L'URSSAF et la CARMF sont calculées automatiquement, tu n'as pas à les saisir dans tes charges. Les options avancées permettent de préciser ta situation d'affiliation : régime normal (retraite de base, complémentaire et ASV) ou dispense.",
  },
  {
    q: 'Que se passe-t-il au-delà de 38 000 € de recettes ?',
    a: "Le régime social change. Le RSPM (taux simplifiés) est ouvert jusqu'à 19 000 € d'honoraires ; on le perd au 1er janvier suivant après deux années de suite au-dessus de 19 000 €, ou une seule au-dessus de 38 000 €. Le RSPM est une option réservée aux remplaçants (et aux régulateurs) sans autre activité libérale. Pour une année type, aux recettes stables, il ne tient que jusqu'à 19 000 € : en mode Auto, recommandé, le simulateur le retient pour un remplaçant jusqu'à ce seuil, et le PAMC (barème classique) au-delà. Déjà au RSPM et entre 19 000 et 38 000 € ? Choisis-le à la main.",
  },
  {
    q: 'Compare-t-il le Micro-BNC et le Régime Réel ?',
    a: "Oui, le calcul est fait dans les deux régimes pour que tu puisses les comparer. En Micro-BNC, un abattement forfaitaire de 34 % remplace tes charges réelles ; au Régime Réel, ce sont tes dépenses professionnelles déductibles qui sont prises en compte.",
  },
  {
    q: 'Le simulateur remplace-t-il un expert-comptable ?',
    a: "Non. Cette simulation est fournie à titre indicatif et repose sur les barèmes en vigueur. Elle ne prend en compte ni tes spécificités fiscales individuelles, ni les évolutions réglementaires, ni les optimisations propres à ta situation. Pour une analyse personnalisée, consulte un expert-comptable, un avocat fiscaliste ou un CGP indépendant.",
  },
];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Simulateur Super-Net',
  description,
  url: `${SITE_URL}${path}`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  inLanguage: 'fr',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Simulateur', item: `${SITE_URL}${path}` },
  ],
};

const jsonLd = [webAppSchema, faqSchema, breadcrumbSchema];

/* Affichage seulement : garde sur une ligne un mot composé (« prend-il »,
   « Micro-BNC ») et un mot avec le « ? » qui le suit. Le texte ne change pas. */
const echapper = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const nouer = (t: string) =>
  echapper(t)
    .replace(/(\S+) \?/g, '<span class="num">$1 ?</span>')
    .replace(/(^|[\s>])([^\s<>]+-[^\s<>]+)(?=[\s<]|$)/g, '$1<span class="num">$2</span>');

/* La mascotte : mêmes largeurs et mêmes formats que dans accueil/TroisCases.astro,
   donc les mêmes fichiers (aucune image de plus dans le build). */
const [pouceAvif, pouceWebp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: pouce, format, width: 230, widths: [150, 230, 300, 460] }))
);

/* Dessins : la croix des plis (da.css la fait tourner), la coche des gages, la
   flèche du mode d'emploi (le dessin de accueil/TroisCases.astro). */
const croix =
  '<svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 3v12M3 9h12"/></svg>';
const coche =
  '<svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 9.5l3.5 3.5 7.5-8"/></svg>';
const fleche =
  '<span class="fl"><span class="sr">→</span><svg viewBox="0 0 16 12" width="16" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 6h12.5M9.5 1.5 14 6l-4.5 4.5"/></svg></span>';
---

<BaseLayout title={title} description={description} path={path} ogImage="/lovable-uploads/Hero-simulateur.png" ogImageWidth={1964} ogImageHeight={1287} jsonLd={jsonLd} bodyClass="da-fond">
  <Fragment slot="head">
    {/* Barre du navigateur mobile : le ciel de la DA (jeton sky-1), comme l'accueil. */}
    <meta name="theme-color" content="#C9DEFF" />
  </Fragment>
  {/* La pastille survole le ciel du premier bloc, qui lui réserve le haut. */}
  <Header />

  <main>
    <div class="tete da-bloc">
      <div class="wrap">
        <!-- Titre de la page (statique) -->
        <section class="band-head intro">
          {/* « Super-Net » sur du jaune, comme partout dans la DA. Les <span class="num">
               ne changent pas le texte : ils gardent le « : » sur la ligne du mot. */}
          <h1 class="aff">Simulateur <span class="num"><span class="hl">Super-Net</span> :</span> ton revenu net de médecin</h1>

          <p class="lead">
            Renseigne ta situation en 2 min, découvre <strong>ce qu'il te reste vraiment</strong> après charges et impôts, et laisse le simulateur te montrer <strong>le régime le plus rentable</strong> entre Micro-BNC et Réel.
          </p>

          <div class="gages">
            {trustBadges.map((label) => (
              <div class="gage">
                <Fragment set:html={coche} />
                <span>{label}</span>
              </div>
            ))}
          </div>
        </section>

        {/* Îlot React — formulaire + résultats, hydraté à la vue. Le <div> porte la
            mascotte (décor, à partir de 1 024 px) : elle se tient derrière le haut de
            l'îlot, coupée à mi-corps. */}
        <div class="outil">
          <picture class="guide">
            <source type="image/avif" srcset={pouceAvif.srcSet.attribute} sizes="190px" />
            <img src={pouceWebp.src} srcset={pouceWebp.srcSet.attribute} sizes="190px" alt="" width={pouceWebp.attributes.width} height={pouceWebp.attributes.height} loading="lazy" decoding="async" />
          </picture>
          <h2 class="sr">Ta simulation Super-Net</h2>
          <SimulateurApp client:visible />
        </div>

        {/* Prise de rendez-vous — juste après le résultat, l'endroit de plus forte
            intention du site : `cta_simulator` est le lien le plus cliqué de la
            landing (20 clics contre 17 pour l'inscription), et le simulateur tourne
            (92 utilisations en 21 jours). Quelqu'un qui vient de voir son super-net a
            un chiffre concret et une question précise sur SA situation. */}
        <section class="rdv">
          <div class="rdv-fiche">
            {/* Formulation valable AVANT comme APRÈS la simulation : le bloc est placé
                sous l'îlot, donc visible dès le chargement, avant qu'aucun chiffre
                n'existe. « Ce chiffre te surprend ? » n'aurait alors eu aucun sens. */}
            <p class="rdv-t">Un doute sur ton <span class="num">chiffre ?</span></p>
            <p class="rdv-p">
              Ton super-net dépend de ton régime, de tes charges et de ton mode d'exercice.
            En 15 minutes, Ryan — médecin remplaçant — te montre comment il suit ses propres
            chiffres au quotidien, et répond à tes questions. En visio, ou il t'appelle.
            </p>
            <a
              href={CALENDLY_URL}
              data-calendly="simulateur_resultat"
              target="_blank"
              rel="noopener"
              class="btn btn-line"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18"/><rect width="18" height="18" x="3" y="4" rx="2"/></svg>
              <span>Prendre 15 min avec Ryan</span>
            </a>
          </div>
        </section>
      </div>
    </div>

    <!-- Section explicative statique (SEO) — contenu de SimulateurGuide.tsx (SPA source),
         porté en <details>/<summary> natif : un accordéon Radix fermé ne livre pas son
         texte au HTML statique, ce qui casserait l'indexation. -->
    <section class="band da-bloc" aria-labelledby="guide-title">
      <div class="wrap cote">
        <div class="band-head">
          <p class="sur">Mode d'emploi</p>
          <h2 id="guide-title">
            Comment utiliser le simulateur
          </h2>
          <p class="lead">
            8 points pour comprendre chaque champ et chaque résultat.
          </p>
        </div>

        <div class="liste">
        <details class="qa">
          <summary>
            <span class="qa-t">1. C'est quoi le <span class="num">Super-Net ?</span></span>
            <span class="sr" aria-hidden="true">+</span><Fragment set:html={croix} />
          </summary>
          <div class="qa-in">
            <p>
              Ce simulateur compare <strong>Micro-BNC</strong> et <strong>Régime Réel</strong> pour calculer ton <strong>Super-Net</strong> : ce qu'il te reste vraiment après cotisations sociales ET impôt sur le revenu. En 2 minutes, tu sais quel régime te laisse le plus en poche.
            </p>
          </div>
        </details>

        <details class="qa">
          <summary>
            <span class="qa-t">2. Tes revenus — les champs essentiels</span>
            <span class="sr" aria-hidden="true">+</span><Fragment set:html={croix} />
          </summary>
          <div class="qa-in">
            <ul>
              <li>
                <strong>Tes revenus libéraux</strong> — Total <em>annuel</em> de tous tes honoraires encaissés (consultations, actes techniques, dépassements, PDSA). Retrouve-le sur ton relevé SNIR ou ta comptabilité.
              </li>
              <li>
                <strong>Tes charges réelles</strong> — Dépenses professionnelles déductibles : loyer, matériel, RCP, comptable, véhicule, formations. <strong>Hors cotisations sociales</strong> (URSSAF et CARMF sont calculées automatiquement). Déduites de l'impôt en Régime Réel uniquement — en Micro-BNC, un abattement forfaitaire de 34% les remplace pour l'impôt. Payées dans les deux cas, elles sont retirées de ton Super-Net dans les deux régimes.
              </li>
              <li>
                <strong>Revenus complémentaires</strong> (dépliable) :
                <ul>
                  <li><em>Revenus salariés</em> — Net imposable annuel si tu cumules hôpital ou gardes salariées. L'abattement de 10% est appliqué automatiquement.</li>
                  <li><em>Revenus PDSA</em> — Gardes de nuit et week-end régulées par l'ARS. Astreintes et majorations exonérées d'impôt sur le revenu en zone sous-dotée, dans la limite de 60 jours par an (art. 151 ter CGI), mais soumises aux cotisations sociales.</li>
                </ul>
              </li>
            </ul>
          </div>
        </details>

        <details class="qa">
          <summary>
            <span class="qa-t">3. Ta situation fiscale</span>
            <span class="sr" aria-hidden="true">+</span><Fragment set:html={croix} />
          </summary>
          <div class="qa-in">
            <ul>
              <li><strong>Situation familiale</strong> — Célibataire, marié/pacsé, veuf ou parent isolé. Détermine ton nombre de parts fiscales et donc ton quotient familial.</li>
              <li><strong>Enfants à charge</strong> — Chaque enfant augmente ton quotient familial. Demi-parts possibles (ex : garde alternée = 0.5 part).</li>
              <li><strong>Revenus du conjoint</strong> (apparaît si marié/pacsé) — Net imposable annuel + type de revenu (salarié, libéral micro, libéral réel, autre). Impact direct sur le taux marginal d'imposition du foyer.</li>
            </ul>
          </div>
        </details>

        <details class="qa">
          <summary>
            <span class="qa-t">4. Paramètres de calcul</span>
            <span class="sr" aria-hidden="true">+</span><Fragment set:html={croix} />
          </summary>
          <div class="qa-in">
            <ul>
              <li><strong>Année</strong> — Détermine les barèmes IR appliqués (2025 ou 2026).</li>
              <li><strong>Lieu d'exercice</strong> — Métropole ou DOM-TOM. Les territoires ultramarins bénéficient d'un abattement automatique sur l'IR (30% Guadeloupe/Martinique/Réunion, 40% Guyane/Mayotte).</li>
              <li><strong>Secteur conventionnel</strong> — Secteur 1 (tarifs Sécu ; déductions supplémentaires 2% + 3% + Groupe III pour les installés) ou Secteur 2 (honoraires libres, pas de déductions S1).</li>
              <li><strong>Régime social</strong> — Auto (recommandé, le simulateur choisit selon ton CA), RSPM (simplifié, ouvert jusqu'à 19 000 €) ou PAMC (classique).</li>
            </ul>
          </div>
        </details>

        <details class="qa">
          <summary>
            <span class="qa-t">5. Options avancées — pour affiner</span>
            <span class="sr" aria-hidden="true">+</span><Fragment set:html={croix} />
          </summary>
          <div class="qa-in">
            <div>
              <p class="st">Retraite &amp; CARMF</p>
              <ul>
                <li><strong>Affilié (régime normal)</strong> — C'est le cas le plus courant. Tu paies l'ensemble des cotisations CARMF : retraite de base, retraite complémentaire, ASV (allocations supplémentaires vieillesse) et invalidité-décès (RID).</li>
                <li><strong>Affilié &lt; 2 ans, &lt; 40 ans</strong> — Si tu viens de t'installer et que tu as moins de 40 ans, tu es <em>exonéré de la cotisation complémentaire</em> pendant tes 2 premières années. Tes cotisations sont donc réduites (montants forfaitaires). C'est un vrai coup de pouce au démarrage.</li>
                <li><strong>Dispensé</strong> — Sur demande à la CARMF, généralement pour des revenus faibles (démarche non automatique, à effectuer auprès de la caisse).</li>
                <li><strong>Taux RID</strong> — L'invalidité-décès peut être cotisée à 25% (couverture minimale) ou 100% (couverture complète). Par défaut, le simulateur utilise 100%.</li>
              </ul>
            </div>
            <div>
              <p class="st">Déductions Secteur 1</p>
              <ul>
                <li><strong>Forfait 2%</strong> — Frais de représentation, réception et prospection déduits automatiquement de tes honoraires, sans justificatif. <em>Installés en secteur 1 uniquement (pas les remplaçants).</em></li>
                <li><strong>Déduction 3% conventionnelle</strong> — 3 % de tes honoraires conventionnels, en plus. <em>Installés en secteur 1 uniquement.</em></li>
                <li><strong>Barème Groupe III</strong> — Une déduction fixe selon tes honoraires conventionnels (de 770 € à 3 050 €, 3 050 € au-delà de 30 450 €), en plus des 2% et 3%. <em>Installés en secteur 1 uniquement.</em></li>
                <li><strong>Ratio honoraires non conventionnés</strong> — Si une partie de tes honoraires est hors convention, les déductions S1 sont réduites proportionnellement.</li>
              </ul>
            </div>
            <div>
              <p class="st">Cotisations volontaires</p>
              <ul>
                <li><strong>PER (Plan d'Épargne Retraite)</strong> — Tes versements sont déductibles de ton revenu imposable. Fonctionne en <em>Micro-BNC et en Réel</em>.</li>
                <li><strong>Madelin (prévoyance/retraite)</strong> — Cotisations complémentaires déductibles de ton bénéfice. <em>Régime Réel uniquement.</em></li>
                <li><strong>Chèques-vacances ANCV</strong> — Déductibles de ton BNC dans la limite d'1 SMIC mensuel par an : <strong>{cvPlafond2024.toLocaleString('fr-FR')} € en 2024</strong>, <strong>{cvPlafond2025.toLocaleString('fr-FR')} € en 2025</strong>, <strong>{cvPlafond2026.toLocaleString('fr-FR')} € en 2026</strong> (SMIC au 1er janvier). <em>Régime Réel uniquement</em> (sans effet en Micro-BNC). Si tu as des salariés, tu dois aussi leur proposer le dispositif.</li>
              </ul>
            </div>
            <div>
              <p class="st">Fiscalité immobilière &amp; zones</p>
              <ul>
                <li><strong>Zones exonérées (ZFU-TE, QPV, FRR)</strong> — Si tu t'es installé dans une zone prioritaire, une partie de ton bénéfice est exonérée d'impôt sur 8 ans (100 % les 5 premières années). Dégressivité selon la zone : <strong>ZFU-TE</strong> (installations jusqu'en 2025, plafond de 50 000 € de bénéfice exonéré par an) et <strong>QPV</strong> (installations de 2026 à 2030) <Fragment set:html={fleche} /> 60 % / 40 % / 20 % ; <strong>FRR</strong> (ex-ZRR) <Fragment set:html={fleche} /> 75 % / 50 % / 25 %. La FRR socle exige le Régime Réel ; ZFU-TE, QPV et FRR+ valent aussi en Micro-BNC.</li>
                <li><strong>Revenus fonciers</strong> — Si tu as des revenus locatifs : micro-foncier (abattement 30%) ou régime réel (avec possibilité de déduire un déficit foncier jusqu'à −10 700 €/an de ton revenu global).</li>
              </ul>
            </div>
            <div>
              <p class="st">Crédits d'impôt</p>
              <ul>
                <li><strong>Emploi à domicile</strong> — 50% des dépenses (ménage, garde, jardinage…), plafond de 12 000 à 15 000 €. Comme tout crédit d'impôt, la part qui dépasse ton impôt t'est remboursée.</li>
                <li><strong>Garde d'enfant &lt; 6 ans (hors domicile)</strong> — 50% des frais de crèche ou assistante maternelle, plafond de 3 500 € par enfant.</li>
                <li><strong>Autres crédits</strong> — Un champ libre pour tout autre crédit d'impôt dont tu bénéficies.</li>
              </ul>
            </div>
          </div>
        </details>

        <details class="qa">
          <summary>
            <span class="qa-t">6. Comprendre les résultats</span>
            <span class="sr" aria-hidden="true">+</span><Fragment set:html={croix} />
          </summary>
          <div class="qa-in">
            <ul>
              <li><strong>Les 2 cartes</strong> — Micro-BNC (abattement 34%) vs Régime Réel (charges réelles + optimisations). Chacune affiche un mini-donut et ton Super-Net mensuel et annuel.</li>
              <li><strong>Le badge « Recommandé »</strong> — Indique le régime qui te laisse le plus en poche.</li>
              <li><strong>Le Super-Net</strong> — Le montant final après TOUT : charges, cotisations, impôt. C'est LE chiffre qui compte.</li>
              <li><strong>« Approfondir »</strong> — Détails ligne par ligne : donut de répartition, comparaison des deux régimes, modalités de prélèvement (source, acomptes, régularisation).</li>
            </ul>
          </div>
        </details>

        <details class="qa">
          <summary>
            <span class="qa-t">7. Comment est calculé ton <span class="num">Super-Net ?</span></span>
            <span class="sr" aria-hidden="true">+</span><Fragment set:html={croix} />
          </summary>
          <div class="qa-in">
            <p>Le Super-Net, c'est ce qu'il te reste <strong>vraiment</strong> en poche après tout. Voici le calcul, étape par étape :</p>
            <ol>
              <li><strong>Tes revenus libéraux</strong> — Le total de tout ce que tu as encaissé dans l'année (honoraires, actes, dépassements).</li>
              <li><strong>− Tes charges</strong> — En <em>Régime Réel</em>, on soustrait tes dépenses professionnelles réelles (loyer, matériel, véhicule…). En <em>Micro-BNC</em>, l'État applique à la place un abattement forfaitaire de 34% (tes charges, payées, restent retirées du Super-Net). <Fragment set:html={fleche} /> Ça donne ton <strong>bénéfice</strong>.</li>
              <li><strong>− Cotisations sociales</strong> — URSSAF (maladie, allocations familiales, retraite de base, CSG-CRDS) + CARMF (retraite complémentaire, invalidité-décès, ASV). Le simulateur les calcule automatiquement selon tes revenus et ta situation CARMF (voir point 5). Elles sont déductibles en <em>Régime Réel</em> (sauf une part de la CSG-CRDS) ; en <em>Micro-BNC</em>, l'abattement de 34% en tient lieu.</li>
              <li><strong>− Déductions fiscales</strong> — Si tu es installé en Secteur 1 : forfait 2%, déduction 3%, barème Groupe III. Puis PER, Madelin, chèques-vacances, zones exonérées… <Fragment set:html={fleche} /> Ça donne ton <strong>revenu imposable libéral</strong>.</li>
              <li><strong>+ Autres revenus du foyer</strong> — On ajoute les salaires (après abattement 10%), les revenus du conjoint, les revenus fonciers. <Fragment set:html={fleche} /> Ça donne le <strong>revenu fiscal du foyer</strong>.</li>
              <li><strong>÷ Parts fiscales</strong> — On divise par ton nombre de parts (selon ta situation familiale et tes enfants) pour obtenir le quotient familial, puis on applique le barème progressif (11%, 30%, 41%, 45%).</li>
              <li><strong>− Crédits d'impôt</strong> — Emploi à domicile, garde d'enfant… Ils viennent réduire directement ton impôt. <Fragment set:html={fleche} /> Ça donne ton <strong>impôt final</strong>.</li>
              <li><strong>= Super-Net</strong> — Revenus − Charges − Cotisations − Impôt = <strong>ce qu'il te reste vraiment</strong>.</li>
            </ol>
            <div class="bref">
              <strong>Micro vs Réel en bref :</strong> En Micro-BNC, un abattement de 34% remplace, pour l'impôt, tes charges ET tes cotisations, que le Régime Réel déduit. Tes charges, elles, sont payées dans les deux régimes. Le simulateur compare les deux pour toi, sur ce qu'il te reste vraiment.
            </div>
          </div>
        </details>

        <details class="qa">
          <summary>
            <span class="qa-t">8. Conseils personnalisés &amp; profils types</span>
            <span class="sr" aria-hidden="true">+</span><Fragment set:html={croix} />
          </summary>
          <div class="qa-in">
            <ul>
              <li><strong>4 piliers</strong> — Budget, Sécurité, Investissement, Optimisation : des recommandations concrètes basées sur TON Super-Net.</li>
              <li><strong>La règle 50/30/20</strong> — Appliquée à ta situation : combien consacrer aux besoins, aux envies et à l'épargne.</li>
              <li><strong>Estimation charges sociales</strong> — Cotisations URSSAF, CARMF et CFE détaillées pour anticiper ta trésorerie.</li>
              <li><strong>Profils types</strong> — Pas envie de tout remplir ? Clique sur un profil type pour pré-remplir le formulaire avec des données réalistes (interne, remplaçant, installé, spécialiste…). Tu peux ensuite ajuster les chiffres avant de lancer la simulation.</li>
            </ul>
          </div>
        </details>
        </div>

        <p class="avis">
          Ce simulateur fournit des estimations basées sur les barèmes en vigueur. Il ne remplace pas l'avis d'un expert-comptable.
        </p>
      </div>
