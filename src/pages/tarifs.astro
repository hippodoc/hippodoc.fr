---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getImage } from 'astro:assets';
import presente from '@/assets/accueil/mascotte-f-presente.webp';
import { SITE_URL, APP_URL, SOFTWARE_APPLICATION_SCHEMA } from '@/lib/site';
import { echapper, nouer } from '@/lib/typo';
import { FAMILLES_INCLUS } from '@/data/inclusOffres';

/**
 * NOUVELLE page (n'existe pas dans la SPA source) — cible « hippodoc prix »,
 * « tarif logiciel médecin remplaçant ». Faits repris de src/config/pricing.ts
 * et FeaturesListModal.tsx de la source (aucun chiffre inventé).
 *
 * Refaite en § 9.gs (MIGRATION.md) : la page reprend la grammaire du bloc
 * tarifs de l'accueil (accueil/Tarifs.astro, épure de § 9.eu) et en est la
 * version dépliée. Chaque chose y est dite une fois.
 * - Le ciel : le titre, une ligne, les trois offres dans l'ordre de l'accueil
 *   (annuel, mensuel, internes), au même format (nom, prix, une ou deux
 *   lignes, bouton), puis quatre garanties (l'essai et la carte bancaire,
 *   l'engagement, la déduction, les syndicats partenaires). Sous 700 px, les
 *   offres Mensuel et Internes sont en grille (le nom à gauche, le prix à
 *   droite) : les trois prix tiennent dans un écran de téléphone.
 * - Une feuille sable : les inclus, rangés en quatre familles sur une feuille
 *   blanche. Les lignes sont celles de FeaturesListModal.tsx, mot pour mot ;
 *   « Abonnement 100 % déductible » en est sorti, dit en entier (« au régime
 *   réel ») dans les garanties, comme sur l'accueil.
 * - Une feuille ciel : les questions, en feuille à lignes (les règles de
 *   accueil/Questions.astro, recopiées ici : `.qa` de da.css reste une fiche).
 * - La scène de fin (le soleil sur l'eau du pied de page), immobile.
 * - Les deux liens d'inscription des offres portent `plan=yearly` et
 *   `plan=monthly`, comme ceux de l'accueil ; leurs `data-track` ne changent
 *   pas (`cta_signup_tarifs_annuel`, `cta_signup_tarifs_mensuel`,
 *   `cta_signup_tarifs_bottom`). Offre des internes (§ 9.gu) : le bouton ouvre
 *   le chat (`tarifs_interne_chat`), l'e-mail reste dans la ligne au-dessus
 *   (`tarifs_interne_mail`).
 * - Carte bancaire : elle EST demandée à l'inscription, rien n'est débité
 *   pendant l'essai (décision 14a du propriétaire). Ne jamais écrire « sans
 *   carte bancaire ».
 * - Aucune classe utilitaire ici : tout est dans la feuille de la page (une
 *   feuille à part, servie à /tarifs seule) et dans da.css.
 * - « ✓ » n'est pas dans la police : dessiné en SVG, le caractère reste dans le
 *   texte, masqué à l'œil (classe `sr`).
 * - Mascotte féminine qui présente (décor), à partir de 1024 px seulement,
 *   derrière la fiche des internes, hors du flux, comme sur l'accueil. Écrite
 *   ici, sans accueil/Mascotte.astro : partagé entre deux pages, le style de ce
 *   composant sortait de la feuille de l'accueil et changeait son HTML.
 * - Corps de texte en rem (ils suivent la taille de police réglée dans le
 *   navigateur), comme sur les autres pages intérieures.
 */

const title = 'Tarif logiciel médecin remplaçant : 29 €/mois | Hippodoc';
const description =
  "Hippodoc coûte 29 €/mois sans engagement, ou 19 €/mois en facturation annuelle (228 €/an, −34 %). Essai gratuit 30 jours, toutes les fonctionnalités incluses.";

const signupUrl = `${APP_URL}/auth?tab=signup`;
const signupAnnuel = `${signupUrl}&plan=yearly`;
const signupMensuel = `${signupUrl}&plan=monthly`;

/* « Inclus dans toutes les offres » : quatre familles, mot pour mot, dans
   src/data/inclusOffres.ts (une source avec le détail des offres de l'accueil,
   § 9.hh). */
const familles = FAMILLES_INCLUS;
/* Les quatre garanties, sous les offres : ce que les visiteurs venaient
   chercher dans les plis (résiliation, carte bancaire, déduction). Phrases
   déjà publiées : le chapô des tarifs de l'accueil, deux réponses de la FAQ de
   cette page, la fiche des internes d'avant § 9.gs. Espace insécable entre
   un nombre et son unité, et dans les guillemets. Dessins : traits de 1,8 px
   sur une grille de 24. */
const garanties = [
  {
    titre: '30 jours gratuits',
    texte: "Ta carte bancaire est demandée à l'inscription, mais rien n'est débité pendant l'essai.",
    dessin: '<rect x="3.5" y="5" width="17" height="15.5" rx="3.5"/><path d="M8 3v4M16 3v4M3.5 10.5h17M9 15.5l2.1 2.1 4-4.2"/>',
  },
  {
    titre: 'Sans engagement en mensuel',
    texte: "Tu peux résilier à tout moment depuis ton espace «\u00a0Abonnement\u00a0». L'offre annuelle est facturée en une fois pour 12\u00a0mois.",
    dessin: '<rect x="4.5" y="10.5" width="15" height="10" rx="3"/><path d="M8.5 10.5V7.6a3.6 3.6 0 0 1 6.9-1.4M12 14.5v2"/>',
  },
  {
    titre: 'Prix TTC, sans frais cachés',
    texte: 'Au régime réel, ton abonnement est un frais professionnel déductible à 100\u00a0%.',
    dessin: '<path d="M6 3.5h12v17l-2.4-1.6-2.4 1.6-1.2-.8-1.2.8-2.4-1.6L6 20.5zM9.5 8.5h5M9.5 12h5"/>',
  },
  {
    titre: "Syndicat d'internes partenaire",
    texte: 'Ton essai gratuit dure 6\u00a0mois au lieu de 30\u00a0jours, grâce à un code fourni par ton syndicat.',
    dessin: '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19.5c.6-3.4 2.9-5.3 6-5.3s5.4 1.9 6 5.3M15.6 5.6a3 3 0 0 1 0 5.8M17.4 14.6c2 .6 3.2 2.2 3.6 4.9"/>',
  },
];

const faqTarifs = [
  {
    question: 'Combien coûte Hippodoc ?',
    answer:
      "Hippodoc coûte 29 € par mois sans engagement, ou 19 € par mois en facturation annuelle (228 € facturés une fois par an, soit 34 % d'économie). Les deux offres commencent par un essai gratuit de 30 jours.",
  },
  {
    question: 'Puis-je résilier à tout moment ?',
    answer:
      "Oui. L'offre mensuelle est sans engagement : tu peux résilier à tout moment depuis ton espace « Abonnement », la résiliation prend effet à la fin de la période en cours. L'offre annuelle est facturée en une fois pour 12 mois.",
  },
  {
    question: "L'abonnement Hippodoc est-il déductible en frais professionnels ?",
    answer:
      "Oui. Au régime réel (déclaration 2035), ton abonnement Hippodoc est un frais professionnel déductible à 100 %. En Micro-BNC, tu ne déduis pas tes frais individuellement : l'abattement forfaitaire de 34 % les couvre.",
  },
  {
    question: "Comment fonctionne l'essai gratuit de 30 jours ?",
    answer:
      "Tu crées ton compte sur app.hippodoc.fr, tu choisis l'offre mensuelle ou annuelle à l'inscription, et tu profites de 30 jours d'essai gratuit avec toutes les fonctionnalités. Ta carte bancaire est demandée, mais rien n'est débité pendant l'essai.",
  },
  {
    question: "Y a-t-il des fonctionnalités payantes en plus ?",
    answer:
      "Non. Toutes les fonctionnalités sont incluses dans toutes les offres : Super-Net, URSSAF, CARMF, déclarations guidées, contrats, factures, planning, statistiques et support. Seule la période de facturation change entre les deux offres.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqTarifs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Tarifs', item: `${SITE_URL}/tarifs` },
  ],
};

const jsonLd = [SOFTWARE_APPLICATION_SCHEMA, faqSchema, breadcrumbSchema];

/* Questions et réponses à l'écran : pas un caractère ne change (le schéma et
   l'écran restent égaux), mais un nombre et son unité, un mot et la ponctuation
   qui le suit, un guillemet et son mot, un mot à traits d'union tiennent
   ensemble (`.num`). Sur téléphone, « espace « » finissait une ligne et
   « Abonnement » » commençait la suivante ; à 320 px, « est-il » se coupait
   après « est- ». Dans la feuille des questions, `.num` est un bloc en ligne (il
   se coupe s'il est plus large que la feuille, qui rogne ce qui dépasse) : la
   parenthèse qui le précède et le point ou la virgule qui le suivent entrent
   dedans, sinon ils pourraient rester seuls sur une ligne. */
const lier = (texte: string) =>
  nouer(echapper(texte).replace(/[\wÀ-ÿ]+(?:-[\wÀ-ÿ]+)+|\d+ (?:€|%|mois|jours)/g, '<span class="num">$&</span>'))
    .replace(/\(<span class="num">/g, '<span class="num">(')
    .replace(/<\/span>([.,;)]+)/g, '$1</span>');

/* La mascotte : mêmes largeurs et mêmes formats que dans accueil/Tarifs.astro,
   donc les mêmes fichiers (aucune image de plus dans le build). */
const [mascotteAvif, mascotteWebp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: presente, format, width: 375, widths: [250, 375, 500] }))
);

/* La coche des listes : le dessin de accueil/Tarifs.astro. */
const coche =
  '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 9.5l3.5 3.5 7.5-8"/></svg>';
---

<BaseLayout title={title} description={description} path="/tarifs" jsonLd={jsonLd} bodyClass="da-fond">
  <Fragment slot="head">
    {/* Barre du navigateur mobile : le ciel de la DA (jeton sky-1), comme l'accueil. */}
    <meta name="theme-color" content="#C9DEFF" />
  </Fragment>
  {/* La pastille survole le ciel du premier bloc, qui lui réserve le haut. */}
  <Header />
  <main>
    <div class="tete da-bloc">
      <div class="wrap">
        <header class="band-head intro">
          {/* Les <span class="num"> de la page ne changent pas le texte : ils gardent sur
               une ligne un mot et le « : » ou le « ? » qui le suit. Le titre se coupe
               après « Hippodoc : ». « à un prix humain » est un bloc en ligne : il
               passe entier à la ligne suivante s'il ne tient pas après « un outil
               pro, » (téléphone), et se coupe seulement s'il est plus large que
               la page (insécable, il la poussait de côté à 320 px avec
               l'espacement du texte agrandi). */}
          <h1 class="aff">Tarifs <span class="num">Hippodoc :</span> <span class="suite">un outil pro, <span class="fin-titre">à un prix humain</span></span></h1>
          <p class="lead">Tout est inclus dans chaque offre. Seule la période de facturation change.</p>
        </header>

        {/* Les trois offres, dans l'ordre et au format de l'accueil. */}
        <div class="plans">
          <div class="offer main">
            <h2 id="offre-annuel">Annuel</h2>
            <p class="price"><b class="aff num">19 €</b>{' '}<span>par mois</span></p>
            <p>228 € facturés une fois par an</p>
            <p class="save"><span>120 € de moins par an que le mensuel</span></p>
            <a
              href={signupAnnuel}
              data-track="cta_signup_tarifs_annuel"
              class="btn btn-brand"
              aria-describedby="offre-annuel"
            >
              Commencer 30 jours gratuits
            </a>
          </div>

          <div class="offer">
            <h2 id="offre-mensuel">Mensuel</h2>
            <p class="price"><b class="aff num">29 €</b>{' '}<span>par mois</span></p>
            <p>Sans engagement</p>
            <a
              href={signupMensuel}
              data-track="cta_signup_tarifs_mensuel"
              class="btn btn-line"
              aria-describedby="offre-mensuel"
            >
              Commencer 30 jours gratuits
            </a>
          </div>

          {/* Internes (décision 13 du propriétaire, 10 novembre 2026). L'essai de
               6 mois des syndicats partenaires (décision 14) est dans les garanties.
               Pas de cumul annoncé, pas de liste de syndicats : /faq la tient. */}
          <section class="offer interne" aria-labelledby="internes-title">
            <picture class="guide">
              <source type="image/avif" srcset={mascotteAvif.srcSet.attribute} sizes="250px" />
              <img src={mascotteWebp.src} srcset={mascotteWebp.srcSet.attribute} sizes="250px" alt="" width={mascotteWebp.attributes.width} height={mascotteWebp.attributes.height} loading="lazy" decoding="async" />
            </picture>
            <h2 id="internes-title">Interne et docteur junior</h2>
            <p class="price"><b class="aff num">10 €</b>{' '}<span>par mois</span></p>
            <p>Jusqu'à la fin de l'internat</p>
            {/* « par chat ou e-mail » passe entier à la ligne : « e-mail » restait seul
                 sur la sienne (téléphone, 1 024 px). */}
            <p>Sur justificatif, <span class="fin-titre">par chat ou <a href="mailto:contact@hippodoc.fr" data-ph="tarifs_interne_mail" class="lien">e-mail</a></span></p>
            {/* Ouvre le chat (`data-ouvre-chat`, ThirdPartyScripts.astro, § 9.gu) : le
                 justificatif s'y envoie en pièce jointe. Sans script, le lien reste
                 celui de l'adresse e-mail. */}
            <a href="mailto:contact@hippodoc.fr" data-ouvre-chat data-ph="tarifs_interne_chat" class="btn btn-line">Envoyer mon justificatif</a>
          </section>
        </div>

        <ul class="surs" role="list">
          {garanties.map((g) => (
            <li>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={g.dessin} />
              <div>
                <strong>{g.titre}</strong>
                <p>{g.texte}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <section class="band da-bloc" aria-labelledby="inclus-title">
      <div class="wrap">
        <div class="band-head">
          <h2 id="inclus-title">Inclus dans toutes les offres</h2>
        </div>
        <div class="familles">
          {familles.map((f) => (
            <div class="famille">
              <h3>{f.titre}</h3>
              <ul class="checks" role="list">
                {f.lignes.map((l) => (
                  <li>
                    <span class="sr" aria-hidden="true">✓</span><Fragment set:html={coche} />
                    {l}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="band air da-bloc" aria-labelledby="faq-tarifs-title">
      <div class="wrap faq">
        <div class="band-head">
          <h2 id="faq-tarifs-title">Questions fréquentes sur les tarifs</h2>
        </div>
        <div class="liste">
          {faqTarifs.map((item) => (
            <details class="qa">
              <summary>
                <span class="qa-t" set:html={lier(item.question)} />
                <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 3v12M3 9h12"/></svg>
              </summary>
              <div class="qa-in"><p set:html={lier(item.answer)} /></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="fin da-bloc">
      <div class="wrap fin-copy">
        <h2>Essaie Hippodoc gratuitement pendant 30 jours</h2>
        <p class="lead">Le logiciel des médecins remplaçants qui calcule tout pour toi.</p>
        <a
          href={signupUrl}
          data-track="cta_signup_tarifs_bottom"
          class="btn btn-brand"
        >
          Créer mon compte
        </a>
        <p class="aide">
          Une <span class="num">question ?</span> <a href="/faq" class="lien">Consulte la FAQ</a> ou <a href="mailto:contact@hippodoc.fr" class="lien">écris-nous</a>.
        </p>
      </div>
      {/* Décor : le soleil de l'accueil se lève sur l'eau du pied de page. */}
      <div class="horizon" aria-hidden="true">
        <span class="sun"></span>
        <span class="wave w3"></span>
        <span class="wave w4"></span>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .num { white-space: nowrap; }
  /* Dans la feuille des questions, qui rogne : un bloc en ligne passe entier à
     la ligne suivante, et se coupe s'il est plus large qu'elle (texte grossi). */
  .liste :global(.num) { display: inline-block; }
  .sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Le ciel : le bloc passe sous la pastille de l'en-tête, il lui réserve le
     haut. En bas, l'air de la feuille et les 40 px que recouvre la suivante. */
  .tete { position: relative; padding: 108px 0 112px; background: linear-gradient(var(--sky-1) 0, var(--sky) 460px); }
  /* Corps de texte en rem : la feuille de la DA les pose en px, ils ne suivaient
     plus la taille de police du navigateur. Même rendu à 16 px. */
  .da-bloc { font-size: 1.0625rem; }
  .lead { font-size: 1.1875rem; }
  .btn { font-size: 1.0625rem; }
  .qa-t { font-size: 1.125rem; }
  .qa-in p { font-size: 1.03125rem; }
  h2 { --corps: clamp(min(2rem, 10vw), 4.5vw, 3.625rem); }
  /* Texte grossi : un mot plus large que sa fiche se coupe au lieu de la pousser. */
  .qa-t { min-width: 0; overflow-wrap: anywhere; }
  .intro { margin-bottom: 36px; }
  .intro h1 { --corps: var(--h1-page); }
  .suite { display: block; }
  /* Un bloc en ligne : il passe entier à la ligne suivante, et ne se coupe que
     s'il est plus large que sa boîte (fin du titre, fin de la ligne des internes). */
  .fin-titre { display: inline-block; }
  .intro .lead { text-wrap-style: balance; }
  /* Les feuilles : le remplissage de l'épure de l'accueil (§ 9.eu), écrit ici
     et non dans da.css, commune à toutes les pages. */
  .band { padding: 76px 0 112px; }
  .band-head { margin-bottom: 36px; }

  /* Les trois offres : la grammaire de accueil/Tarifs.astro (nom, prix, une ou
     deux lignes, bouton), dans le même ordre. Une colonne bornée : sans elle la
     colonne implicite prend la largeur de son contenu le plus large, et la page
     défile de côté quand le texte est espacé ou grossi. */
  .plans { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .offer { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 28px; border-radius: 30px; background: var(--paper); box-shadow: var(--clay); }
  /* Texte grossi : un nom ou une adresse plus larges que leur fiche se coupent
     au lieu de la pousser. */
  .offer h2 { min-width: 0; margin: 0; font-family: var(--text); font-size: 1.125rem; font-weight: var(--tb); line-height: 1.35; letter-spacing: 0; overflow-wrap: anywhere; }
  .offer p { min-width: 0; margin: 0; font-size: 1rem; color: var(--ink-2); overflow-wrap: anywhere; }
  .offer .price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 8px; }
  .price b { --corps: 4rem; color: var(--ink); }
  /* L'offre annuelle : l'eau profonde, le bouton jaune. */
  .offer.main { --focus: #FFFFFF; background: linear-gradient(var(--deep), #1F4FAF); color: var(--paper); box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.22), inset 0 -5px 0 rgba(10, 25, 70, 0.22), 0 22px 44px -22px rgba(13, 40, 105, 0.6); }
  .offer.main p { color: var(--on-deep-2); }
  .offer.main .price b { color: var(--paper); }
  /* L'économie : un surlignage jaune, pas une pastille. Sur deux lignes (320 px),
     chaque ligne garde son trait arrondi. C'est le seul signal de la fiche. */
  .offer.main .save { line-height: 1.75; text-wrap-style: balance; }
  .save span { padding: 3px 9px; border-radius: 9px; background: var(--sun); color: var(--ink); font-size: 0.90625rem; font-weight: var(--tb); -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  /* Les boutons au pied des fiches, sur une même ligne, libellé sur une ligne. */
  .offer > .btn { min-width: 0; margin-top: auto; padding: 8px 14px; text-align: center; overflow-wrap: anywhere; }
  .offer > p:last-of-type { margin-bottom: 18px; }
  /* La mascotte qui présente les offres : à partir de 1024 px (voir plus bas). */
  .guide { display: none; pointer-events: none; }
  .guide img { display: block; width: 100%; max-width: none; height: auto; }

  /* Les quatre garanties, posées sur le ciel sous les offres : un dessin dans
     une pastille blanche, un titre, une phrase. */
  .surs { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; margin: 30px 0 0; padding: 0 4px; list-style: none; }
  /* `align-content` : sans lui, une case plus courte que sa voisine partage
     la hauteur en trop entre ses rangées, et son titre descend. */
  .surs li { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: start; align-content: start; gap: 0 14px; }
  .surs svg { box-sizing: content-box; padding: 9px; border-radius: 50%; background: var(--paper); box-shadow: var(--clay-sm); color: var(--brand); }
  /* Texte grossi : « Abonnement » et ses guillemets, liés par des espaces
     insécables, se coupent plutôt que de pousser la page de côté. */
  .surs li > div { min-width: 0; overflow-wrap: anywhere; }
  .surs strong { display: block; padding-top: 2px; font-size: 1.0625rem; line-height: 1.35; color: var(--ink); }
  .surs p { margin: 3px 0 0; font-size: 1rem; line-height: 1.5; color: var(--ink-2); text-wrap-style: pretty; }

  /* Inclus dans toutes les offres : une feuille blanche, une rangée par
     famille, un filet entre deux rangées. Sur téléphone, le titre de la
     famille au-dessus de ses lignes ; à partir de 640 px, les lignes sur deux
     colonnes ; à partir de 900 px, le titre à gauche et les lignes à droite. */
  .familles { padding: 4px 24px; border-radius: 30px; background: var(--paper); box-shadow: var(--clay); }
  .famille { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px 40px; padding: 20px 0 22px; }
  .famille + .famille { border-top: 1px solid var(--line); }
