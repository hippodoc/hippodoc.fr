---
/**
 * Page de série du blog — `/blog/serie/<slug>`.
 *
 * Remplace le filtre 100 % CSS de /blog, qui ne laissait aucune trace dans l'URL :
 * une série ne pouvait ni se partager, ni se bookmarker, ni revenir avec le bouton
 * Retour, et surtout n'était indexable nulle part. Trois vraies pages = trois
 * portes d'entrée SEO supplémentaires.
 *
 * Deux segments d'URL (`blog/serie/x`) : aucune collision avec `blog/[slug].astro`,
 * qui n'en matche qu'un. Aucune URL existante n'est renommée (invariant).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BlogCard from '@/components/BlogCard.astro';
import { SITE_URL } from '@/lib/site';
import { blogSeries } from '@/lib/blog-series';
import { SERIES_SLUGS, seriesPath } from '@/lib/blog-series-slugs';
import { resolveCovers } from '@/lib/blog-covers';

export async function getStaticPaths() {
  return blogSeries.map((series) => ({
    params: { series: SERIES_SLUGS[series.id] },
    props: { series },
  }));
}

const { series } = Astro.props;

const posts = (await getCollection('blog'))
  .filter((p) => p.data.seriesId === series.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const covers = await resolveCovers(posts);

const path = seriesPath(series.id);
const title = `${series.name} — Blog Hippodoc`;
const description = `${series.description}. ${posts.length} articles pour médecins remplaçants, écrits par le Dr. Ryan Goburdhun.`;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}${path}#collection`,
  name: title,
  description,
  url: `${SITE_URL}${path}`,
  inLanguage: 'fr-FR',
  isPartOf: { '@id': `${SITE_URL}/blog#blog` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_URL}/blog/${p.id}`,
      name: p.data.title,
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: series.name, item: `${SITE_URL}${path}` },
  ],
};
---

<BaseLayout title={title} description={description} path={path} jsonLd={[collectionSchema, breadcrumbSchema]}>
  <Header />
  <main class="container max-w-6xl px-4 py-10">
    <nav aria-label="Fil d'Ariane" class="mb-6 text-sm text-muted-foreground">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="inline-flex min-h-6 items-center hover:text-hippo-600">Accueil</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/blog" class="inline-flex min-h-6 items-center hover:text-hippo-600">Blog</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-foreground" aria-current="page">{series.name}</li>
      </ol>
    </nav>

    <header class="mx-auto mb-10 max-w-2xl text-center">
      <span class={`series-badge bg-gradient-to-r ${series.color}`}>{series.name}</span>
      {/* Typographie alignée sur le H1 de /blog, mais SANS dégradé : la pastille de
          série juste au-dessus porte déjà sa propre couleur (violet pour la
          fiscalité, orange pour les guides) — un dégradé bleu dessous jurerait. */}
      <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight text-hippo-800 md:text-5xl">{series.name}</h1>
      <p class="mt-3 text-lg text-muted-foreground">{series.description}.</p>
      <p class="mt-2 text-sm text-muted-foreground">
        {posts.length} article{posts.length > 1 ? 's' : ''}{series.totalEpisodes ? ` sur ${series.totalEpisodes} prévus` : ''}
      </p>
    </header>

    <!-- Navigation entre séries : chaque page reste à un clic des autres -->
    <nav aria-label="Séries du blog" class="mb-8 flex flex-wrap justify-center gap-2">
      <a
        href="/blog"
        class="rounded-full border border-hippo-200 px-4 py-2 text-sm font-medium text-hippo-700 transition-colors hover:bg-hippo-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        Tous les articles
      </a>
      {blogSeries.map((s) => (
        <a
          href={seriesPath(s.id)}
          aria-current={s.id === series.id ? 'page' : undefined}
          class:list={[
            'rounded-full border px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring',
            s.id === series.id
              ? 'border-hippo-600 bg-hippo-600 text-white'
              : 'border-hippo-200 text-hippo-700 hover:bg-hippo-50',
          ]}
        >
          {s.name}
        </a>
      ))}
    </nav>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, i) => (
        <BlogCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          readTime={post.data.readTime}
          seriesId={post.data.seriesId}
          episodeNumber={post.data.episodeNumber}
          cover={covers.get(post.id)}
          eager={i === 0}
        />
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
