---
/**
 * Page de série du blog — `/blog/serie/<slug>`.
 *
 * Remplace le filtre 100 % CSS de /blog, qui ne laissait aucune trace dans l'URL :
 * une série ne pouvait ni se partager, ni se bookmarker, ni revenir avec le bouton
 * Retour, et surtout n'était indexable nulle part. Trois vraies pages = trois
 * portes d'entrée SEO supplémentaires.
 *
 * Deux segments d'URL (`blog/serie/x`) : aucune collision avec `blog/[slug].astro`,
 * qui n'en matche qu'un. Aucune URL existante n'est renommée (invariant).
 *
 * Habillée dans la DA 2026 en phase 5c (MIGRATION.md § 9.ej) : seul l'habillage a
 * changé (textes, titres, liens, ordre des blocs, JSON-LD et attributs de mesure
 * sont ceux d'avant). Styles dans `src/styles/blog-liste.css`, la feuille des
 * quatre pages de liste.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BlogCard from '@/components/BlogCard.astro';
import BlogAppel from '@/components/BlogAppel.astro';
import '@/styles/blog-liste.css';
import { SITE_URL } from '@/lib/site';
import { blogSeries } from '@/lib/blog-series';
import { SERIES_SLUGS, SERIES_INTROS, seriesPath } from '@/lib/blog-series-slugs';
import { resolveCovers } from '@/lib/blog-covers';
import { byNewest, byEpisode } from '@/lib/blog-sort';
import { nouer } from '@/lib/typo';

export async function getStaticPaths() {
  return blogSeries.map((series) => ({
    params: { series: SERIES_SLUGS[series.id] },
    props: { series },
  }));
}

const { series } = Astro.props;

const posts = (await getCollection('blog'))
  .filter((p) => p.data.seriesId === series.id)
  /* Séries numérotées : ordre de lecture (#1, #2…) ; Guides & Conseils : plus récent d'abord. */
  .sort(series.totalEpisodes === null ? byNewest : byEpisode);

const covers = await resolveCovers(posts);

const path = seriesPath(series.id);
const title = `${series.name} — Blog Hippodoc`;
const description = `${series.description}. ${posts.length} articles pour médecins remplaçants, écrits par le Dr. Ryan Goburdhun.`;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}${path}#collection`,
  name: title,
  description,
  url: `${SITE_URL}${path}`,
  inLanguage: 'fr-FR',
  isPartOf: { '@id': `${SITE_URL}/blog#blog` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_URL}/blog/${p.id}`,
      name: p.data.title,
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: series.name, item: `${SITE_URL}${path}` },
  ],
};
---

<BaseLayout title={title} description={description} path={path} jsonLd={[collectionSchema, breadcrumbSchema]} bodyClass="da-fond">
  <Fragment slot="head">
    {/* Barre du navigateur mobile : le ciel de la DA (jeton sky-1), comme l'accueil. */}
    <meta name="theme-color" content="#C9DEFF" />
  </Fragment>
  {/* La pastille survole le ciel du premier bloc, qui lui réserve le haut. */}
  <Header variante="flottante" />
  <main class="bl da-bloc" data-blog-serie={series.id} data-blog-total={posts.length}>
    <div class="bl-tete">
      <div class="wrap">
        <nav aria-label="Fil d'Ariane" class="bl-fil">
          <ol role="list">
            <li><a href="/">Accueil</a></li>
            <li aria-hidden="true">›</li>
            <li><a href="/blog">Blog</a></li>
            <li aria-hidden="true">›</li>
            <li aria-current="page">{series.name}</li>
          </ol>
        </nav>

        {/* Le titre à gauche, le texte de la série à droite sur une fiche (l'un sous
             l'autre jusqu'à 1024 px). */}
        <div class="bl-presentation">
          <header class="bl-intro">
            {/* La pastille blanche de la série, comme en tête des articles. */}
            <span class="bl-pastille">{series.name}</span>
            <h1 class="aff">{series.name}</h1>
            <p class="lead">{series.description}.</p>
            <p class="bl-compte">
              {posts.length} article{posts.length > 1 ? 's' : ''}
            </p>
          </header>

          {/* Texte propre à la page : sans lui, une page de série n'avait qu'une seule
              phrase à elle pour ~280 mots au total, le reste étant les cartes et la
              navigation, communes à toutes. Voir SERIES_INTROS. Les <strong> restent
              en encre : le bleu est réservé aux vrais liens. */}
          {SERIES_INTROS[series.id] && (
            <div class="bl-texte" set:html={nouer(SERIES_INTROS[series.id])} />
          )}
        </div>

        <!-- Navigation entre séries : chaque page reste à un clic des autres -->
        <nav aria-label="Séries du blog" class="bl-series">
          <a href="/blog">
            Tous les articles
          </a>
          {blogSeries.map((s) => (
            <a href={seriesPath(s.id)} aria-current={s.id === series.id ? 'page' : undefined}>
              {s.name}
            </a>
          ))}
        </nav>
      </div>
    </div>

    {/* Feuille sable : les cartes de la série, puis l'appel au simulateur. */}
    <div class="band bl-fin">
      <div class="wrap">
        <div class="bl-grille">
          {posts.map((post, i) => (
            <BlogCard
              slug={post.id}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              readTime={post.data.readTime}
              seriesId={post.data.seriesId}
              episodeNumber={post.data.episodeNumber}
              cover={covers.get(post.id)}
              eager={i === 0}
            />
          ))}
        </div>

        <div class="bl-appel-place">
          <BlogAppel emplacement="blog_serie" />
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
