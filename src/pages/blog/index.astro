---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_URL } from '@/lib/site';
import { blogSeries } from '@/lib/blog-series';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const blogImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/blog/**/*.{png,jpg,jpeg,webp}',
  { eager: true }
);

const covers = new Map<string, { src: string; width: number; height: number }>();
for (const post of posts) {
  const assetPath = post.data.cover.replace(/^\/blog\//, '/src/assets/blog/');
  const mod = blogImages[assetPath];
  if (mod) {
    const img = await getImage({ src: mod.default, width: 640, format: 'webp' });
    covers.set(post.id, {
      src: img.src,
      width: Number(img.attributes.width),
      height: Number(img.attributes.height),
    });
  }
}

const formatDate = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const seriesCounts = new Map<string, number>(
  blogSeries.map((s) => [s.id, posts.filter((p) => p.data.seriesId === s.id).length])
);

const title = 'Blog Hippodoc — Conseils pour médecins remplaçants';
const description = `${posts.length} articles pratiques pour médecins remplaçants : fiscalité, cotisations, guides et conseils d'experts.`;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE_URL}/blog#blog`,
  name: 'Blog Hippodoc',
  description,
  url: `${SITE_URL}/blog`,
  inLanguage: 'fr-FR',
  publisher: { '@id': `${SITE_URL}/#organization` },
  blogPost: posts.slice(0, 10).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `${SITE_URL}/blog/${p.id}`,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---

<BaseLayout title={title} description={description} path="/blog" jsonLd={[blogSchema]}>
  <Header />
  <main class="container px-4 py-10">
    <header class="mx-auto mb-10 max-w-2xl text-center">
      <h1 class="text-3xl font-bold text-foreground md:text-4xl">Le blog des médecins remplaçants</h1>
      <p class="mt-3 text-lg text-muted-foreground">
        {posts.length} fiches pratiques sur la fiscalité, les cotisations URSSAF et CARMF, les contrats et la vie du remplaçant — écrites par le Dr. Ryan Goburdhun, médecin et fondateur d'Hippodoc.
      </p>
    </header>

    <!-- Filtre par série, 100 % CSS (radios + sélecteurs) -->
    <div class="blog-filter">
      <input type="radio" name="series-filter" id="filter-tous" class="sr-only" checked />
      <input type="radio" name="series-filter" id="filter-fiche-pratique" class="sr-only" />
      <input type="radio" name="series-filter" id="filter-fiche-fiscalite" class="sr-only" />
      <input type="radio" name="series-filter" id="filter-divers" class="sr-only" />

      <div class="mb-8 flex flex-wrap justify-center gap-2">
        <label for="filter-tous" class="filter-btn cursor-pointer rounded-full border border-hippo-200 px-4 py-2 text-sm font-medium text-hippo-700 transition-colors hover:bg-hippo-50">
          Tous les articles <span class="text-hippo-400">({posts.length})</span>
        </label>
        {blogSeries.map((s) => (
          <label for={`filter-${s.id}`} class="filter-btn cursor-pointer rounded-full border border-hippo-200 px-4 py-2 text-sm font-medium text-hippo-700 transition-colors hover:bg-hippo-50">
            {s.name} <span class="text-hippo-400">({seriesCounts.get(s.id)}{s.totalEpisodes ? `/${s.totalEpisodes}` : ''})</span>
          </label>
        ))}
      </div>

      <div class="blog-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => {
          const series = blogSeries.find((s) => s.id === post.data.seriesId);
          const cover = covers.get(post.id);
          return (
            <article class={`blog-card s-${post.data.seriesId} blog-card-hover overflow-hidden rounded-2xl border border-hippo-100 bg-white shadow-sm`}>
              <a href={`/blog/${post.id}`} class="block">
                {cover && (
                  <img
                    src={cover.src}
                    alt=""
                    width={cover.width}
                    height={cover.height}
                    class="aspect-[16/9] w-full object-cover"
                    loading="lazy"
                  />
                )}
                <div class="p-5">
                  <div class="mb-2 flex items-center gap-2">
                    {series && (
                      <span class={`series-badge bg-gradient-to-r ${series.color}`}>{series.name}</span>
                    )}
                    {post.data.episodeNumber !== undefined && post.data.seriesId !== 'divers' && (
                      <span class="text-xs text-muted-foreground">#{post.data.episodeNumber}</span>
                    )}
                  </div>
                  <h2 class="text-lg font-bold leading-snug text-foreground">{post.data.title}</h2>
                  <p class="mt-2 line-clamp-3 text-sm text-muted-foreground">{post.data.description}</p>
                  <div class="mt-4 flex items-center justify-between text-xs text-muted-foreground">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                    <span>{post.data.readTime}</span>
                  </div>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* État actif des boutons + filtrage par série, sans JavaScript */
  #filter-tous:checked ~ div label[for='filter-tous'],
  #filter-fiche-pratique:checked ~ div label[for='filter-fiche-pratique'],
  #filter-fiche-fiscalite:checked ~ div label[for='filter-fiche-fiscalite'],
  #filter-divers:checked ~ div label[for='filter-divers'] {
    background-color: theme('colors.hippo.600');
    border-color: theme('colors.hippo.600');
    color: white;
  }
  #filter-fiche-pratique:checked ~ .blog-grid .blog-card:not(.s-fiche-pratique),
  #filter-fiche-fiscalite:checked ~ .blog-grid .blog-card:not(.s-fiche-fiscalite),
  #filter-divers:checked ~ .blog-grid .blog-card:not(.s-divers) {
    display: none;
  }
</style>
