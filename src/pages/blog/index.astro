---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BlogCard from '@/components/BlogCard.astro';
import { SITE_URL } from '@/lib/site';
import { blogSeries } from '@/lib/blog-series';
import { seriesPath } from '@/lib/blog-series-slugs';
import { resolveCover, resolveCovers } from '@/lib/blog-covers';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const covers = await resolveCovers(posts);

/* Mise en avant du dernier article : sans hiérarchie éditoriale, le guide le plus
   stratégique avait exactement le même poids visuel que le plus anecdotique. */
const [featured, ...rest] = posts;
/* Seuls les 9 suivants passent en cartes : les 38 empilées faisaient 19 000 px de
   haut en mobile. Les 38 restent tous accessibles via l'index en bas de page. */
const recents = rest.slice(0, 9);
const featuredSeries = blogSeries.find((s) => s.id === featured.data.seriesId);

/* La cover « à la une » devient l'élément LCP de la page. Servie en 1200 px fixes,
   elle faisait chuter le LCP à 4,1 s (perf 97 → 87). Elle s'affiche au plus sur la
   moitié d'un conteneur de 1152 px : deux largeurs en srcset suffisent, l'une pour
   le mobile, l'autre pour le desktop en densité 2x. */
const featuredCover = await resolveCover(featured.data.cover, 1024);
const featuredCoverSmall = await resolveCover(featured.data.cover, 640);

const formatDate = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const seriesCounts = new Map<string, number>(
  blogSeries.map((s) => [s.id, posts.filter((p) => p.data.seriesId === s.id).length])
);

const title = 'Blog Hippodoc — Conseils pour médecins remplaçants';
const description = `${posts.length} articles pratiques pour médecins remplaçants : fiscalité, cotisations, guides et conseils d'experts.`;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE_URL}/blog#blog`,
  name: 'Blog Hippodoc',
  description,
  url: `${SITE_URL}/blog`,
  inLanguage: 'fr-FR',
  publisher: { '@id': `${SITE_URL}/#organization` },
  blogPost: posts.slice(0, 10).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `${SITE_URL}/blog/${p.id}`,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---

<BaseLayout title={title} description={description} path="/blog" jsonLd={[blogSchema]}>
  <Header />
  <main class="container px-4 py-10">
    {/* En-tête resserré : la version centrée occupait 492 px avant la première
         carte en mobile, soit un écran entier de texte. Alignée à gauche, phrase
         courte. La signature « écrites par le Dr. Ryan Goburdhun » a été retirée
         d'ici : elle reste sur chaque article (bloc auteur + JSON-LD `Article`),
         où elle porte un signal E-E-A-T réel et vérifiable article par article. */}
    <header class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-b border-hippo-100 pb-6">
      <div>
        {/* Même traitement que le H1 de la landing (HeroSection) : base hippo-800,
            dégradé hippo-500→600 sur le membre de phrase accentué. Le dégradé reste
            réservé aux très grands titres — à cette taille il passe le seuil AA
            « grand texte » (3:1), ce qui ne serait pas le cas en petit corps. */}
        <h1 class="text-4xl font-bold leading-tight tracking-tight text-hippo-800 md:text-5xl">
          Le blog des <span class="bg-gradient-to-r from-hippo-500 to-hippo-600 bg-clip-text text-transparent">médecins remplaçants</span>
        </h1>
        <p class="mt-2 text-lg text-muted-foreground">
          Fiscalité, cotisations URSSAF et CARMF, contrats et vie du remplaçant.
        </p>
      </div>
      <p class="text-sm text-muted-foreground">
        <span class="font-semibold text-hippo-700">{posts.length}</span> fiches pratiques
      </p>
    </header>

    {/* Navigation par série. Anciennement un filtre 100 % CSS (radios + `display:none`)
         qui ne laissait aucune trace dans l'URL : impossible à partager, à mettre en
         favori ou à retrouver avec le bouton Retour, et invisible pour l'indexation.
         Ce sont désormais de vrais liens vers /blog/serie/*, avec le focus clavier
         natif (les radios `sr-only` posaient un problème WCAG 2.4.7). */}
    <nav aria-label="Séries du blog" class="mb-8 flex flex-wrap justify-center gap-2">
      <a
        href="/blog"
        aria-current="page"
        class="rounded-full border border-hippo-600 bg-hippo-600 px-4 py-2 text-sm font-medium text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        {/* Le compteur était en `text-white/80` : 3,85:1 sur hippo-600, sous le seuil
            AA (même /90 ne donne que 4,47). La nuance passe donc par la graisse et
            non par l'opacité — blanc plein = 5,15:1. */}
        Tous les articles <span class="font-normal text-white">({posts.length})</span>
      </a>
      {blogSeries.map((s) => (
        <a
          href={seriesPath(s.id)}
          class="rounded-full border border-hippo-200 px-4 py-2 text-sm font-medium text-hippo-700 transition-colors hover:bg-hippo-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          {s.name} <span class="text-hippo-600">({seriesCounts.get(s.id)})</span>
        </a>
      ))}
    </nav>

    {/* Article mis en avant : pleine largeur, cover en priorité (c'est le LCP
         de la page), pour donner une hiérarchie de lecture dès le premier écran. */}
    <a
      href={`/blog/${featured.id}`}
      class="blog-card-hover mb-10 grid overflow-hidden rounded-2xl border border-hippo-100 bg-white shadow-sm md:grid-cols-2"
    >
      <div class="flex flex-col justify-center p-6 md:p-8">
        <div class="mb-3 flex items-center gap-2">
          <span class="rounded-full bg-hippo-100 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-hippo-700">À la une</span>
          {featuredSeries && <span class={`series-badge bg-gradient-to-r ${featuredSeries.color}`}>{featuredSeries.name}</span>}
        </div>
        <h2 class="text-2xl font-bold leading-snug text-foreground md:text-3xl">{featured.data.title}</h2>
        <p class="mt-3 text-muted-foreground">{featured.data.description}</p>
        <div class="mt-4 flex items-center gap-4 text-xs text-muted-foreground">
          <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
          <span>{featured.data.readTime}</span>
        </div>
      </div>

      {/* L'image vient APRÈS le texte dans le DOM, et reprend la colonne de gauche
           en desktop via `order`. En mobile elle sortait sinon du premier écran et
           devenait l'élément LCP : chargée en priorité, elle faisait tomber la perf
           de 97 à 87 (LCP 4,1 s). Le titre redevient le LCP, et l'image se charge
           en différé sans bloquer le rendu. */}
      {featuredCover && (
        <img
          src={featuredCover.src}
          srcset={featuredCoverSmall ? `${featuredCoverSmall.src} 640w, ${featuredCover.src} 1024w` : undefined}
          sizes="(min-width: 768px) 50vw, 100vw"
          alt=""
          width={featuredCover.width}
          height={featuredCover.height}
          class="aspect-[16/9] w-full object-cover md:order-first md:h-full"
          loading="lazy"
          decoding="async"
        />
      )}
    </a>

    <h2 class="mb-5 text-xl font-bold text-foreground">Derniers articles</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {recents.map((post) => (
        <BlogCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          readTime={post.data.readTime}
          seriesId={post.data.seriesId}
          episodeNumber={post.data.episodeNumber}
          cover={covers.get(post.id)}
        />
      ))}
    </div>

    {/* Index complet. Les 38 cartes empilées faisaient 19 000 px de haut en mobile
         et n'offraient aucun moyen de repérer un sujet précis : on ne pouvait que
         faire défiler. Cette liste donne les 38 titres d'un coup d'œil, groupés par
         série. Toujours visible (pas de <details>) pour rester scannable et
         indexable, en trois colonnes sur grand écran. */}
    <section class="mt-16 border-t border-hippo-100 pt-10" aria-labelledby="index-titre">
      <h2 id="index-titre" class="text-xl font-bold text-foreground">Tous les articles</h2>
      <p class="mt-1 text-sm text-muted-foreground">Les {posts.length} fiches, classées par série.</p>

      <div class="mt-8 grid gap-x-10 gap-y-9 lg:grid-cols-3">
        {blogSeries.map((s) => (
          <div>
            <h3 class="flex items-baseline gap-2 border-b border-hippo-100 pb-2">
              <a href={seriesPath(s.id)} class="font-semibold text-hippo-700 hover:text-hippo-800">{s.name}</a>
              <span class="text-xs font-normal text-muted-foreground">{seriesCounts.get(s.id)}</span>
            </h3>
            <ul class="mt-3 space-y-1">
              {posts
                .filter((p) => p.data.seriesId === s.id)
                .map((p) => (
                  <li>
                    <a
                      href={`/blog/${p.id}`}
                      class="flex items-baseline justify-between gap-3 rounded-md py-1.5 text-sm leading-snug text-foreground transition-colors hover:text-hippo-700"
                    >
                      <span>{p.data.title}</span>
                      <span class="shrink-0 text-xs tabular-nums text-muted-foreground">{p.data.readTime}</span>
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
