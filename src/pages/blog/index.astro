---
/**
 * /blog : la liste des articles.
 *
 * Habillée dans la DA 2026 en phase 5c (MIGRATION.md § 9.ej) : seul l'habillage a
 * changé. Textes, titres, liens, ordre des blocs, JSON-LD, identifiants et
 * attributs de mesure sont ceux d'avant (période d'observation SEO) ; le script
 * de la recherche, en bas de ce fichier, n'a pas bougé.
 * Aucune classe utilitaire dans le gabarit (celles que le script donne aux
 * résultats mises à part) : les styles sont dans `src/styles/blog-liste.css`, la
 * feuille des quatre pages de liste.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BlogCard from '@/components/BlogCard.astro';
import BlogAppel from '@/components/BlogAppel.astro';
import '@/styles/blog-liste.css';
import { SITE_URL, CALENDLY_URL } from '@/lib/site';
import { blogSeries } from '@/lib/blog-series';
import { seriesPath } from '@/lib/blog-series-slugs';
import { resolveCover, resolveCovers } from '@/lib/blog-covers';
import { byNewest, byEpisode } from '@/lib/blog-sort';
import { nouer, echapper } from '@/lib/typo';

const posts = (await getCollection('blog')).sort(byNewest);

const covers = await resolveCovers(posts);

/* Mise en avant du dernier article : sans hiérarchie éditoriale, le guide le plus
   stratégique avait exactement le même poids visuel que le plus anecdotique. */
/* La « une » est un choix éditorial (`featured: true` dans le frontmatter) ; à
   défaut, le plus récent selon byNewest — et non plus l'ordre alphabétique. */
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
/* 8 cartes d'emblée : les 38 empilées faisaient 19 000 px de haut en mobile.
   8 et non 9 : la grille est en 2 puis 4 colonnes (cartes portrait), 8 remplit
   les deux sans carte orpheline. Les suivantes sont dans un <details> « Voir les
   N autres articles » (§ 9.dt) : sans lui, l'onglet « Tous les articles (46) »
   n'en montrait que 9 en cartes, le reste n'existant qu'en liste de titres. */
const recents = rest.slice(0, 8);
const autres = rest.slice(8);
const featuredSeries = blogSeries.find((s) => s.id === featured.data.seriesId);

/* La cover « à la une » devient l'élément LCP de la page. Servie en 1200 px fixes,
   elle faisait chuter le LCP à 4,1 s (perf 97 → 87). Affichée en portrait 4:5 sur
   une colonne de 340 px en desktop, pleine largeur en mobile : deux largeurs en
   srcset suffisent (340 px × densité 2 ≈ 720). */
const featuredCover = await resolveCover(featured.data.cover, 720);
const featuredCoverSmall = await resolveCover(featured.data.cover, 480);
// Descripteurs `w` = largeurs RÉELLES des fichiers (une cover source de 450 px
// n'a qu'une variante utile).
const featuredSrcset = featuredCover
  ? featuredCoverSmall && featuredCoverSmall.width < featuredCover.width
    ? `${featuredCoverSmall.src} ${featuredCoverSmall.width}w, ${featuredCover.src} ${featuredCover.width}w`
    : `${featuredCover.src} ${featuredCover.width}w`
  : undefined;

const formatDate = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const seriesCounts = new Map<string, number>(
  blogSeries.map((s) => [s.id, posts.filter((p) => p.data.seriesId === s.id).length])
);

const title = 'Blog Hippodoc — Conseils pour médecins remplaçants';
/* Description portée de 103 à ~155 caractères : sous ~120, Google complète
   l'aperçu avec un extrait de page choisi par lui. Les thèmes cités sont ceux
   réellement couverts par les articles du blog. */
const description = `${posts.length} articles pour médecins remplaçants : statuts et modes d'exercice, cotisations URSSAF et CARMF, déclarations 2035 et 2042, contrats, licence de remplacement.`;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE_URL}/blog#blog`,
  name: 'Blog Hippodoc',
  description,
  url: `${SITE_URL}/blog`,
  inLanguage: 'fr-FR',
  publisher: { '@id': `${SITE_URL}/#organization` },
  blogPost: posts.slice(0, 10).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `${SITE_URL}/blog/${p.id}`,
    datePublished: p.data.pubDate.toISOString(),
  })),
};
---

<BaseLayout title={title} description={description} path="/blog" jsonLd={[blogSchema]} bodyClass="da-fond">
  <Fragment slot="head">
    {/* Desktop : la cover « À la une » est l'élément LCP (colonne gauche du premier
        écran) mais reste en lazy pour le mobile, où elle est sous la ligne de
        flottaison. On la précharge donc à partir de 768 px seulement (§ 9.bi). */}
    {featuredSrcset && (
      <link rel="preload" as="image" media="(min-width: 768px)" imagesrcset={featuredSrcset} imagesizes="340px" fetchpriority="high" />
    )}
    {/* Barre du navigateur mobile : le ciel de la DA (jeton sky-1), comme l'accueil. */}
    <meta name="theme-color" content="#C9DEFF" />
  </Fragment>
  {/* La pastille survole le ciel du premier bloc, qui lui réserve le haut. */}
  <Header />
  <main class="bl da-bloc" data-blog-total={posts.length}>
    <div class="bl-tete">
      <div class="wrap">
        {/* En-tête resserré, aligné à gauche, phrase courte. La signature « écrites
             par le Dr. Ryan Goburdhun » reste sur chaque article (bloc auteur +
             JSON-LD `Article`), où elle porte un signal E-E-A-T vérifiable. */}
        <header class="bl-intro">
          <div>
            <h1 class="aff">
              Le blog des <span>médecins remplaçants</span>
            </h1>
            <p class="lead">
              Fiscalité, cotisations URSSAF et CARMF, contrats et vie du remplaçant.
            </p>
          </div>
          <p class="bl-compte">
            <span>{posts.length}</span> articles
          </p>
        </header>

        {/* Recherche (§ 9.db). Le lecteur arrive avec une question précise (« remplir
             la DSFU », « chèques-vacances »), pas avec une série en tête. Le module de
             recherche et l'index (/blog/recherche.json) ne se chargent qu'au premier
             focus du champ ; la page ne s'alourdit pas. Sans JavaScript, le bloc est
             masqué (<noscript>) et la page reste identique. La ligne d'état a une
             hauteur réservée : rien ne bouge quand le compteur s'affiche. */}
        <div id="blog-recherche" role="search" class="bl-recherche">
          <label for="blog-recherche-champ" class="bl-sr">Rechercher un article du blog</label>
          <div class="bl-champ">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              id="blog-recherche-champ"
              type="search"
              autocomplete="off"
              enterkeyhint="search"
              placeholder="Rechercher : DSFU, CARMF, chèques-vacances…"
              aria-describedby="blog-recherche-etat"
              aria-controls="blog-recherche-resultats"
            />
          </div>
          <p id="blog-recherche-etat" class="bl-etat" aria-live="polite"></p>
          <ul id="blog-recherche-resultats" class="bl-resultats" hidden></ul>
          <div id="blog-recherche-vide" class="bl-vide" hidden>
            <p>Pas encore d'article sur ce sujet. Essaie un autre mot, cherche dans le <a href="/guide-declarations" class="lien">guide des déclarations</a>, ou <a href={CALENDLY_URL} data-calendly="blog_search" target="_blank" rel="noopener" class="lien">prends 15 min avec Ryan</a> pour en parler.</p>
          </div>
        </div>
        <noscript><style>{'#blog-recherche{display:none}'}</style></noscript>

        {/* Navigation par série : de vrais liens vers /blog/serie/* (partageables,
             indexables, focus clavier natif). */}
        <nav aria-label="Séries du blog" class="bl-series">
          <a href="/blog" aria-current="page">
            Tous les articles <span>({posts.length})</span>
          </a>
          {blogSeries.map((s) => (
            <a href={seriesPath(s.id)}>
              {s.name} <span>({seriesCounts.get(s.id)})</span>
            </a>
          ))}
        </nav>

        {/* Article mis en avant : une grande fiche sur le ciel, pour donner une
             hiérarchie de lecture dès le premier écran. */}
        <a href={`/blog/${featured.id}`} data-ph="blog_index_featured" class="bl-une">
          <div class="bl-une-texte">
            <div class="bl-marques">
              <span class="bl-etiquette">À la une</span>
              {featuredSeries && <span class="chip plan">{featuredSeries.name}</span>}
            </div>
            <h2 set:html={nouer(echapper(featured.data.title))} />
            <p class="bl-une-extrait" set:html={nouer(echapper(featured.data.description))} />
            <div class="bl-infos">
              <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
              <span>{featured.data.readTime}</span>
            </div>
          </div>

          {/* L'image vient APRÈS le texte dans le DOM, et reprend la colonne de gauche
               sur ordinateur (`order`). Sur téléphone elle sortait sinon du premier
               écran et devenait l'élément LCP : chargée en priorité, elle faisait
               tomber la perf de 97 à 87 (LCP 4,1 s). Le titre reste le LCP, et
               l'image se charge en différé sans bloquer le rendu. Elle garde ses
               340 px de large à partir de 768 px (`sizes` et préchargement). */}
          {featuredCover && (
            <img
              src={featuredCover.src}
              srcset={featuredSrcset}
              sizes="(min-width: 768px) 340px, 100vw"
              alt=""
              width={featuredCover.width}
              height={featuredCover.height}
              loading="lazy"
              decoding="async"
            />
          )}
        </a>
      </div>
    </div>

    {/* Feuille sable : les cartes. */}
    <div class="band">
      <div class="wrap">
        <h2 class="bl-titre">Derniers articles</h2>
        <div class="bl-grille">
          {recents.map((post) => (
            <BlogCard
              headingLevel={3}
              slug={post.id}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              readTime={post.data.readTime}
              seriesId={post.data.seriesId}
              episodeNumber={post.data.episodeNumber}
              cover={covers.get(post.id)}
            />
          ))}
        </div>

        {/* Les autres articles, en cartes, derrière un <details> natif : zéro JS, contenu
             présent dans le HTML (indexable), covers en lazy donc non téléchargées tant
             que le bloc est fermé. À l'ouverture, le bouton disparaît et la grille
             continue sans rupture sous les 8 premières cartes. */}
        {autres.length > 0 && (
          <details class="bl-suite">
            <summary data-ph="blog_index_show_all" class="btn btn-line">
              Voir les {autres.length} autres articles
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="bl-grille">
              {autres.map((post) => (
                <BlogCard
                  headingLevel={3}
                  slug={post.id}
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  readTime={post.data.readTime}
                  seriesId={post.data.seriesId}
                  episodeNumber={post.data.episodeNumber}
                  cover={covers.get(post.id)}
                />
              ))}
            </div>
          </details>
        )}

        <div class="bl-appel-place">
          <BlogAppel emplacement="blog_index" />
        </div>
      </div>
    </div>

    {/* Feuille ciel : l'index complet. Les cartes ne donnent aucun moyen de repérer
         un sujet précis ; cette liste donne tous les titres d'un coup d'œil, groupés
         par série. Toujours visible (pas de <details>) pour rester scannable et
         indexable : une fiche par série, côte à côte sur grand écran. */}
    <div class="band air bl-fin">
      <section class="wrap" aria-labelledby="index-titre">
        <h2 id="index-titre" class="bl-titre">Tous les articles</h2>
        <p class="bl-sous-titre">Les {posts.length} articles, classés par série.</p>

        <div class="bl-index">
          {blogSeries.map((s) => (
            <div class="bl-serie">
              <h3>
                <a href={seriesPath(s.id)}>{s.name}</a>
                <span>{seriesCounts.get(s.id)}</span>
              </h3>
              <ul role="list">
                {posts
                  .filter((p) => p.data.seriesId === s.id)
                  .sort(s.totalEpisodes === null ? byNewest : byEpisode)
                  .map((p) => (
                    <li>
                      <a href={`/blog/${p.id}`}>
                        <span set:html={nouer(echapper(p.data.title))} />
                        <span>{p.data.readTime}</span>
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  /* Recherche du blog (§ 9.db) — exception à la règle « zéro JS » des pages
     statiques, listée dans CLAUDE.md. Rien ne se charge avant le premier focus. */
  import type { EntreeRecherche, Resultat } from '@/lib/blog-search';

  const MAX = 10;
  const champ = document.getElementById('blog-recherche-champ') as HTMLInputElement | null;
  const etat = document.getElementById('blog-recherche-etat');
  const liste = document.getElementById('blog-recherche-resultats');
  const vide = document.getElementById('blog-recherche-vide');

  if (champ && etat && liste && vide) {
    let chercher: ((i: EntreeRecherche[], q: string) => { resultats: Resultat[]; approchant: boolean }) | null = null;
    let index: EntreeRecherche[] = [];
    let chargement: Promise<void> | null = null;
    let premier: string | null = null;
    let minuterie: number | undefined;

    const charger = () =>
      (chargement ??= Promise.all([
        import('@/lib/blog-search'),
        fetch('/blog/recherche.json').then((r) => r.json() as Promise<EntreeRecherche[]>),
      ]).then(([mod, data]) => {
        chercher = mod.chercher;
        index = data;
      }));

    const lien = (r: Resultat, rang: number): HTMLLIElement => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `/blog/${r.entree.s}`;
      a.dataset.ph = 'blog_search_result';
      a.dataset.phRank = String(rang + 1);
      a.className = 'flex items-baseline justify-between gap-3 px-4 py-3 text-sm leading-snug text-foreground transition-colors hover:bg-hippo-50 hover:text-hippo-700';
      const titre = document.createElement('span');
      titre.textContent = r.entree.t;
      const meta = document.createElement('span');
      meta.className = 'shrink-0 text-xs text-muted-foreground';
      meta.textContent = r.entree.r;
      a.append(titre, meta);
      li.append(a);
      return li;
    };

    const afficher = () => {
      const q = champ.value.trim();
      liste.replaceChildren();
      premier = null;
      if (!q || !chercher) {
        liste.hidden = true;
        vide.hidden = true;
        etat.textContent = '';
        return;
      }
      const { resultats, approchant } = chercher(index, q);
      const n = resultats.length;
      if (n === 0) {
        liste.hidden = true;
        vide.hidden = false;
        etat.textContent = 'Aucun article trouvé.';
      } else {
        resultats.slice(0, MAX).forEach((r, i) => liste.append(lien(r, i)));
        premier = `/blog/${resultats[0].entree.s}`;
        liste.hidden = false;
        vide.hidden = true;
        const total = n > 1 ? `${n} articles` : '1 article';
        etat.textContent = approchant
          ? `Aucun article ne contient tous ces mots. ${total} en contiennent une partie :`
          : n > MAX
            ? `${total} trouvés, voici les ${MAX} plus pertinents :`
            : `${total} trouvé${n > 1 ? 's' : ''} :`;
      }
      // Mesure : terme cherché (tronqué) et nombre de résultats, une fois la frappe
      // terminée. Émis vers le module d'analytics, qui y ajoute le contexte commun.
      window.clearTimeout(minuterie);
      if (q.length >= 2) {
        minuterie = window.setTimeout(() => {
          window.dispatchEvent(
            new CustomEvent('hippodoc:blog-search', { detail: { query: q.slice(0, 60), results: n, approchant } }),
          );
        }, 1500);
      }
    };

    champ.addEventListener('focus', () => void charger(), { once: true });
    champ.addEventListener('input', () => void charger().then(afficher));
    champ.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && premier) {
        e.preventDefault();
        window.location.href = premier;
      } else if (e.key === 'Escape') {
        champ.value = '';
        afficher();
      }
    });
  }
</script>
