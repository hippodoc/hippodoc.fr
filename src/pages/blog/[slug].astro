---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BlogSlides from '@/components/BlogSlides.tsx';
import { SITE_URL, APP_URL, LOGO_URL, CALENDLY_URL, PRODUCT_DEFINITION, AUTEURS } from '@/lib/site';
import { blogSeries } from '@/lib/blog-series';
import { seriesPath } from '@/lib/blog-series-slugs';
import { miniMarkdownToHtml, stripMiniMarkdown } from '@/lib/blog-format';
/* Nouveau système de lecture (novembre 2026, MIGRATION.md § 9.fj). Toute la feuille de la
   page est dans un fichier de src/styles : Tailwind ne la lit pas, et le corps de l'article,
   rendu depuis le Markdown, n'a pas l'attribut de portée d'Astro. Elle part dans la feuille
   de la page, jamais dans la feuille commune. Le balisage qu'elle dessine est posé au rendu
   par src/lib/rehype-article.mjs. */
import '@/styles/blog-article.css';
import { entreesSommaire } from '@/lib/article-sommaire';
import { EMO_SRC } from '@/lib/article-emojis.mjs';
import { donneesPartage, nomImagePartage } from '@/lib/image-partage.mjs';
import portraitRyan from '@/assets/founders/ryan-goburdhun.jpeg';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
/* Une entrée par titre { slug, depth, texte, emoji, numero, encadre, sources, sous, np… }. */
const entrees = entreesSommaire(headings, remarkPluginFrontmatter?.balisage);
const posts = await getCollection('blog');

/* Le sommaire — le plan seul : les h2 qui ne sont ni un titre d'encadré ni les sources.
   Dès trois parties (les 48 articles, contre 19 avec l'ancien seuil de 1 200 mots et
   8 h2) : on sait toujours où l'on est, et les fiches courtes en profitent autant que
   les guides. Ordinateur (1 040 px et plus) : rail collant à gauche, toujours ouvert,
   la partie en cours repérée sans script. Téléphone et tablette : un pli « Sommaire »
   en tête de la feuille, une pastille ronde qui y ramène, un fil de lecture.
   Les sous-parties (rang 2, `t-sous` posé par le plugin : « 4.2 », ou « 1. Retraite de
   base » sous « Combien ça coûte ? ») sont en retrait, hors du compte des parties. */
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const plan = entrees.filter((e) => e.depth === 2 && !e.encadre && !e.sources);
/* Les parties comptées : ni les sous-parties, ni un titre hors du compte (« Légende » du
   calendrier fiscal : dans le sommaire, sans numéro, sans repère au-dessus du titre). */
const principal = plan.filter((e) => !e.sous && !e.horsCompte);
const showToc = plan.length >= 3;
/* Numéros. Dans le texte, au-dessus de chaque titre de partie, sa place dans le plan
   (« 04 / 10 », compteurs CSS, le total donné ici) ; pas quand l'auteur a numéroté des
   parties (« 1. », 1️⃣, « Étape 1 ») : deux numérotations se seraient superposées.
   Dans le rail : un plan numéroté par l'auteur sur au moins la moitié de ses parties
   (« mode auteur ») garde ses numéros, une entrée sans numéro n'en a pas ; sinon, le
   rail numérote les parties (01, 02…), du même compte que le repère. Une sous-partie
   garde toujours le numéro de l'auteur. */
const numerote = principal.some((e) => e.numero);
const modeAuteur = principal.length > 0 && principal.filter((e) => e.numero).length * 2 >= principal.length;
const parSlug = new Map(entrees.map((e) => [e.slug, e]));
/* Libellé d'une entrée : le texte du lien est celui du titre, caractère pour caractère.
   Les émojis (et le numéro écrit, quand le rail l'affiche dans sa colonne) restent dans
   le lien, masqués à l'œil comme la classe `sr` du site, et muets. */
const libelle = (h: { slug: string; text: string }) => {
  const e = parSlug.get(h.slug);
  if (!e) return { avant: '', milieu: h.text, apres: '' };
  const visible = e.numero && (modeAuteur || e.sous) ? e.texteSansNumero : e.texte;
  const i = visible ? h.text.indexOf(visible) : -1;
  if (i < 0) return { avant: '', milieu: h.text, apres: '' };
  return { avant: h.text.slice(0, i), milieu: visible, apres: h.text.slice(i + visible.length) };
};
const RE_EMO = new RegExp(EMO_SRC, 'gu');
const masquerEmojis = (html: string) => html.replace(RE_EMO, (m) => `<span class="em-cache" aria-hidden="true">${m}</span>`);
/* Repère de la partie en cours, repli pour les moteurs sans `scroll-target-group` (Safari 26,
   Firefox 159) : une ligne de temps par titre du plan, nommée ici ; chaque lien suit la sienne et
   celle de la partie suivante. Une petite feuille écrite au rendu, aucun script, sous la largeur
   du rail seulement (ailleurs, le moteur calculait des lignes de temps pour un rail absent).
   Comme le repère natif de Chrome : la première partie est allumée dès le haut de la page (son
   lien, `som-debut`, ne suit que la ligne de la partie suivante), la dernière le reste jusqu'au
   bas (`som-fin` : elle ne suit que la sienne). Une ligne de temps `none` ne convient pas :
   WebKit applique quand même l'état final de l'animation. */
const nomLigne = (i: number) => `--p${i}`;
const lignes = plan.map((e, i) => `[id="${e.slug.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"]{view-timeline-name:${nomLigne(i)}}`).join('');
const feuilleRepere = showToc
  ? `@supports (animation-timeline: view()) and (not (scroll-target-group: auto)){@media (min-width:1040px){.fiche{timeline-scope:${plan.map((_, i) => nomLigne(i)).join(',')}}${lignes}}}`
  : '';
/* Plan long (plus de 14 parties) qui a des sous-parties : le rail de l'ordinateur ne montre que les
   parties (frais-pros-medecin-liberal-2026 : 11 entrées sur 22, il tient dans un écran de 800 px) ;
   la partie reste repérée pendant ses sous-parties. Le pli du téléphone les montre toutes. */
const dense = plan.length > 14 && plan.some((e) => e.sous);
const auRail = dense ? principal : plan;
const lignesDuLien = (slug: string) => {
  const i = plan.findIndex((e) => e.slug === slug);
  if (i < 0) return { style: undefined, debut: false, fin: false };
  const k = auRail.findIndex((e) => e.slug === slug);
  const suivante = k >= 0 ? auRail[k + 1] : plan[i + 1];
  return {
    style: `--ta:${nomLigne(i)};--tb:${suivante ? nomLigne(plan.indexOf(suivante)) : nomLigne(i)}`,
    debut: k === 0,
    fin: !suivante,
  };
};

const {
  title, description, pubDate, updatedDate, author, authorRole, category, categoryNumber,
  seriesId, episodeNumber, readTime, cover, cta, ctaHref, faq, relatedArticles, slides,
} = post.data;
const signupUrl = `${APP_URL}/auth?tab=signup`;

const slug = post.id;
const path = `/blog/${slug}`;
const series = blogSeries.find((s) => s.id === seriesId);

/* Images : covers + slides optimisées via astro:assets (les originaux
   viennent de public/blog/ de la SPA source, copiés dans src/assets/blog). */
const blogImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/blog/**/*.{png,jpg,jpeg,webp}',
  { eager: true }
);

function blogAsset(publicPath: string) {
  return blogImages[publicPath.replace(/^\/blog\//, '/src/assets/blog/')]?.default ?? null;
}

/* La largeur demandée est bornée à celle de la source : sharp n'agrandit jamais
   (withoutEnlargement), mais Astro annonçait quand même la largeur demandée — onze
   covers de 450 px étaient déclarées « 800w » et « 1200w » (§ 9.bd). */
async function resolveBlogImage(publicPath: string, width: number) {
  const src = blogAsset(publicPath);
  if (!src) return null;
  return await getImage({ src, width: Math.min(width, src.width), format: 'webp' });
}

/* Recadrage paysage d'une cover portrait, calé sur le HAUT : c'est là qu'est
   dessiné le titre. Dimensions bornées à la source pour que les valeurs déclarées
   (og:image:width/height, JSON-LD) soient celles du fichier réellement servi. */
async function croppedCover(publicPath: string, ratio: number, format: 'jpg' | 'webp') {
  const src = blogAsset(publicPath);
  if (!src) return null;
  const width = Math.min(1200, src.width, Math.floor(src.height * ratio));
  const height = Math.round(width / ratio);
  const img = await getImage({ src, width, height, fit: 'cover', position: 'top', format });
  return { url: `${SITE_URL}${img.src}`, width, height };
}

/* Couverture : une vignette (§ 9.fj), 64 × 80 px sur téléphone à côté de la ligne de
   confiance, 132 × 165 px sur ordinateur (elle repoussait le texte à 1,5 écran sur
   téléphone). Candidats du srcset : 160, 264 et 400 px (deux fois la plus grande
   vignette, et un peu plus), bornés à la largeur de la source et dédoublonnés. Le `src`
   reste celui d'avant (900 px, ou la largeur de l'affiche quand elle est plus petite :
   les robots qui ne lisent pas le srcset). */
const coverImage = await resolveBlogImage(cover, 900);
const coverVariants = (
  await Promise.all([160, 264, 400].map((w) => resolveBlogImage(cover, w)))
).filter((v): v is NonNullable<typeof v> => v !== null);
const coverSrcset = [...new Map(coverVariants.map((v) => [Number(v.attributes.width), v.src])).entries()]
  .map(([w, src]) => `${src} ${w}w`)
  .join(', ');
/* `loading="lazy"` retiré des attributs de getImage : Astro ne dédoublonne pas un
   attribut étalé puis redéfini, et le navigateur garde le premier (lazy). */
const { loading: _lazy, ...coverAttrs } = coverImage?.attributes ?? {};
/* Image de partage (§ 9.fl) : fabriquée à la construction, 1 200 × 630 px, dans la DA
   (src/pages/blog/partage/[slug].jpg.ts). Elle remplace le recadrage de l'affiche, souvent
   flou (31 articles sur 48 avaient une affiche de moins de 1 200 px, 11 vers 450 px).
   C'est l'og:image, la twitter:image et la première image du JSON-LD Article ; suivent
   les recadrages de l'affiche en 16:9, 4:3 et 1:1, comme le recommande Google. */
const partage = donneesPartage(posts).get(slug)!;
const imagePartage = { url: `${SITE_URL}/blog/partage/${nomImagePartage(slug, partage)}.jpg`, width: 1200, height: 630 };
const ldImages = [
  imagePartage,
  ...(await Promise.all([16 / 9, 4 / 3, 1].map((r) => croppedCover(cover, r, 'jpg')))).filter(
    (v): v is NonNullable<typeof v> => v !== null
  ),
];

const resolvedSlides = slides
  ? (
      await Promise.all(
        slides.map(async (s) => {
          const img = await resolveBlogImage(s.src, 900);
          return img
            ? { src: img.src, alt: s.alt, width: img.attributes.width, height: img.attributes.height }
            : { src: s.src, alt: s.alt };
        })
      )
    )
  : null;

/* Articles connexes */
const related = (relatedArticles ?? [])
  .map((rslug) => posts.find((p) => p.id === rslug))
  .filter((p) => p !== undefined)
  .slice(0, 6);

/* Vignettes des articles connexes : 40 × 50 px (44 × 55 au téléphone) ; 132 px de large
   suffisent à trois fois cette taille (288 px servaient l'ancienne vignette de 96 px). */
const relatedCovers = new Map<string, string>();
for (const r of related) {
  const img = await resolveBlogImage(r.data.cover, 132);
  if (img) relatedCovers.set(r.id, img.src);
}

/* Dates */
const formatDate = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

/* JSON-LD. Un auteur connu (table AUTEURS de site.ts) renvoie à sa fiche de /qui-sommes-nous
   (même `@id` que la Person de cette page, § 9.fj) : les 48 articles se rattachent à elle au
   lieu de redéclarer une personne sans identifiant. Le nom ne change pas. Un auteur absent
   de la table n'a ni lien ni identifiant (il ne prend pas ceux d'un autre). */
const fiche = AUTEURS[author];
const authorSchema = fiche
  ? { '@type': 'Person', '@id': `${SITE_URL}${fiche.ancre}`, name: author, url: `${SITE_URL}${fiche.ancre.split('#')[0]}` }
  : { '@type': 'Person', name: author };
/* Portrait de l'auteur (bloc auteur) : 56 px, et son double, comme sur l'accueil (mêmes fichiers). */
const portrait = fiche?.portrait === 'ryan'
  ? await Promise.all((['avif', 'webp'] as const).map((format) => getImage({ src: portraitRyan, format, width: 56, widths: [56, 112] })))
  : null;
/* « Fiche Fiscalité #4 » puis « Épisode 4 » : le même numéro deux fois. Quand la pastille le
   porte, « Épisode N » reste dans le texte, masqué à l'œil (classe `sr`). */
const episodeRepete = !!categoryNumber && episodeNumber !== undefined && categoryNumber.replace(/\D/g, '') === String(episodeNumber);
/* Appel à l'essai : un titre long (plus de 90 signes, deux articles) passe d'un cran plus petit. */
const ctaTitre = cta ?? 'Prêt à simplifier ta gestion de remplaçant ?';
const ctaLong = [...stripMiniMarkdown(ctaTitre).replace(new RegExp(EMO_SRC, 'gu'), '').trim()].length > 90;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${SITE_URL}${path}#article`,
  headline: title,
  description,
  image: ldImages.map((i) => i.url),
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'fr-FR',
  articleSection: category,
  author: authorSchema,
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'Hippodoc',
    logo: { '@type': 'ImageObject', url: LOGO_URL },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE_URL}${path}` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    /* Niveau série : aucun article ne renvoyait vers sa page de série (§ 9.be). */
    ...(series ? [{ '@type': 'ListItem', position: 3, name: series.name, item: `${SITE_URL}${seriesPath(series.id)}` }] : []),
    { '@type': 'ListItem', position: series ? 4 : 3, name: title, item: `${SITE_URL}${path}` },
  ],
};

const faqSchema = faq && faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: stripMiniMarkdown(item.question),
        acceptedAnswer: { '@type': 'Answer', text: stripMiniMarkdown(item.answer) },
      })),
    }
  : null;

const jsonLd = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];

/* Suffixe de marque adaptatif (§ 9.bi) : le suffixe fixe « | Blog Hippodoc »
   (16 car.) faisait dépasser 60 caractères à plusieurs <title>, contre le contrat
   SEO. Le titre de l'article n'est jamais tronqué : c'est la marque qui cède. */
const titreComplet =
  title.length <= 44 ? `${title} | Blog Hippodoc` : title.length <= 49 ? `${title} | Hippodoc` : title;
/* « Mis à jour le » seulement si la date est POSTÉRIEURE à la publication :
   un article affichait « 21 avril 2026 · Mis à jour le 21 avril 2026 ». */
const misAJour = updatedDate && updatedDate.getTime() > pubDate.getTime() ? updatedDate : null;

/* Habillage DA 2026 (phase 5c, MIGRATION.md § 9.ej). Les caractères que la police
   du site n'a pas (les flèches) sont dessinés ; le caractère reste dans le texte,
   masqué à l'œil (classe `sr`). */
const flecheDroite =
  '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>';
/* Un mot et la ponctuation qui le suit après une espace (? ! : ; / »), ou le
   guillemet ouvrant et le mot qui le suit, tiennent ensemble dans un
   <span class="num"> : le signe ne commence ni ne finit jamais une ligne. Le
   texte ne change pas, l'espace reste une espace ; les balises sont laissées
   telles quelles. Même principe que sur /faq. Le corps de l'article, lui, sort
   du Markdown sans retouche.
   De même pour une forme inversée (« a-t-elle », « s'apprécie-t-il ») : vingt
   questions en ont une, et la ligne se coupait après « a- » ou après « -t- ». */
const nouer = (html: string) =>
  html
    .split(/(<[^>]+>)/)
    .map((morceau) =>
      morceau.startsWith('<')
        ? morceau
        : morceau.replace(/(?:« )?[^\s«]+(?: [?!:;/»](?=[\s"')\].,]|$))+|« [^\s«]+|[^\s«]+-t-(?:ils?|elles?|on)(?![\p{L}-])/gu, '<span class="num">$&</span>')
    )
    .join('');
/* Un titre est du texte, pas du HTML : il est échappé avant d'être noué. */
const echapper = (texte: string) => texte.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/* La croix des plis `.qa` (da.css) : elle tourne et jaunit à l'ouverture. */
const croix =
  '<svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 3v12M3 9h12"/></svg>';
---

<BaseLayout
  title={titreComplet}
  description={description}
  path={path}
  ogImage={imagePartage.url}
  ogImageWidth={imagePartage.width}
  ogImageHeight={imagePartage.height}
  ogImageAlt={title}
  ogType="article"
  jsonLd={jsonLd}
  bodyClass="da-fond"
>
  <Fragment slot="head">
    {/* Barre du navigateur mobile : le ciel de la DA (jeton sky-1), comme l'accueil. */}
    <meta name="theme-color" content="#C9DEFF" />
    {/* Le repère de la partie en cours, repli sans scroll-target-group (feuille écrite au rendu ;
        dans <head> : une feuille n'a pas sa place dans <main>). */}
    {feuilleRepere && <style is:inline set:html={feuilleRepere} />}
  </Fragment>
  {/* La pastille survole le ciel du haut de la page, qui lui réserve la place. */}
  <Header />
  <main id="top" class:list={['page', 'fiche', 'da-bloc', showToc && 'guidee']}>
    {/* Fil de lecture (téléphone et tablette) : 3 px dans le bas de la pastille de l'en-tête, calé sur le corps. */}
    <div class="lecture-fil" aria-hidden="true"></div>

    <nav aria-label="Fil d'Ariane" class="fil">
      <ol role="list">
        <li><a href="/">Accueil</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/blog">Blog</a></li>
        <li aria-hidden="true">›</li>
        {series && (
          <>
            <li><a href={seriesPath(series.id)}>{series.name}</a></li>
            <li aria-hidden="true">›</li>
          </>
        )}
        <li aria-current="page" set:html={nouer(echapper(title))} />
      </ol>
    </nav>

    {/* « Retour au blog » est retiré (§ 9.fj) : le fil d'Ariane porte le même lien, juste au-dessus. */}

    {/* Métadonnées d'instrumentation, injectées au build : `page-analytics.ts` les
       lit pour blog_article_viewed / blog_scroll_depth / blog_read_completed. Les
       valeurs viennent du frontmatter, donc identiques à l'historique PostHog
       (category « Fiche Fiscalité », series_id « fiche-fiscalite »…).
       La page est une grille (le <main>) : <article> et son <header> n'y font pas de
       boîte, leurs enfants s'y placent directement (blog-article.css). */}
    <article
      class:list={['article', coverImage && 'illustree']}
      data-blog-slug={slug}
      data-blog-category={category}
      data-blog-series={seriesId}
      data-blog-episode={episodeNumber ?? 0}
    >
      <header class="tete">
        <div class="marques">
          {series && (
            <a href={seriesPath(series.id)} class="serie">
              {category}{categoryNumber ? ` ${categoryNumber}` : ''}
            </a>
          )}
          {episodeNumber !== undefined && seriesId !== 'divers' && (
            <span class:list={['episode', episodeRepete && 'sr']}>Épisode {episodeNumber}</span>
          )}
        </div>
        <h1 class="aff" set:html={nouer(echapper(title))} />
        {/* La ligne de confiance : les mêmes mots, réordonnés par la feuille (date, durée,
            auteur). Le nom de l'auteur mène à sa fiche (§ 9.fj). Quand l'article a été mis
            à jour, la date de publication reste dans la page, masquée à l'œil. */}
        <div class:list={['infos', misAJour && 'a-jour']}>
          {fiche ? <a href={fiche.ancre} class="auteur">{author}</a> : <span class="auteur">{author}</span>}
          <time class="publie" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {misAJour && (
            <span class="maj">Mis à jour le <time datetime={misAJour.toISOString()}>{formatDate(misAJour)}</time></span>
          )}
          <span class="duree">{readTime} de lecture</span>
        </div>
      </header>

      {/* Couverture : une vignette, 64 × 80 px sur téléphone à droite de la ligne de
          confiance, 132 × 165 px sur ordinateur. Ce n'est plus l'élément principal de la
          page : pas de `fetchpriority`. */}
      {coverImage && (
        <img
          src={coverImage.src}
          {...coverAttrs}
          loading="eager"
          srcset={coverSrcset || undefined}
          sizes="(min-width: 1040px) 132px, (min-width: 700px) 120px, (min-width: 560px) 76px, 64px"
          alt={title}
          class="couverture"
        />
      )}

      {/* Le sommaire : un seul <details>. Téléphone et tablette : un pli fermé en tête de
          la feuille. Ordinateur : le rail collant à gauche, toujours ouvert
          (::details-content). Ses entrées : les parties du plan seulement. */}
      {showToc && (
        <details class:list={['som', modeAuteur && 'som-auteur', dense && 'som-dense', auRail.length > 12 && 'som-long']} id="sommaire">
          <summary class="som-tete">
            <span class="som-tete-nom">Sommaire</span>
            <svg class="som-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          {/* role explicite : le mode lecture de Firefox (Readability) écarte une navigation ainsi
              marquée, et le texte de l'article y commence par « L'essentiel », pas par le plan. */}
          <nav aria-label="Sommaire de l'article" class="som-nav" role="navigation">
            <p class="som-nom">Sommaire</p>
            <ol role="list" id="sommaire-liste" class="som-liste">
              {plan.map((e) => {
                const h = toc.find((x) => x.slug === e.slug)!;
                const l = libelle(h);
                const repere = lignesDuLien(e.slug);
                return (
                  <li class:list={['partie', e.sous && 'sous-partie', e.horsCompte && 'hors-compte']}>
                    <a
                      href={`#${e.slug}`}
                      data-no={e.numero && (modeAuteur || e.sous) ? e.numero : undefined}
                      class:list={[repere.debut && 'som-debut', repere.fin && 'som-fin']}
                      style={repere.style}
                    >{l.avant && <span class="em-cache" aria-hidden="true">{l.avant}</span>}<span class="som-txt" set:html={masquerEmojis(nouer(echapper(l.milieu)))} />{l.apres && <span class="em-cache" aria-hidden="true">{l.apres}</span>}</a>
                  </li>
                );
              })}
            </ol>
            <a href="#top" class="som-haut">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
              Retour en haut
            </a>
          </nav>
        </details>
      )}

      {/* Le corps : le texte dans une colonne de lecture de 624 px au plus (67 à 69
          caractères par ligne pleine sur ordinateur, 19 px). Les sauts de ligne
          volontaires (« \ » en fin de ligne) sortent en <br>. Le total des parties sert
          au repère « 04 / 10 » des titres (compteurs de blog-article.css). */}
      <div
        class:list={['corps', numerote && 'numerote']}
        data-blog-zone="corps"
        style={`counter-reset: np-tot ${principal.length} np-pos`}
      >
        <Content />
        {/* Fin réelle du TEXTE — et non le bas de la page : le partage, le bloc
            auteur et le pied de page viennent après. C'est ce repère qui déclenche
            blog_read_completed, ce qui explique qu'il soit historiquement plus
            fréquent que `depth: 100`. */}
        <span data-blog-fin aria-hidden="true"></span>
      </div>

      {/* Le carrousel de planches (4 articles) : après le texte (§ 9.fj). Avant, il
          repoussait le début du texte à 1,4 écran sur téléphone. */}
      {resolvedSlides && (
        <div class="planches">
          <BlogSlides slides={resolvedSlides} client:visible />
        </div>
      )}

      {/* Fin d'article, dans l'ordre du téléphone (§ 9.fj) : questions, articles
          connexes, appel à l'essai, auteur, partage, « Pour aller plus loin ». Sur
          ordinateur large, l'appel à l'essai est la carte collante de la colonne de
          droite. */}
      {faq && faq.length > 0 && (
        <section class="questions" aria-labelledby="faq-title" data-blog-zone="faq">
          <h2 id="faq-title">Questions fréquentes</h2>
          <div class="liste">
            {faq.map((item) => (
              <details class="qa">
                <summary>
                  <span class="qa-t" set:html={nouer(miniMarkdownToHtml(item.question))} />
                  <Fragment set:html={croix} />
                </summary>
                <div class="qa-in" set:html={nouer(miniMarkdownToHtml(item.answer))} />
              </details>
            ))}
          </div>
        </section>
      )}

      {related.length > 0 && (
        <section class="connexes" aria-labelledby="related-title" data-blog-zone="connexes">
          <h2 id="related-title">Articles connexes</h2>
          <div class="cartes">
            {related.map((r, i) => (
              <a href={`/blog/${r.id}`} data-ph="blog_related" data-ph-rank={i + 1} class="carte">
                {relatedCovers.get(r.id) && (
                  <img src={relatedCovers.get(r.id)} alt="" loading="lazy" width="44" height="55" />
                )}
                <div>
                  <p class="carte-titre" set:html={nouer(echapper(r.data.title))} />
                  <p class="carte-duree">{r.data.readTime} de lecture</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Appel à l'action (§ 9.bf) : rendu sur TOUS les articles ; verify-site échoue sur
          un article sans `data-track="cta_` dans cet <aside>. Sur ordinateur large (1 360 px
          et plus), la carte collante de la colonne de droite ; ailleurs, après les questions
          et les articles connexes (§ 9.fj). Un seul élément, mêmes mots, mêmes attributs.
          Le titre est un <p> : en titre, il devenait un sous-titre du plan du document. Son
          émoji (deux 🚀) reste dans le texte, masqué à l'œil. La définition produit est
          reprise mot pour mot de site.ts : 5 articles ne nomment jamais le produit. */}
      <aside
        class="essai"
        aria-label="Essayer Hippodoc"
        data-blog-zone="cta"
      >
        <p class:list={['essai-titre', ctaLong && 'essai-titre-long']} set:html={masquerEmojis(nouer(miniMarkdownToHtml(ctaTitre)))} />
        <p class="essai-def" set:html={nouer(echapper(PRODUCT_DEFINITION))} />
        <a
          href={ctaHref ?? signupUrl}
          data-track={ctaHref === '/simulateur' ? 'cta_simulateur_blog' : ctaHref === '/essai' ? 'cta_essai_blog' : 'cta_signup_blog'}
          class="btn btn-brand"
        >
          {ctaHref === '/simulateur' ? 'Simule ton Super-Net' : ctaHref === '/essai' ? 'Découvrir Hippodoc' : 'Commencer gratuitement'}
        </a>
        {/* Le HTML n'a jamais eu d'espace entre le lien et le point médian (« gratuit· ») :
            le texte reste tel quel, le point est dans un <span> que la feuille écarte du lien. */}
        {ctaHref ? (
          <p class="essai-note">
            <a href={signupUrl} data-track="cta_signup_blog">Ou commence l'essai gratuit</a><span class="pt">·</span>{' '}30 jours · Sans engagement
          </p>
        ) : (
          <p class="essai-note">Essai gratuit 30 jours · Sans engagement</p>
        )}
        {/* Lien direct, jamais le widget (CLAUDE.md). `brancherCalendly()` y
            reporte les UTM de session et émet `calendly_clicked`. */}
        <p class="essai-note">
          <a
            href={CALENDLY_URL}
            data-calendly="blog_article"
            target="_blank"
            rel="noopener"
          >Prendre 15 min avec Ryan</a>
        </p>
      </aside>

      {/* Bloc auteur — signal E-E-A-T : sur des sujets « argent/santé », Google valorise
          l'expertise identifiable de l'auteur. */}
      <aside class="signature" aria-label="À propos de l'auteur">
        {/* Le portrait de l'auteur (décor : son nom suit), les initiales pour un auteur sans portrait. */}
        {portrait ? (
          <picture class="portrait">
            <source type="image/avif" srcset={portrait[0].srcSet.attribute} sizes="56px" />
            <img src={portrait[1].src} srcset={portrait[1].srcSet.attribute} sizes="56px" alt="" width="56" height="56" loading="lazy" decoding="async" />
          </picture>
        ) : (
          <span class="initiales">
            {author.replace(/^Dr\.?\s*/i, '').split(/\s+/).map((n) => n[0]).slice(0, 2).join('')}
          </span>
        )}
        <div class="signature-texte">
          <p class="nom">{author}</p>
          {authorRole && <p class="role">{authorRole}</p>}
          <p class="mot">
            Il partage ici ce qu'il applique au quotidien : fiscalité, cotisations et gestion de l'activité libérale.
            <a href="/qui-sommes-nous" class="lien">En savoir plus</a>
          </p>
        </div>
      </aside>

      {/* Partage : liens simples, aucun script tiers (un guide fiscal se transfère surtout
          entre confrères par messagerie). */}
      <div class="partage" data-blog-zone="partage">
        <span class="partage-nom">Partager cet article</span>
        <a
          href={`https://wa.me/?text=${encodeURIComponent(`${title} — ${SITE_URL}${path}`)}`}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="reseau"
          data-ph="blog_share_whatsapp"
        >
          WhatsApp
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`${SITE_URL}${path}`)}`}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="reseau"
          data-ph="blog_share_linkedin"
        >
          LinkedIn
        </a>
        <a
          href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${description}\n\n${SITE_URL}${path}`)}`}
          class="reseau"
          data-ph="blog_share_email"
        >
          E-mail
        </a>
      </div>

      <aside class="suite" aria-label="Pour aller plus loin" data-blog-zone="plus-loin">
        <h2>Pour aller plus loin</h2>
        <ul role="list">
          <li><a href="/simulateur" data-track="cta_simulateur_blog_more" class="lien"><span class="sr">→</span>{' '}<Fragment set:html={flecheDroite} />Simule ton Super-Net (revenu net après cotisations et impôts)</a></li>
          <li><a href="/guide-declarations" data-track="cta_guide_blog_more" class="lien"><span class="sr">→</span>{' '}<Fragment set:html={flecheDroite} />Guide des déclarations 2035, 2042 et DSFU du médecin</a></li>
          <li><a href="/tarifs" data-track="cta_pricing_blog_more" class="lien"><span class="sr">→</span>{' '}<Fragment set:html={flecheDroite} />Tarifs Hippodoc : 29 €/mois ou 19 €/mois en annuel, essai 30 jours</a></li>
        </ul>
      </aside>
    </article>

    {/* Retour en haut, en bas de page : sous 1 040 px (la pastille du sommaire est partie avec
        le texte) et sans rail ; le rail a le sien. */}
    <div class="remonter">
      <a
        href="#top"
        class="lien"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
        Retour en haut
      </a>
    </div>

    {/* Téléphone et tablette : la pastille « Sommaire », ronde, en bas à gauche, après un
        écran de défilement et tant que le texte est à l'écran. Un lien d'ancre vers la liste
        du pli, qui s'ouvre seul (le navigateur ouvre un <details> qui contient la cible). */}
    {showToc && (
      <a href="#sommaire-liste" class="som-pastille">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 5h8M13 12h8M13 19h8M3 5h4M3 12h4M3 19h4"/></svg>
        <span class="sr">Sommaire</span>
      </a>
    )}
  </main>
  <Footer />
</BaseLayout>
