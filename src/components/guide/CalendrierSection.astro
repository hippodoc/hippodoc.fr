---
/**
 * Portage statique de CalendrierSection.tsx (SPA source). Déviations
 * volontaires :
 *  - Bascule "Mois en cours / Chronologique" (JS, useState) → retirée ;
 *    tri fixé à "mois en cours en premier", calculé une fois au build
 *    Astro statique (même contrainte que SeasonalBanner.astro — reflète
 *    la date du déploiement, pas celle de la visite).
 */
import { Calendar } from 'lucide-react';
import { calendrierAnnuel } from '@/data/boussoleData';

const currentMonth = new Date().getMonth() + 1;
const sorted = [...calendrierAnnuel].sort((a, b) => {
  const aD = (a.numero - currentMonth + 12) % 12;
  const bD = (b.numero - currentMonth + 12) % 12;
  return aD - bD;
});
---

<section id="calendrier" class="py-12 md:py-16 scroll-mt-20 bg-gradient-to-b from-hippo-50/20 to-transparent dark:from-hippo-950/10">
  <div class="max-w-5xl mx-auto px-4">
    <div class="mb-8">
      <h2 class="text-2xl md:text-3xl font-bold text-foreground flex items-center gap-2"><Calendar className="h-7 w-7 text-hippo-500" /> Calendrier annuel du médecin libéral</h2>
      <p class="text-muted-foreground mt-1">Les échéances mois par mois — mois actuel en premier</p>
    </div>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
      {sorted.map(m => {
        const isCurrent = m.numero === currentMonth;
        return (
          <div class={`p-4 rounded-xl backdrop-blur border transition-all ${isCurrent ? 'bg-hippo-50 border-hippo-300 ring-1 ring-hippo-200/50 shadow-md dark:bg-hippo-900/30 dark:border-hippo-600' : 'bg-white/80 border-slate-200/60 dark:bg-slate-800/60 dark:border-slate-700/60'}`}>
            <div class="flex items-center gap-2 mb-3">
              <span class={`w-8 h-8 rounded-lg text-xs font-bold flex items-center justify-center ${isCurrent ? 'bg-hippo-500 text-white' : 'bg-hippo-100 text-hippo-700 dark:bg-hippo-900/40 dark:text-hippo-300'}`}>{String(m.numero).padStart(2, '0')}</span>
              <span class="font-semibold text-sm text-foreground">{m.mois}</span>
              {isCurrent && <span class="text-[10px] font-medium text-hippo-600 bg-hippo-100 px-1.5 py-0.5 rounded dark:bg-hippo-900/40 dark:text-hippo-300">Ce mois</span>}
            </div>
            <div class="space-y-2">
              {m.demarches.map(d => (
                <div class="flex items-start gap-2">
                  <span class={`mt-0.5 w-2 h-2 rounded-full shrink-0 ${d.urgent ? 'bg-red-400' : 'bg-slate-300 dark:bg-slate-600'}`} />
                  <div><p class="text-xs font-medium text-foreground">{d.titre}</p><p class="text-[11px] text-muted-foreground leading-snug">{d.description}</p></div>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
