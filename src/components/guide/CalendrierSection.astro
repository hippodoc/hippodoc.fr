---
/**
 * Portage statique de CalendrierSection.tsx (SPA source). Déviations
 * volontaires :
 *  - Bascule "Mois en cours / Chronologique" (JS, useState) → retirée ;
 *    tri fixé à "mois en cours en premier", calculé une fois au build
 *    Astro statique (même contrainte que SeasonalBanner.astro — reflète
 *    la date du déploiement, pas celle de la visite).
 *
 * DA 2026 (phase 5d, MIGRATION.md § 9.el) : douze fiches ; celle du mois en cours
 * a un filet d'encre et la pastille « Ce mois ». Une échéance urgente garde son
 * point d'alerte. Styles dans src/styles/guide.css.
 */
import { Calendar } from 'lucide-react';
import { calendrierAnnuel } from '@/data/boussoleData';

const currentMonth = new Date().getMonth() + 1;
const sorted = [...calendrierAnnuel].sort((a, b) => {
  const aD = (a.numero - currentMonth + 12) % 12;
  const bD = (b.numero - currentMonth + 12) % 12;
  return aD - bD;
});
---

<section id="calendrier" class="gd-sec">
  <div class="wrap">
    <div class="gd-sec-tete">
      <h2 class="gd-h2"><Calendar className="gd-ic" /> Calendrier annuel du médecin libéral</h2>
      <p class="gd-sous">Les échéances mois par mois — mois actuel en premier</p>
    </div>
    <div class="gd-mois-grille">
      {sorted.map(m => {
        const isCurrent = m.numero === currentMonth;
        return (
          <div class:list={['gd-mois', isCurrent && 'courant']}>
            <div class="gd-mois-tete">
              <span class="gd-mois-num">{String(m.numero).padStart(2, '0')}</span>
              <span class="gd-mois-nom">{m.mois}</span>
              {isCurrent && <span class="chip plan">Ce mois</span>}
            </div>
            <div class="gd-pile">
              {m.demarches.map(d => (
                <div class="gd-demarche">
                  <span class:list={['gd-pastille', d.urgent && 'urgent']} />
                  <div><p class="gd-demarche-nom">{d.titre}</p><p class="gd-demarche-p">{d.description}</p></div>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
