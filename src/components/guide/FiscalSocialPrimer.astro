---
/**
 * Portage statique de FiscalSocialPrimer.tsx (SPA source, variante non
 * compacte — celle utilisée dans Zone 1 de GuideDeclarationsBody).
 * Déviations volontaires :
 *  - Toggle ouvert/fermé persisté en `localStorage` (JS) → `<details>`
 *    natif, **ouvert par défaut** (meilleur pour le SEO : le contenu
 *    pédagogique est visible d'emblée dans le HTML plutôt que masqué tant
 *    que le visiteur n'a pas cliqué).
 *  - Bouton "Voir la fiche dédiée" (`onClick` → ouvre la fiche RO-014 en
 *    aval) → ancre `<a href="#regle-RO-014">`.
 *  - `motion.section` (framer-motion) → `<section>` brute.
 *
 * DA 2026 (phase 5d, MIGRATION.md § 9.el) : un pli `.qa` ouvert (fiche blanche, la
 * croix de la DA), deux fiches ciel doux côte à côte. Impôts en bleu, social en
 * vert (jetons `--plan`, `--ok`). Styles dans src/styles/guide.css.
 */
import { Landmark, Stethoscope } from 'lucide-react';

/* La croix des plis (da.css la fait tourner) et la flèche du lien (la police n'a
   pas de flèche : un dessin). */
const croix =
  '<svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 3v12M3 9h12"/></svg>';
const fleche =
  '<svg class="gd-fl" viewBox="0 0 16 12" width="16" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 6h12.5M9.5 1.5 14 6l-4.5 4.5"/></svg>';
---

<section class="gd-rappel" aria-label="Rappel pédagogique : régime fiscal et régime social">
  <div class="wrap">
    <div class="gd-rappel-fiche">
      <details class="qa" open>
        <summary>
          <div class="gd-rappel-tete">
            <div class="gd-duo">
              <span class="gd-rond plan">
                <Landmark className="gd-ic" />
              </span>
              <span class="gd-rond ok">
                <Stethoscope className="gd-ic" />
              </span>
            </div>
            {/* Le <span> ne change pas le texte : il garde le « : » sur la ligne du mot. */}
            <h2 class="qa-t">
              Fiscal ≠ <span class="gd-num">social :</span> 2 mondes, 2 déclarations
            </h2>
          </div>
          <Fragment set:html={croix} />
        </summary>

        <div class="qa-in">
          <p class="gd-rappel-p">
            Une déclaration calcule <strong>combien tu dois aux impôts</strong>,
            l'autre calcule <strong>combien tu dois à la Sécu et à la CARMF</strong>.
            Deux administrations, deux formulaires, deux dates.
          </p>

          <div class="gd-mondes">
            <div class="gd-monde plan">
              <div class="gd-monde-tete">
                <div class="gd-rond plan plein">
                  <Landmark className="gd-ic" />
                </div>
                <div class="gd-monde-nom">
                  Côté impôts
                </div>
                <span class="chip plan">
                  Fiscal
                </span>
              </div>
              <dl>
                <dt>Qui ?</dt>
                <dd><strong>DGFiP</strong> · impots.gouv.fr</dd>
                <dt>Régime ?</dt>
                <dd>Micro-BNC <span class="gd-doux">ou</span> BNC réel</dd>
                <dt>Tu remplis ?</dt>
                <dd>
                  <ul>
                    <li><strong>2042</strong> — déclaration principale</li>
                    <li><strong>2042 C-PRO</strong> — case <strong>5HQ</strong> (micro) ou <strong>5QC</strong> (réel)</li>
                    <li><strong>2035</strong> — liasse détaillée (réel uniquement)</li>
                  </ul>
                </dd>
                <dt>Pour ?</dt>
                <dd>Calculer ton <strong>impôt sur le revenu</strong></dd>
              </dl>
            </div>

            <div class="gd-monde ok">
              <div class="gd-monde-tete">
                <div class="gd-rond ok plein">
                  <Stethoscope className="gd-ic" />
                </div>
                <div class="gd-monde-nom">
                  Côté URSSAF + CARMF
                </div>
                <span class="chip ok">
                  Social
                </span>
              </div>
              <dl>
                <dt>Qui ?</dt>
                <dd><strong>URSSAF</strong> + <strong>CARMF</strong></dd>
                <dt>Régime ?</dt>
                <dd>
                  PAMC <span class="gd-doux">(cas général)</span> <span class="gd-doux">ou</span> RSPM{' '}
                  <span class="gd-doux">(option des remplaçants, jusqu'à 19 k€)</span>
                </dd>
                <dt>Tu remplis ?</dt>
                <dd>
                  <strong>DSFU</strong> sur urssaf.fr<br />
                  <span class="gd-doux">cases <strong>DSCS</strong>, <strong>DSAV</strong>, <strong>DSDE</strong>…</span>
                </dd>
                <dt>Pour ?</dt>
                <dd>
                  Calculer tes <strong>cotisations sociales</strong>
                  <br />
                  <span class="gd-doux">(maladie, retraite CARMF, allocations…)</span>
                </dd>
              </dl>
            </div>
          </div>

          <div class="gd-rappel-fin">
            <p>
              Ces deux régimes sont{' '}
              <strong>indépendants</strong> : être en
              micro-BNC ne te dispense pas de la DSFU si tu es au PAMC.{' '}
              <a
                href="#regle-RO-014"
                class="gd-lien"
              >
                Voir la fiche dédiée <Fragment set:html={fleche} />
              </a>
            </p>
          </div>
        </div>
      </details>
    </div>
  </div>
</section>
