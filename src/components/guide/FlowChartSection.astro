---
/**
 * Portage statique de FlowChartSection.tsx (SPA source). Déviations
 * volontaires (page 100 % statique, zéro JS hors îlot boussole) :
 *  - Surlignage des cases selon le profil sélectionné / les codes calculés
 *    par le wizard (`selectedProfil`, `wizardCaseCodes`) : supprimé — le
 *    diagramme affiche toujours toutes les cases au même niveau visuel
 *    (l'îlot boussole est autonome, il ne peut plus synchroniser cette
 *    section statique).
 *  - `onClick={() => scrollToCase(code)}` → ancre `<a href="#case-CODE">`.
 *
 * DA 2026 (phase 5d, MIGRATION.md § 9.el) : trois fiches en relief, une par
 * colonne ; chaque case est une pastille ciel doux qui mène à sa fiche. La
 * flèche « ↓ » est un dessin (la police n'a pas de flèche), le caractère reste
 * dans le texte, masqué à l'œil. Styles dans src/styles/guide.css.
 */
import { Banknote, FileText, HeartPulse, Building2, Map } from 'lucide-react';

// Chaque case était un <button> dans la source : ici une ancre.
const nodeClass = 'gd-noeud';
// Variante pleine largeur de la colonne Social et des cases SEL.
const nodeClassFull = `gd-noeud plein`;

const socialNodes: Array<{ code: string; label: string; deprecated?: boolean }> = [
  { code: 'DSCS', label: 'CA brut (pour le ratio)' },
  { code: 'DSAV', label: 'Part conventionnée' },
  { code: 'DSAU', label: 'Déclenche la PCC (S1)' },
  { code: 'DSAW', label: 'Dépassements' },
  { code: 'DSAT', label: 'EHPAD/HAD/SSIAD' },
  { code: 'DSDE', label: 'RBS positif' },
  { code: 'DSDG', label: 'RBS négatif (rare)' },
  { code: 'DSCN', label: 'Chèques Vacances' },
  { code: 'DSDX', label: 'IJ CPAM' },
  { code: 'DSCZ', label: 'IJ Madelin reçues + AJPA' },
  { code: 'DSEM', label: 'Épargne salariale (IS)' },
  { code: 'DSCO', label: 'Supprimée 2026 (→ RBS)', deprecated: true },
  { code: 'DSFA', label: 'PDSA exonérée (micro-BNC)' },
];

const selNodes = [
  { code: 'DSDI', label: 'Gérant société IS' },
  { code: 'DSEC', label: 'Rémunération brute' },
  { code: 'DSSC', label: 'Dividendes > 10%' },
];
---

<section id="flux" class="gd-sec">
  <div class="wrap">
    <div class="gd-sec-tete">
      <h2 class="gd-h2">
        <Map className="gd-ic" /> Le parcours de ta déclaration
      </h2>
      <p class="gd-sous">De tes recettes jusqu'aux cotisations sociales</p>
    </div>

    <div class="gd-flux">
      {/* Column 1: Recettes */}
      <div class="gd-col">
        <div class="gd-col-tete">
          <div class="gd-rond">
            <Banknote className="gd-ic" />
          </div>
          <h3>Recettes</h3>
        </div>
        <div class="gd-calcul">
          <div class="gd-calcul-haut">CA Brut total</div>
          <div class="gd-calcul-ligne">− Rétrocessions versées <span>(réel L21/BG · micro pré-déduit)</span></div>
          <div class="gd-calcul-ligne">− Redevance collaboration <span>(réel L16/BG · micro pré-déduit)</span></div>
          <div class="gd-calcul-ligne">− Revenus exonérés (ZFU + PDSA)</div>
          <div class="gd-calcul-total">
            = CA Net déclarable
          </div>
        </div>
        <div class="gd-vers"><span class="gd-sr">↓</span><svg viewBox="0 0 12 16" width="12" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 1.5v12.5M1.5 9.5 6 14l4.5-4.5"/></svg></div>
      </div>

      {/* Column 2: Fiscal */}
      <div class="gd-col">
        <div class="gd-col-tete">
          <div class="gd-rond plan">
            <FileText className="gd-ic" />
          </div>
          <h3>Fiscal (IR)</h3>
        </div>
        <div class="gd-pile">
          <div class="gd-lot">
            <p class="gd-sur">Micro-BNC</p>
            <a href="#case-5HQ" class={nodeClass}><span class="gd-code">5HQ</span> — CA déclarable</a>
          </div>
          <div class="gd-lot">
            <p class="gd-sur">Réel BNC</p>
            <div class="gd-pile serre">
              <a href="#case-2035" class={nodeClass}><span class="gd-code">2035</span> — Liasse fiscale</a>
              <a href="#case-CI" class={nodeClass}><span class="gd-code">CI</span> — Divers à déduire (PDSA)</a>
              <a href="#case-5QC" class={nodeClass}><span class="gd-code">5QC</span> — Bénéfice net</a>
            </div>
          </div>
          <div class="gd-lot">
            <p class="gd-sur">Cases 2035-A déductibles</p>
            <div class="gd-pile serre">
              <a href="#case-BT" class={nodeClass}><span class="gd-code">BT</span> — Cot. IJ CPAM (0,30 %)</a>
              <a href="#case-BU" class={nodeClass}><span class="gd-code">BU</span> — Cot. PER/Madelin</a>
            </div>
          </div>
          <a href="#case-5HP" class={nodeClass}><span class="gd-code">5HP</span> — Exonéré ZFU/ZRR/JEI (net)</a>
          <div class="gd-pile serre gd-autres">
            <p class="gd-sur">Autres cases 2042</p>
            <a href="#case-1AS" class={nodeClass}><span class="gd-code">1AS</span> — IJ CARMF retraite</a>
            <a href="#case-1AZ" class={nodeClass}><span class="gd-code">1AZ</span> — IJ CARMF invalidité</a>
            <a href="#case-1AJ" class={nodeClass}><span class="gd-code">1AJ</span> — Salaires (gardes hospitalières)</a>
            <a href="#case-6QS" class={nodeClass}><span class="gd-code">6QS</span> — Info plafond PER</a>
            <a href="#case-8UZ" class={nodeClass}><span class="gd-code">8UZ</span> — CESU pré-financés</a>
            <a href="#case-4BE" class={nodeClass}><span class="gd-code">4BE</span> — Loyer pro domicile</a>
          </div>
        </div>
      </div>

      {/* Column 3: Social */}
      <div class="gd-col">
        <div class="gd-col-tete">
          <div class="gd-rond ok">
            <HeartPulse className="gd-ic" />
          </div>
          <h3>Social (DSFU)</h3>
        </div>
        <div class="gd-pile serre">
          {socialNodes.map(n => (
            <a
              href={`#case-${n.code}`}
              title={n.deprecated ? 'Case supprimée pour les revenus 2026 — réintégrée via le RBS (DSDE/DSDG).' : undefined}
              class={`${nodeClassFull} ${n.deprecated ? 'retire' : ''}`}
            >
              <span class="gd-code">{n.code}</span> — {n.label}
            </a>
          ))}
          {/* SEL-specific cases */}
          <div class="gd-pile serre gd-autres">
            <p class="gd-sur">
              <Building2 className="gd-ic" /> SELARL / SELAS
            </p>
            {selNodes.map(n => (
              <a href={`#case-${n.code}`} class={nodeClassFull}>
                <span class="gd-code">{n.code}</span> — {n.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
