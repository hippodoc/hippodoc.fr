---
/**
 * Aiguillage vers les pages filles du guide.
 *
 * Ajout du 23 août 2026 (MIGRATION.md § 9.ap) : sans ce bloc, les pages filles
 * ne seraient atteignables que par le sitemap. Une page qu'aucun lien interne
 * ne désigne est explorée tard et mal — c'est le motif « Détectée, actuellement
 * non indexée » qui touchait déjà 48 URL du domaine.
 *
 * Bloc purement additif : aucune section existante du hub n'est modifiée.
 *
 * DA 2026 (phase 5d, MIGRATION.md § 9.el) : quatre fiches en relief sur le ciel,
 * sous la barre de recherche.
 */
const PAGES = [
  {
    href: '/guide-declarations/dsfu-pamc',
    titre: 'DSFU (ex DS-PAMC)',
    detail: 'Les 15 cases du volet social, une par une',
  },
  {
    href: '/guide-declarations/2042-c-pro',
    titre: '2042-C-PRO',
    detail: '5HQ, 5QC et les cases d’exonération',
  },
  {
    href: '/guide-declarations/medecin-remplacant',
    titre: 'Médecin remplaçant',
    detail: 'Les cases et les pièges de ce statut',
  },
  {
    href: '/guide-declarations/calculette',
    titre: 'HippoCalc',
    detail: 'Calculette 2035 · 2042 · DSFU',
  },
];
---

<nav aria-label="Pages détaillées du guide" class="gd-droit da-bloc">
  <div class="wrap">
    <h2 class="gd-sur">
      Aller droit au but
    </h2>
    <p class="gd-droit-p">
      Cette page réunit tout. Ces quatre-là traitent un point précis, en détail.
    </p>
    <ul class="gd-droit-liste">
      {PAGES.map((p) => (
        <li>
          <a
            href={p.href}
            class="gd-porte"
          >
            <span class="gd-porte-nom">{p.titre}</span>
            <span class="gd-porte-sous">{p.detail}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
