---
/** Portage verbatim de DisclaimerSection.tsx (SPA source). */
import { ShieldCheck } from 'lucide-react';
---

<section id="disclaimer" class="py-8 md:py-10 scroll-mt-20">
  <div class="max-w-5xl mx-auto px-4">
    <div class="p-5 rounded-2xl bg-slate-50/80 border border-slate-200/60 dark:bg-slate-800/40 dark:border-slate-700/50">
      <div class="flex items-start gap-3">
        <ShieldCheck className="h-5 w-5 text-muted-foreground shrink-0 mt-0.5" />
        <p class="text-xs text-muted-foreground leading-relaxed">
          Ce contenu est <strong class="text-muted-foreground">purement informatif</strong> et ne remplace pas l'avis d'un expert-comptable ou d'un avocat spécialisé.
          Chaque information doit être vérifiée selon ta situation individuelle — les niveaux de certitude reflètent un consensus terrain, pas une vérité absolue.
        </p>
      </div>
    </div>
  </div>
</section>
