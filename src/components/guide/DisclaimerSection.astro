---
/** Portage verbatim de DisclaimerSection.tsx (SPA source).
 *  DA 2026 (phase 5d, MIGRATION.md § 9.el) : une fiche à plat, sous les articles. */
import { ShieldCheck } from 'lucide-react';
---

<section id="disclaimer" class="gd-avis">
  <div class="wrap">
    <div class="gd-avis-fiche">
      <div class="gd-avis-in">
        <ShieldCheck className="gd-ic" />
        <p>
          Ce contenu est <strong>purement informatif</strong> et ne remplace pas l'avis d'un expert-comptable ou d'un avocat spécialisé.
          Chaque information doit être vérifiée selon ta situation individuelle — les niveaux de certitude reflètent un consensus terrain, pas une vérité absolue.
        </p>
      </div>
    </div>
  </div>
</section>
