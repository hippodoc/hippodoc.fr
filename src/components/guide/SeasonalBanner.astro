---
/**
 * Portage statique de SeasonalBanner.tsx (SPA source). Déviation : la
 * source recalculait `new Date().getMonth()` à chaque rendu client (page
 * React) ; ici le mois est figé au moment du build Astro statique (output:
 * 'static') — le bandeau reflète donc la date du dernier déploiement, pas
 * la date de visite. Comportement identique à `CalendrierSection.astro`
 * (même contrainte de build statique). Bouton `onClick={scrollTo}` → ancre
 * `<a href="#profils">`.
 *
 * DA 2026 (phase 5d, MIGRATION.md § 9.el) : même comportement (dans le flux,
 * entre l'en-tête et <main>, il part avec la page ; libellé de l'échéance
 * masqué sur téléphone, où il ne reste que son signe ; fin de phrase masquée
 * sur téléphone). L'en-tête est une pastille qui flotte : le bandeau devient
 * une pastille lui aussi, sur le ciel, juste dessous. `ton` remplace les trois
 * dégradés : `alerte` (échéance de paiement), `info` (les deux autres).
 */
import { Clock, AlertTriangle, Gift } from 'lucide-react';

const month = new Date().getMonth();

type SeasonalMsg = {
  Icon: typeof Clock;
  text: string;
  linkText?: string;
  linkTarget?: string;
  textAfter?: string;
  ton: 'info' | 'alerte';
  badge?: string;
};

function getSeasonalMessage(): SeasonalMsg | null {
  if (month >= 3 && month <= 5) {
    return {
      Icon: Clock,
      text: 'Choisis ton ',
      linkText: 'profil ci-dessous',
      linkTarget: 'profils',
      textAfter: ' pour savoir quelles cases remplir.',
      ton: 'info',
      badge: 'Période de déclaration',
    };
  }
  if (month === 10) {
    return {
      Icon: AlertTriangle,
      text: "L'avis de CFE est disponible. Paiement avant le 15 décembre.",
      ton: 'alerte',
      badge: 'Échéance CFE',
    };
  }
  if (month === 11) {
    return {
      Icon: Gift,
      text: "Dernière chance pour optimiser ton année : Chèques Vacances ANCV, Madelin, achats de matériel.",
      ton: 'info',
      badge: "Fin d'année fiscale",
    };
  }
  return null;
}

const msg = getSeasonalMessage();
// Composant dynamique : Astro exige une variable capitalisée pour un tag
// composant — on l'extrait plutôt que d'utiliser `msg.Icon` en notation pointée.
const Icon = msg?.Icon ?? null;
---

{msg && Icon && (
  <div class="gd-echeance da-bloc">
    <div class={`gd-echeance-in ${msg.ton}`}>
      {msg.badge && (
        <span class="gd-echeance-nom">
          <Icon className="gd-ic" />
          {msg.badge}
        </span>
      )}
      <span class="gd-echeance-signe"><Icon className="gd-ic" /></span>
      <span class="gd-echeance-texte">
        {msg.text}
        {msg.linkText && msg.linkTarget && (
          <a href={`#${msg.linkTarget}`}>
            {msg.linkText}
          </a>
        )}
        {msg.textAfter && <span class="gd-echeance-suite">{msg.textAfter}</span>}
      </span>
    </div>
  </div>
)}
