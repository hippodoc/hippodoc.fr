---
/**
 * Portage statique de HeroSection.tsx (SPA source). Déviations volontaires
 * (page 100 % statique, zéro JS hors îlots) :
 *  - `motion.div` (framer-motion) → markup brut, mêmes classes.
 *  - Boutons `onClick={scrollTo(...)}` → ancres `<a href="#profils">`
 *    (scroll natif, `scroll-behavior: smooth` déjà globale — voir global.css).
 *  - Bouton "Contribuer" (ouvre le chat Crisp) : Crisp n'est pas repris sur
 *    le site public (cf. MIGRATION.md §6, contrainte "zéro JS hors
 *    îlots + PostHog") → retiré, noté comme omission dans le rapport.
 *  - `ShareButton` (Web Share API / presse-papiers, JS) : retiré (même
 *    contrainte) — le lien reste partageable via l'URL de la page.
 *  - "Sources officielles" (toggle JS) → `<details>/<summary>` natif.
 *
 * DA 2026 (phase 5d, MIGRATION.md § 9.el) : le titre sur le ciel, à gauche ; « enfin
 * claires » dans le bleu de l'eau ; le bouton qui mène à la boussole en jaune.
 * Styles dans src/styles/guide.css (`gd-tete`). Mascotte qui montre du doigt
 * (décor, les fichiers de l'accueil, retournée pour désigner le titre), à
 * partir de 1 024 px.
 */
import { getImage } from 'astro:assets';
import pointe from '@/assets/accueil/mascotte-f-pointe.webp';
import { format } from 'date-fns';
import { fr } from 'date-fns/locale';
import { Compass, ShieldCheck, Calculator, ChevronDown, ExternalLink, BookOpen } from 'lucide-react';
import { GUIDE_DECLARATIONS_LAST_UPDATED as LAST_UPDATED } from '@/lib/guide/lastUpdated';

const SOURCES_OFFICIELLES = [
  {
    label: 'Brochure IR 2026',
    url: 'https://www.impots.gouv.fr/www2/fichiers/documentation/brochure/ir_2026/accueil.htm',
  },
  {
    label: 'Notice 2035',
    url: 'https://www.impots.gouv.fr/sites/default/files/formulaires/2035-sd/2026/2035-sd_5385.pdf',
  },
  {
    label: 'Guide déclaration PAMC 2026',
    url: 'https://www.impots.gouv.fr/sites/default/files/media/1_metier/1_particulier/EV/1_declarer/190_travailleur_independant/pamc/pam_guide-declaration-revenus_v1.0-du-09-04-2026.pdf',
  },
  /* Ajouts août 2026 (MIGRATION.md § 9.an) : les trois premières sources ne
     couvraient que le fiscal. Le guide traite pourtant autant de social — DSFU,
     RSPM, affiliation CARMF — sans qu'aucune source ne soit atteignable d'un clic.
     Chaque URL ci-dessous a été vérifiée (200) avant d'être ajoutée.
     ⚠️ Volontairement des pages de référence durables, pas des permaliens BOFiP :
     ces derniers embarquent un identifiant numérique et une date de publication
     (…/2495-PGP.html/identifiant=BOI-…-20260407) qui changent à chaque
     republication. Sur une page fiscale, un lien mort est pire que pas de lien. */
  {
    label: 'Régime micro-BNC',
    url: 'https://entreprendre.service-public.gouv.fr/vosdroits/F32105',
  },
  {
    label: 'Déclarations du PAMC',
    url: 'https://entreprendre.service-public.gouv.fr/vosdroits/F36740',
  },
  {
    label: 'Dispositif simplifié remplaçants (RSPM)',
    url: 'https://entreprendre.service-public.gouv.fr/vosdroits/R63763',
  },
  {
    label: 'Affiliation et dispense CARMF',
    url: 'https://www.carmf.fr/page.php?page=cdrom/coti/coti-affiliation.htm',
  },
  {
    label: 'Déduction forfaitaire de 10 %',
    url: 'https://www.impots.gouv.fr/particulier/questions/comment-puis-je-beneficier-de-la-deduction-forfaitaire-de-10',
  },
];

const updatedLabel = format(LAST_UPDATED, 'd MMMM yyyy', { locale: fr });

/* La mascotte : mêmes largeurs et mêmes formats que dans accueil/PourQui.astro,
   donc les mêmes fichiers (aucune image de plus dans le build). */
const [mascotteAvif, mascotteWebp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: pointe, format, width: 300, widths: [150, 300, 450, 620] }))
);
---

<section class="gd-tete da-bloc">
  <div class="wrap">
    <div class="gd-tete-in">
      <div class="gd-gages">
        <div class="chip ok gd-gage">
          <span class="gd-point" aria-hidden="true"></span>
          Mis à jour le {updatedLabel}
        </div>
        <div class="chip plan gd-gage">
          <ShieldCheck className="gd-ic" />
          Terrain + sources officielles
        </div>
      </div>

      {/* L'espace entre la virgule et le <span> est supprimé au build : sans le
          `{' '}` explicite, le h1 se lit « sociales,enfin claires ».
          « enfin claires » ne se coupe pas en deux (§ 9.ed). */}
      <h1 class="aff">
        Tes déclarations fiscales et sociales,{' '}
        <span class="gd-eau gd-num">
          enfin claires
        </span>
      </h1>

      <p class="lead">
        2042-C-PRO, 2035, DSFU (ex DS-PAMC) : chaque case expliquée, chaque piège signalé.
        Guide pratique créé par des médecins, pour des médecins.
      </p>

      {/* Signature visible : le pendant à l'écran du `author` JSON-LD. Une page
          fiscale anonyme n'inspire pas confiance, à un lecteur comme à un moteur. */}
      <p class="gd-signe">
        Écrit et tenu à jour par{' '}
        <a href="/qui-sommes-nous" class="lien">
          Dr. Ryan Goburdhun
        </a>, médecin remplaçant et fondateur d'Hippodoc · Révisé le {updatedLabel}
      </p>

      <div class="gd-actions">
        <a
          href="#profils"
          class="btn btn-brand"
        >
          <Compass className="gd-ic" />
          Trouver ma situation
        </a>
        <a
          href="/guide-declarations/calculette"
          class="btn btn-line"
        >
          <Calculator className="gd-ic" />
          Calculette
        </a>
      </div>
      <details class="gd-sources">
        <summary>
          <BookOpen className="gd-ic" />
          Sources officielles
          <ChevronDown className="gd-ic gd-chevron" />
        </summary>
        <div class="gd-sources-in">
          {SOURCES_OFFICIELLES.map((source, i) => (
            <span class="gd-source">
              {i > 0 && <span class="gd-sep">·</span>}
              <a
                href={source.url}
                target="_blank" rel="noopener noreferrer"
              >
                {source.label}
                <ExternalLink className="gd-ic" />
              </a>
            </span>
          ))}
        </div>
      </details>
    </div>
    <picture class="gd-guide">
      <source type="image/avif" srcset={mascotteAvif.srcSet.attribute} sizes="264px" />
      <img src={mascotteWebp.src} srcset={mascotteWebp.srcSet.attribute} sizes="264px" alt="" width={mascotteWebp.attributes.width} height={mascotteWebp.attributes.height} loading="lazy" decoding="async" />
    </picture>
  </div>
</section>
