---
/**
 * Portage statique de PremiumCtaSection.tsx (SPA source). Déviations
 * volontaires :
 *  - Copie personnalisée par profil sélectionné (`PROFIL_COPY`) : le
 *    profil n'est plus connu côté page statique (îlot boussole autonome)
 *    → on affiche systématiquement `FALLBACK_COPY` (copie générique de
 *    la source, mot pour mot).
 *  - Lien CTA principal "Démarrer mon essai gratuit 30 jours" : la source
 *    pointait vers `/essai` (interne SPA) → changé vers
 *    `${APP_URL}/auth?tab=signup` (consigne de portage).
 *  - `trackEvent(...)` sur clic → attributs `data-track` (PostHog
 *    autocapture, cf. Header.astro), pas de handler JS.
 *  - `motion.div` (framer-motion, whileInView) → markup brut.
 *
 * DA 2026 (phase 5d, MIGRATION.md § 9.el) : une fiche sur l'eau profonde, dans la
 * scène de fin. Le Super-Net sur du jaune, comme partout dans la DA ; le bouton
 * de l'essai en jaune, celui du simulateur en blanc. Les deux halos et le
 * reflet (décor) disparaissent. Styles dans src/styles/guide.css.
 */
import { Wand2, Calculator, Check, TrendingUp } from 'lucide-react';
import { APP_URL } from '@/lib/site';

const badge = "Quel que soit ton mode d'exercice";
const subtitle = 'URSSAF, CARMF et impôts consolidés à chaque encaissement.';

const BENEFICES = [
  'Charges & amortissements suivis',
  '2035, 2042-C-PRO & DSFU pré-remplies',
  'Factures, contrats, statistiques & prévisionnel intégrés',
];
---

<section id="cta-premium" class="gd-essai" aria-labelledby="cta-premium-title">
  <div class="wrap">
    <div class="gd-essai-fiche">
      <div class="gd-essai-in">
        <div class="gd-essai-in2">
          <div class="gd-essai-pile">
            <div class="gd-essai-centre">
              <div class="gd-essai-gage">
                <Wand2 className="gd-ic" />
                {badge}
              </div>
            </div>

            <div class="gd-essai-titre">
              <h2 id="cta-premium-title">
                Ton <span class="hl">Super-Net</span>,<br class="gd-br-tel" /> calculé en temps réel.
              </h2>
              <p class="lead">
                {subtitle}
              </p>
            </div>

            {/* Mockup statique du Super-Net — preuve visuelle, pas de données user */}
            <div class="gd-apercu">
              <div class="gd-apercu-in">
                <div class="gd-apercu-tete">
                  <div class="gd-apercu-nom">
                    Super-Net 2026
                  </div>
                  <div class="gd-apercu-vif">
                    <span class="gd-point" aria-hidden="true"></span>
                    Mis à jour à l'instant
                  </div>
                </div>

                <div class="gd-apercu-lignes">
                  <div><span>Recettes</span><span class="fort">82 400 €</span></div>
                  <div><span>− URSSAF</span><span>−12 100 €</span></div>
                  <div><span>− CARMF</span><span>−8 600 €</span></div>
                  <div><span>− Impôts</span><span>−14 200 €</span></div>
                </div>

                <div class="gd-apercu-filet"></div>

                <div class="gd-apercu-total">
                  <span>Super-Net</span>
                  <span class="hl">
                    47 500 €
                  </span>
                </div>
                <div class="gd-apercu-plus">
                  <TrendingUp className="gd-ic" />
                  +1 240 € ce mois
                </div>
              </div>
            </div>

            <ul class="gd-essai-atouts">
              {BENEFICES.map((b) => (
                <li>
                  <Check className="gd-ic" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>

            <div class="gd-essai-boutons">
              <a
                href={`${APP_URL}/auth?tab=signup`}
                data-track="guide_declarations_cta_essai"
                class="btn btn-brand"
              >
                Démarrer mon essai gratuit 30 jours
                <svg class="gd-fl" viewBox="0 0 16 12" width="16" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 6h12.5M9.5 1.5 14 6l-4.5 4.5"/></svg>
              </a>
              <a
                href="/simulateur"
                data-track="guide_declarations_cta_simulateur"
                aria-label="Tester le simulateur public sans inscription"
                class="btn btn-white"
              >
                <Calculator className="gd-ic" />
                Tester le simulateur
              </a>
            </div>

            <p class="gd-essai-mention">
              30 jours offerts · Sans engagement · Données hébergées dans l'Union européenne
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
