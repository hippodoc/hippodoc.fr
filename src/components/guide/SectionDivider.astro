---
/**
 * Portage verbatim (markup + classes) de SectionDivider.tsx (SPA source).
 * Séparateur de zone : pastille numérotée + titre + hint. 4 zones :
 * 1·Commence ici · 2·Référence rapide · 3·Pour aller plus loin · 4·Outils pratiques.
 *
 * DA 2026 (phase 5d, MIGRATION.md § 9.el) : c'est l'en-tête d'une feuille (une
 * feuille par étape). Le numéro dans une pastille encre, le titre de l'étape en
 * grand. Mêmes éléments, même ordre ; l'indice reste écrit deux fois (sous le
 * titre sur téléphone, à droite au-delà), un seul est affiché.
 */
interface Props {
  step: 1 | 2 | 3 | 4;
  label: string;
  hint?: string;
  /** Réduit l'espacement vertical (utile pour le 1er divider sous une recherche sticky). */
  compact?: boolean;
}

const { step, label, hint, compact } = Astro.props;
---

<div class:list={['wrap', 'gd-etape', compact && 'compact']}>
  <div class="gd-etape-in">
    <span class="gd-etape-num">
      {step}
    </span>
    <div class="gd-etape-txt">
      <p class="gd-sur">
        Étape {step} / 4
      </p>
      <h2>
        {label}
      </h2>
      {hint && (
        <p class="gd-etape-indice bas">
          {hint}
        </p>
      )}
    </div>
    {hint && (
      <span class="gd-etape-indice cote">
        {hint}
      </span>
    )}
  </div>
</div>
