---
/**
 * Carte d'article des pages de liste du blog (/blog et /blog/serie/*).
 *
 * Habillée dans la DA 2026 en phase 5c (MIGRATION.md § 9.ef) : une fiche blanche
 * en relief, la couverture dedans, à coins ronds. Lien, titre (et son niveau),
 * extrait, date, durée, série et numéro : ceux d'avant, dans le même ordre.
 * Aucune classe utilitaire : les styles sont dans `src/styles/blog-liste.css`,
 * la feuille des quatre pages de liste.
 *
 * La classe `blog-card s-<seriesId>` est conservée : elle reste utile pour cibler
 * une série en CSS.
 *
 * Format des couvertures : toutes en PORTRAIT (2:3, 3:4 ou 4:5), titre dessiné en
 * haut. Le cadre est 4:5, ancré sur le haut : une 4:5 s'affiche entière, une 2:3
 * ne perd que le bas. Sur téléphone, la carte passe à l'horizontale (vignette à
 * gauche) : une couverture 4:5 pleine largeur ferait ~430 px de haut par carte.
 */
import { blogSeries } from '@/lib/blog-series';
import { nouer, echapper } from '@/lib/typo';

interface Props {
  /** Niveau du titre de carte : 3 quand la grille est sous un h2 de section (/blog). */
  headingLevel?: 2 | 3;
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  readTime: string;
  seriesId: string;
  episodeNumber?: number;
  cover?: { src: string; width: number; height: number; srcSmall?: string };
  /** Charge la couverture en priorité (première carte de la grille) plutôt qu'en différé. */
  eager?: boolean;
}

const {
  headingLevel = 2, slug, title, description, pubDate, readTime, seriesId, episodeNumber, cover, eager = false,
} = Astro.props;

const series = blogSeries.find((s) => s.id === seriesId);

const formatDate = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---

<article class={`blog-card s-${seriesId} bl-carte`}>
  <a href={`/blog/${slug}`} data-ph="blog_card">
    {cover && (
      <div class="bl-vignette">
        <img
          src={cover.src}
          srcset={cover.srcSmall ? `${cover.srcSmall} 320w, ${cover.src} ${cover.width}w` : undefined}
          sizes={cover.srcSmall ? '(min-width: 1024px) 270px, (min-width: 640px) 45vw, 112px' : undefined}
          alt=""
          width={cover.width}
          height={cover.height}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
        />
      </div>
    )}
    <div class="bl-carte-texte">
      <div class="bl-marques">
        {series && <span class="chip plan">{series.name}</span>}
        {episodeNumber !== undefined && seriesId !== 'divers' && (
          <span class="bl-numero">#{episodeNumber}</span>
        )}
      </div>
      <Heading set:html={nouer(echapper(title))} />
      <p class="bl-extrait" set:html={nouer(echapper(description))} />
      <div class="bl-infos">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span>{readTime}</span>
      </div>
    </div>
  </a>
</article>
