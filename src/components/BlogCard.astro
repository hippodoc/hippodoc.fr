---
/**
 * Ligne d'article des pages de liste du blog (/blog et /blog/serie/*).
 *
 * Habillée dans la DA 2026 en phase 5c (MIGRATION.md § 9.ej), puis mise en
 * lignes sur une feuille au § 9.fk : l'affiche en vignette à gauche, la série et
 * le numéro en petites capitales, le titre, l'extrait (masqué au téléphone, il
 * reste dans le HTML), date et durée. Lien, titre (et son niveau), extrait,
 * date, durée, série et numéro : ceux d'avant, dans le même ordre.
 * Aucune classe utilitaire : les styles sont dans `src/styles/blog-liste.css`,
 * la feuille des quatre pages de liste.
 *
 * La classe `blog-card s-<seriesId>` est conservée : elle reste utile pour cibler
 * une série en CSS.
 *
 * Les affiches (§ 9.fo) : toutes en PORTRAIT (2:3, 0,75, 0,79 ou 0,805), titre dessiné
 * en haut. Elles ne se rognent jamais : montrées entières dans un cadre 4:5, calées en
 * haut, sur un fond pris aux couleurs de leurs bords (`bords`, calculé à la construction
 * par `src/lib/affiche-bords.mjs`). Cadre de 26,5 % de la largeur de l'écran au
 * téléphone (88 à 112 px : 95 px à 360, 104 px à 393), 144 px à partir de 640 px.
 * `sizes` dit ces largeurs ; `src` et dimensions déclarées sont ceux d'avant.
 */
import { blogSeries } from '@/lib/blog-series';
import { nouer, echapper, nouerNombres } from '@/lib/typo';

interface Props {
  /** Niveau du titre de carte : 3 quand la grille est sous un h2 de section (/blog). */
  headingLevel?: 2 | 3;
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  readTime: string;
  seriesId: string;
  episodeNumber?: number;
  cover?: { src: string; width: number; height: number; srcset?: string; bords?: string };
  /** Charge la couverture en priorité (première carte de la grille) plutôt qu'en différé. */
  eager?: boolean;
}

const {
  headingLevel = 2, slug, title, description, pubDate, readTime, seriesId, episodeNumber, cover, eager = false,
} = Astro.props;

const series = blogSeries.find((s) => s.id === seriesId);

const formatDate = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---

<article class={`blog-card s-${seriesId} bl-carte`}>
  <a href={`/blog/${slug}`} data-ph="blog_card">
    {cover && (
      <div class="bl-vignette">
        <img
          src={cover.src}
          srcset={cover.srcset}
          sizes={cover.srcset ? '(min-width: 640px) 144px, (min-width: 423px) 112px, 26.5vw' : undefined}
          alt=""
          width={cover.width}
          height={cover.height}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          style={cover.bords}
        />
      </div>
    )}
    <div class="bl-carte-texte">
      <div class="bl-marques">
        {series && <span class="chip plan">{series.name}</span>}
        {episodeNumber !== undefined && seriesId !== 'divers' && (
          <span class="bl-numero">#{episodeNumber}</span>
        )}
      </div>
      <Heading set:html={nouer(echapper(title))} />
      <p class="bl-extrait" set:html={nouer(nouerNombres(echapper(description)))} />
      <div class="bl-infos">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span>{readTime}</span>
      </div>
    </div>
  </a>
</article>
