---
/**
 * PostHog — mesure d'audience SANS COOKIE, sous exemption de consentement (CNIL).
 * Chargé en module différé : ne bloque jamais le rendu.
 *
 * ⚠️ Changement d'architecture, novembre 2026 (MIGRATION.md § 9.hi). PostHog
 * tournait pour tout le monde avec un cookie `.hippodoc.fr` de 395 jours, au nom
 * de la même exemption. L'audit du 16 novembre 2026 a montré qu'elle ne tenait
 * pas : IP complète conservée (réglage du projet), échéance du cookie repoussée à
 * chaque page vue, et navigation www rattachée au compte nominatif à l'inscription
 * (le cookie était commun avec l'app, qui appelle `identify`).
 *
 * Désormais `cookieless_mode: 'always'` : PostHog ne dépose AUCUN cookie et
 * n'écrit rien dans le localStorage ni le sessionStorage. Son serveur calcule un
 * identifiant anonyme du jour (jour, navigateur, IP, site), puis jette l'IP. Rien
 * ne relie plus un visiteur de www à son compte sur l'app.
 *   - Finalité : mesure d'audience du site, jamais la publicité.
 *   - Aucun montant saisi n'est envoyé (tranches seulement, § 9.hi).
 *   - Ni enregistrement de session, ni heatmap, ni dead-click.
 *   - Droit d'opposition en un clic (`/politique-confidentialite`).
 *
 * ⚠️ PRÉREQUIS côté projet : « Cookieless tracking » (Settings › Web analytics)
 * doit être activé, sinon PostHog JETTE les événements sans cookie.
 *
 * ⚠️ En mode `always`, PostHog ignore `opt_out_capturing()`. L'opposition est donc
 * appliquée ICI, dans `before_send`, qui rend `null` (événement abandonné).
 *
 * Attribution des campagnes vers l'app : plus de cookie partagé ; les liens vers
 * app.hippodoc.fr reçoivent les `utm_*` de la première page de la visite (voir
 * `transmettreCampagne`). Jamais les identifiants de clic publicitaire (Google, Meta).
 *
 * Ce qui reste soumis au bandeau : GA4 et le Meta Pixel (ThirdPartyScripts.astro).
 */
---
<script>
  import posthog from 'posthog-js';
  import { creerEmetteur } from '@/lib/analytics-commun';
  import { caviarderEvenement } from '@/lib/caviardage-url';

  const CLE_PROJET = 'phc_x3JYWa7EjhuuwVVBLyks74ud58ZmUppaC666QkmTUXox';

  /**
   * Consentement PUBLICITAIRE, lu comme ThirdPartyScripts : le cookie
   * `hippodoc-consent` (domaine parent) fait foi, `localStorage` en repli.
   * Ici il ne sert qu'à ne pas effacer le cookie PostHog de l'app (voir
   * `effacerAncienIdentifiant`).
   */
  function readConsent(): string | null {
    const partage = (window as unknown as { hippodocConsent?: () => string | null }).hippodocConsent;
    if (typeof partage === 'function') {
      try {
        return partage();
      } catch {
        /* on retombe sur la lecture locale */
      }
    }
    try {
      const m = document.cookie.match(/(?:^|;\s*)hippodoc-consent=([^;]+)/);
      if (m) return decodeURIComponent(m[1]);
    } catch {
      /* cookies inaccessibles */
    }
    try {
      return localStorage.getItem('cookie-consent');
    } catch {
      return null;
    }
  }

  /**
   * Opposition à la MESURE D'AUDIENCE — à ne pas confondre avec le consentement
   * publicitaire du bandeau. Cookie de domaine parent, pour que l'opposition vaille
   * aussi sur l'app.
   */
  function mesureRefusee(): boolean {
    try {
      if (/(?:^|;\s*)hippodoc-mesure=refusee/.test(document.cookie)) return true;
    } catch {
      /* cookies inaccessibles */
    }
    try {
      return localStorage.getItem('hippodoc-mesure') === 'refusee';
    } catch {
      return false;
    }
  }

  posthog.init(CLE_PROJET, {
    api_host: 'https://t.hippodoc.fr',
    ui_host: 'https://eu.posthog.com',
    // Aucun cookie, aucun stockage local : identifiant anonyme calculé par le serveur.
    cookieless_mode: 'always',
    persistence: 'memory',
    autocapture: true,
    capture_pageview: true,
    capture_pageleave: true,
    person_profiles: 'identified_only',
    disable_session_recording: true,
    // Opposition : en mode `always`, seul `before_send` peut encore arrêter un envoi.
    // Jetons de connexion Supabase (fragment `#access_token=…`) : jamais dans une URL
    // envoyée. Le script de tête de BaseLayout renvoie déjà ces visites vers l'app
    // avant tout chargement ; ceci est le filet (§ 9.ea).
    before_send: (evenement) => (mesureRefusee() ? null : caviarderEvenement(evenement)),
    // PostHog chargeait `surveys.js` — 98 Ko — sur CHAQUE page du site alors
    // qu'aucune enquête n'est configurée sur le projet (table `surveys` vide).
    disable_surveys: true,
    // ⚠️ Heatmaps et dead-clicks relèvent de l'analyse comportementale, pas de la
    // mesure d'audience : coupés ici ET côté projet (la configuration distante
    // l'emporte sur la config client quand celle-ci ne dit rien).
    capture_heatmaps: false,
    capture_dead_clicks: false,
  });

  /**
   * Nettoyage des anciens traceurs de PostHog (avant § 9.hi) : identifiant de 395
   * jours dans le localStorage de www et cookie `ph_<clé>_posthog` sur
   * `.hippodoc.fr`.
   * ⚠️ Le cookie est commun avec app.hippodoc.fr, qui l'utilise pour un visiteur
   * ayant ACCEPTÉ les cookies : on ne l'efface que sans cet accord, sinon on
   * casserait l'identité de l'app. Son domaine est rejoué tel qu'il a été posé.
   */
  function effacerAncienIdentifiant(): void {
    try {
      localStorage.removeItem(`ph_${CLE_PROJET}_posthog`);
      for (const cle of Object.keys(sessionStorage)) {
        if (cle.startsWith(`ph_${CLE_PROJET}`)) sessionStorage.removeItem(cle);
      }
    } catch {
      /* stockage indisponible */
    }
    if (readConsent() === 'accepted') return;
    try {
      const hote = window.location.hostname;
      const domaines = ['', `;domain=${hote}`, `;domain=.${hote}`];
      const parties = hote.split('.');
      if (parties.length > 2) domaines.push(`;domain=.${parties.slice(-2).join('.')}`);
      for (const brut of document.cookie.split(';')) {
        const nom = brut.split('=')[0].trim();
        if (!/^ph_.*_posthog$/.test(nom)) continue;
        for (const d of domaines) {
          document.cookie = `${nom}=;path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT${d}`;
        }
      }
    } catch {
      /* cookies indisponibles */
    }
  }
  effacerAncienIdentifiant();

  /**
   * Attribution vers l'app, sans cookie : les liens vers app.hippodoc.fr reçoivent
   * les `utm_*` de la PREMIÈRE page de la visite (contexte de session de
   * `analytics-commun`, en sessionStorage, sans identifiant). L'app les lit à
   * l'arrivée (`readUtmAttribution`, `readFirstTouchAttribution`) et les rattache à
   * l'inscription. Sans campagne, une source externe (Instagram, Google…) part en
   * `utm_source` avec `utm_medium=referral`. Jamais les identifiants de clic de Google ou Meta : ce sont des
   * identifiants publicitaires, ils n'ont pas à suivre la personne dans son compte.
   */
  function transmettreCampagne(): void {
    try {
      const { contexte } = creerEmetteur(posthog);
      const lire = (cle: string): string | null => {
        const v = contexte['initial_' + cle] ?? contexte[cle];
        return typeof v === 'string' && v ? v : null;
      };
      const parametres: Record<string, string> = {};
      for (const cle of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']) {
        const v = lire(cle);
        if (v) parametres[cle] = v.slice(0, 200);
      }
      // Référent de la PREMIÈRE page (celui de la page courante est www dès la 2e).
      const hote = typeof contexte.initial_referrer_host === 'string' ? contexte.initial_referrer_host : '';
      if (!parametres.utm_source && hote && !hote.includes('hippodoc')) {
        const familles = ['google', 'instagram', 'facebook', 'linkedin', 'bing', 'whatsapp'];
        parametres.utm_source = familles.find((f) => hote.includes(f)) ?? hote.slice(0, 100);
        parametres.utm_medium = 'referral';
      }
      if (!Object.keys(parametres).length) return;
      for (const lien of document.querySelectorAll<HTMLAnchorElement>('a[href^="https://app.hippodoc.fr"]')) {
        const url = new URL(lien.href);
        // Un lien qui porte déjà sa campagne (partenaire, e-mail) la garde.
        if (url.searchParams.has('utm_source')) continue;
        for (const [cle, v] of Object.entries(parametres)) url.searchParams.set(cle, v);
        lien.href = url.toString();
      }
    } catch {
      /* la mesure peut échouer, jamais la page */
    }
  }
  if (!mesureRefusee()) transmettreCampagne();

  /**
   * Droit d'opposition, exercé depuis `/politique-confidentialite`.
   * Écrit sur le domaine parent pour valoir aussi sur `app.hippodoc.fr`, selon le
   * même principe que `hippodoc-consent` (cf. MIGRATION.md §9.x) — et le domaine
   * est DÉRIVÉ de l'hôte, un navigateur rejetant un cookie dont le domaine ne
   * correspond pas à l'hôte courant.
   */
  function memoriserOpposition(refusee: boolean): void {
    const valeur = refusee ? 'refusee' : 'acceptee';
    try {
      localStorage.setItem('hippodoc-mesure', valeur);
    } catch {
      /* stockage indisponible : le cookie suffit */
    }
    try {
      const partage = /(^|\.)hippodoc\.fr$/.test(window.location.hostname) ? ';domain=.hippodoc.fr' : '';
      document.cookie =
        `hippodoc-mesure=${valeur}${partage};path=/;max-age=${60 * 60 * 24 * 395};samesite=lax` +
        (window.location.protocol === 'https:' ? ';secure' : '');
    } catch {
      /* cookies indisponibles */
    }
  }

  /** Le texte est rendu au build pour l'état « active » : on le corrige si le
   *  visiteur s'est déjà opposé, sinon la page affirmerait le contraire de la
   *  réalité à quelqu'un qui revient vérifier son choix. */
  function afficherEtat(refusee: boolean): void {
    const etat = document.getElementById('mesure-etat');
    if (!etat) return;
    etat.textContent = refusee
      ? 'Vous êtes opposé à la mesure d’audience. Plus aucune donnée de navigation n’est collectée.'
      : 'La mesure d’audience est active. Elle produit des statistiques anonymes de fréquentation.';
  }
  afficherEtat(mesureRefusee());

  document.addEventListener('click', (ev) => {
    const cible = (ev.target as HTMLElement | null)?.closest<HTMLElement>('[data-mesure]');
    if (!cible) return;
    ev.preventDefault();
    const refuser = cible.dataset.mesure === 'refuser';
    // `before_send` relit ce cookie à chaque événement : l'effet est immédiat.
    memoriserOpposition(refuser);
    afficherEtat(refuser);
  });

  /**
   * Analytics de page. Chargées ICI, après `init()`, pour deux raisons : l'ordre
   * d'exécution est garanti (un second <script> ne l'aurait pas été) et l'instance
   * `posthog` est la même (le module est un singleton).
   * Import dynamique et aiguillé par chemin : une page non mesurée ne télécharge
   * rien, et le code reste hors du chemin critique de rendu.
   */
  const cheminMesure = window.location.pathname.replace(/\/$/, '') || '/';
  const pageMesuree = cheminMesure === '/' || /^\/(tarifs|faq|comparatif|guide-declarations|guide|blog|simulateur)(\/|$)/.test(cheminMesure);
  // Toute page qui porte un lien Calendly charge aussi le module : c'est lui qui y
  // reporte les UTM et mesure le clic. /qui-sommes-nous, absente de la liste, en
  // était privée (§ 9.dr) — ce test couvre d'office les prochains liens.
  if (pageMesuree || document.querySelector('a[data-calendly]')) {
    import('@/lib/analytics-init')
      .then((m) => m.initAnalytics(posthog))
      .catch(() => {
        /* la mesure peut échouer, jamais la page */
      });
  }

  /**
   * ⚠️ Les événements de consentement passent par `creerEmetteur`, PAS par
   * `posthog.capture()` en direct : sans lui, ils partaient sans `deployment_env`,
   * `device_type` ni `utm_*` (mesuré), et le taux de refus n'était comparable ni par
   * appareil ni par campagne. `creerEmetteur` est mémoïsé : l'appeler ici comme dans
   * `analytics-init` ne compte qu'une seule page vue.
   */
  window.addEventListener('hippodoc:consent-changed', (e) => {
    const value = (e as CustomEvent).detail;
    const { emettre } = creerEmetteur(posthog);
    // Le bandeau ne gouverne que les traceurs publicitaires (GA4, Meta Pixel) ; la
    // mesure d'audience, sans cookie, n'en dépend pas.
    emettre(value === 'accepted' ? 'cookie_consent_granted' : 'cookie_consent_denied');
  });
</script>
