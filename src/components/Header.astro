---
import { APP_URL } from '@/lib/site';

/**
 * Header global — style « glass » porté de src/components/landing/Header.tsx.
 * Nav minimaliste (passe de simplification août 2026) : 3 ancres vers les
 * sections clés de la landing (« Découvrir », « Pour qui », « Tarifs ») + un
 * seul dropdown « Ressources ». Dropdown 100 % CSS (hover/focus-within) : les
 * liens restent dans le HTML statique (contrairement à Radix). Menu mobile à
 * plat 100 % CSS (checkbox) ; seul un micro-script inline referme le tiroir
 * quand on clique une ancre de la même page (aucune navigation ne se produit,
 * le CSS seul ne peut pas décocher la checkbox).
 */

const anchorItems = [
  { href: '/#film-presentation', label: 'Découvrir', ph: 'landing_nav_decouvrir' },
  { href: '/#parcours', label: 'Pour qui', ph: 'landing_nav_pour_qui' },
  { href: '/#pricing', label: 'Tarifs', ph: 'landing_nav_pricing' },
];

const resourceItems = [
  { href: '/simulateur', label: 'Simulateur', ph: 'landing_resource_simulateur' },
  { href: '/guide-declarations', label: 'Guide déclarations', ph: 'landing_resource_guide-declarations' },
  { href: '/blog', label: 'Blog', ph: 'landing_resource_blog' },
  { href: '/faq', label: 'FAQ', ph: 'landing_resource_faq' },
  { href: '/qui-sommes-nous', label: 'Qui sommes-nous ?', ph: 'landing_resource_qui-sommes-nous' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 w-full px-3 pt-2 sm:px-4 sm:pt-3">
  <!-- Checkbox du menu mobile : enfant direct du header (hors du conteneur
       backdrop-blur, qui créerait un containing block et casserait `fixed`
       pour l'overlay et le tiroir ci-dessous). -->
  <input type="checkbox" id="mobile-menu-toggle" class="peer sr-only" />
  <div
    class="mx-auto flex h-16 max-w-[1320px] items-center justify-between rounded-2xl border border-[hsl(var(--landing-glass-border)/0.58)] bg-[hsl(var(--landing-glass)/0.74)] px-3 shadow-[var(--shadow-landing-glass)] backdrop-blur-xl backdrop-saturate-150 sm:px-5 lg:rounded-full lg:px-6"
  >
    <a
      href="/"
      class="flex min-h-11 shrink-0 items-center gap-2 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      aria-label="Hippodoc — accueil"
    >
      <img src="/lovable-uploads/hippodoc-logo-96.webp" alt="" width="40" height="40" class="h-10 w-auto" />
      <span class="hidden text-lg font-bold text-hippo-700 sm:inline sm:text-xl">Hippo<span class="text-hippo-500">doc</span></span>
    </a>

    <nav class="hidden items-center gap-5 xl:gap-6 lg:flex" aria-label="Navigation principale">
      {anchorItems.map((item) => (
        <a
          href={item.href}
          data-ph={item.ph}
          class="inline-flex min-h-11 items-center text-[15px] font-medium text-hippo-800 transition-colors hover:text-hippo-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          {item.label}
        </a>
      ))}

      <!-- Dropdown « Ressources » 100 % CSS (hover + focus-within) ; liens toujours dans le HTML -->
      <div class="group relative">
        <button
          type="button"
          class:list={[
            'inline-flex min-h-11 cursor-pointer items-center gap-1 text-[15px] font-medium transition-colors group-hover:text-hippo-600 group-focus-within:text-hippo-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring',
            resourceItems.some((item) => item.href === currentPath) ? 'text-hippo-600' : 'text-hippo-800',
          ]}
        >
          Ressources
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="invisible absolute right-0 top-full z-50 pt-2 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="w-56 rounded-xl border border-[hsl(var(--landing-glass-border)/0.72)] bg-[hsl(var(--landing-glass)/0.92)] p-1.5 shadow-[var(--shadow-landing-glass-scrolled)] backdrop-blur-xl backdrop-saturate-150">
            {resourceItems.map((item) => (
              <a
                href={item.href}
                data-ph={item.ph}
                aria-current={currentPath === item.href ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center rounded-lg px-3 text-[15px] font-medium transition-colors hover:bg-hippo-50 hover:text-hippo-600',
                  currentPath === item.href ? 'text-hippo-600' : 'text-hippo-800',
                ]}
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <div class="hidden items-center gap-2 lg:flex">
        <a
          href={`${APP_URL}/auth`}
          data-ph="landing_login_header"
          class="inline-flex h-10 items-center justify-center rounded-md px-4 py-2 text-[15px] font-semibold text-hippo-800 transition-colors hover:bg-hippo-50 hover:text-hippo-600"
        >
          Connexion
        </a>
        <a
          href={`${APP_URL}/auth?tab=signup`}
          data-track="cta_signup_header"
          class="inline-flex h-10 items-center justify-center rounded-full bg-hippo-600 px-5 py-2 text-[15px] font-semibold text-primary-foreground shadow-lg shadow-hippo-500/20 transition-colors hover:bg-hippo-700"
        >
          Essai gratuit 30j
        </a>
      </div>

      <!-- Bouton hamburger (le tiroir lui-même est un frère du conteneur, plus bas) -->
      <label
        for="mobile-menu-toggle"
        data-ph="landing_mobile_menu_open"
        class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl text-hippo-800 transition-colors hover:bg-hippo-50 hover:text-hippo-600 lg:hidden"
        aria-label="Ouvrir le menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </label>
    </div>
  </div>

  <!-- Menu mobile 100 % CSS : overlay + tiroir qui glisse depuis la droite (comme la source) -->
  <label
    for="mobile-menu-toggle"
    aria-hidden="true"
    class="invisible fixed inset-0 z-40 cursor-pointer bg-black/60 opacity-0 backdrop-blur-sm transition-[opacity,visibility] duration-300 peer-checked:visible peer-checked:opacity-100 motion-reduce:transition-none lg:hidden"
  ></label>

  <div
    id="mobile-menu-drawer"
    class="invisible fixed bottom-3 right-3 top-3 z-50 w-[calc(100%-1.5rem)] max-w-[360px] translate-x-[110%] overflow-hidden rounded-2xl border border-[hsl(var(--landing-glass-border)/0.72)] bg-[hsl(var(--landing-glass)/0.92)] shadow-[var(--shadow-landing-glass-scrolled)] backdrop-blur-xl backdrop-saturate-150 transition-[transform,visibility] duration-300 peer-checked:visible peer-checked:translate-x-0 motion-reduce:transition-none lg:hidden"
  >
        <div class="flex h-full flex-col px-5 pb-4 pt-5">
          <div class="flex min-h-11 items-center justify-between">
            <span class="flex items-center gap-2">
              <img src="/lovable-uploads/hippodoc-logo-96.webp" alt="" width="36" height="36" class="h-9 w-auto" />
              <span class="text-lg font-bold text-hippo-700">Hippo<span class="text-hippo-500">doc</span></span>
            </span>
            <label for="mobile-menu-toggle" class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl text-hippo-700" aria-label="Fermer le menu">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </label>
          </div>
          <nav class="mt-5 flex min-h-0 flex-1 flex-col overflow-y-auto" aria-label="Navigation mobile">
            <div class="space-y-1">
              {anchorItems.map((item) => (
                <a
                  href={item.href}
                  data-ph={`landing_mobile_${item.ph.replace('landing_', '')}`}
                  class="flex min-h-12 items-center gap-3 rounded-xl px-3 text-base font-semibold text-hippo-800 transition-colors hover:bg-hippo-50 hover:text-hippo-600"
                >
                  {item.label}
                </a>
              ))}
            </div>
            <p class="mb-1 mt-5 px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Ressources</p>
            <div class="space-y-1">
              {resourceItems.map((item) => (
                <a
                  href={item.href}
                  data-ph={`landing_mobile_${item.ph.replace('landing_', '')}`}
                  class="flex min-h-12 items-center gap-3 rounded-xl px-3 text-base font-semibold text-hippo-800 transition-colors hover:bg-hippo-50 hover:text-hippo-600"
                >
                  {item.label}
                </a>
              ))}
            </div>
          </nav>
          <div class="mt-4 grid grid-cols-2 gap-2 border-t border-hippo-100 pt-4">
            <a
              href={`${APP_URL}/auth`}
              class="inline-flex h-11 items-center justify-center rounded-full border border-hippo-200 px-3 text-sm font-semibold text-hippo-700 transition-colors hover:bg-hippo-50 hover:text-hippo-600"
            >
              Connexion
            </a>
            <a
              href={`${APP_URL}/auth?tab=signup`}
              data-track="cta_signup_header_mobile"
              class="inline-flex h-11 items-center justify-center rounded-full bg-hippo-600 px-2 text-sm font-semibold text-primary-foreground shadow-lg shadow-hippo-500/20 transition-colors hover:bg-hippo-700"
            >
              Essai gratuit 30j
            </a>
          </div>
        </div>
  </div>

  <!-- Cliquer une ancre de la page courante ne déclenche aucune navigation :
       la checkbox doit être décochée explicitement, sinon le tiroir reste ouvert. -->
  <script is:inline>
    document.getElementById('mobile-menu-drawer').addEventListener('click', function (e) {
      if (e.target.closest('a')) document.getElementById('mobile-menu-toggle').checked = false;
    });
  </script>
</header>
