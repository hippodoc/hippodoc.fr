---
/**
 * Syndicats d'internes, partenaires et soutiens (DA 2026, phase 3,
 * MIGRATION.md § 9). Feuille « sable », entre les témoignages et les tarifs
 * (épure de novembre 2026, MIGRATION.md § 9.eu : les syndicats et leurs 6 mois
 * d'essai mènent aux prix ; avant, feuille « ciel » juste après le fondateur).
 *
 * - Épure de novembre 2026 : les quatre tuiles sont plus basses, et sous la
 *   fiche des 6 mois il n'y a plus qu'UNE feuille blanche à la place de quatre
 *   objets (deux cartes de partenaires, deux plaques de soutiens) : le titre
 *   des partenaires en étiquette, leurs deux lignes, un filet, puis « Soutenu
 *   par », les trois logos sur une rangée sans plaque et leurs deux légendes
 *   dessous. Deux colonnes à partir de 900 px. Le HTML garde l'ordre « logos
 *   d'un soutien, sa légende » : c'est la feuille qui range les logos puis les
 *   légendes (`order`, les <li> s'effacent). Fin du chapô retirée (« pour
 *   accompagner leurs adhérents dans leurs premiers remplacements »).
 * - Décision du propriétaire (10 novembre 2026) : les syndicats d'internes ont
 *   une vraie place, pas une ligne discrète. Seuls les partenariats SIGNÉS sont
 *   affichés : SILR, CRP-IMG, SIOI, AIMGL (Limoges), HomeDoc, Doctripper. Deux
 *   autres sont en cours : ne pas les ajouter avant signature. La ville figure
 *   sur chaque tuile (un autre syndicat porte le sigle AIMGL).
 * - Textes repris de /qui-sommes-nous (titre, introduction, noms, villes,
 *   descriptions, textes alternatifs, liens).
 * - Essai de 6 mois : décision 13a du propriétaire (10 novembre 2026), TOUS les
 *   syndicats d'internes partenaires donnent 6 mois d'essai au lieu d'un mois,
 *   sans exception. La phrase vague reprise de /faq (« Certains syndicats…
 *   un essai prolongé ») est remplacée par une phrase exacte, mise en avant
 *   sous les quatre tuiles : une fiche bleu profond, comme l'offre annuelle
 *   et le sélecteur de profils. Seul texte nouveau du bloc.
 * - Décision 14c (10 novembre 2026, nuit) : les 6 mois sont gratuits, réservés
 *   aux adhérents et obtenus avec un code fourni par leur syndicat. La fiche le
 *   dit dans la même phrase, mot pour mot (« grâce à un code fourni par leur
 *   syndicat »), fin de phrase gardée sur sa ligne : « Le code est fourni par
 *   ton syndicat. » citait « le code » sans l'avoir annoncé et passait de
 *   « les adhérents » à « ton », au risque d'être confondu avec le « code
 *   promo » du tarif interne (pli des tarifs). Aucun nom de code, aucune marche
 *   à suivre : rien d'autre n'est confirmé (et verify-site.mjs, garde
 *   « 4 octies », refuse un code promo affiché). « au lieu de 30 jours » et non
 *   plus « d'un mois » : la durée dite partout ailleurs sur la page.
 * - Mesure : `data-landing-section="partners"` (la série continue) ; les cinq
 *   `data-ph="landing_partner_*"` de l'ancienne section sont gardés,
 *   `landing_partner_homedoc` est nouveau sur l'accueil.
 * - Soutiens : Région Île-de-France et Bpifrance sont UNE seule aide
 *   (Innov'Up, § 9.dq), d'où leurs deux logos sur la même plaque.
 * - Logos : les fichiers de public/lovable-uploads/, copiés dans
 *   src/assets/accueil/partenaires/ pour passer par astro:assets (AVIF et
 *   WebP). Plusieurs ont un fond blanc opaque : tous sont posés sur du blanc.
 *   Retouches de fond, sans toucher au dessin : le voile gris du fichier
 *   CRP-IMG est ramené au blanc ; les logos des trois soutiens sont rognés au
 *   ras du dessin (leurs fichiers étaient à moitié vides, d'où des logos
 *   minuscules) ; celui de la Région vient de logo-region-idf.png (275 px).
 * - Les quatre logos de syndicats sont calés sur une même masse : chacun a sa
 *   part de la zone (`h`, `l`, en pour cent), le rond et le carré un peu
 *   moins hauts que les logos en largeur.
 * - Les soutiens ne sont montrés qu'ici : le pied de l'accueil ne répète pas
 *   leurs logos (Footer.astro, prop `soutiens`).
 * - Texte alternatif des syndicats : le nom complet seul (le sigle est écrit
 *   juste dessous, il était lu deux fois).
 * - Titres : un <h2>, un <h3> (les deux partenaires).
 */
import '@/styles/da.css';
import { Picture } from 'astro:assets';
import silr from '@/assets/accueil/partenaires/silr-logo.jpg';
import crpImg from '@/assets/accueil/partenaires/crp-img-logo.png';
import sioi from '@/assets/accueil/partenaires/sioi-logo.jpg';
import aimgl from '@/assets/accueil/partenaires/aimgl-logo.png';
import homedoc from '@/assets/accueil/partenaires/homedoc-logo-160.webp';
import doctripper from '@/assets/accueil/partenaires/doctripper-logo.png';
import regionIdf from '@/assets/accueil/partenaires/region-idf.png';
import bpifrance from '@/assets/accueil/partenaires/bpifrance.png';
import frenchCare from '@/assets/accueil/partenaires/french-care.png';

/* `largeur` : la largeur d'affichage la plus grande, en px (un fichier à cette
   largeur, un au double). `h` et `l` : la part de la zone du logo qu'il peut
   occuper, en hauteur et en largeur (zone de 88 px de haut sur ordinateur,
   58 px sur téléphone). */
const syndicats = [
  { ph: 'silr', nom: 'SILR', complet: 'Syndicat des Internes du Languedoc-Roussillon', ville: 'Montpellier', logo: silr, largeur: 112, h: 100, l: 100, url: 'https://www.silr.fr/le-silr/nos-partenaires/' },
  { ph: 'crp_img', nom: 'CRP-IMG', complet: 'Internes de médecine générale de Poitiers', ville: 'Poitiers', logo: crpImg, largeur: 168, h: 100, l: 76, url: 'https://www.isnar-img.com/villes/poitiers-crp-img/' },
  { ph: 'sioi', nom: 'SIOI', complet: "Syndicat des Internes de l'Océan Indien", ville: 'La Réunion', logo: sioi, largeur: 186, h: 100, l: 84, url: 'https://www.sioi974.fr/' },
  { ph: 'aimgl', nom: 'AIMGL', complet: 'Association des Internes de Médecine Générale de Limoges', ville: 'Limoges', logo: aimgl, largeur: 116, h: 100, l: 100, url: 'https://www.aimgl.fr' },
];

const partenaires = [
  { ph: 'homedoc', nom: 'HomeDoc', texte: 'Le logement des internes en médecine', logo: homedoc, largeur: 52, url: 'https://homedoc.fr' },
  { ph: 'doctripper', nom: 'Doctripper', texte: 'Plateforme de remplacements médicaux', logo: doctripper, largeur: 54, url: 'https://doctripper.com' },
];
---

<section data-landing-section="partners" class="band da-bloc pt" aria-labelledby="partenaires-titre">
  <div class="wrap">
    <div class="band-head">
      <h2 id="partenaires-titre">Aux côtés des internes, partout en France</h2>
      <p class="lead">Ces syndicats d'internes ont signé une convention avec Hippodoc.</p>
    </div>

    <ul class="synd" role="list">
      {syndicats.map((s) => (
        <li>
          <a class="tile" href={s.url} target="_blank" rel="noopener noreferrer" data-ph={`landing_partner_${s.ph}`}>
            <span class="logo" style={`--h:${s.h}%;--l:${s.l}%`}>
              <Picture src={s.logo} formats={['avif', 'webp']} fallbackFormat="webp" width={s.largeur} widths={[s.largeur, 2 * s.largeur]} sizes={`${s.largeur}px`} alt={s.complet} loading="lazy" decoding="async" />
            </span>
            <span class="nom">{s.nom}</span>{' '}
            <span class="ville">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              {s.ville}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="plus"><b class="aff num">6 mois</b>{' '}<span>d’essai gratuit au lieu de 30 jours, pour les adhérents de ces syndicats,{' '}<span class="code">grâce à un code fourni par leur syndicat.</span></span></p>

    <div class="feuille">
      <div class="jeunes">
        <h3>Et des partenaires pensés pour les jeunes médecins</h3>
        <ul class="parts" role="list">
          {partenaires.map((p) => (
            <li>
              <a class="part" href={p.url} target="_blank" rel="noopener noreferrer" data-ph={`landing_partner_${p.ph}`}>
                <span class="logo">
                  <Picture src={p.logo} formats={['avif', 'webp']} fallbackFormat="webp" width={p.largeur} widths={[p.largeur, 2 * p.largeur]} sizes={`${p.largeur}px`} alt="" loading="lazy" decoding="async" />
                </span>
                <span class="txt"><b>{p.nom}</b>{' '}<span>{p.texte}</span></span>
                <svg class="fl" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 14.5 14.5 5.5M7 5.5h7.5V13"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="backers">
        <p class="backers-t">Soutenu par</p>
        <ul role="list">
          <li>
            <span class="plaque">
              <Picture src={regionIdf} formats={['avif', 'webp']} fallbackFormat="webp" width={105} widths={[105, 210]} sizes="105px" alt="Région Île-de-France" style="--h:26px" loading="lazy" decoding="async" />
              <Picture src={bpifrance} formats={['avif', 'webp']} fallbackFormat="webp" width={88} widths={[88, 176]} sizes="88px" alt="Bpifrance" style="--h:28px" loading="lazy" decoding="async" />
            </span>
            <span class="leg">Lauréat Innov'Up</span>
          </li>
          <li>
            <span class="plaque">
              <Picture src={frenchCare} formats={['avif', 'webp']} fallbackFormat="webp" width={39} widths={[39, 78]} sizes="39px" alt="La French Care" style="--h:66px" loading="lazy" decoding="async" />
            </span>
            <span class="leg">Membre de La French Care</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .synd, .parts, .backers ul { margin: 0; padding: 0; list-style: none; }
  .num { white-space: nowrap; }

  /* Règles communes aux feuilles de l'épure (remplissage, chapô, marge sous
     l'en-tête), écrites ici et non dans da.css, commune à toutes les pages. */
  .lead { text-wrap-style: balance; }
  @media (max-width: 559px) {
    .pt { padding: 44px 0 72px; }
    .band-head { margin-bottom: 22px; }
    .lead { font-size: 17px; }
  }
  @media (min-width: 900px) {
    .pt { padding: 76px 0 112px; }
    .band-head { margin-bottom: 36px; }
  }

  /* Les quatre syndicats : deux par ligne sur téléphone, quatre à partir de 640 px. */
  .synd { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .tile { display: flex; flex-direction: column; align-items: center; gap: 2px; height: 100%; box-sizing: border-box; padding: 14px 10px 15px; border-radius: 26px; background: var(--paper); box-shadow: var(--clay); color: var(--ink); text-align: center; text-decoration: none; transition: translate 200ms var(--ease); }
  .tile:hover { translate: 0 -3px; }
  .tile .logo { display: flex; align-items: center; justify-content: center; width: 100%; height: 58px; margin-bottom: 8px; }
  /* <picture> s'efface : c'est l'image qui se cale dans la boîte du logo. */
  .logo :global(picture), .plaque :global(picture) { display: contents; }
  /* Sans cela, chaque <source> compterait pour un élément de la rangée (et son écart). */
  .logo :global(source), .plaque :global(source) { display: none; }
  .logo :global(img) { display: block; width: auto; max-width: var(--l, 100%); height: auto; max-height: var(--h, 100%); object-fit: contain; }
  .nom { font-size: 17px; font-weight: var(--tb); line-height: 1.25; }
  .ville { display: inline-flex; align-items: center; gap: 5px; font-size: 14px; color: var(--ink-2); }
  .ville svg { flex: none; color: var(--brand); }
  /* L'essai de 6 mois des adhérents : une fiche bleu profond sous les tuiles,
     le chiffre en grand, puis deux phrases courtes (l'offre, le code). */
  .plus { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 20px; margin: 12px 0 0; padding: 15px 20px 17px; border-radius: 24px; background: linear-gradient(var(--deep), #1F4FAF); color: var(--paper); font-size: 16px; line-height: 1.4; box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.22), inset 0 -5px 0 rgba(10, 25, 70, 0.22), 0 22px 44px -22px rgba(13, 40, 105, 0.6); }
  .plus b { --corps: 34px; flex: none; }
  .plus span { flex: 1 1 15rem; color: var(--on-deep-2); text-wrap-style: balance; }
  /* Le code : fin de la phrase, toujours sur sa propre ligne. Lignes équilibrées
     au-dessus : plus de « syndicats. » seul sur la sienne (900 px). */
  .plus .code { display: block; }

  /* Une seule feuille blanche : les deux partenaires, puis les soutiens. */
  .feuille { --survol: #F4F7FE; margin-top: 12px; overflow: hidden; border-radius: 24px; background: var(--paper); box-shadow: var(--clay-sm); }
  /* Le titre des partenaires, en étiquette. */
  .feuille h3, .backers-t { margin: 0; font-family: var(--text); font-size: 16px; font-weight: 660; line-height: 1.35; letter-spacing: 0; color: var(--ink-2); text-wrap-style: balance; }
  .feuille h3 { padding: 18px 20px 6px; }
  /* Deux lignes, séparées par un filet qui s'arrête aux marges de la feuille ;
     au survol, toute la ligne se teinte et la flèche part vers le site. */
  .parts li { margin: 0 20px; }
  .parts li + li { border-top: 1px solid var(--line); }
  .part { display: flex; align-items: center; gap: 14px; min-height: 68px; box-sizing: border-box; margin: 0 -20px; padding: 10px 20px; color: var(--ink); text-decoration: none; transition: background-color 160ms var(--ease); }
  .part:hover { background: var(--survol); }
  .part:focus-visible { outline-offset: -4px; border-radius: 18px; }
  .part .logo { display: flex; flex: none; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 14px; background: var(--sky-soft); }
  .part .logo :global(img) { max-width: 38px; max-height: 38px; }
  .txt { display: flex; flex: 1; flex-direction: column; min-width: 0; }
  .txt b { font-size: 17px; line-height: 1.3; }
  .txt span { font-size: 14.5px; line-height: 1.4; color: var(--ink-2); text-wrap-style: balance; }
  .fl { flex: none; color: var(--ink); transition: translate 200ms var(--ease); }
  .part:hover .fl { translate: 2px -2px; }

  /* Les soutiens : les trois logos sur une rangée, sans plaque, leurs deux
     légendes dessous. Chaque <li> s'efface (son logo et sa légende deviennent
     des éléments de la rangée) : la feuille range les logos d'abord, un retour
     à la ligne (le pseudo-élément), puis les légendes. */
  .backers { margin: 6px 20px 0; padding: 14px 0 16px; border-top: 1px solid var(--line); color: var(--ink-2); }
  .backers ul { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 22px; margin-top: 8px; }
  .backers ul::before { content: ""; order: 2; flex-basis: 100%; height: 0; }
  .backers li { display: contents; }
  /* Chaque logo a sa hauteur (`--h`) : rognés au ras du dessin, ils n'ont pas tous le même rapport. */
  .plaque { order: 1; display: inline-flex; flex: none; align-items: center; gap: 22px; }
  .plaque :global(img) { display: block; flex: none; width: auto; height: calc(var(--h) * 0.8); }
  .leg { order: 3; font-size: 13px; line-height: 1.35; }

  @media (max-width: 379px) {
    .backers ul, .plaque { column-gap: 16px; }
  }
  @media (min-width: 640px) {
    .synd { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .plus { margin-top: 14px; }
    .feuille { margin-top: 14px; }
    .leg { font-size: 14.5px; }
  }
  /* Ordinateur : la feuille sur deux colonnes, les partenaires à gauche, les
     soutiens à droite, un filet entre les deux. */
  @media (min-width: 900px) {
    .plus { gap: 4px 28px; margin-top: 18px; padding: 20px 34px 22px; border-radius: 30px; font-size: 18px; }
    .plus b { --corps: 48px; }
    .synd { gap: 18px; }
    .tile { gap: 3px; padding: 20px 20px 22px; border-radius: 32px; }
    .tile .logo { height: 88px; margin-bottom: 12px; }
    .nom { font-size: 21px; }
    .ville { font-size: 15px; }
    .feuille { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); margin-top: 18px; border-radius: 30px; }
    .feuille h3 { padding: 24px 32px 8px; }
    .jeunes { padding-bottom: 10px; }
    .parts li { margin: 0 32px; }
    .part { min-height: 76px; margin: 0 -32px; padding: 12px 32px; }
    .part .logo { width: 52px; height: 52px; }
    .part .logo :global(img) { max-width: 42px; max-height: 42px; }
    .txt b { font-size: 18px; }
    .txt span { font-size: 16px; }
    .backers { display: flex; flex-direction: column; justify-content: center; margin: 24px 0; padding: 0 32px; border-top: 0; border-left: 1px solid var(--line); }
    .backers ul { gap: 12px 28px; margin-top: 16px; }
    .plaque { gap: 28px; }
    .plaque :global(img) { height: var(--h); }
  }
  /* Contrastes forcés (Windows) : sans fond, un contour rend sa forme à la fiche. */
  @media (forced-colors: active) { .plus, .feuille { border: 1px solid CanvasText; } }
  @media (prefers-reduced-motion: reduce) {
    .tile, .part, .fl { transition: none; }
    .tile:hover, .part:hover .fl { translate: none; }
  }
</style>
