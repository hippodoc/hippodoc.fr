---
/**
 * Questions fréquentes (DA 2026, phase 3, MIGRATION.md § 9). Feuille « sable »,
 * juste sous les tarifs : la réponse « Combien coûte Hippodoc ? » dit « la
 * section tarifs juste au-dessus ». Remplace home/FaqSection.astro (supprimé
 * en phase 4a, à lire dans l'historique git).
 *
 * - Les questions viennent de src/data/faqAccueil.ts, source unique partagée
 *   avec le JSON-LD FAQPage de index.astro : toutes, dans leur ordre, textes
 *   non touchés (seules les espaces devant « ? » et « : » deviennent insécables
 *   à l'affichage, src/lib/typo.ts). <details> natifs : chaque réponse est dans
 *   le HTML.
 * - Mesure : `data-landing-section="faq"` (la série continue),
 *   `data-ph="landing_faq_<id>"` sur chaque <summary>, `landing_faq_all` sur le
 *   lien vers /faq. `id="questions"` est nouveau (aucun lien ne le vise encore).
 * - Épure de novembre 2026 (MIGRATION.md § 9.eu) : huit questions au lieu de
 *   dix (src/data/faqAccueil.ts), et une seule feuille blanche à huit lignes,
 *   séparées par un filet, à la place de dix fiches. Les règles de la feuille
 *   sont ici : `.qa` (da.css) sert aussi à /faq, à /tarifs et aux plis des
 *   tarifs de l'accueil, qui gardent leurs fiches. Le chapô « Celles qu'on
 *   nous pose avant de se lancer. » est retiré.
 * - Carte de rendez-vous compacte, `data-calendly="faq_accueil"` (l'emplacement
 *   et son identifiant continuent). Le paragraphe sur Ryan est dans le bloc
 *   fondateur : seule reste ici la question (« Rien à préparer. En visio, ou
 *   il t'appelle. », dit mot pour mot dans ce bloc, est retiré à l'épure).
 *   Elle est écrite APRÈS la liste dans le HTML :
 *   l'ordre de lecture et de tabulation est celui de l'écran à toutes les
 *   largeurs (titre et lien, questions, rendez-vous). Sous 900 px, elle ferme
 *   la liste. À partir de 900 px, la grille la place dans la colonne de gauche,
 *   sous le lien (la colonne restait vide sur toute la hauteur de la liste), et
 *   elle seule suit la lecture des réponses ; le titre, lui, défile avec la page.
 * - Titres : un <h2>, un <h3> par question (dans son <summary>).
 */
import '@/styles/da.css';
import { getImage } from 'astro:assets';
import { FAQ_ACCUEIL } from '@/data/faqAccueil';
import { CALENDLY_URL } from '@/lib/site';
import { insecables } from '@/lib/typo';
import portrait from '@/assets/founders/ryan-goburdhun.jpeg';

/* Vignette de la carte de rendez-vous : 56 px, et son double. Décor (le nom est dans le bouton). */
const [avif, webp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: portrait, format, width: 56, widths: [56, 112] }))
);
---

<section data-landing-section="faq" id="questions" class="band da-bloc fq" aria-labelledby="questions-titre">
  <div class="wrap faq">
    <div class="band-head">
      <h2 id="questions-titre">Questions fréquentes</h2>
      <a class="toutes" href="/faq" data-ph="landing_faq_all">Voir toutes les questions</a>
    </div>

    <div class="liste">
      {FAQ_ACCUEIL.map((item) => (
        <details class="qa">
          <summary data-ph={`landing_faq_${item.id}`}>
            <h3>{insecables(item.question)}</h3>
            <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 3v12M3 9h12"/></svg>
          </summary>
          <div class="qa-in"><p set:html={insecables(item.answerHtml)} /></div>
        </details>
      ))}
    </div>

    {/* Prise de rendez-vous, là où le doute naît (§ 9.r) : la FAQ est la zone
        d'objection de la page. Lien simple, jamais le widget. */}
    <div class="rdv">
      <picture>
        <source type="image/avif" srcset={avif.srcSet.attribute} sizes="56px" />
        <img src={webp.src} srcset={webp.srcSet.attribute} sizes="56px" alt="" width="56" height="56" loading="lazy" decoding="async" />
      </picture>
      <p class="rdv-t">Tu veux voir ce que ça donne au quotidien&nbsp;?</p>
      <a class="btn btn-white" href={CALENDLY_URL} data-calendly="faq_accueil" target="_blank" rel="noopener">Prendre 15 min avec Ryan</a>
    </div>
  </div>
</section>

<style>
  /* Règles communes aux feuilles de l'épure (remplissage), écrites ici et non
     dans da.css, commune à toutes les pages. */
  @media (max-width: 559px) {
    .fq { padding: 44px 0 72px; }
  }
  @media (min-width: 900px) {
    .fq { padding: 76px 0 112px; }
  }
  /* Sous 900 px : le titre, la liste, puis la carte de rendez-vous, l'un sous
     l'autre, dans l'ordre du HTML. */
  .faq { --ecart: 22px; display: grid; gap: var(--ecart); }
  .faq .band-head { align-items: flex-start; gap: 6px; margin-bottom: 0; }
  /* Lien seul sur sa ligne : une cible de 44 px de haut. */
  .toutes { display: inline-flex; align-items: center; min-height: 44px; border-radius: 6px; font-weight: var(--tb); color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .toutes:hover { color: var(--brand); }

  /* Une seule feuille blanche, une ligne par question, un filet entre deux
     lignes (il s'arrête aux marges de la feuille). `.qa` (da.css) est une
     fiche : ici elle perd son fond, son ombre et sa marge, la feuille les
     porte. Au survol, toute la ligne se teinte ; l'anneau de focus est tracé
     à l'intérieur de la ligne (la feuille rogne ce qui dépasse). */
  .liste { --survol: #F4F7FE; min-width: 0; overflow: hidden; border-radius: 24px; background: var(--paper); box-shadow: var(--clay-sm); }
  .liste .qa { --marge: 20px; margin: 0; padding: 0 var(--marge); border-radius: 0; background: none; box-shadow: none; }
  .liste .qa > summary { gap: 14px; min-height: 60px; box-sizing: border-box; margin: 0 calc(-1 * var(--marge)); padding: 13px var(--marge); border-radius: 0; transition: background-color 160ms var(--ease); }
  /* Le filet : un trait d'un pixel en haut de la ligne, dessiné en fond pour
     s'arrêter aux marges alors que la ligne, elle, va d'un bord à l'autre. */
  .liste .qa + .qa > summary { background: linear-gradient(var(--line), var(--line)) no-repeat var(--marge) 0 / calc(100% - 2 * var(--marge)) 1px; }
  .liste .qa > summary:hover { background-color: var(--survol); }
  .liste .qa > summary:focus-visible { outline-offset: -4px; border-radius: 16px; }
  .liste .qa > summary h3 { font-size: 17px; line-height: 1.35; }
  .liste .qa > summary > svg { width: 30px; height: 30px; padding: 6px; }
  .liste .qa > summary:hover > svg { background: var(--sky-1); }
  .liste .qa[open] > summary:hover > svg { background: var(--sun-hover); }
  .liste .qa-in { padding: 2px 0 20px; }

  /* La carte de rendez-vous : la vignette, la question, le bouton. Le bouton
     reste sur la ligne s'il y tient, sinon il passe dessous et prend toute la
     largeur (son `flex-grow` de 1 ne pèse rien face aux 999 du texte tant
     qu'ils partagent la ligne). Elle reste à 14 px de la feuille. */
  .rdv { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 16px; margin-top: calc(14px - var(--ecart)); padding: 18px 20px 22px; border-radius: 24px; background: var(--sky); }
  .rdv picture { flex: none; }
  .rdv img { display: block; width: 56px; height: 56px; border-radius: 50%; object-fit: cover; }
  .rdv-t { flex: 999 1 190px; min-width: 0; margin: 0; font-size: 17px; font-weight: var(--tb); line-height: 1.3; color: var(--ink); text-wrap-style: balance; }
  .rdv .btn { flex: 1 0 auto; max-width: 100%; padding-block: 8px; text-align: center; }

  /* Petits téléphones : le texte reste à côté de la vignette. */
  @media (max-width: 359px) {
    .rdv-t { flex-basis: 140px; }
    .rdv .btn { padding-inline: 10px; font-size: 16px; }
    .liste .qa { --marge: 18px; }
  }
  /* Ordinateur : deux colonnes. À gauche le titre et le lien (rangée 1), puis
     la carte de rendez-vous (rangée 2) ; à droite la feuille, sur les deux
     rangées. La carte est placée par la grille, pas par le HTML. */
  @media (min-width: 900px) {
    .faq { grid-template-columns: minmax(0, 280px) minmax(0, 1fr); grid-template-rows: auto 1fr; gap: 24px 56px; }
    .faq .band-head { grid-column: 1; grid-row: 1; gap: 10px; }
    .liste { grid-column: 2; grid-row: 1 / span 2; border-radius: 28px; }
    .liste .qa { --marge: 28px; }
    .liste .qa > summary { min-height: 64px; padding-block: 14px; }
    .liste .qa > summary h3 { font-size: 18px; }
    .rdv { grid-column: 1; grid-row: 2; align-self: start; margin-top: 0; padding: 20px 20px 22px; }
    .rdv-t { flex-basis: 130px; }
  }
  /* Colonne de 280 px : le libellé du bouton tient sur une ligne. */
  @media (min-width: 900px) and (max-width: 1179px) {
    .rdv { padding-inline: 16px; }
    .rdv .btn { padding-inline: 8px; font-size: 16px; }
  }
  @media (min-width: 1180px) {
    .faq { grid-template-columns: 320px minmax(0, 1fr); column-gap: 96px; }
  }
  /* La carte suit la lecture des réponses (dans sa rangée, qui descend jusqu'au
     bas de la feuille), si l'écran est assez haut. */
  @media (min-width: 900px) and (min-height: 700px) {
    .rdv { position: sticky; top: 104px; }
  }
  /* Contrastes forcés (Windows) : sans fond ni ombre, un contour rend sa forme
     à la feuille et à la fiche ; chaque ligne garde un trait au-dessus. */
  @media (forced-colors: active) {
    .rdv, .liste { border: 1px solid CanvasText; }
    .liste .qa { border: 0; }
    .liste .qa + .qa { border-top: 1px solid CanvasText; }
  }
</style>
