---
/**
 * Questions fréquentes (DA 2026, phase 3, MIGRATION.md § 9). Feuille « sable »,
 * juste sous les tarifs : la réponse « Combien coûte Hippodoc ? » dit « la
 * section tarifs juste au-dessus ». Remplace home/FaqSection.astro.
 *
 * - Les questions viennent de src/data/faqAccueil.ts, source unique partagée
 *   avec le JSON-LD FAQPage de index.astro : toutes, dans leur ordre, textes
 *   non touchés (seules les espaces devant « ? » et « : » deviennent insécables
 *   à l'affichage, src/lib/typo.ts). <details> natifs : chaque réponse est dans
 *   le HTML.
 * - Mesure : `data-landing-section="faq"` (la série continue),
 *   `data-ph="landing_faq_<id>"` sur chaque <summary>, `landing_faq_all` sur le
 *   lien vers /faq. `id="questions"` est nouveau (aucun lien ne le vise encore).
 * - Carte de rendez-vous compacte, `data-calendly="faq_accueil"` (l'emplacement
 *   et son identifiant continuent). Le paragraphe sur Ryan est maintenant dans
 *   le bloc fondateur : seules restent ici la question et « Rien à préparer. En
 *   visio, ou il t'appelle. ». Sous 900 px, elle ferme la liste ; à partir de
 *   900 px, elle est dans la colonne de gauche, sous le lien (la colonne
 *   restait vide sur toute la hauteur de la liste), et suit la lecture avec le
 *   titre. Elle est écrite dans le HTML juste après le titre : sous 900 px,
 *   `order` la replace après la liste. Contrepartie : au clavier, sous 900 px,
 *   le bouton de rendez-vous reçoit le focus avant les questions, alors qu'il
 *   est affiché après elles.
 * - Titres : un <h2>, un <h3> par question (dans son <summary>).
 */
import '@/styles/da.css';
import { getImage } from 'astro:assets';
import { FAQ_ACCUEIL } from '@/data/faqAccueil';
import { CALENDLY_URL } from '@/lib/site';
import { insecables } from '@/lib/typo';
import portrait from '@/assets/founders/ryan-goburdhun.jpeg';

/* Vignette de la carte de rendez-vous : 56 px, et son double. Décor (le nom est dans le bouton). */
const [avif, webp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: portrait, format, width: 56, widths: [56, 112] }))
);
---

<section data-landing-section="faq" id="questions" class="band da-bloc fq" aria-labelledby="questions-titre">
  <div class="wrap faq">
    <div class="cote">
      <div class="band-head">
        <h2 id="questions-titre">Questions fréquentes</h2>
        <p class="lead">Celles qu’on nous pose avant de se lancer.</p>
        <a class="toutes" href="/faq" data-ph="landing_faq_all">Voir toutes les questions</a>
      </div>

      {/* Prise de rendez-vous, là où le doute naît (§ 9.r) : la FAQ est la zone
          d'objection de la page. Lien simple, jamais le widget. */}
      <div class="rdv">
        <picture>
          <source type="image/avif" srcset={avif.srcSet.attribute} sizes="56px" />
          <img src={webp.src} srcset={webp.srcSet.attribute} sizes="56px" alt="" width="56" height="56" loading="lazy" decoding="async" />
        </picture>
        <div class="rdv-copy">
          <p class="rdv-t">Tu veux voir ce que ça donne au quotidien&nbsp;?</p>
          <p>Rien à préparer. En visio, ou il t'appelle.</p>
        </div>
        <a class="btn btn-white" href={CALENDLY_URL} data-calendly="faq_accueil" target="_blank" rel="noopener">Prendre 15 min avec Ryan</a>
      </div>
    </div>

    <div class="liste">
      {FAQ_ACCUEIL.map((item) => (
        <details class="qa">
          <summary data-ph={`landing_faq_${item.id}`}>
            <h3>{insecables(item.question)}</h3>
            <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 3v12M3 9h12"/></svg>
          </summary>
          <div class="qa-in"><p set:html={insecables(item.answerHtml)} /></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Sous 900 px, `.cote` s'efface : le titre, la liste, puis la carte de
     rendez-vous (`order`), l'un sous l'autre. */
  .faq { --ecart: 32px; display: grid; gap: var(--ecart); }
  .cote { display: contents; }
  .faq .band-head { order: 1; align-items: flex-start; margin-bottom: 0; }
  .liste { order: 2; }
  .liste .qa:last-child { margin-bottom: 0; }
  /* La carte reste à 18 px de la dernière question, comme quand elle fermait la liste. */
  .rdv { order: 3; }
  /* Lien seul sur sa ligne : une cible de 44 px de haut. */
  .toutes { display: inline-flex; align-items: center; min-height: 44px; border-radius: 6px; font-weight: var(--tb); color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .toutes:hover { color: var(--brand); }
  .liste { min-width: 0; }

  /* La carte de rendez-vous : la vignette, le texte, le bouton. Le bouton reste
     sur la ligne s'il y tient, sinon il passe dessous et prend toute la largeur
     (son `flex-grow` de 1 ne pèse rien face aux 999 du texte tant qu'ils
     partagent la ligne). */
  .rdv { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 16px; margin-top: calc(18px - var(--ecart)); padding: 20px 22px 24px; border-radius: 24px; background: var(--sky); }
  .rdv picture { flex: none; }
  .rdv img { display: block; width: 56px; height: 56px; border-radius: 50%; object-fit: cover; }
  .rdv-copy { flex: 999 1 190px; min-width: 0; }
  .rdv-copy p { margin: 0; font-size: 16px; line-height: 1.45; color: var(--ink-2); }
  .rdv-copy .rdv-t { font-size: 17.5px; font-weight: var(--tb); line-height: 1.3; color: var(--ink); }
  .rdv .btn { flex: 1 0 auto; max-width: 100%; padding-block: 8px; text-align: center; }

  @media (max-width: 559px) {
    .faq { --ecart: 26px; }
  }
  /* Petits téléphones : le texte reste à côté de la vignette. */
  @media (max-width: 359px) {
    .rdv-copy { flex-basis: 140px; }
  }
  /* Ordinateur : la colonne de gauche porte le titre, le lien, puis la carte
     de rendez-vous. */
  @media (min-width: 900px) {
    .faq { grid-template-columns: minmax(0, 280px) minmax(0, 1fr); gap: 56px; }
    .cote { display: flex; flex-direction: column; align-self: start; gap: 28px; min-width: 0; }
    .rdv { margin-top: 0; padding: 20px 20px 22px; }
    .rdv-copy { flex-basis: 130px; }
  }
  /* Colonne de 280 px : le libellé du bouton tient sur une ligne. */
  @media (min-width: 900px) and (max-width: 1179px) {
    .rdv { padding-inline: 16px; }
    .rdv .btn { padding-inline: 8px; font-size: 16px; }
  }
  @media (min-width: 1180px) {
    .faq { grid-template-columns: 320px minmax(0, 1fr); gap: 96px; }
  }
  /* La colonne suit la lecture des réponses, si l'écran est assez haut pour la
     montrer en entier sous l'en-tête. */
  @media (min-width: 900px) and (min-height: 700px) {
    .cote { position: sticky; top: 104px; }
  }
  /* Contrastes forcés (Windows) : sans fond ni ombre, un contour rend sa forme à la fiche. */
  @media (forced-colors: active) { .rdv { border: 1px solid CanvasText; } }
</style>
