  /* Vue 3 : à recevoir */
  .due { display: grid; gap: 24px; }
  .due-sum { display: flex; flex-direction: column; gap: 4px; margin: 0; }
  .due-sum .v { --corps: clamp(40px, 9.4vw, 66px); }
