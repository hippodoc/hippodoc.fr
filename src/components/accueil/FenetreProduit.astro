  /* Mouvement : seulement si le visiteur n'a pas demandé à le réduire. */
  @media (prefers-reduced-motion: no-preference) {
    .stage:has(#apercu-super-net:checked) .p1,
    .stage:has(#apercu-journees:checked) .p2,
    .stage:has(#apercu-a-recevoir:checked) .p3,
    .stage:has(#apercu-declaration:checked) .p4 { animation: apercu-fade 300ms var(--ease) both; }
    /* La fenêtre monte en place quand elle entre à l'écran (navigateurs qui
       savent lier une animation au défilement ; les autres l'affichent telle quelle).
       ⚠️ Deux règles, deux sélecteurs : écrites ensemble, la minification du build
