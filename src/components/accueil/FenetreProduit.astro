       navigateurs refusent (toute la déclaration tombe, plus aucun mouvement). */
    @supports (animation-timeline: view()) {
      .stage { animation: apercu-arrive linear both; }
      div.stage { animation-timeline: view(); animation-range: entry 0% entry 42%; }
    }
