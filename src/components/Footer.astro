---
import '@/styles/da.css';
import { Picture } from 'astro:assets';
import ScriptTiroir from '@/components/ScriptTiroir.astro';
import frenchCare from '@/assets/accueil/partenaires/french-care.png';
import bpifrance from '@/assets/accueil/partenaires/bpifrance.png';
import regionIdf from '@/assets/accueil/partenaires/region-idf.png';

/**
 * Pied du site : l'eau profonde de la DA 2026, sur toutes les pages depuis la
 * phase 5a (MIGRATION.md § 9.ed). Il n'y a plus de copie à tenir en double.
 * Rangé par intention depuis § 9.gj (le modèle des pieds de Linear, Notion,
 * Indy) : la marque (logo, phrase, réseaux, soutiens), trois colonnes
 * (« Produit », « Ressources », « À propos »), puis une bande en petit pour les
 * pages légales, « Préférences cookies » et le ©. Avant : une seule colonne de
 * seize liens où se mêlaient outils, blog, entreprise et pages légales, trois
 * articles qui semblaient des sous-parties du comparatif, et le téléphone et
 * l'e-mail donnés deux fois. L'adresse du siège n'y est plus : elle est dans
 * les mentions légales.
 * Chaque lien porte un `data-ph="landing_footer_*"` (les liens de colonnes n'en
 * avaient pas : ils n'étaient pas mesurés). `landing_footer_phone` et
 * `landing_footer_email` passent des pastilles rondes aux lignes d'« À propos »
 * (même lien, même série). Habillage dans src/styles/da.css (classes `ft-*`),
 * sans classe Tailwind ; `da-bloc` marque un bloc de la DA (voir da.css).
 * Doit rester le premier <footer> du document : la mesure s'y accroche.
 * Logo : le mot seul, comme dans l'en-tête (voir Header.astro).
 * - Les réseaux sont les trois pastilles rondes, avec leur `data-ph`.
 * - Prop `soutiens` : la plaque « Ils soutiennent Hippodoc ». L'accueil la
 *   retire (`soutiens={false}`) : son bloc Partenaires montre déjà les trois
 *   logos, avec leur légende. Les logos passent par astro:assets (mêmes
 *   fichiers que ce bloc, dimensions réelles).
 * - Après le pied, ScriptTiroir.astro : le micro-script du tiroir mobile de
 *   l'en-tête, une fois par page (voir ce fichier).
 */
interface Props {
  /** Affiche la plaque des soutiens (à retirer sur une page qui les montre déjà). */
  soutiens?: boolean;
}
const { soutiens = true } = Astro.props;
const year = new Date().getFullYear();

const colonnes = [
  {
    titre: 'Produit',
    liens: [
      { href: '/#sous-la-surface', label: 'Comment ça marche', ph: 'landing_footer_comment-ca-marche' },
      { href: '/#parcours', label: 'Pour qui', ph: 'landing_footer_pour-qui' },
      { href: '/simulateur', label: 'Simulateur Super-Net', ph: 'landing_footer_simulateur' },
      { href: '/tarifs', label: 'Tarifs', ph: 'landing_footer_tarifs' },
      { href: '/comparatif', label: 'Comparatif des logiciels', ph: 'landing_footer_comparatif' },
    ],
  },
  {
    titre: 'Ressources',
    liens: [
      { href: '/guide-declarations', label: 'Guide des déclarations', ph: 'landing_footer_guide-declarations' },
      { href: '/guide', label: 'Guide du remplaçant (PDF)', ph: 'landing_footer_guide-remplacant' },
      { href: '/guide-declarations/calculette', label: 'Calculette fiscale', ph: 'landing_footer_calculette' },
      { href: '/blog', label: 'Blog', ph: 'landing_footer_blog' },
      { href: '/faq', label: 'FAQ', ph: 'landing_footer_faq' },
    ],
  },
  {
    titre: 'À propos',
    liens: [
      { href: '/qui-sommes-nous', label: 'Qui sommes-nous\u00a0?', ph: 'landing_footer_qui-sommes-nous' },
      { href: 'mailto:contact@hippodoc.fr', label: 'contact@hippodoc.fr', ph: 'landing_footer_email' },
      { href: 'tel:+33756898961', label: '07 56 89 89 61', ph: 'landing_footer_phone', nb: true },
    ],
  },
];

const legaux = [
  { href: '/mentions-legales', label: 'Mentions légales', ph: 'landing_footer_mentions-legales' },
  { href: '/conditions-utilisations', label: "Conditions d'utilisation", ph: 'landing_footer_conditions-utilisations' },
  { href: '/politique-confidentialite', label: 'Politique de confidentialité', ph: 'landing_footer_politique-confidentialite' },
  { href: '/rgpd', label: 'RGPD', ph: 'landing_footer_rgpd' },
];
---

<footer class="ft da-bloc">
  <div class="wrap ft-in">
    <div class="ft-marque">
      <a href="/" data-ph="landing_footer_home" class="ft-logo">
        <span class="logo-word">Hippo<span>doc</span></span>
      </a>

      <p class="ft-tagline">Le cockpit financier des médecins.</p>
      <div class="ft-social">
        <a href="https://www.linkedin.com/company/hippodoc/" data-ph="landing_footer_linkedin" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61574895730373" data-ph="landing_footer_facebook" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://www.instagram.com/hippodoc.fr/" data-ph="landing_footer_instagram" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        </a>
      </div>

      {soutiens && (
        <div class="ft-backers">
          <p>Ils soutiennent Hippodoc</p>
          <div class="ft-backers-logos">
            <Picture src={frenchCare} formats={['avif', 'webp']} fallbackFormat="webp" width={39} widths={[39, 78]} sizes="33px" alt="La French Care" style="--h:56px" loading="lazy" decoding="async" />
            <Picture src={bpifrance} formats={['avif', 'webp']} fallbackFormat="webp" width={88} widths={[88, 176]} sizes="82px" alt="Bpifrance" style="--h:26px" loading="lazy" decoding="async" />
            <Picture src={regionIdf} formats={['avif', 'webp']} fallbackFormat="webp" width={105} widths={[105, 210]} sizes="97px" alt="Région Île-de-France" style="--h:24px" loading="lazy" decoding="async" />
          </div>
        </div>
      )}
    </div>

    <nav class="ft-nav" aria-label="Plan du site">
      {colonnes.map((col) => (
        <div class="ft-col">
          <h3 class="ft-title">{col.titre}</h3>
          <ul class="ft-list">
            {col.liens.map((l) => (
              <li><a href={l.href} data-ph={l.ph} class:list={[l.nb && 'ft-nb']}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="wrap ft-legal">
    <div class="ft-legal-in">
      <ul class="ft-legaux">
        {legaux.map((l) => (
          <li><a href={l.href} data-ph={l.ph}>{l.label}</a></li>
        ))}
        <li><button type="button" data-cookie-prefs class="ft-prefs">Préférences cookies</button></li>
      </ul>
      <p>© {year} Hippodoc. Tous droits réservés.</p>
    </div>
  </div>
</footer>

{/* Micro-script du tiroir mobile de l'en-tête, hors du flux de l'en-tête. */}
<ScriptTiroir />
