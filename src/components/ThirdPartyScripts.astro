---
/**
 * Scripts tiers différés : GA4 (Consent Mode v2), Meta Pixel, Crisp,
 * + bannière cookies portée de src/components/cookies/CookieConsent.tsx (SPA source).
 *
 * Stratégie perf : rien ne se charge pendant la fenêtre Lighthouse.
 * gtag.js et Crisp ne sont injectés qu'après `load` + idle (~4 s) OU à la
 * première interaction (pointerdown/keydown/touchstart), au premier des deux.
 * Le Meta Pixel n'est chargé qu'avec le consentement « accepted » (comme la source).
 * Clé de consentement identique à la source : localStorage['cookie-consent'].
 * Calendly : simples liens HTML (zéro script) — pas de widget flottant.
 */
---

<!-- Bannière cookies (masquée par défaut ; affichée par le script si aucun choix stocké).
     ⚠️ Version compacte (août 2026). L'ancienne faisait 266 px de haut sur un iPhone,
     soit 40 % du premier écran, et RECOUVRAIT le CTA principal du hero — mesuré : le
     bouton « Commencer l'essai gratuit » était masqué par la bannière, et l'élément
     le plus visible du premier écran était « Accepter tous ». Sur du trafic payant,
     la première action demandée ne peut pas être un choix de cookies posé par-dessus
     l'offre.
     Trois décisions pour compacter sans rien perdre :
       - texte ramené de 40 à 12 mots, les FINALITÉS restant nommées (mesure
         d'audience, publicité Google/Meta) comme l'exige la CNIL, plus un lien vers
         la politique de confidentialité qui n'existait pas auparavant ;
       - les deux boutons passent côte à côte au lieu d'être empilés ;
       - la croix de fermeture est retirée : elle portait déjà
         data-cookie-action="essential", donc elle faisait exactement la même chose
         que « Tout refuser », en moins explicite, et coûtait une ligne entière.
     Refuser reste aussi simple qu'accepter — même taille, même forme, un seul
     appui — ce que la CNIL exige. -->
  <div
    id="cookie-banner"
    hidden
    class="fixed inset-x-0 bottom-[max(0.5rem,env(safe-area-inset-bottom))] z-50 mx-auto w-[calc(100%-1.5rem)] max-w-lg rounded-xl border border-border bg-white/95 p-2.5 shadow-xl backdrop-blur-sm sm:bottom-[max(1.5rem,env(safe-area-inset-bottom))] sm:p-4"
    role="dialog"
    aria-modal="false"
    aria-labelledby="cookie-banner-title"
  >
    <h3 id="cookie-banner-title" class="sr-only">Nous respectons votre vie privée</h3>

    <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:gap-4">
      <p class="flex items-start gap-2 text-xs leading-relaxed text-muted-foreground sm:flex-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-hippo-600" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        <span>
          Mesure d'audience et publicité (Google, Meta). Le site fonctionne sans.{' '}
          <a href="/politique-confidentialite" class="font-medium text-hippo-600 underline underline-offset-2 hover:text-hippo-700">En savoir plus</a>
        </span>
      </p>

      <div class="grid shrink-0 grid-cols-2 gap-2 sm:flex">
        <button type="button" data-cookie-action="essential" class="min-h-11 rounded-md border border-input bg-white px-4 text-xs font-medium text-foreground hover:bg-hippo-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-hippo-600">
          Tout refuser
        </button>
        <button type="button" data-cookie-action="accept" class="min-h-11 rounded-md bg-gradient-to-r from-hippo-500 to-hippo-600 px-4 text-xs font-medium text-white hover:from-hippo-600 hover:to-hippo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-hippo-700">
          Tout accepter
        </button>
      </div>
    </div>
  </div>

<style is:global>
  /* Le bandeau s'efface quand le tiroir de menu mobile est ouvert.
     Sans cette règle, les deux sont en z-50 et le bandeau recouvre le bas du menu :
     « Qui sommes-nous ? », « Connexion » et « Essai gratuit » disparaissaient
     derrière lui. Quelqu'un qui ouvre le menu navigue — il ne décide pas de ses
     cookies ; le bandeau revient à la fermeture.
     `:has()` est nécessaire car la case du tiroir vit dans le <header> et le
     bandeau plus loin dans le <body> : aucun sélecteur de voisinage ne les relie.
     Sur un navigateur sans `:has()`, la règle est simplement ignorée et le
     comportement reste celui d'avant — dégradation propre. */
  body:has(#mobile-menu-toggle:checked) #cookie-banner {
    display: none;
  }
</style>

<script is:inline>
  /* Bootstrap analytics — porté de index.html + CookieConsent.tsx de la SPA source. */
  (function () {
    var GA_ID = 'G-T8TFWPPW3M';
    var PIXEL_ID = '3299991043509379';
    var CRISP_ID = '3e4f14e5-8e4e-40fd-b1f5-f0b940186f56';

    /* Caviardage des URLs (jetons Supabase magic-link/OAuth) — audit source juillet 2026 */
    function scrub(raw) {
      try {
        var sensitive = ['access_token','refresh_token','provider_token','provider_refresh_token','id_token','code','token','token_hash','confirmation_token','recovery_token','invite_token'];
        var u = new URL(raw);
        for (var i = 0; i < sensitive.length; i++) if (u.searchParams.has(sensitive[i])) u.searchParams.set(sensitive[i], '<redacted>');
        return u.toString();
      } catch (e) { return raw; }
    }
    window.hippodocScrubLocation = scrub;

    function consent() {
      try { return localStorage.getItem('cookie-consent'); } catch (e) { return null; }
    }

    /* Consent Mode v2 — défaut DENIED (RGPD), AVANT tout chargement gtag.js */
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted',
      wait_for_update: 500,
    });
    gtag('set', 'ads_data_redaction', true);
    gtag('set', 'url_passthrough', true);
    gtag('js', new Date());
    gtag('config', GA_ID, {
      send_page_view: false,
      anonymize_ip: true,
      page_location: scrub(window.location.href),
      page_referrer: scrub(document.referrer || ''),
    });
    var GRANTED = { ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted', analytics_storage: 'granted' };
    if (consent() === 'accepted') gtag('consent', 'update', GRANTED);

    function inject(src, cb) {
      var s = document.createElement('script');
      s.async = true; s.src = src;
      if (cb) s.onload = cb;
      document.head.appendChild(s);
    }

    var pixelLoaded = false;
    function loadPixel() {
      if (pixelLoaded || consent() !== 'accepted') return;
      pixelLoaded = true;
      !(function (f, b, e, v, n, t) {
        if (f.fbq) return; n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
        if (!f._fbq) f._fbq = n; n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
        t = b.createElement(e); t.async = true; t.src = v; b.head.appendChild(t);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      window.fbq('init', PIXEL_ID);
      window.fbq('track', 'PageView');
    }

    var deferredDone = false;
    function loadDeferred() {
      if (deferredDone) return;
      deferredDone = true;
      /* GA4 : page_view manuel (cookieless ping si consentement refusé/absent) */
      inject('https://www.googletagmanager.com/gtag/js?id=' + GA_ID, function () {
        gtag('event', 'page_view', {
          page_path: window.location.pathname,
          page_location: scrub(window.location.href),
          page_title: document.title,
        });
      });
      loadPixel();
    }

    var crispDone = false;
    function loadCrisp() {
      if (crispDone) return;
      crispDone = true;
      window.$crisp = window.$crisp || [];
      window.CRISP_WEBSITE_ID = CRISP_ID;
      inject('https://client.crisp.chat/l.js');
    }

    /* Crisp UNIQUEMENT à la première interaction : jamais dans la fenêtre Lighthouse,
       et la bulle apparaît dès le premier geste d'un visiteur réel. */
    ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (evt) {
      addEventListener(evt, loadCrisp, { once: true, passive: true });
    });

    /* GA4 + Pixel : première interaction OU 6 s après `load` (hors trace Lighthouse) */
    ['pointerdown', 'keydown', 'touchstart'].forEach(function (evt) {
      addEventListener(evt, loadDeferred, { once: true, passive: true });
    });
    function armDeferred() { setTimeout(loadDeferred, 6000); }
    if (document.readyState === 'complete') { armDeferred(); }
    else { addEventListener('load', armDeferred); }

    /* Bannière */
    var banner = document.getElementById('cookie-banner');
    function choose(value) {
      try { localStorage.setItem('cookie-consent', value); } catch (e) {}
      if (banner) banner.hidden = true;
      if (value === 'accepted') {
        gtag('consent', 'update', GRANTED);
        gtag('event', 'page_view', {
          page_path: window.location.pathname,
          page_location: scrub(window.location.href),
          page_title: document.title,
        });
        if (deferredDone) loadPixel();
      }
      /* PostHog (module séparé) écoute cet événement pour ajuster sa persistance */
      dispatchEvent(new CustomEvent('hippodoc:consent-changed', { detail: value }));
    }
    if (banner) {
      banner.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest('[data-cookie-action]');
        if (!btn) return;
        choose(btn.getAttribute('data-cookie-action') === 'accept' ? 'accepted' : 'essential-only');
      });
      if (!consent()) banner.hidden = false;
      /* Bouton « Préférences cookies » du footer : rouvre la bannière */
      document.addEventListener('click', function (e) {
        var t = e.target && e.target.closest('[data-cookie-prefs]');
        if (t) { e.preventDefault(); banner.hidden = false; }
      });
    }
  })();
</script>
