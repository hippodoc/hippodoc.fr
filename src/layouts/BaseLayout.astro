---
import '@/styles/global.css';
// Après la feuille globale : en-tête, pied, bannière cookies et bulle de chat de
// la DA 2026 (toutes les pages depuis la phase 5a, MIGRATION.md § 9.ed).
import '@/styles/da.css';
import PostHog from '@/components/PostHog.astro';
import ThirdPartyScripts from '@/components/ThirdPartyScripts.astro';
import { SITE_URL, ORGANIZATION_SCHEMA } from '@/lib/site';
import { imagePartagePage } from '@/lib/partage-pages';
// Même fichier que le `src` du @font-face de da.css : Vite émet une seule URL à
// empreinte, le préchargement et la feuille de style demandent donc le même fichier.
import policeSite from '@/assets/fonts/google-sans-flex-latin-wght400-800-rond100.woff2?url';

interface Props {
  /** Titre unique < 60 caractères, mot-clé d'abord, marque à la fin. */
  title: string;
  /** Meta description unique ~150 caractères, en français. */
  description: string;
  /** Chemin canonique SANS slash final (ex. "/simulateur"). "" = accueil. */
  path: string;
  /** Image OG absolue ou chemin ; défaut : l'image de partage de la page (`src/lib/partage-pages.ts`,
      § 9.ha), ou celle de l'accueil. Seuls les articles du blog la donnent (la leur, § 9.fl). */
  ogImage?: string;
  ogImageAlt?: string;
  /** Dimensions réelles de ogImage (défaut : celles de l'image de la page, 1200×630). */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  /** Blocs JSON-LD additionnels (Organization est injecté partout). */
  jsonLd?: object[];
  noindex?: boolean;
  /** Classe ajoutée à <body>, après `da` (jetons de la DA 2026, sur toutes les
      pages). `da-fond` : le fond de page de la DA (ciel en haut, eau profonde
      en bas), pour une page entièrement dans la DA comme l'accueil. */
  bodyClass?: string;
}

const partage = imagePartagePage(Astro.props.path || '/');
const {
  title,
  description,
  path,
  ogImage = partage.url,
  ogImageAlt = partage.alt,
  ogImageWidth = partage.width,
  ogImageHeight = partage.height,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  bodyClass = '',
} = Astro.props;

const canonical = `${SITE_URL}${path}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
const allJsonLd = [ORGANIZATION_SCHEMA, ...jsonLd];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    {/* Jetons de connexion Supabase (§ 9.ea). Le Site URL Supabase est www : un
        lien de confirmation, de connexion ou de réinitialisation peut donc arriver
        ICI avec ses jetons dans le fragment (#access_token=…). On les retire de
        l'adresse et de l'historique, puis on poursuit le parcours sur l'app, avant
        que quoi que ce soit (mesure, scripts tiers) ait pu lire l'URL. Destination
        fixe : seul le fragment est transmis, jamais la requête. */}
    <script is:inline>
      (function () {
        try {
          var h = location.hash;
          if (!h || !/(?:^#|&)(?:access_token|refresh_token|error_code)=/.test(h)) return;
          try { history.replaceState(null, '', location.pathname + location.search); } catch (e) {}
          location.replace('https://app.hippodoc.fr/auth' + h);
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Hippodoc" />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="max-image-preview:large" />}

    {/* Canonique sur les seules pages indexables : la 404, servie sous n'importe
        quelle URL, déclarait « /404 » comme canonique. hreflang retirés : sur un
        site monolingue, fr + x-default pointant sur la page elle-même n'apportent
        rien (§ 9.bi). */}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="Blog Hippodoc" href={`${SITE_URL}/rss.xml`} />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="5jk-XYDlgOh2l9tE_lWx3TSdQ0uBUrh4iXHyxvKYe9s" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={/\.png$/i.test(ogImageUrl) ? 'image/png' : 'image/jpeg'} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Hippodoc" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hippodoc_app" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/lovable-uploads/1a136973-2c47-426b-a1ce-70d29cdabb35.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/lovable-uploads/1a136973-2c47-426b-a1ce-70d29cdabb35.png" sizes="180x180" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {allJsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {/* Police du site (Google Sans Flex, toutes les pages depuis la phase 5a, § 9.ed) :
        préchargée, sinon elle n'est découverte qu'après la feuille de style.
        `crossorigin` obligatoire : sans lui, le fichier est téléchargé deux fois. */}
    <link rel="preload" as="font" type="font/woff2" href={policeSite} crossorigin />

    <slot name="head" />
  </head>

  <body class:list={['da', bodyClass]}>
    <slot />
    <PostHog />
    <ThirdPartyScripts />
  </body>
</html>
