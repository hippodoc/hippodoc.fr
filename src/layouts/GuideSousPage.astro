---
/**
 * Gabarit des pages filles du guide des déclarations.
 *
 * Ces pages sont ADDITIVES : /guide-declarations conserve l'intégralité de son
 * contenu, elles en reprennent un sous-ensemble sous un angle que le hub ne peut
 * pas servir (un formulaire, un profil), avec leur propre titre, leur propre
 * introduction et leur propre FAQ. Voir MIGRATION.md § 9.ap.
 *
 * Le fil d'Ariane visible double le `BreadcrumbList` : Search Console suit déjà
 * les fils d'Ariane du site (rapport « Fils d'Ariane »), et un guide à deux
 * niveaux sans fil d'Ariane laisse le lecteur sans retour vers la référence.
 *
 * DA 2026 (phase 5d, MIGRATION.md § 9.el) : seul l'habillage a changé. Page
 * entièrement dans la DA (fond `da-fond`, en-tête qui flotte) : le ciel
 * (fil d'Ariane, titre, signature, chapô), les feuilles que chaque page pose
 * dans son contenu (`<div class="band da-bloc">`, sable puis ciel), et la fin
 * (les articles, « Le guide complet », l'avertissement, le soleil sur l'eau
 * du pied). Styles dans src/styles/guide.css, partagés avec le hub.
 */
import '@/styles/guide.css';
import BlogReadMore from '@/components/BlogReadMore.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_URL } from '@/lib/site';
import { GUIDE_DECLARATIONS_LAST_UPDATED, GUIDE_DECLARATIONS_LAST_UPDATED_ISO } from '@/lib/guide/lastUpdated';
import { reponsePourSchema } from '@/lib/guide/reponse-schema';

interface Props {
  title: string;
  description: string;
  /** Chemin canonique sans slash final, ex. "/guide-declarations/dsfu-pamc". */
  path: string;
  /** Titre visible (H1). Peut différer du <title>. */
  h1: string;
  /** Nom court pour le fil d'Ariane. */
  breadcrumb: string;
  /** Questions de la page pour le FAQPage JSON-LD. */
  faq?: { question: string; reponse: string }[];
  /** Articles du blog à proposer en fin de page (slugs). */
  articles?: string[];
}

const { title, description, path, h1, breadcrumb, faq = [], articles = [] } = Astro.props;

const authorSchema = {
  '@type': 'Person',
  name: 'Dr. Ryan Goburdhun',
  jobTitle: "Médecin remplaçant & fondateur d'Hippodoc",
  url: `${SITE_URL}/qui-sommes-nous`,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Guide Déclarations', item: `${SITE_URL}/guide-declarations` },
    { '@type': 'ListItem', position: 3, name: breadcrumb, item: `${SITE_URL}${path}` },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: h1,
  description,
  url: `${SITE_URL}${path}`,
  author: authorSchema,
  reviewedBy: authorSchema,
  lastReviewed: GUIDE_DECLARATIONS_LAST_UPDATED_ISO,
  dateModified: GUIDE_DECLARATIONS_LAST_UPDATED_ISO,
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: 'fr',
  isPartOf: { '@type': 'WebPage', url: `${SITE_URL}/guide-declarations` },
};

/* Le FAQPage n'est déclaré que si la page rend réellement les questions en
   clair : `verify-site.mjs` échoue si une question du JSON-LD est absente du
   texte visible, ou si une réponse n'y est pas mot pour mot (d'où
   `reponsePourSchema`, qui nomme les renvois comme l'écran). */
const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((q) => ({
        '@type': 'Question',
        name: q.question,
        acceptedAnswer: { '@type': 'Answer', text: reponsePourSchema(q.reponse) },
      })),
    }
  : null;

const dateLisible = GUIDE_DECLARATIONS_LAST_UPDATED.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/* Le titre, découpé pour l'affichage seulement : le mot qui précède « : » reste
   sur sa ligne (sur téléphone, le « : » partait seul au début de la suivante).
   Le texte du <h1> est le même, au caractère près. */
const h1Morceaux = h1.split(/(\S+ [:?!])/);

const jsonLd = faqSchema
  ? [breadcrumbSchema, webPageSchema, faqSchema]
  : [breadcrumbSchema, webPageSchema];
---

<BaseLayout title={title} description={description} path={path} ogType="article" jsonLd={jsonLd} bodyClass="da-fond">
  <Fragment slot="head">
    {/* Barre du navigateur mobile : le ciel de la DA (jeton sky-1), comme l'accueil. */}
    <meta name="theme-color" content="#C9DEFF" />
  </Fragment>
  {/* La pastille survole le ciel du premier bloc, qui lui réserve le haut. */}
  <Header />

  <main class="gd gd-fille">
    <div class="gd-tete da-bloc">
      <div class="wrap">
        <nav aria-label="Fil d'Ariane" class="gd-ariane">
          <ol>
            <li><a href="/">Accueil</a></li>
            <li aria-hidden="true">›</li>
            <li><a href="/guide-declarations">Guide Déclarations</a></li>
            <li aria-hidden="true">›</li>
            <li class="ici" aria-current="page">{breadcrumb}</li>
          </ol>
        </nav>

        <h1 class="aff">{h1Morceaux.map((m, i) => (i % 2 ? <span class="gd-num">{m}</span> : m))}</h1>

        {/* `{' '}` : un retour à la ligne collé à une balise en ligne fait disparaître
            l'espace au rendu (la page a affiché « Goburdhun,médecin » et « guide :DSFU »
            jusqu'à § 9.el ; même correction de rendu qu'en § 9.ei, aucun mot ne change). */}
        <p class="gd-signe">
          Mis à jour le {dateLisible} · révisé par Dr. Ryan Goburdhun,{' '}
          <span class="gd-num">médecin remplaçant</span>
        </p>

        <slot name="chapo" />
      </div>
    </div>

    <slot />

    <div class="gd-fin da-bloc">
      <div class="wrap gd-fin-in">
        {articles.length > 0 && (
          <div class="gd-lire">
            <BlogReadMore slugs={articles} emplacement={path.split('/').pop() ?? 'guide'} />
          </div>
        )}
        <div class="gd-complet">
          <h2>Le guide complet</h2>
          <p>
            Cette page traite un cas précis. Le guide des déclarations réunit la totalité de
            la matière : les 35 cases de formulaires, 49 questions fréquentes, 85 termes de
            glossaire, la boussole qui identifie ton profil et le calendrier annuel.
          </p>
          <p class="gd-complet-bouton">
            <a
              href="/guide-declarations"
              class="btn btn-brand"
            >
              Ouvrir le guide des déclarations
            </a>
          </p>
          <p class="gd-complet-autres">
            Autres pages du guide :{' '}
            <a href="/guide-declarations/dsfu-pamc">DSFU (ex DS-PAMC)</a> ·{' '}
            <a href="/guide-declarations/2042-c-pro">2042-C-PRO</a> ·{' '}
            <a href="/guide-declarations/medecin-remplacant">Médecin remplaçant</a> ·{' '}
            <a href="/guide-declarations/calculette">HippoCalc</a>
          </p>
        </div>

        <p class="gd-avis-p">
          Contenu informatif, à jour des règles connues au {dateLisible}. Il ne remplace pas
          l'avis d'un expert-comptable ou de ton AGA, et n'engage ni l'administration fiscale
          ni l'URSSAF. En cas de doute sur ta situation, fais vérifier ta déclaration.
        </p>
      </div>
      {/* Décor : le soleil de l'accueil se lève sur l'eau du pied de page. */}
      <div class="gd-horizon" aria-hidden="true">
        <span class="gd-soleil"></span>
        <span class="gd-vague v3"></span>
        <span class="gd-vague v4"></span>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
