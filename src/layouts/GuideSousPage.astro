---
/**
 * Gabarit des pages filles du guide des déclarations.
 *
 * Ces pages sont ADDITIVES : /guide-declarations conserve l'intégralité de son
 * contenu, elles en reprennent un sous-ensemble sous un angle que le hub ne peut
 * pas servir (un formulaire, un profil), avec leur propre titre, leur propre
 * introduction et leur propre FAQ. Voir MIGRATION.md § 9.ap.
 *
 * Le fil d'Ariane visible double le `BreadcrumbList` : Search Console suit déjà
 * les fils d'Ariane du site (rapport « Fils d'Ariane »), et un guide à deux
 * niveaux sans fil d'Ariane laisse le lecteur sans retour vers la référence.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_URL } from '@/lib/site';
import { GUIDE_DECLARATIONS_LAST_UPDATED, GUIDE_DECLARATIONS_LAST_UPDATED_ISO } from '@/lib/guide/lastUpdated';

interface Props {
  title: string;
  description: string;
  /** Chemin canonique sans slash final, ex. "/guide-declarations/dsfu-pamc". */
  path: string;
  /** Titre visible (H1). Peut différer du <title>. */
  h1: string;
  /** Nom court pour le fil d'Ariane. */
  breadcrumb: string;
  /** Questions de la page pour le FAQPage JSON-LD. */
  faq?: { question: string; reponse: string }[];
}

const { title, description, path, h1, breadcrumb, faq = [] } = Astro.props;

const authorSchema = {
  '@type': 'Person',
  name: 'Dr. Ryan Goburdhun',
  jobTitle: "Médecin remplaçant & fondateur d'Hippodoc",
  url: `${SITE_URL}/qui-sommes-nous`,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Guide Déclarations', item: `${SITE_URL}/guide-declarations` },
    { '@type': 'ListItem', position: 3, name: breadcrumb, item: `${SITE_URL}${path}` },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: h1,
  description,
  url: `${SITE_URL}${path}`,
  author: authorSchema,
  reviewedBy: authorSchema,
  lastReviewed: GUIDE_DECLARATIONS_LAST_UPDATED_ISO,
  dateModified: GUIDE_DECLARATIONS_LAST_UPDATED_ISO,
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: 'fr',
  isPartOf: { '@type': 'WebPage', url: `${SITE_URL}/guide-declarations` },
};

/* Le FAQPage n'est déclaré que si la page rend réellement les questions en
   clair : `verify-site.mjs` échoue si une question du JSON-LD est absente du
   texte visible. */
const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((q) => ({
        '@type': 'Question',
        name: q.question,
        acceptedAnswer: { '@type': 'Answer', text: q.reponse },
      })),
    }
  : null;

const dateLisible = GUIDE_DECLARATIONS_LAST_UPDATED.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const jsonLd = faqSchema
  ? [breadcrumbSchema, webPageSchema, faqSchema]
  : [breadcrumbSchema, webPageSchema];
---

<BaseLayout title={title} description={description} path={path} ogType="article" jsonLd={jsonLd}>
  <div class="min-h-screen bg-white dark:bg-slate-950">
    <Header />

    <main class="pb-20">
      <div class="max-w-5xl mx-auto px-4 pt-10 md:pt-14">
        <nav aria-label="Fil d'Ariane" class="mb-6">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
            <li><a href="/" class="hover:text-hippo-600 hover:underline">Accueil</a></li>
            <li aria-hidden="true">›</li>
            <li><a href="/guide-declarations" class="hover:text-hippo-600 hover:underline">Guide Déclarations</a></li>
            <li aria-hidden="true">›</li>
            <li class="text-foreground font-medium" aria-current="page">{breadcrumb}</li>
          </ol>
        </nav>

        <h1 class="text-3xl md:text-4xl font-bold leading-tight text-foreground">{h1}</h1>

        <p class="mt-3 text-sm text-muted-foreground">
          Mis à jour le {dateLisible} · révisé par Dr. Ryan Goburdhun,
          <span class="whitespace-nowrap">médecin remplaçant</span>
        </p>

        <slot name="chapo" />
      </div>

      <slot />

      <div class="max-w-5xl mx-auto px-4 mt-16">
        <div class="rounded-2xl border border-hippo-200/60 bg-hippo-50/50 p-6 dark:border-hippo-800/50 dark:bg-hippo-950/20">
          <h2 class="text-lg font-bold text-foreground">Le guide complet</h2>
          <p class="mt-2 text-sm text-muted-foreground">
            Cette page traite un cas précis. Le guide des déclarations réunit la totalité de
            la matière : les 35 cases de formulaires, 49 questions fréquentes, 85 termes de
            glossaire, la boussole qui identifie ton profil et le calendrier annuel.
          </p>
          <p class="mt-4">
            <a
              href="/guide-declarations"
              class="inline-flex items-center gap-1.5 rounded-lg bg-hippo-600 px-4 py-2 text-sm font-semibold text-white no-underline hover:bg-hippo-700"
            >
              Ouvrir le guide des déclarations
            </a>
          </p>
          <p class="mt-4 text-sm text-muted-foreground">
            Autres pages du guide :
            <a href="/guide-declarations/dsfu-pamc" class="text-hippo-600 hover:underline dark:text-hippo-400">DSFU (ex DS-PAMC)</a> ·
            <a href="/guide-declarations/2042-c-pro" class="text-hippo-600 hover:underline dark:text-hippo-400">2042-C-PRO</a> ·
            <a href="/guide-declarations/medecin-remplacant" class="text-hippo-600 hover:underline dark:text-hippo-400">Médecin remplaçant</a> ·
            <a href="/guide-declarations/calculette" class="text-hippo-600 hover:underline dark:text-hippo-400">HippoCalc</a>
          </p>
        </div>

        <p class="mt-8 text-xs leading-relaxed text-muted-foreground">
          Contenu informatif, à jour des règles connues au {dateLisible}. Il ne remplace pas
          l'avis d'un expert-comptable ou de ton AGA, et n'engage ni l'administration fiscale
          ni l'URSSAF. En cas de doute sur ta situation, fais vérifier ta déclaration.
        </p>
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
